      "writtenOn": "2016-05-27T00:58:09Z",
      "side": 1,
      "message": "If any current system uses the current commands, we can\u0027t change them, or new ectool / cros_ec drivers will send incompatible messages.\n\nYou\u0027ll need to add a new version of the command which has a bigger duty cycle field.  See EC_CMD_SWITCH_ENABLE_WIRELESS for an example.",
      "range": {
        "startLine": 1222,
        "startChar": 1,
        "endLine": 1222,
        "endChar": 50
      },
      "revId": "19c8fd1304f9a4496d35d3540a5dba555b9a4d00",

      "lineNbr": 134,
      "author": {
        "id": 1314845
      },
      "writtenOn": "2019-07-01T18:17:05Z",
      "side": 1,
      "message": "Robust *and* future proof (i.e., when new chips are added).",
      "parentUuid": "ee69ded9_bde5418e",
      "range": {
        "startLine": 132,
        "startChar": 0,
        "endLine": 134,
        "endChar": 2
      },

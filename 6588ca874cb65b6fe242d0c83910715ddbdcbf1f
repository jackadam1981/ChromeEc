      "lineNbr": 191,
      "author": {
        "id": 1106949
      },
      "writtenOn": "2019-02-27T19:15:42Z",
      "side": 1,
      "message": "I\u0027m not sure about this. If we\u0027re solid about using DCR \u003e CTR to disable the PWM, we should update pwm_get_enabled and pwm_enable accordingly.",
      "range": {
        "startLine": 191,
        "startChar": 0,
        "endLine": 191,
        "endChar": 59
      },
      "revId": "6588ca874cb65b6fe242d0c83910715ddbdcbf1f",

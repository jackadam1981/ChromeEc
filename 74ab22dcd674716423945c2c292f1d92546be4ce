      "message": "per this experiment:\n```\nfsammoura@fsammoura2:~/chromiumos/src/platform/ec$ git diff\ndiff --git a/zephyr/drivers/fingerprint/fingerprint_egis630.c b/zephyr/drivers/fingerprint/fingerprint_egis630.c\nindex 4535d8b5da..280b4851f3 100644\n--- a/zephyr/drivers/fingerprint/fingerprint_egis630.c\n+++ b/zephyr/drivers/fingerprint/fingerprint_egis630.c\n@@ -313,7 +313,7 @@ static int egis630_init_driver(const struct device *dev)\n                return -EINVAL;\n        }\n \n-       ret \u003d gpio_pin_configure_dt(\u0026cfg-\u003ereset_pin, GPIO_OUTPUT_INACTIVE);\n+       ret \u003d gpio_pin_configure_dt(\u0026cfg-\u003ereset_pin, GPIO_INPUT);\n        if (ret \u003c 0) {\n                LOG_ERR(\"Can\u0027t configure sensor reset pin\");\n                return ret;\ndiff --git a/zephyr/emul/emul_egis630.c b/zephyr/emul/emul_egis630.c\nindex 97a0fb341c..6bfa765d53 100644\n--- a/zephyr/emul/emul_egis630.c\n+++ b/zephyr/emul/emul_egis630.c\n@@ -65,6 +65,10 @@ static int egis630_emul_io(const struct emul *target,\n        if (data-\u003estop_spi) {\n                return -EINVAL;\n        }\n+       gpio_emul_input_set(cfg-\u003ereset_pin.port, cfg-\u003ereset_pin.pin, 1);\n+       LOG_INF(\"Value1: %d\", gpio_pin_get_dt(\u0026cfg-\u003ereset_pin));\n+       gpio_emul_input_set(cfg-\u003ereset_pin.port, cfg-\u003ereset_pin.pin, 0);\n+       LOG_INF(\"Value2: %d\", gpio_pin_get_dt(\u0026cfg-\u003ereset_pin));\n \n        if (gpio_emul_output_get(cfg-\u003ereset_pin.port, cfg-\u003ereset_pin.pin) \u003d\u003d\n            0) {\n@@ -133,14 +137,14 @@ ZTEST_RULE(egis630_emul_reset, NULL, egis630_emul_reset_rule_after);\n static int egis630_emul_init(const struct emul *target,\n                             const struct device *parent)\n {\n-       const struct egis630_emul_cfg *cfg \u003d target-\u003ecfg;\n+       //const struct egis630_emul_cfg *cfg \u003d target-\u003ecfg;\n        struct egis630_emul_data *data \u003d target-\u003edata;\n        ARG_UN
    {
      "key": {
        "uuid": "c31f87fd_406b2e86",
        "filename": "chip/stm32/usb_spi.c",
        "patchSetId": 3
      },
      "lineNbr": 226,
      "author": {
        "id": 1347380
      },
      "writtenOn": "2020-06-03T21:01:43Z",
      "side": 1,
      "message": "The buffer is not circular on this platform. rx_count only indicates the size of the last USB packet received. We do not have enough USB endpoints or space within the USB RAM region to allocate circular buffers on the Servo Micro platforms. Simiular behavior also occurs on implementations of the STM32 which do use double buffering although in that case it\u0027s treated as a bounce buffer.\n\nbtable_ep[] is mapped to the address of the USB registers controlling each endpoint. Other aspects of the endpoint status including if it can accept new packets, if it has a packet, or if it can transmit packets is controlled via access to the STM32_USB_EP(config-\u003eendpoint) register and querying or setting it\u0027s state.",
      "parentUuid": "a98d0612_3e400c1e",
      "range": {
        "startLine": 226,
        "startChar": 1,
        "endLine": 226,
        "endChar": 68
      },
      "revId": "112c66e09b07c4dc5e82300825b2dad2ea04e538",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

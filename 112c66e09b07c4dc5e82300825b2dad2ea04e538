      "writtenOn": "2020-06-03T20:14:34Z",
      "side": 1,
      "message": "how does this work? Is the usb buffer circular or not? if it is cicrlular, rx_count is not the number of bytes in the last packet, if it is not circular - who sets rx_count back to zero?",
      "range": {
        "startLine": 226,
        "startChar": 1,
        "endLine": 226,
        "endChar": 68
      },
      "revId": "112c66e09b07c4dc5e82300825b2dad2ea04e538",

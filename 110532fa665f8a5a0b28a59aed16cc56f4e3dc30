        "id": 1106949
      },
      "writtenOn": "2023-02-16T17:25:32Z",
      "side": 1,
      "message": "Doesn\u0027t the host need to know whether the requested limit was accepted or not?",
      "parentUuid": "8d732b7a_47edcf54",
      "range": {
        "startLine": 2578,
        "startChar": 23,
        "endLine": 2578,
        "endChar": 31
      },
      "revId": "110532fa665f8a5a0b28a59aed16cc56f4e3dc30",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {

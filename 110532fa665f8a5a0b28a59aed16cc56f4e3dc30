        "id": 1106949
      },
      "writtenOn": "2023-02-15T20:55:39Z",
      "side": 1,
      "message": "You probably want to validate this and return error if it\u0027s too high or too low.",
      "range": {
        "startLine": 2578,
        "startChar": 23,
        "endLine": 2578,
        "endChar": 31
      },
      "revId": "110532fa665f8a5a0b28a59aed16cc56f4e3dc30",

        "uuid": "ed6ae15f_6bf66e64",
        "filename": "common/flash_log.c",
        "patchSetId": 2
      },
      "lineNbr": 101,
      "author": {
        "id": 1000039
      },
      "writtenOn": "2019-03-17T20:03:57Z",
      "side": 1,
      "message": "Platform means chip architecture, I guess it is too broad here, changed to chip.",
      "parentUuid": "e811d6e3_9c7b1625",
      "range": {
        "startLine": 101,
        "startChar": 23,
        "endLine": 101,
        "endChar": 31
      },
      "revId": "3929f4f23875c7fd3eb7bdb434dafcdde9a34480",

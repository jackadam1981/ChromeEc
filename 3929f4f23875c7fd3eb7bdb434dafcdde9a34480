      },
      "writtenOn": "2019-03-16T05:33:07Z",
      "side": 1,
      "message": "Could we lock a mutex, instead?\n\n(we might need to implement a mutex_trylock function, though)",
      "revId": "3929f4f23875c7fd3eb7bdb434dafcdde9a34480",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

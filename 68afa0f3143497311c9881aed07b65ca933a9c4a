    {
      "key": {
        "uuid": "0dd5bfc8_9c4ca2e2",
        "filename": "chip/g/dcrypto/bn.c",
        "patchSetId": 1
      },
      "lineNbr": 1232,
      "author": {
        "id": 1000039
      },
      "writtenOn": "2017-09-26T18:03:22Z",
      "side": 1,
      "message": "The goal of this function is to demonstrate that the new random number generator produces exactly the same sequence as the old, so just adding one line in the generator is cleaner than to add the same test code in two different implementations.\n\nAvoiding statics would be great, but given that this code is compiled in only occasionally having a clean separation (just one line to call the function) seems preferable to me.",
      "parentUuid": "e9ebc565_513bf356",
      "range": {
        "startLine": 1218,
        "startChar": 1,

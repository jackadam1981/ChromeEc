    {
      "unresolved": true,
      "key": {
        "uuid": "02102faa_9844d02a",
        "filename": "zephyr/app/ec/chip/riscv/riscv-ite/it8xxx2-espi.c",
        "patchSetId": 6
      },
      "lineNbr": 19,
      "author": {
        "id": 1308749
      },
      "writtenOn": "2022-07-26T20:57:22Z",
      "side": 1,
      "message": "The comments in device.h upstream indicate one should call `device_is_ready()` before using the pointer returned by `DEVICE_DT_GET`.",
      "parentUuid": "1360bf49_6448f135",
      "revId": "b13e2b1c3fb488dda303b9250c4bebc40aae3336",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

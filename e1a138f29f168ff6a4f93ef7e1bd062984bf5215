        "patchSetId": 5
      },
      "lineNbr": 949,
      "author": {
        "id": 1000253
      },
      "writtenOn": "2016-09-16T21:03:12Z",
      "side": 1,
      "message": "How do we know the write actually worked if we don\u0027t change the value? Shouldn\u0027t it be incumbent on the user of the test to find a register which can be changed safely?\n\nI think we need something like:\n1. Read the register\n2. Come up with a new value by change bits (deemed safe to change).\n3. Read to verify the new was written.\n4. Write the original value.\n5. Read to verify the original value was restored.",
      "range": {
        "startLine": 945,
        "startChar": 0,
        "endLine": 949,
        "endChar": 6
      },
      "revId": "e1a138f29f168ff6a4f93ef7e1bd062984bf5215",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

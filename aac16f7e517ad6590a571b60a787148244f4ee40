    {
      "key": {
        "uuid": "f7ed688d_7a71c36c",
        "filename": "common/pinweaver.c",
        "patchSetId": 10
      },
      "lineNbr": 597,
      "author": {
        "id": 1160200
      },
      "writtenOn": "2018-03-16T23:11:03Z",
      "side": 1,
      "message": "We need to keep track of the bits_per_level and height somewhere. We could export it, but then we would still need a monotonic counter. I think the space required for storing these keys is small enough to justify the benefits of being able to generate a new Merkle tree independently from a TPM reset with independent keys.",
      "parentUuid": "7da8ce0f_89fd3fd0",
      "range": {
        "startLine": 597,
        "startChar": 0,
        "endLine": 597,
        "endChar": 56
      },
      "revId": "aac16f7e517ad6590a571b60a787148244f4ee40",

    {
      "key": {
        "uuid": "93b23402_19f24ff8",
        "filename": "power/icelake.c",
        "patchSetId": 3
      },
      "lineNbr": 29,
      "author": {
        "id": 1123814
      },
      "writtenOn": "2018-07-04T17:39:38Z",
      "side": 1,
      "message": "No, this is a holdover from cannonlake.c implementation which itself is identical to what is in skylake.c . The comment certainly isn\u0027t accurate. Since icelake doesn\u0027t use a PMIC, does the power_button_pch_press() call still apply? What is the difference between \u0027force_shutdown\u0027 and \u0027force_g3\u0027 for icelake?",
      "parentUuid": "626a533f_bd5b9778",
      "range": {
        "startLine": 28,
        "startChar": 15,
        "endLine": 29,
        "endChar": 10
      },
      "revId": "0af70e4acc44c1bf0f8ef486ef7674237a1cb34f",

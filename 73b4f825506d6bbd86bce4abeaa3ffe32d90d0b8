    {
      "key": {
        "uuid": "d6468f6b_bcb5d89f",
        "filename": "driver/tcpm/nct38xx.c",
        "patchSetId": 4
      },
      "lineNbr": 199,
      "author": {
        "id": 1160634
      },
      "writtenOn": "2019-02-17T12:12:29Z",
      "side": 1,
      "message": "I saw the following problem: If I connect a device is one orientation and then disconnect it and connect in a different orientation something goes wrong (not sure what) and the connection does not work. We didn’t fully debug it, but we found that setting the polarity back to 0 solves the problem.",
      "parentUuid": "edcb7bb7_c2293570",
      "range": {
        "startLine": 199,
        "startChar": 1,
        "endLine": 199,
        "endChar": 27
      },
      "revId": "73b4f825506d6bbd86bce4abeaa3ffe32d90d0b8",

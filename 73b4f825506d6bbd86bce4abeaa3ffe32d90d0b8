        "id": 1259838
      },
      "writtenOn": "2019-02-14T17:00:40Z",
      "side": 1,
      "message": "why do we need to set the polarity back to 0, what bad thing happens if we don\u0027t do this?",
      "range": {
        "startLine": 199,
        "startChar": 1,
        "endLine": 199,
        "endChar": 27
      },
      "revId": "73b4f825506d6bbd86bce4abeaa3ffe32d90d0b8",

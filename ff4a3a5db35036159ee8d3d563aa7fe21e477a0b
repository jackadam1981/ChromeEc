      "writtenOn": "2022-06-21T19:49:42Z",
      "side": 1,
      "message": "I like the proposed name `CONFIG_PRINTF_ENABLE_32BIT_LONG_FMT`. Does anyone have a strong opinion to keep these separate?",
      "parentUuid": "599c9de4_0241c900",
      "revId": "ff4a3a5db35036159ee8d3d563aa7fe21e477a0b",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

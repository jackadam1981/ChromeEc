      "writtenOn": "2022-06-17T17:54:21Z",
      "side": 1,
      "message": "I went back and forth on whether the check should be on the config flag (`CONFIG_PRINTF_DISABLE_32BIT_LONG_WORKAROUND`) or the devices in which that flag should be enabled. I feel like the board names is a better option but what do you think?",
      "range": {
        "startLine": 189,
        "startChar": 17,
        "endLine": 189,
        "endChar": 35
      },
      "revId": "ff4a3a5db35036159ee8d3d563aa7fe21e477a0b",

        "id": 1128369
      },
      "writtenOn": "2017-03-20T22:00:58Z",
      "side": 1,
      "message": "Default value of VSYS is 8.96 V. We want to keep charger in Pre-charge state at init (VSYS \u003e VBAT) before enabling Charging.",
      "parentUuid": "7a3b06c2_69f0b779",
      "revId": "867f8ad26931647a8e19edd5e583b3789f203a5b",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

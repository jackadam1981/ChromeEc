      "lineNbr": 57,
      "author": {
        "id": 1347380
      },
      "writtenOn": "2020-06-03T09:08:38Z",
      "side": 1,
      "message": "This packet indicates the status code for the USB SPI transfer indicating success or failure. I picked this example to show how multi-packets are transmitted and demonstrate how a packet containing the status code is always included. Protocol V1 does the same thing.",
      "parentUuid": "ed23f239_42446228",
      "range": {
        "startLine": 54,
        "startChar": 0,
        "endLine": 57,
        "endChar": 34
      },
      "revId": "e1071ad23f6eb765fdb8ec986989fe1a0ebea442",

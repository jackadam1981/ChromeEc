      "writtenOn": "2022-04-12T21:13:38Z",
      "side": 1,
      "message": "Does forcing sink state avoid a hard reset? If so, how?",
      "parentUuid": "763c3bba_c38948f6",
      "revId": "53543540fd35aebc723f28d2b8b229612db42a31",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,

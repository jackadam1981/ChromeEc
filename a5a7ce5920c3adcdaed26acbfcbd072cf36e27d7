      "writtenOn": "2023-10-06T17:28:33Z",
      "side": 1,
      "message": "This should be `LOG_PRINTK`.  APIs that start with \"Z_\" or \"z_\" are considered private, and can be changed at any time.\n\nAlso, is a spin lock around `LOG_PRINTK` guaranteed safe?  Has this been tested when the UART is configured for interrupt and polling modes?",
      "range": {
        "startLine": 56,
        "startChar": 1,
        "endLine": 56,
        "endChar": 13
      },
      "revId": "a5a7ce5920c3adcdaed26acbfcbd072cf36e27d7",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

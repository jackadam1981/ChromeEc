srck := $(CURDIR)/util/kconfig
objk := $(out)/util/kconfig
Kconfig := Kconfig

#KBUILD_DEFCONFIG := configs/defconfig
KBUILD_DEFCONFIG := $(BDIR)/defconfig.in
DEFCONFIG := $(BDIR)/defconfig.out

#DOTCONFIG ?= $(top)/.config
#DOTCONFIG ?= $(out)/board.kconfig
DOTCONFIG ?= $(BDIR)/board.kconfig
export CONFIG_ := KCONFIG_
export KCONFIG_CONFIG = $(DOTCONFIG)
export KCONFIG_AUTOCONFIG := $(out)/auto.conf
#config.h
export KCONFIG_AUTOHEADER := $(out)/kconfig.h
export KCONFIG_DEPENDENCIES := $(out)/auto.conf.cmd
#/config
export KCONFIG_SPLITCONFIG := $(out)/include/kconfig
export KCONFIG_TRISTATE := $(out)/tristate.conf

export COREBOOT_BUILD_DIR := $(out)

# [new, cj] env KCONFIG_POSITIVES := 1

# env KCONFIG_AUTOCONFIG := $(obj)/auto.conf
# env KCONFIG_NEGATIVES := 1
# env KCONFIG_SPLITCONFIG := $(obj)/config
# env KCONFIG_DEPENDENCIES := $(obj)/auto.conf.cmd
# env KCONFIG_AUTOHEADER := $(obj)/config.h
# env KCONFIG_TRISTATE := $(obj)/tristate.conf
# env KCONFIG_PROBABILITY
# env KCONFIG_ALLCONFIG
# env KCONFIG_SEED
# env KCONFIG_NOSILENTUPDATE
# warnings are errors
export KCONFIG_STRICT := 1

include $(srck)/Makefile

common_dirs+=util/kconfig util/kconfig/lxdialog
common_dirs+=include/kconfig

################################################################

cmd_silentoldconfig = \
	if [ -e $< ]; then \
		$(MAKE) silentoldconfig $(silent) ; \
	else \
		touch $@ ; \
	fi

$(KCONFIG_CONFIG):

$(KCONFIG_AUTOHEADER): $(KCONFIG_CONFIG) $(objk)/conf
	+$(call quiet,silentoldconfig,GEN    )

$(KCONFIG_AUTOCONFIG): $(KCONFIG_AUTOHEADER) ;

CFLAGS += -include $(abspath $(KCONFIG_AUTOHEADER))

################################################################

.PHONY: kconfig-sanity
kconfig-sanity: $(config:%=%.raw) $(KCONFIG_AUTOHEADER:.h=.raw) ;
kconfig-sanity: $(out)/kconfig.new
kconfig-sanity: $(out)/kconfig.missing
kconfig-sanity: $(out)/kconfig.common

cmd_gen_conf_raw = \
	$(CPP) $(CPPFLAGS) -P -dM -Ichip/$(CHIP) \
	-I$(BASEDIR) -I$(BDIR) -DSECTION_IS_RW=$(EMPTY) include/config.h | \
	sed -ne "s, \+$$,,;s,^\#define K\?\(CONFIG_.*\)$$,\1,p" | \
	sort -o $@

$(config:%=%.raw): $(config)
	$(call quiet,gen_conf_raw,GEN    )

# we really need to run kconfig.h through cpp to get the full
# effect of other header files turning stuff on/off

cmd_gen_kc_raw = \
	sed -ne "/__yn$$/d;s,^\#define K\?\(CONFIG_.*\)$$,\1,p" $< | \
	sort -o $@

cmd_gen_kc_comm = \
	comm -12 $(config:%=%.raw) $(KCONFIG_AUTOHEADER:%.h=%.raw) > $@

cmd_gen_kc_new = \
	comm -13 $(config:%=%.raw) $(KCONFIG_AUTOHEADER:%.h=%.raw) > $@

cmd_gen_kc_miss = \
	comm -23 $(config:%=%.raw) $(KCONFIG_AUTOHEADER:%.h=%.raw) > $@

$(KCONFIG_AUTOHEADER:%.h=%.raw): $(KCONFIG_AUTOHEADER)
	$(call quiet,gen_kc_raw,GEN    )

$(out)/kconfig.common: $(config:%=%.raw) $(KCONFIG_AUTOHEADER:%.h=%.raw)
	$(call quiet,get_kc_comm,GEN    )

$(out)/kconfig.new: $(config:%=%.raw) $(KCONFIG_AUTOHEADER:%.h=%.raw)
	$(call quiet,get_kc_new,GEN    )

$(out)/kconfig.missing: $(config:%=%.raw) $(KCONFIG_AUTOHEADER:%.h=%.raw)
	$(call quiet,get_kc_miss,GEN    )

      },
      "writtenOn": "2022-11-07T20:44:25Z",
      "side": 1,
      "message": "The requester tagged https://crbug.com/1152584#c2 as reference where the solution was giving push access directly to the branch instead of `refs/for/refs/*`.\n\nYou think we shouldn\u0027t be doing that?",
      "parentUuid": "317fcc94_b202ba25",
      "range": {
        "startLine": 41,
        "startChar": 9,
        "endLine": 41,
        "endChar": 54
      },
      "revId": "85f1bb8ab9d01da12bb0e8b09e53a59352c86ea7",

      "lineNbr": 255,
      "author": {
        "id": 1106949
      },
      "writtenOn": "2023-01-17T18:10:49Z",
      "side": 1,
      "message": "I didn\u0027t find any reference of EC_FAN_SPEED_STALLED (and EC_FAN_SPEED_NOT_PRESENT) either.\n\n(FYI: We should also deprecate EC_FAN_SPEED_NOT_PRESENT and add EC_FAN_COUNT, instead.)",
      "parentUuid": "e732c5c5_6d2fcfe5",
      "range": {
        "startLine": 255,
        "startChar": 31,
        "endLine": 255,
        "endChar": 32
      },
      "revId": "59842b5b57d110f75b86865b1a2973bd1a698257",

        "id": 1530058
      },
      "writtenOn": "2024-11-07T18:28:30Z",
      "side": 1,
      "message": "@alevkoy@chromium.org - what are your thoughts on this?",
      "parentUuid": "fa2d1460_6f73e049",
      "range": {
        "startLine": 1401,
        "startChar": 15,
        "endLine": 1401,
        "endChar": 25
      },
      "revId": "9f2295ab2496a138a88f048fb360452e6043b3c1",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

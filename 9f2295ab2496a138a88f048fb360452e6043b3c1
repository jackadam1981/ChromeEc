      "writtenOn": "2024-11-06T20:35:49Z",
      "side": 1,
      "message": "Should we be applying `DRP_NORMAL` in all other dual role modes besides `PD_DRP_TOGGLE_ON`?",
      "range": {
        "startLine": 1401,
        "startChar": 15,
        "endLine": 1401,
        "endChar": 25

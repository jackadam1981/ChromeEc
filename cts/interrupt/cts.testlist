/*
 * Test interrupt
 *
 * After sync, DUT goes into sleep, waiting for an interrupt from TH. TH
 * raises GPIO level to wake up DUT.
 *
 * Requirements:
 * - Sync connection
 * - GPIO_OUTPUT connection from TH to DUT's interrupt pin
 */
CTS_TEST(interrupt_test)

/*
 * Test interrupt disabled
 *
 * Requirements:
 * - Sync connection
 * - GPIO_OUTPUT connection from TH to DUT's interrupt pin
 */
CTS_TEST(interrupt_disable_test)

/*
 * Other ideas
 *
 * Test back-to-back interrupts
 */
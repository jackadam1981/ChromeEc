/*
 * Test timer accuracy
 *
 * After sync, DUT and TH start counting down one second. After one second,
 * DUT raises GPIO level. TH determines whether the test passes or not based
 * on how much time elapsed.
 *
 * Requirements:
 * - Sync connection
 * - GPIO_OUTPUT connection
 * - Calibrated TH timer
 */
CTS_TEST(timer_calibration_test)

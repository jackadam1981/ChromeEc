    {
      "key": {
        "uuid": "5b2648fc_689e6f34",
        "filename": "include/config.h",
        "patchSetId": 2
      },
      "lineNbr": 3811,
      "author": {
        "id": 1106949
      },
      "writtenOn": "2018-08-07T18:17:33Z",
      "side": 1,
      "message": "Can you justify 5% as well? If the battery is charged higher than that, imbalance doesn\u0027t cause an issue?",
      "range": {
        "startLine": 3811,
        "startChar": 55,
        "endLine": 3811,
        "endChar": 56
      },
      "revId": "d2a122a8b5c1a470388dcda330f999f45906c0a1",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

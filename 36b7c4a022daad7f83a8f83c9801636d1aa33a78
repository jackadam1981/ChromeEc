      "lineNbr": 100,
      "author": {
        "id": 1529242
      },
      "writtenOn": "2022-01-25T22:17:07Z",
      "side": 1,
      "message": "That\u0027s weird. The compiler shouldn\u0027t raise errors about variables that are only used within a if block if they are not used elsewhere.",
      "parentUuid": "dd787147_be54bd07",
      "range": {
        "startLine": 100,
        "startChar": 0,
        "endLine": 100,
        "endChar": 26
      },
      "revId": "36b7c4a022daad7f83a8f83c9801636d1aa33a78",

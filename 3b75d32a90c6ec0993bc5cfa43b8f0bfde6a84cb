      "lineNbr": 299,
      "author": {
        "id": 1148900
      },
      "writtenOn": "2017-10-14T03:59:04Z",
      "side": 1,
      "message": "This is executed when the following sequence happens:\n(1) the host sets the alarm\n(2) the idle task comes in and overwrite the alarm\n(3) the alarm goes off and wakes up the idle task, but the host wake time in (1) doesn\u0027t come yet\n\nThen we need to restore the alarm setting to (1).",
      "parentUuid": "5f9a009e_481e6cee",
      "range": {
        "startLine": 298,
        "startChar": 0,
        "endLine": 299,
        "endChar": 29
      },
      "revId": "3b75d32a90c6ec0993bc5cfa43b8f0bfde6a84cb",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

      "writtenOn": "2016-05-17T18:21:47Z",
      "side": 1,
      "message": "There\u0027s potentially big precision loss here (eg. v1 - v0 \u003d 24, num_steps \u003d 5). Can we try another way?",
      "range": {
        "startLine": 128,
        "startChar": 2,
        "endLine": 128,
        "endChar": 34
      },
      "revId": "76e86ce6e0f03ce12dfb4ba8f14fece9bdaab627",

      "writtenOn": "2020-03-18T21:01:49Z",
      "side": 1,
      "message": "tcpm_set_connection is optional code and may or may not be chip specific. I wanted to make sure the order was what the TCPCI suggests in the spec.  Since this is optional, it is safest to leave it where it already exists so other devices do not start breaking.",
      "parentUuid": "b4309b07_ee3e6cff",
      "range": {
        "startLine": 1704,
        "startChar": 2,
        "endLine": 1704,

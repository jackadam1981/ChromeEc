 		gpio_cpu_c10_gate_r: cpu_c10_gate_r {
 			gpios = <&gpiob 2 (GPIO_INPUT | GPIO_VOLTAGE_1P8)>;
 		};
-		gpio_c_ec_pdb_ctrl_r: c_ec_pdb_ctrl_r {

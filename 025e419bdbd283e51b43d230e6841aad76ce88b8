      },
      "lineNbr": 85,
      "author": {
        "id": 1308749
      },
      "writtenOn": "2021-05-10T18:00:38Z",
      "side": 1,
      "message": "I tried the following, but it didn\u0027t compile:\n\n#if PREEMPT_ENABLED\nconfig SYSTEM_WORKQUEUE_PRIORITY\n    default NUM_PREEMPT_PRIORITIES - 1\n#endif",
      "parentUuid": "a5a0d2a5_817104da",
      "revId": "025e419bdbd283e51b43d230e6841aad76ce88b8",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "7f92ce5c_6f426983",
        "filename": "zephyr/app/ec/ec_app_main.c",
        "patchSetId": 3
      },
      "lineNbr": 85,

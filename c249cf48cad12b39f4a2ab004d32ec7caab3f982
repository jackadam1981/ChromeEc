      "writtenOn": "2019-06-19T22:50:57Z",
      "side": 1,
      "message": "I know we discussed in the past that we should be using MODE_CHANGE here instead of MKBP. But what do you think about Ec_HOST_EVENT_PD_MCU? Does the notification make more sense as a PD event?",
      "range": {
        "startLine": 600,
        "startChar": 1,
        "endLine": 600,
        "endChar": 21
      },
      "revId": "c249cf48cad12b39f4a2ab004d32ec7caab3f982",

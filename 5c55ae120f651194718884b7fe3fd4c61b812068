    {
      "key": {
        "uuid": "74ba4cd7_921c5a65",
        "filename": "common/usbc/tbt_alt_mode.c",
        "patchSetId": 3
      },
      "lineNbr": 245,
      "author": {
        "id": 1305927
      },
      "writtenOn": "2020-09-18T20:31:26Z",
      "side": 1,
      "message": "This already happened in TBT_ACTIVE.",
      "revId": "5c55ae120f651194718884b7fe3fd4c61b812068",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

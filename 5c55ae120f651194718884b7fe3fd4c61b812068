      },
      "writtenOn": "2020-09-22T01:17:17Z",
      "side": 1,
      "message": "Since we do not query SOP\u0027\u0027, we do not need to call pd_dfp_exit_mode() here",
      "parentUuid": "a935a6fb_ddcd7e05",
      "revId": "5c55ae120f651194718884b7fe3fd4c61b812068",

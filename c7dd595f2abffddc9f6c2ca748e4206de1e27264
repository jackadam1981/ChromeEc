      },
      "lineNbr": 187,
      "author": {
        "id": 1000058
      },
      "writtenOn": "2016-08-19T19:38:16Z",
      "side": 1,
      "message": "I think we should have an explicit \"reboot\" command, rather than just hanging here indefinitely. Maybe a separate EXTENSION?",
      "range": {
        "startLine": 184,
        "startChar": 3,
        "endLine": 187,
        "endChar": 5
      },
      "revId": "c7dd595f2abffddc9f6c2ca748e4206de1e27264",

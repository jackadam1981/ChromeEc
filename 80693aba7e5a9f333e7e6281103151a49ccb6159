      "unresolved": true
    },
    {
      "key": {
        "uuid": "fbda0149_5f20aa78",
        "filename": "chip/ish/watchdog.c",
        "patchSetId": 1
      },
      "lineNbr": 110,
      "author": {
        "id": 1330845
      },
      "writtenOn": "2019-03-15T21:08:08Z",
      "side": 1,
      "message": "I designed this console command with the thoughts that it would be really easy to test and implement the watchdog on future ISH cores simply by running \u0027wdt enable ...\u0027, even if CONFIG_WATCHDOG is undef\u0027ed. It could also be useful for quick experimentation of finding practical values for T1 and T2.\n\nAlong the same lines, maybe useful for temporarily disabling WDT for testing a new feature.\n\nIf you don\u0027t think any of that would actually be useful, willing to remove.",
      "parentUuid": "545a24ff_2daa971c",
      "range": {
        "startLine": 93,
        "startChar": 0,
        "endLine": 110,
        "endChar": 2

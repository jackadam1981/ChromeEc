    {
      "key": {
        "uuid": "545a24ff_2daa971c",
        "filename": "chip/ish/watchdog.c",
        "patchSetId": 1
      },
      "lineNbr": 110,
      "author": {
        "id": 1259838
      },
      "writtenOn": "2019-03-15T20:05:52Z",
      "side": 1,
      "message": "I don\u0027t think that disabling watchdog reset is something we would ever want to do on command line. I don\u0027t think it is worth having the console command (although it may have been useful for the feature development)",
      "range": {
        "startLine": 93,
        "startChar": 0,
        "endLine": 110,
        "endChar": 2
      },
      "revId": "80693aba7e5a9f333e7e6281103151a49ccb6159",

        "patchSetId": 2
      },
      "lineNbr": 83,
      "author": {
        "id": 1000058
      },
      "writtenOn": "2015-09-16T05:55:33Z",
      "side": 1,
      "message": "OFFSET, MAINB, and SIZE are all fields in the same control register, so they\u0027re gonna get *something*. MAINB is required, though.\n\nIt seems that the sequence between that register and the buffer filling doesn\u0027t matter. AFAICT, the controller just needs all the parameter registers set up before we enable it and tell it to go.",
      "parentUuid": "8478d270_6c17d40f",
      "range": {
        "startLine": 82,
        "startChar": 0,

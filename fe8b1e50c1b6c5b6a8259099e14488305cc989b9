      "writtenOn": "2022-02-24T17:55:01Z",
      "side": 1,
      "message": "We could create a virtual wire driver that maps into the GPIO API.  Then this property (and the next) wouldn\u0027t be needed.\n\nIf you like this idea, open a bug for cleanup later.",
      "range": {
        "startLine": 157,
        "startChar": 0,
        "endLine": 157,
        "endChar": 21
      },
      "revId": "fe8b1e50c1b6c5b6a8259099e14488305cc989b9",

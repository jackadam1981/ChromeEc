      "writtenOn": "2017-02-16T10:08:33Z",
      "side": 1,
      "message": "This is dangerous. It\u0027s the handler for the TPM update path, and calling it through USB will cause the updater to be run on both hooks and tpm tasks. It must not be whitelisted.",
      "revId": "359fa8e14feff99e163b99eb1a5fb18ddcd14181",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

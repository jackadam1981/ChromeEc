    {
      "key": {
        "uuid": "1baaa590_d1b14ab2",
        "filename": "chip/ish/ipc_heci.c",
        "patchSetId": 19
      },
      "lineNbr": 658,
      "author": {
        "id": 1137654
      },
      "writtenOn": "2018-12-12T01:31:11Z",
      "side": 1,
      "message": "I also thought about taking this out to separate file but I\u0027ve added this task here because, unlike HECI, this is mandatory. this is for managing the link btw host and ISH. This task always should be there to enable any protocol.\n\nAs I mentioned above, the file name of this will be changed to \"ipc.c\" once we migrate existing \"ipc.c\" into this.",
      "parentUuid": "349b9486_dbe0c121",
      "range": {
        "startLine": 658,
        "startChar": 3,
        "endLine": 658,
        "endChar": 33
      },
      "revId": "6d422a756645eea0e457f29ca549e521e3b3f1f9",

    {
      "key": {
        "uuid": "b5f8e448_ad37145e",
        "filename": "chip/ish/ipc_heci.c",
        "patchSetId": 19
      },
      "lineNbr": 246,
      "author": {
        "id": 1137654
      },
      "writtenOn": "2018-12-12T01:31:11Z",
      "side": 1,
      "message": "I know drbl has the length, protocol.. but it\u0027s my habit considering speed. which is based on ARM which I worked on most of my engineering time.\nTry to keep \u003c\u003d 4 arguments, up to 4,sending as arguments is the faster since ARM ABI defines using r0~r3 for arguments.\n\nx86 ABI asks stack(push) for arguments for standard call. So It\u0027s about push VS and-shift. I just checked machine cycle and push(3+2) is faster than and-shift(6+4).",
      "parentUuid": "c9d14a4f_95a69adc",
      "range": {
        "startLine": 246,
        "startChar": 28,
        "endLine": 246,
        "endChar": 47
      },
      "revId": "6d422a756645eea0e457f29ca549e521e3b3f1f9",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

        "id": 1137654
      },
      "writtenOn": "2018-12-12T15:51:07Z",
      "side": 1,
      "message": "Sorry, \"6\" may not be the right number. let me check the actual machine instruction code for this.",
      "parentUuid": "b5f8e448_ad37145e",
      "range": {
        "startLine": 246,
        "startChar": 28,
        "endLine": 246,
        "endChar": 47
      },
      "revId": "6d422a756645eea0e457f29ca549e521e3b3f1f9",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true

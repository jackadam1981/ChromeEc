      "writtenOn": "2018-12-11T21:38:25Z",
      "side": 1,
      "message": "it looks like every call side just uses the size in the drbl parameter. Can we derive the size from the drbl within this function and not pass in this fourth parameter?",
      "range": {
        "startLine": 246,
        "startChar": 28,
        "endLine": 246,
        "endChar": 47
      },
      "revId": "6d422a756645eea0e457f29ca549e521e3b3f1f9",

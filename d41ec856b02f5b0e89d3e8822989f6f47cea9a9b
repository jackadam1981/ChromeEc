    {
      "key": {
        "uuid": "78f5f797_bc43d7c7",
        "filename": "board/cr50/tpm2/virtual_nvmem.c",
        "patchSetId": 19
      },
      "lineNbr": 269,
      "author": {
        "id": 1000039
      },
      "writtenOn": "2018-08-02T18:36:46Z",
      "side": 1,
      "message": "as we can\u0027t do anything in assert, I think it would make more sense for this function just to clip the range the caller if trying to read and then only read the valid part(s).",
      "parentUuid": "89f5d065_97441dc8",
      "revId": "d41ec856b02f5b0e89d3e8822989f6f47cea9a9b",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

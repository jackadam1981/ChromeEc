        "id": 1520632
      },
      "writtenOn": "2024-03-16T07:51:47Z",
      "side": 1,
      "message": "But the desired effect was to disable PP3300 before ec reset, which would require switching from S5 to G3.",
      "parentUuid": "2ccacc05_93a7e027",
      "range": {
        "startLine": 1054,
        "startChar": 0,
        "endLine": 1057,
        "endChar": 17

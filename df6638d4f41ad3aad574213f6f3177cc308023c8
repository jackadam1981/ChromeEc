      "writtenOn": "2019-05-31T22:16:44Z",
      "side": 1,
      "message": "I2C Bus specification reserves slave address 0\nhttps://i2c.info/i2c-bus-specification#7-bit-addressing\n\nIn the case of ITE EC, TCPCs are embedded in EC. Hence no need to configure the slave address for TCPCs and is left as 0.",
      "parentUuid": "7df04ed5_d577e112",
      "range": {
        "startLine": 38,
        "startChar": 2,
        "endLine": 38,
        "endChar": 21
      },
      "revId": "df6638d4f41ad3aad574213f6f3177cc308023c8",

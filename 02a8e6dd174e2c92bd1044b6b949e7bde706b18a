    {
      "key": {
        "uuid": "6f9911b6_67607db4",
        "filename": "chip/npcx/espi.c",
        "patchSetId": 1
      },
      "lineNbr": 545,
      "author": {
        "id": 1003000
      },
      "writtenOn": "2017-02-08T07:29:31Z",
      "side": 1,
      "message": "According to the spec, any unplanned reset event in host/PCH will result in an abrupt assertion of eSPI_Reset#, thus prematurely terminating any eSPI transactions that were going on. Also, the motivation behind adding a dedicated reset pin is to handle all kinds of global reset events and thus it acts as the fundamental reset to the eSPI interface.\n\nMy understanding of the spec is that no matter what component fails, eSPI_Reset# should always be asserted to the EC.",
      "parentUuid": "bbf50d33_aa2aa8c5",
      "revId": "02a8e6dd174e2c92bd1044b6b949e7bde706b18a",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

      "message": "OK.",
      "parentUuid": "6f9911b6_67607db4",
      "revId": "02a8e6dd174e2c92bd1044b6b949e7bde706b18a",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

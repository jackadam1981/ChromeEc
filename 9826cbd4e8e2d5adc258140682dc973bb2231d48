      "message": "This isn\u0027t required by the pd_shared_alert_task(), correct?\n\nI think it makes more sense to put some of this logic into Kconfig.usbc\n\n    config PLATFORM_EC_USB_PD_INT_SHARED\n        bool # no help text, intermediate helper option only\n       \n    if PLATFORM_EC_USB_PD_INT_SHARED\n    config PLATFORM_EC_USB_PD_PORT_0_SHARED\n        bool \"USB-C port 0 interrupt is shared\"\n        select PLATFORM_EC_USB_PD_INT_SHARED\n    ...\n    config PLATFORM_EC_USB_PD_PORT_3_SHARED\n        bool \"USB-C port 3 interrupt is shared\"\n        select PLATFORM_EC_USB_PD_INT_SHARED\n    endif # PLATFORM_EC_USB_PD_INT_SHARED\n\nThen here, you add an HAS_TASK for the shared interrupt, and guard the individual port interrupts.\n\n    config HAS_TASK_PD_INT_SHARED\n        bool\n        depends on PLATFORM_EC_USB_PD_INT_SHARED\n        \n    config HAS_TASK_PD_INT_C0\n\tbool\n\tdepends on PLATFORM_EC_USB_POWER_DELIVERY\n\tdepends on !PLATFORM_EC_USB_PD_INT_SHARED\n        default y if PLATFORM_EC_USB_PD_PORT_MAX_COUNT \u003e 0",

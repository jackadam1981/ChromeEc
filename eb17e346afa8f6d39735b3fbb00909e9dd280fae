      "writtenOn": "2025-01-17T18:45:35Z",
      "side": 1,
      "message": "The test may contain multiple iterations, like 10. So the resulting sink/source ratio should change from 5:5 to 10:0. Make sure to disable TrySrc in DUT.",
      "parentUuid": "f9a0a2bd_e620d32d",
      "revId": "eb17e346afa8f6d39735b3fbb00909e9dd280fae",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

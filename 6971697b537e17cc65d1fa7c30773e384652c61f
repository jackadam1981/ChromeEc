      "writtenOn": "2018-08-03T02:25:09Z",
      "side": 1,
      "message": "i2c_read8, I think?\n\nOne problem is that you can\u0027t lock the bus in advance, with that... Do you really need to lock the bus the whole time, actually?",
      "range": {
        "startLine": 207,
        "startChar": 7,
        "endLine": 207,
        "endChar": 15
      },
      "revId": "6971697b537e17cc65d1fa7c30773e384652c61f",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true

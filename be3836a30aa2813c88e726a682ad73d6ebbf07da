    {
      "unresolved": false,
      "key": {
        "uuid": "138c1f42_5521d2f5",
        "filename": "zephyr/test/accel_cal/CMakeLists.txt",
        "patchSetId": 2
      },
      "lineNbr": 20,
      "author": {
        "id": 1333748
      },
      "writtenOn": "2021-09-02T19:36:50Z",
      "side": 1,
      "message": "That\u0027s done in some places in the test, but this last bit is used to check that one algorithm\u0027s result is better than another\u0027s. I\u0027ve considered/tried:\n\n1. Updating the sample input - but this would potentially result in the same thing when running in yet another environment.\n2. Comparing with a tolerace - but again, the tolerance might need to increase again and again in different environments.\n3. This change which explicitly builds for a specific machine which makes the test deterministic.\n\nFeel free to suggest an alternate approach, but I think that this approach is the most forward compatible.",
      "parentUuid": "55756553_941d2d01",
      "range": {
        "startLine": 20,
        "startChar": 39,
        "endLine": 20,
        "endChar": 69
      },
      "revId": "be3836a30aa2813c88e726a682ad73d6ebbf07da",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {

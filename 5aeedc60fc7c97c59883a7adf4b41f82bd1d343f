    {
      "key": {
        "uuid": "5c56da5d_20bd4177",
        "filename": "driver/mag_lis2mdl.c",
        "patchSetId": 8
      },
      "lineNbr": 31,
      "author": {
        "id": 1104704
      },
      "writtenOn": "2019-02-02T01:47:52Z",
      "side": 1,
      "message": "Behind BMI160, LIS2MDL is in forced mode (it collect data on BMI160 request).\nBehind LMS6DSM, it is in continuous mode: it collect data on its own. In that mode, it average 2 readings for compensating for the measurement bias (see magnetometer offset cancellation in AN5069 - https://www.st.com/content/ccc/resource/technical/document/application_note/group0/a3/5d/fa/98/34/34/4f/2f/DM00427201/files/DM00427201.pdf/jcr:content/translations/en.DM00427201.pdf) \nIt can not do it in forced mode [https://buganizer.corp.google.com/issues/110363137#comment7]",
      "parentUuid": "e45bef95_75668020",
      "range": {
        "startLine": 31,
        "startChar": 0,
        "endLine": 31,
        "endChar": 32
      },
      "revId": "5aeedc60fc7c97c59883a7adf4b41f82bd1d343f",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

      "writtenOn": "2019-02-01T18:13:57Z",
      "side": 1,
      "message": "Why is this section necessary for one pass-thru sensor but not the other?",
      "range": {
        "startLine": 31,
        "startChar": 0,
        "endLine": 31,
        "endChar": 32
      },
      "revId": "5aeedc60fc7c97c59883a7adf4b41f82bd1d343f",

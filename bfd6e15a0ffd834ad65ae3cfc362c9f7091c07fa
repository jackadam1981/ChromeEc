      "writtenOn": "2020-04-23T17:53:27Z",
      "side": 1,
      "message": "ok we can keep the support. We just need to make sure the ranges aren\u0027t ever hardcoded in factory scripts.",
      "parentUuid": "95d38aab_5a18d233",
      "range": {
        "startLine": 13,
        "startChar": 0,
        "endLine": 14,
        "endChar": 7
      },

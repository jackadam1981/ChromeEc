    },
    {
      "key": {
        "uuid": "fe2d7851_c011155b",
        "filename": "/COMMIT_MSG",
        "patchSetId": 5
      },
      "lineNbr": 13,
      "author": {
        "id": 1314845
      },
      "writtenOn": "2019-06-14T01:40:19Z",
      "side": 1,
      "message": "The touchpad team has expressed interest in using clang as well. It\u0027s a little easier for them (or others) to help out when they have time if this lands rather than carrying around a series of patches. (They may be able to look at the flash size reporting)\n\nIt\u0027s also a little easier for me to make sure the clang version still builds and runs without having to rebase my changes all the time. So far there haven\u0027t been conflicts, but the longer we wait the more likely it will.",
      "parentUuid": "a7b6663e_e7498e34",
      "revId": "7246553ca669d8a753b536b2b0c118c9691bc996",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

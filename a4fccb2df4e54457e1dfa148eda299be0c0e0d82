        "id": 1259838
      },
      "writtenOn": "2019-05-22T17:03:39Z",
      "side": 1,
      "message": "Does the \u0027A\u0027 constraint mean the address of the memory location is held in a register? Why do we need to deference the address then?\n\n(not saying this is wrong, just trying to understand better)",
      "range": {
        "startLine": 25,
        "startChar": 17,
        "endLine": 25,
        "endChar": 28
      },
      "revId": "a4fccb2df4e54457e1dfa148eda299be0c0e0d82",

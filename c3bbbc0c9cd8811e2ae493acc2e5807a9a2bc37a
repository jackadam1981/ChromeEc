      "writtenOn": "2022-09-26T18:40:59Z",
      "side": 1,
      "message": "Ah, calling `memcpy` will still push to the stack. Out of curiosity, if you use a `for` loop for the copy, are you able to remove it completely?",
      "parentUuid": "bb83c51f_23a6a457",
      "range": {
        "startLine": 68,
        "startChar": 1,
        "endLine": 68,
        "endChar": 47
      },
      "revId": "c3bbbc0c9cd8811e2ae493acc2e5807a9a2bc37a",

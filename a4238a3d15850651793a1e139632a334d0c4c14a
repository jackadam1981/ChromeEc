      "writtenOn": "2016-08-18T20:12:19Z",
      "side": 1,
      "message": "why are two timers needed - can we not get by with just one?",
      "range": {
        "startLine": 9,
        "startChar": 0,
        "endLine": 12,
        "endChar": 24
      },
      "revId": "a4238a3d15850651793a1e139632a334d0c4c14a",

      },
      "writtenOn": "2022-02-08T17:09:38Z",
      "side": 1,
      "message": "this should turn into self.configureall(..., build\u003dTrue, test\u003dTrue), right?",
      "range": {
        "startLine": 681,
        "startChar": 0,
        "endLine": 701,
        "endChar": 35
      },
      "revId": "f2b6b61d24741e674146a0bd91eeadc4e3c0d163",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "39c4b935_28c73697",

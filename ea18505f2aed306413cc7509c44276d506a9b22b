      "writtenOn": "2021-10-07T22:49:53Z",
      "side": 1,
      "message": "Here and elsewhere, I would distinguish between \"TCPC\" and \"TCPCI.\" IIUC, this emulator specifically covers TCPCI-conforming TCPCs. To handle other TCPCs, we\u0027ll eventually need other emulators.",
      "range": {
        "startLine": 7,
        "startChar": 11,
        "endLine": 7,
        "endChar": 20
      },
      "revId": "ea18505f2aed306413cc7509c44276d506a9b22b",

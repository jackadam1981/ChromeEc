      "writtenOn": "2025-04-08T22:53:49Z",
      "side": 1,
      "message": "Should this skip the FW update if the current version matches the passed in firmware binary?",
      "range": {
        "startLine": 307,
        "startChar": 0,
        "endLine": 307,
        "endChar": 78
      },
      "revId": "769c96c0207653e7c1c246e74f3463201bf9f2c2",

      "key": {
        "uuid": "b2ca3243_28e1931a",
        "filename": "extra/pdc/pdc_fwup.py",
        "patchSetId": 2
      },
      "lineNbr": 307,
      "author": {
        "id": 1523797
      },
      "writtenOn": "2025-04-09T17:14:49Z",
      "side": 1,
      "message": "I think that makes sense for Depthcharge so updates don\u0027t happen unnecessarily, but for a developer-oriented flashing tool I\u0027d rather just do whatever is requested, limited only by the PDC\u0027s internal validation step. We do also sometimes get re-releases of the same version or need to make config tweaks that might not result in a version or proj_name change.",
      "parentUuid": "61a8d3a9_cfb26126",
      "range": {
        "startLine": 307,
        "startChar": 0,
        "endLine": 307,

      "writtenOn": "2023-11-02T23:15:25Z",
      "side": 1,
      "message": "Instead of using a completion it may make more sense to use the `wait_event()` API (see include/linux/wait.h). That way you can have the condition argument check `pdata-\u003exfer_state`, and then wake up the task after changing the state. It may also help avoid holding the mutex over such a wide area.",
      "range": {
        "startLine": 495,
        "startChar": 8,
        "endLine": 495,
        "endChar": 36
      },
      "revId": "9f048f73cec77196fab2c1c72318c072ed972a29",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

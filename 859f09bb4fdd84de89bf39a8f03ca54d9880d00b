    {
      "key": {
        "uuid": "601b4375_2acd9332",
        "filename": "driver/tcpm/anx74xx.c",
        "patchSetId": 1
      },
      "lineNbr": 158,
      "author": {
        "id": 1002124
      },
      "writtenOn": "2018-07-03T21:54:35Z",
      "side": 1,
      "message": "Only if board_set_tcpc_power_mode() is implemented to use that, right? What ensures such a thing? If that\u0027s the expectation note that it\u0027s a requirement.",
      "revId": "859f09bb4fdd84de89bf39a8f03ca54d9880d00b",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

    {
      "key": {
        "uuid": "05575fb0_e2e285a5",
        "filename": "common/usb_pd_protocol.c",
        "patchSetId": 1
      },
      "lineNbr": 415,
      "author": {
        "id": 1002124
      },
      "writtenOn": "2018-07-11T23:10:36Z",
      "side": 1,
      "message": "I think the ANX NACKs the first transaction that matches its i2c address when it is in low power mode. This is another reason for sequencing state through a single task.",
      "parentUuid": "c8c0e8ec_3ce3d96a",
      "range": {
        "startLine": 415,
        "startChar": 2,
        "endLine": 415,
        "endChar": 14
      },
      "revId": "859f09bb4fdd84de89bf39a8f03ca54d9880d00b",

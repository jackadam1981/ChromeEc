      },
      "lineNbr": 415,
      "author": {
        "id": 1259838
      },
      "writtenOn": "2018-07-11T22:24:51Z",
      "side": 1,
      "message": "I am not familiar with the throwaway transaction requirement/suggestion. Are there some TCPCs that come out of LPM slowly?\n\nIf we do want to do that, we can add a call to the low_power_mode_checker method.",
      "parentUuid": "02baedc1_44bc2d11",
      "range": {
        "startLine": 415,
        "startChar": 2,
        "endLine": 415,
        "endChar": 14
      },
      "revId": "859f09bb4fdd84de89bf39a8f03ca54d9880d00b",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

     dd if=/dev/zero of=ec.bin.blank bs=1024 seek=1024 count=1024 conv=notrunc
     flashrom -V -p ec:type=fp -i EC_RW -w ec.bin.blank
     flashrom -V -p ec:type=fp -i EC_RW -w ec.bin
    TEST=flashread returns correct data after an erase
    EC> flashwrite 0x180000 1024 => Initialize flash
    EC> flashread 0x180000 1024 => Loads data in cache
    EC> flasherase 0x180000 131072
    EC> flashread 0x180000 1024 => Make sure cache was invalidated
    

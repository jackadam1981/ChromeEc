            ccd -> AP RX+TX, EC RX+TX
    
            ccdset uartecrx unlesslocked
            ccdset uartectx ifopened
            ccdset uartaprx always
            ccdset uartaptx unlesslocked
    
            ccdunlock
            ccd -> AP RX+TX, EC RX
            ccdlock
            ccd -> AP RX, EC disabled
    
            ccdoops

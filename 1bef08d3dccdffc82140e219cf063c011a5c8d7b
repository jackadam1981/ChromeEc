      "lineNbr": 334,
      "author": {
        "id": 1259838
      },
      "writtenOn": "2023-09-21T19:30:13Z",
      "side": 1,
      "message": "can the protocol really handle a blocking call for 100ms? This seems like we want a callback or something to let the hyperdebug keep running and processing other things in the mean time (like console output)",
      "range": {
        "startLine": 334,
        "startChar": 2,
        "endLine": 334,
        "endChar": 17
      },
      "revId": "1bef08d3dccdffc82140e219cf063c011a5c8d7b",

        "id": 1330845
      },
      "writtenOn": "2023-07-24T19:17:36Z",
      "side": 1,
      "message": "Adding cmake definitons in the command line is for developer quick-hacks only, and shouldn\u0027t be suggested as the interface to do this.  You might consider adding an appropriate flag to zmake to do what you\u0027re looking for.",
      "range": {
        "startLine": 12,
        "startChar": 42,
        "endLine": 12,
        "endChar": 67
      },
      "revId": "90cd159a3da3bb5b0bd937c3af91e4c4207f5f35",

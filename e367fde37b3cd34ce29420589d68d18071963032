    {
      "key": {
        "uuid": "ca1e83b1_84b605f3",
        "filename": "include/charge_ramp.h",
        "patchSetId": 4
      },
      "lineNbr": 32,
      "author": {
        "id": 1141739
      },
      "writtenOn": "2020-05-13T08:37:04Z",
      "side": 1,
      "message": "This match up with PD port plus dedicated port, assumes PD port starts from 0, same as charge_manager.\n\nThis is for the multi driver use case. Since different drivers has different implementation of ramp_allowed/ramp_max, I must pick one driver to dispatch the function call.\n(I think this is weird, but I don\u0027t have a better idea)",
      "parentUuid": "c597d3f2_d23d3111",
      "revId": "e367fde37b3cd34ce29420589d68d18071963032",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {

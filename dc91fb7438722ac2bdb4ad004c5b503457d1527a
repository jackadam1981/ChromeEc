      "side": 1,
      "message": "I don\u0027t see any eSPI drivers that set `event.evt_data` with ESPI_BUS_RESET.  Is there a chance that eSPI drivers might do this in the future?",
      "range": {
        "startLine": 114,
        "startChar": 0,

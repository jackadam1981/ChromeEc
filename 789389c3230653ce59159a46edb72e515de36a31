      "writtenOn": "2021-04-26T22:59:50Z",
      "side": 1,
      "message": "This I2C write may be interrupted and get delayed. A better way is to do the time check after the second I2C write and have a way to revert it back if timeout.",
      "range": {
        "startLine": 431,
        "startChar": 0,
        "endLine": 433,
        "endChar": 7
      },
      "revId": "789389c3230653ce59159a46edb72e515de36a31",

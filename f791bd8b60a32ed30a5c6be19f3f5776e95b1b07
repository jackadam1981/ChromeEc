      "writtenOn": "2019-04-17T21:11:24Z",
      "side": 1,
      "message": "That\u0027ll create an order dependency on cbi_get_board_version and cbi_get_sku_id because we want to check board_version \u003e\u003d 3 before calling board_get_panel_id.",
      "parentUuid": "b839b58e_906e4bb1",
      "range": {
        "startLine": 136,
        "startChar": 4,

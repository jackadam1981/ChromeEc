    {
      "key": {
        "uuid": "21fb6499_2e6421c2",
        "filename": "include/config.h",
        "patchSetId": 3
      },
      "lineNbr": 3985,
      "author": {
        "id": 1149894
      },
      "writtenOn": "2020-08-04T00:23:00Z",
      "side": 1,
      "message": "We will define these macros when a board is submitted for compliance testing. After the board passes, that board is added to the USB-IF Integrator\u0027s list. So if someone wanted to verify that a board with a given MODEL_PART_NUMBER and PRODUCT_REVISION is compliance tested, it can be found on the USB-IF integrator\u0027s list.\n\nCurrently, no board will have these defined.\n\ngenvif extracts PD information from board.h and usb_pd_policy.c files in the board directories.",
      "parentUuid": "226123ba_78c87091",
      "range": {
        "startLine": 3985,
        "startChar": 7,
        "endLine": 3985,
        "endChar": 38
      },

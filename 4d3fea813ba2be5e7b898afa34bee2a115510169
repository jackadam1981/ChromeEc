    },
    {
      "key": {
        "uuid": "6e7d126d_75b221d7",
        "filename": "Makefile",
        "patchSetId": 1
      },
      "lineNbr": 21,
      "author": {
        "id": 1308749
      },
      "writtenOn": "2020-07-13T16:56:20Z",
      "side": 1,
      "message": "With this change, the baseboard and board relationship is still only determined by the make variable \"baseboard:\u003d\u003cBASEBOARD\u003e\" in build.mk.\n\nThis was intentional, so that board/\u003cBOARD\u003e files can be moved to the nested \u003cBASEBOARD\u003e directory unmodified.  In theory you could nest a \u003cBOARD\u003e under the wrong \u003cBASEBOARD\u003e directory and it will still compile.\n\nI\u0027ll explore follow on changes that enforce the \u003cBOARD\u003e and \u003cBASEBOARD\u003e relationship explicitly based on the directory nesting.",
      "parentUuid": "c44c4d82_bf639e88",

      "writtenOn": "2020-03-25T22:12:17Z",
      "side": 1,
      "message": "This is intentionally expanded.\n\nWhite-space separated boards is at the core of this implementation, since you specify boards in one argument (-b \"nocturne hatch\") with space separation. Thus, boards shall not have whitespace.\n\nPositionalizing the boards here simplifies this implementation.",
      "parentUuid": "367afbe6_69307e9f",
      "range": {
        "startLine": 141,
        "startChar": 55,
        "endLine": 141,
        "endChar": 77
      },

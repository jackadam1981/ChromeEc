        "id": 1259838
      },
      "writtenOn": "2018-03-19T16:03:08Z",
      "side": 1,
      "message": "I hope we don\u0027t ever mix and match different PPC on the same board. If so we will need to rethink some of these config options. As of now everything looks good though.",
      "range": {
        "startLine": 3341,
        "startChar": 0,
        "endLine": 3342,
        "endChar": 29
      },
      "revId": "aaac1aa7da7cb1ccceee749ede018551a61165a0",

              "replacement": "\t\t\toffset \u003d \u003c(0x40000 - 0x1000)\u003e;\n"
            }
          ]
        }
      ],
      "revId": "0be955d5956e7184cbdab60acc9a47653d0c0a92",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {

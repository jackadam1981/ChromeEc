      },
      "writtenOn": "2025-06-06T21:34:19Z",
      "side": 1,
      "message": "If you want the RO image to be limited to 0x40000 bytes, this offset should be `(0x40000 - 0x1000)`.",
      "range": {
        "startLine": 37,
        "startChar": 13,
        "endLine": 37,
        "endChar": 20
      },

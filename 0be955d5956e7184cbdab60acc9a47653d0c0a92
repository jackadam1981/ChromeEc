      "side": 1,
      "message": "This should be `0x40000 - 0x1000 - 0x400`\nOtherwise, the sysjump code won\u0027t copy the fmap and CBI data.",
      "range": {
        "startLine": 29,
        "startChar": 15,
        "endLine": 29,
        "endChar": 22

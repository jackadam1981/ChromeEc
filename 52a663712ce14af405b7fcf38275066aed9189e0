    {
      "key": {
        "uuid": "f19a05fb_7caca248",
        "filename": "common/spi_nor.c",
        "patchSetId": 1
      },
      "lineNbr": 697,
      "author": {
        "id": 1315467
      },
      "writtenOn": "2019-11-26T21:43:05Z",
      "side": 1,
      "message": "As usual, I\u0027m trying not to change the previous underlying logic. You could (probably) get away with just the wait after the erase, but then you\u0027re relying on the previous code to have done the right thing. The pre-existing code was using the extra paranoia of waiting first, and it makes me more comfortable to leave it as it was.\n\nThe wait is very quick compared to an erase, so you buy practically nothing by messing with the code, but lose a safety check.",
      "parentUuid": "655c0f5d_083c4946",
      "range": {
        "startLine": 694,
        "startChar": 4,
        "endLine": 697,
        "endChar": 20
      },
      "revId": "52a663712ce14af405b7fcf38275066aed9189e0",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },
    {
      "key": {

    {
      "key": {
        "uuid": "655c0f5d_083c4946",
        "filename": "common/spi_nor.c",
        "patchSetId": 1
      },
      "lineNbr": 697,
      "author": {
        "id": 1000039
      },
      "writtenOn": "2019-11-26T15:38:54Z",
      "side": 1,
      "message": "Also, is it possible that there was no erase for the previous block, so there is no operation in progress during this check - will this work?\n\nI agree that the wait should be immediately after the erase operation.",
      "parentUuid": "d40db8a8_255877d7",
      "range": {
        "startLine": 694,
        "startChar": 4,
        "endLine": 697,
        "endChar": 20
      },
      "revId": "52a663712ce14af405b7fcf38275066aed9189e0",

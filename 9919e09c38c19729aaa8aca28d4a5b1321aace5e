    {
      "key": {
        "uuid": "25c1bb68_a6c6284b",
        "filename": "common/usbc/usb_pe_drp_sm.c",
        "patchSetId": 4
      },
      "lineNbr": 148,
      "author": {
        "id": 1305927
      },
      "writtenOn": "2020-05-27T02:22:08Z",
      "side": 1,
      "message": "I don\u0027t think a flag is currently sufficient to synchronize access to a large object across multiple state transitions. I think that it probably would be if we had atomic check and set for flags. That seems practical but well out of scope. In the meantime, this seemed like one of the less weird synchronization schemes. But if anyone has any better ideas, I\u0027m open.",
      "range": {
        "startLine": 144,
        "startChar": 0,
        "endLine": 148,
        "endChar": 52
      },
      "revId": "9919e09c38c19729aaa8aca28d4a5b1321aace5e",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

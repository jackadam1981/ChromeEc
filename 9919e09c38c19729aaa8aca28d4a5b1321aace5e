        "id": 1305927
      },
      "writtenOn": "2020-05-28T21:13:27Z",
      "side": 1,
      "message": "This confused me briefly, and I made a note for myself to fix it, but it\u0027s out of scope for now.",
      "parentUuid": "d1166270_3b92763c",
      "range": {
        "startLine": 483,
        "startChar": 4,

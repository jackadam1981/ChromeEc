      "writtenOn": "2018-09-26T21:52:23Z",
      "side": 1,
      "message": "Okay, found it in section 6.9: Note: A Sink can still send Hard Reset signaling at any time.\n\nFrom the source point of view, I believe we\u0027ll still want to set NG since it\u0027s listed as an AMS",
      "parentUuid": "c09a03f9_68ff2493",
      "range": {
        "startLine": 3738,
        "startChar": 15,
        "endLine": 3738,
        "endChar": 24
      },
      "revId": "d9b7865f2d5ca2cd1ec6a4f0f9a0211264b8a223",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

      "writtenOn": "2015-11-03T18:01:21Z",
      "side": 1,
      "message": "#define I2C_PORT_IS_SLAVE(port) \\\n((port)-\u003e... \u0026 I2C_CONFIG_SLAVE)\n\n#define I2C_PORT_IS_MASTER(port) (!I2C_PORT_IS_SLAVE(port))",
      "parentUuid": "f6195673_6bbafc30",
      "revId": "ae98412d19524639dac96243d4f26f8175c95f66",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

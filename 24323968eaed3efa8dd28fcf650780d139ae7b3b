      "writtenOn": "2019-07-12T08:52:40Z",
      "side": 1,
      "message": "Nobody uses bool in EC code, maybe let\u0027s not start now? Returning an int is perfectly fine.",
      "revId": "24323968eaed3efa8dd28fcf650780d139ae7b3b",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

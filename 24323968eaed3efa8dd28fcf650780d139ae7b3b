      "writtenOn": "2019-07-17T16:49:46Z",
      "side": 1,
      "message": "It seems that the consensus on chatty-firmware is that we should be using stdbool: https://groups.google.com/a/google.com/d/msg/chromeos-chatty-firmware/ESHmZYBRays/hm0TqBVbDAAJ",
      "parentUuid": "2a493632_c6bc5661",
      "revId": "24323968eaed3efa8dd28fcf650780d139ae7b3b",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

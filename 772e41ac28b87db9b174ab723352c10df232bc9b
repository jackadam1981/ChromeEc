      "writtenOn": "2022-06-14T16:10:08Z",
      "side": 1,
      "message": "Is there a plan to use `EC_HOST_CMD_HANDLER` when appropriate?",
      "range": {
        "startLine": 34,
        "startChar": 1,
        "endLine": 34,
        "endChar": 28
      },
      "revId": "772e41ac28b87db9b174ab723352c10df232bc9b",

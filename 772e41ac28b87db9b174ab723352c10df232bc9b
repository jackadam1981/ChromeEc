        "id": 1477788
      },
      "writtenOn": "2022-06-15T12:20:35Z",
      "side": 1,
      "message": "It would require to either remove the legacy EC declarations or duplicate the code by leaving the legacy and on zephyr, declare using newer API. Of course, it may be used for new host commands that would be implemented only on zephyr.",
      "parentUuid": "51a9d59f_696498e4",
      "range": {
        "startLine": 34,
        "startChar": 1,
        "endLine": 34,
        "endChar": 28

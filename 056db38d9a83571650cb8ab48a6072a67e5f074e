      "writtenOn": "2023-02-15T21:56:15Z",
      "side": 1,
      "message": "Doesn\u0027t splitting an atomic operation into two defeat the purpose of an atomic operation?",
      "range": {
        "startLine": 267,
        "startChar": 1,
        "endLine": 267,
        "endChar": 41
      },
      "revId": "056db38d9a83571650cb8ab48a6072a67e5f074e",

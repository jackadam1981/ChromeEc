    {
      "key": {
        "uuid": "5ab18456_b3703bc3",
        "filename": "driver/temp_sensor/thermistor_ncp15wb.c",
        "patchSetId": 5
      },
      "lineNbr": 126,
      "author": {
        "id": 1000253
      },
      "writtenOn": "2016-07-15T20:08:29Z",
      "side": 1,
      "message": "Not quite - All we care about is finding if mv is between two data points (inclusive). From there we figure out many degrees are in between the two points and approximately how many millivolts represent each degree in that range, and add that to the lower data point\u0027s voltage until we reach the input voltage and thus determine the number of degrees to add to the lower point\u0027s temperature to reach the actual temperature.\n\nLine 118 handles the case where mv is more than any of the entries - If we\u0027re out of bounds, we just return the lowest/highest entry. That\u0027s convention used for generating the table - Anything below the lowest data point doesn\u0027t matter and the highest point and anything higher is critical.",
      "parentUuid": "5ab18456_f05f59c9",
      "revId": "2f1f7717f4811b7dda56c166360d3604f38e2ed2",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },
    {

      "writtenOn": "2022-08-25T04:05:48Z",
      "side": 1,
      "message": "When current_level become to -1, it will set current_level to 0.\nRefer to line 85.",
      "parentUuid": "a761c59a_48d360d8",
      "range": {
        "startLine": 78,
        "startChar": 0,
        "endLine": 78,
        "endChar": 19
      },
      "revId": "dc26be655d381406979d5ea25fbb85b1374f242e",

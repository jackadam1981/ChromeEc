      "side": 1,
      "message": "What\u0027s the motivation? Is it required or just a simplification?",
      "range": {
        "startLine": 14,
        "startChar": 0,
        "endLine": 15,
        "endChar": 35
      },
      "revId": "960406d6a94a58e5619804ee212840691b3131f0",

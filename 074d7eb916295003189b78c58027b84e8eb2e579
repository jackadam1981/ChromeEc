      "writtenOn": "2018-11-08T23:19:11Z",
      "side": 1,
      "message": "This seems backwards to me. I would expect this to be logical_present, and the raw gpio value to be physical presence.",
      "range": {
        "startLine": 224,
        "startChar": 5,
        "endLine": 224,
        "endChar": 22
      },
      "revId": "074d7eb916295003189b78c58027b84e8eb2e579",

    {
      "key": {
        "uuid": "3ee28b21_6a8c7b10",
        "filename": "board/cr50/wp.c",
        "patchSetId": 1
      },
      "lineNbr": 224,
      "author": {
        "id": 1308749
      },
      "writtenOn": "2018-11-09T18:51:03Z",
      "side": 1,
      "message": "\"physical_presence\" in this context means \"user presence\" and I agree the names are confusing.  There is a need for two routines: one indicates the state of the actual state of battery present GPIO (GPIO_BATT_PRES_L), and the new routine indicates whether the user has passed the physical presence criteria (battery removal plus button press).\n\nMaybe it makes sense to go with board_battery_is_present() for the GPIO state, and board_user_is_present() for the more complicated checks that battery has been removed and the power button pressed.\n\nThe fact that battery removal is part of the user presence check is irrelevant to most of the callers.",
      "parentUuid": "508bbc38_b2d065b6",
      "range": {
        "startLine": 224,
        "startChar": 5,
        "endLine": 224,
        "endChar": 22
      },
      "revId": "074d7eb916295003189b78c58027b84e8eb2e579",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {
      "key": {

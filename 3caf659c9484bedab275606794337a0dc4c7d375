      "unresolved": false
    },
    {
      "key": {
        "uuid": "31c77f33_3b9f8fb3",
        "filename": "include/ec_commands.h",
        "patchSetId": 4
      },
      "lineNbr": 4832,
      "author": {
        "id": 1165921
      },
      "writtenOn": "2018-07-24T15:43:52Z",
      "side": 1,
      "message": "See for example struct ec_flash_bank, which adds two reserved bytes to bring it up to a multiple of 4 bytes. That seems to be the convention in this file.\n\nThis code is compiled by Linux, various firmware builders and user-space tools.",
      "parentUuid": "92a4cbd7_9ca4269a",
      "range": {
        "startLine": 4832,
        "startChar": 3,
        "endLine": 4832,
        "endChar": 18
      },
      "revId": "3caf659c9484bedab275606794337a0dc4c7d375",

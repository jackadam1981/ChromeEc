      "writtenOn": "2018-09-19T16:43:49Z",
      "side": 1,
      "message": "Instead of passing protocol_version through it makes sense to update\nrequest-\u003eheader.data_length\nin make_compatible().",
      "range": {
        "startLine": 936,
        "startChar": 6,
        "endLine": 938,
        "endChar": 27
      },
      "revId": "4937b9d9fd43371f207ba20cb7aad1dbba5d7c36",

    {
      "key": {
        "uuid": "52e7b611_493ab7f6",
        "filename": "include/ec_commands.h",
        "patchSetId": 2
      },
      "lineNbr": 4236,
      "author": {
        "id": 1003000
      },
      "writtenOn": "2019-03-09T02:35:39Z",
      "side": 1,
      "message": "When a timeout occurs, host event is already set to indicate the failure. Is it really necessary/useful to set this as well?",
      "range": {
        "startLine": 4236,
        "startChar": 8,
        "endLine": 4236,
        "endChar": 36
      },
      "revId": "253c752214d1b9c2b8878431940b26a6acc178da",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "b48a21c9_b3a3e594",
        "filename": "include/ec_commands.h",
        "patchSetId": 2
      },
      "lineNbr": 4236,
      "author": {
        "id": 1260470
      },
      "writtenOn": "2019-03-11T16:30:00Z",
      "side": 1,
      "message": "Yes, I think it is. The host events get processed elsewhere, and is overloaded with other functionality. Reporting the suspend failure directly in the resume message makes sense to me. If you\u0027re worried about stealing a bit, I could expand the transition count out to 32-bits.",
      "parentUuid": "52e7b611_493ab7f6",
      "range": {
        "startLine": 4236,
        "startChar": 8,
        "endLine": 4236,
        "endChar": 36
      },
      "revId": "253c752214d1b9c2b8878431940b26a6acc178da",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "7848c8b4_e40bb378",
        "filename": "include/ec_commands.h",
        "patchSetId": 2
      },
      "lineNbr": 4236,
      "author": {
        "id": 1003000
      },
      "writtenOn": "2019-03-11T17:47:16Z",
      "side": 1,
      "message": "\u003e Reporting the suspend failure directly in the resume message makes sense to me.\n\nSG",
      "parentUuid": "b48a21c9_b3a3e594",
      "range": {
        "startLine": 4236,
        "startChar": 8,
        "endLine": 4236,
        "endChar": 36
      },
      "revId": "253c752214d1b9c2b8878431940b26a6acc178da",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {
      "key": {

      "message": "Ack",
      "parentUuid": "2de4e52d_d8c13f52",
      "range": {
        "startLine": 884,
        "startChar": 16,
        "endLine": 884,
        "endChar": 17
      },
      "revId": "253c752214d1b9c2b8878431940b26a6acc178da",

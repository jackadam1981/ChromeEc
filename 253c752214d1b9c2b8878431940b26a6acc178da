        "filename": "include/ec_commands.h",
        "patchSetId": 2
      },
      "lineNbr": 4249,
      "author": {
        "id": 1003000
      },
      "writtenOn": "2019-03-09T02:35:39Z",
      "side": 1,
      "message": "It would be good to indicate that this is valid only when the host sleep event is set to HOST_SLEEP_EVENT_S0IX_RESUME.",
      "revId": "253c752214d1b9c2b8878431940b26a6acc178da",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {

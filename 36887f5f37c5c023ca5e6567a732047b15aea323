        "id": 1129199
      },
      "writtenOn": "2018-09-30T23:20:46Z",
      "side": 1,
      "message": "Right. I wonder if HMAC(prk, user_id || 0x01) is really stronger/different than just doing HMAC(prk, user_id) .",
      "parentUuid": "417da39f_05684e34",
      "revId": "36887f5f37c5c023ca5e6567a732047b15aea323",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

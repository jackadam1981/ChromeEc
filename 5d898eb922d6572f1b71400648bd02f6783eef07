      "writtenOn": "2023-11-10T00:15:46Z",
      "side": 1,
      "message": "you shouldn\u0027t use porcelain commands in a script.  consider using `ls-files` instead.",
      "range": {
        "startLine": 80,
        "startChar": 17,
        "endLine": 80,
        "endChar": 23
      },
      "revId": "5d898eb922d6572f1b71400648bd02f6783eef07",

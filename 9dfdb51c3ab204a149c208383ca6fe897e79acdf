      "side": 1,
      "message": "This seems common to all ADL implementations.  Why is this in the APP state machine instead of the chipset state machine.",
      "range": {
        "startLine": 231,
        "startChar": 0,
        "endLine": 265,
        "endChar": 0
      },
      "revId": "9dfdb51c3ab204a149c208383ca6fe897e79acdf",

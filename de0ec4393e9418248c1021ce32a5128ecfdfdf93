      "writtenOn": "2024-06-12T15:28:08Z",
      "side": 1,
      "message": "Shouldn\u0027t we also need to use this inside the command, since it\u0027s writing to `data-\u003einfo`?",
      "revId": "de0ec4393e9418248c1021ce32a5128ecfdfdf93",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

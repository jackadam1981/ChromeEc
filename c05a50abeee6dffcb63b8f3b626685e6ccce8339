      "writtenOn": "2024-08-02T19:00:32Z",
      "side": 1,
      "message": "Where are you suggesting pdc_power_mgmt_set_active_charge_port() to be called from?\n\nThis function should only be called from the charge_manager.",
      "parentUuid": "5ac708fc_31a98ff1",
      "revId": "c05a50abeee6dffcb63b8f3b626685e6ccce8339",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

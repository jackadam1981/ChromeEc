      "writtenOn": "2022-10-25T02:08:42Z",
      "side": 1,
      "message": "Hi all,\n\nAfter check, coreboot didn\u0027t define EC_ENABLE_TBMC_DEVICE in \nsrc/mainboard/google/skyrim/variants/baseboard/include/baseboard/ec.h and\nsrc/mainboard/google/skyrim/variants/winterhold/include/variant/ec.h.\n\nBR,\nEric KY Cheng",
      "parentUuid": "f6698518_1dbef2f1",
      "range": {
        "startLine": 116,
        "startChar": 0,
        "endLine": 119,
        "endChar": 6
      },

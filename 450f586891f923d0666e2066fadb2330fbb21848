      "writtenOn": "2020-01-17T19:33:47Z",
      "side": 1,
      "message": "How does this flush the usb console data?",
      "revId": "450f586891f923d0666e2066fadb2330fbb21848",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

config CHIP
	string
	default "g"		if CHIP_G__yn
	default "host"		if CHIP_HOST__yn
	default "ish"		if CHIP_ISH__yn
	default "it83xx"	if CHIP_IT83XX__yn
	default "lm4"		if CHIP_LM4__yn
	default "max32660"	if CHIP_MAX32660__yn
	default "mchp"		if CHIP_MCHP__yn
	default "mec1322"	if CHIP_MEC1322__yn
	default "mt_scp"	if CHIP_MT_SCP__yn
	default "npcx"		if CHIP_NPCX__yn
	default "nrf51"		if CHIP_NRF51__yn
	default "stm32"		if CHIP_STM32__yn

config UART_TX_BUF_SIZE
	int "UART transmit buffer size in bytes"
	default 2048	if CHIP_ISH__yn
	default 8192	if CHIP_LM4__yn
	default 8192	if CHIP_MAX32660__yn
	default 1024	if CHIP_MCHP__yn
	default 2048	if CHIP_MEC1322__yn
	default 1024	if CHIP_NPCX__yn
	default 1024	if CHIP_NRF51__yn
	default 2048	if CHIP_STM32__yn
	default 512
	help
	  UART transmit buffer size in bytes.  Must be a power of 2 for macros in
	  common/uart_buffering.c to work properly.


config CHIP_PANIC_BACKUP
	bool "Panic backup"
	default n
	help
	  Certain platforms(e.g. eve, poppy) cannot retain panic info in data ram since
	  VCC is powered down on EC reset. On such platforms, panic data needs to be
	  saved/restored to persistent storage by using chip specific
	  implementations. This option can be enabled by those platforms that have and
	  wish to use chip-implemented panic backup/restore functions.

config STACK_SIZE__yn
	bool "Select STACK_SIZE"

if STACK_SIZE__yn

config STACK_SIZE
	int "Default stack size to use for tasks, in bytes"
	default 1024 if (CHIP = "g")
	default 1024 if (CHIP = "ish")
	default 1024 if (CHIP = "it83xx")
	default 1024 if (CHIP = "mec1322")
	default 1024 if (CHIP = "mt_scp")
	default 1024 if (CHIP = "npcx")
	default 1024 if (CHIP = "nrf51")
	default 1024 if (CHIP = "stm32")

endif # STACK_SIZE__yn

config CHIP_MEMORY_REGIONS
	bool "The chip needs to define special SRAM memory regions as linker sections"
	help
	  The chip needs to define special SRAM memory regions as linker sections.
	  Those regions are defined in the special-purpose preprocessed file in
	  chip/<chip_name>/memory_regions.inc using the following macro:
	  REGION(name, attributes, start_address, size)

	  Note: these 'special' regions are NOT cleared at startup contrary to .bss.

config CHIP_PRE_INIT
	bool "Chip needs to do pre-init"
	help
	  Chip needs to do pre-init very early in main(), and provides chip_pre_init()
	  to do so.

config RTC
	bool "Support Real-Time Clock (RTC)"

menu "Low Power Idle"

config LOW_POWER_IDLE
	bool "low power idle"
	help
	  Low power idle options. These are disabled by default and all boards that
	  want to use low power idle must define it. When using the LFIOSC, the low
	  frequency clock will be used to conserve even more power when possible.

	  GPIOs which need to trigger interrupts in low power idle must specify the
	  GPIO_INT_DSLEEP flag in gpio_list[].

	  Note that for some processors (e.g. LM4), an active JTAG connection will
	  prevent the EC from using low-power idle.

config LOW_POWER_USE_LFIOSC
	bool "Use LFIOSC"

config LOW_POWER_IDLE_LIMITED
	bool "Allows us to enable/disable low power idle mode in runtime"

endmenu # LPI


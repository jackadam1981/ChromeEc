menu "ADC config"

config ADC
	bool "Compile chip support for analog-to-digital convertor"

# TODO: this should be "if ADC", but enabled by default in config.h

config ADC_WATCHDOG
	bool
	prompt "Include the ADC analog watchdog feature in the ADC code"
	default y

if ADC

choice
	prompt "Chip-dependent ADC configuration"

config ADC_PROFILE_SINGLE
	bool "Sample all inputs once when requested"
config ADC_PROFILE_FAST_CONTINUOUS
	bool "Sample all inputs continuously using DMA, with minimal sample time."

endchoice

endif # ADC

endmenu # "ADC config"

config WATCHDOG
	bool "Compile watchdog timer support"
	default y
	help
	  Compile watchdog timer support.  The watchdog timer will reboot the system
	  if the hook task (which is the lowest-priority task on the system) gets
	  starved for CPU time and isn't able to fire its HOOK_TICK event.

if WATCHDOG

config WATCHDOG_HELP
	bool "Try to detect a watchdog that is about to fire"
	help
	  Try to detect a watchdog that is about to fire, and print a trace.  This is
	  required on chips such as STM32 where the watchdog timer simply reboots the
	  system without any early warning.

endif # WATCHDOG

config WATCHDOG_MAX_RETRIES
	int "The maximum number of times that the watchdog timer may reset"
	default 4
	help
	  The maximum number of times that the watchdog timer may reset
	  before halting the system (or taking some sort of other
	  chip-dependent corrective action).

config WATCHDOG_PERIOD_MS
	int "Watchdog period in ms; see also AUX_TIMER_PERIOD_MS"
	default 1600

config FPU
	bool "Enable support for floating point unit"

config HIBERNATE
	bool "Enable system hibernate"
	default y

config MPU
	bool "Support memory protection unit (MPU)"


config DMA
	bool "Support DMA transfers inside the EC"

config DMA_DEFAULT_HANDLERS
	bool "Use the common interrupt handlers for DMA IRQs"
	default y

config DMA_HELP
	bool "Compile extra debugging and tests for the DMA module"

config FW_INCLUDE_RO
	bool "FW_INCLUDE_RO"
	default y
	help
	  Board Image ec.bin contains a RO firmware.  If not defined, the image will
	  only contain the RW firmware.

config FW_LIMITED_IMAGE
	bool "If defined, another image (RW) exists with more features"

config MAPPED_STORAGE
	bool "Flash is directly mapped into the EC's address space"
	default y
	help
	  Flash is directly mapped into the EC's address space.  If this is not
	  defined, the flash driver must implement flash_physical_read().

choice
	prompt "EC code can reside on internal or external storage"
	help
	  EC code can reside on internal or external storage. Only one of these
	  CONFIGs should be defined. CONFIG_INTERNAL_STORAGE implies XIP
	  (eXecute-In-Place) semantics. i.e. code is being fetched directly from
	  storage media.

config EXTERNAL_STORAGE
	bool "EXTERNAL_STORAGE"
config INTERNAL_STORAGE
	bool "INTERNAL_STORAGE"
endchoice

menu "ALS config"

config ALS
	bool "ALS support"

if ALS

choice
	prompt "Choose ALS chip"

config ALS_AL3010
	bool "ALS_AL3010"

config ALS_BH1730
	bool "ALS_BH1730"

config ALS_BH1730_LUXTH_PARAMS
	bool "Use board specific lux calculation"
	depends on ALS_BH1730
	help
	  If defined, BH1730 uses board specific lux calculation formula parameters.
	  If not defined, BH1730 uses default parameters to calculate lux.

config ALS_ISL29035
	bool "Enable ALS_ISL29035 support"

config ALS_OPT3001
	bool "ALS_OPT3001"

config ALS_SI114X__yn
	bool "Select ALS_SI114X"
config ALS_SI114X
	hex "Define the exact model ID present on the board: SI1141 = 41, SI1142 = 42"
	default 0x40 if BOARD_EVE
	depends on ALS_SI114X__yn

if ALS_SI114X

config ALS_SI114X_CHECK_REVISION
	bool "Check if the device revision is supported"

config ALS_SI114X_POLLING
	bool "Enable Si114x to operate in polling mode"
	help
	  Enable Si114x to operate in polling mode. This config is used in conjunction
	  with CONFIG_ALS_SI114X_INT_EVENT. When polling is enabled, the read is
	  initiated in the same manner as when interrupts are used, but the event which
	  triggers the irq_handler is generated by deferred call using a fixed delay.

endif # ALS_SI114X

config ALS_TCS3400
	bool "Define to include the clear channel driver for the tcs3400 light sensor"

if ALS_TCS3400

config TCS_USE_LUX_TABLE
	bool "TCS_USE_LUX_TABLE"
	help
	  Define to use atime tables in anti-saturation algos in the tcs3400 driver.
	  Defining this for a board makes the anti-saturation algorithm much more
	  efficient, but requires the board to have it's lens cover scale and k_channel
	  scales to be determined.  Define this for a board once it's added its
	  cover_scale and k_channel scale factors.

config ALS_TCS3400_EMULATED_IRQ_EVENT
	bool "Enable tcs3400 to operate without interrupt pin"
	help
	  Enable tcs3400 to operate without interrupt pin. This config is used in
	  conjunction with CONFIG_ALS_TCS3400_INT_EVENT. When this option is enabled,
	  the read is initiated in the same manner as when interrupts are used, but the
	  event which triggers the irq_handler is generated by deferred call.

endif # ALS_TCS3400

endchoice # ALS chip

config ALS_LIGHTBAR_DIMMING
	bool "Define which ALS sensor is used for dimming the lightbar when dark"



endif #ALS

endmenu # "ALS config"

config WATCHDOG
	bool "Compile watchdog timer support"
	default y
	help
	  Compile watchdog timer support.  The watchdog timer will reboot the system
	  if the hook task (which is the lowest-priority task on the system) gets
	  starved for CPU time and isn't able to fire its HOOK_TICK event.

if WATCHDOG

config WATCHDOG_HELP
	bool "Try to detect a watchdog that is about to fire"
	help
	  Try to detect a watchdog that is about to fire, and print a trace.  This is
	  required on chips such as STM32 where the watchdog timer simply reboots the
	  system without any early warning.

endif # WATCHDOG

config WATCHDOG_MAX_RETRIES
	int "The maximum number of times that the watchdog timer may reset"
	default 4
	help
	  The maximum number of times that the watchdog timer may reset
	  before halting the system (or taking some sort of other
	  chip-dependent corrective action).

config WATCHDOG_PERIOD_MS
	int "Watchdog period in ms; see also AUX_TIMER_PERIOD_MS"
	default 1600

config FPU
	bool "Enable support for floating point unit"

config SUPPORT_HIBERNATE
	bool "Enable system hibernate"
	default y

config I2C
	bool "Enable I2C support"

config I2C_MASTER
	bool "EC uses an I2C master interface"

config I2C_MULTI_PORT_CONTROLLER
	bool "I2C multi-port controller"
	help
	  If CONFIG_I2C_MULTI_PORT_CONTROLLER is defined, a single on-chip I2C
	  controller may have multiple I2C ports attached. Therefore, I2c operations
	  must lock the controller (not just the port) to prevent hardware access
	  conflicts.

config MPU
	bool "Support memory protection unit (MPU)"


if CHIP_NPCX__yn

config SUPPORT_CHIP_HIBERNATION
	bool "If defined, chip hibernation is used"
	default y
	help
	  If defined, chip hibernation is used. Your board needs to define wake-up
	  signals. Undefine this to use board hibernation capability.

config HIBERNATE_PSL
	bool "Use PSL (Power Switch Logic) for hibernating"
	help
	  Use PSL (Power Switch Logic) for hibernating. It turns off VCC power rail
	  for ultra-low power consumption and uses PSL inputs rely on VSBY power rail
	  to wake up ec and the whole system.

endif # CHIP_NPCX__yn

config DMA
	bool "Support DMA transfers inside the EC"

config DMA_DEFAULT_HANDLERS
	bool "Use the common interrupt handlers for DMA IRQs"
	default y

config DMA_HELP
	bool "Compile extra debugging and tests for the DMA module"

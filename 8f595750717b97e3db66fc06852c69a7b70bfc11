      "unresolved": true
    },
    {
      "key": {
        "uuid": "30d5ec4a_61c1e7fd",
        "filename": "common/ocpc.c",
        "patchSetId": 6
      },
      "lineNbr": 151,
      "author": {
        "id": 1125984
      },
      "writtenOn": "2020-05-19T22:29:27Z",
      "side": 1,
      "message": "In my opinion it\u0027s acceptable to a point. As we are using smart batteries, the fuel gauges onboard have built-in protection that should disable the charge FET if it receives a voltage it doesn\u0027t like for too long.\n\nGiven the lag time in setting the voltage, our charger task tick time, and retrieving the new values from the ADCs, I think some overshoot is expected.",
      "parentUuid": "05b491bf_6e929126",
      "range": {
        "startLine": 151,
        "startChar": 21,
        "endLine": 151,
        "endChar": 23
      },
      "revId": "8f595750717b97e3db66fc06852c69a7b70bfc11",

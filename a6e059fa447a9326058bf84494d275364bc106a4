        "id": 1314845
      },
      "writtenOn": "2024-07-22T18:17:19Z",
      "side": 1,
      "message": "Is there any reason not to have the asserts too? It *should* always be faster, but it would be a concern if it wasn\u0027t for some reason, so it doesn\u0027t seem like it\u0027s bad to verify that.",
      "parentUuid": "ec2f86b6_688a02eb",
      "range": {
        "startLine": 346,
        "startChar": 0,
        "endLine": 348,
        "endChar": 4

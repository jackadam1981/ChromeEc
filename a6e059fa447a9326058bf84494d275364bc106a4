      "writtenOn": "2024-07-23T12:21:42Z",
      "side": 1,
      "message": "From my measurements, unaligned and aligned memmoves take the same amount of time. However aligned memcpy is ~3 times faster. Not sure what it works like that. Do you think we should investigate that?",
      "parentUuid": "3d10ca74_6ede398b",
      "range": {
        "startLine": 346,
        "startChar": 0,
        "endLine": 348,
        "endChar": 4
      },
      "revId": "a6e059fa447a9326058bf84494d275364bc106a4",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

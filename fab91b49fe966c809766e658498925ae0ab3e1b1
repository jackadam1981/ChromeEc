      "lineNbr": 72,
      "author": {
        "id": 1441652
      },
      "writtenOn": "2024-02-13T09:44:44Z",
      "side": 1,
      "message": "The problem is that the compiler can optimize out the `memset()`.",
      "parentUuid": "b41c280c_41f75c50",
      "range": {
        "startLine": 72,
        "startChar": 1,
        "endLine": 72,
        "endChar": 64

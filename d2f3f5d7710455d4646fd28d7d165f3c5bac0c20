      "side": 1,
      "message": "Marked as resolved.",
      "parentUuid": "d32d0159_4dc42722",
      "revId": "d2f3f5d7710455d4646fd28d7d165f3c5bac0c20",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "540bb724_d2540b86",
        "filename": "common/usbc/usb_tc_drp_acc_trysrc_sm.c",
        "patchSetId": 3
      },
      "lineNbr": 4034,

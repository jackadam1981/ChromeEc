    {
      "key": {
        "uuid": "ff15e889_33119d24",
        "filename": "common/new_nvmem.c",
        "patchSetId": 9
      },
      "lineNbr": 2751,
      "author": {
        "id": 1152319
      },
      "writtenOn": "2019-03-29T21:48:19Z",
      "side": 1,
      "message": "it\u0027s more about simplifying than optimizing. I\u0027d just prefer the logic and the data structure to be simple for this case, so that we don\u0027t miss some corner cases, esp if we make more changes to the whole nvmem thing in the future. e.g. even now I haven\u0027t quiet checked what happens if right from the beginning or after adding a few fake (k,v) pairs, there\u0027s\n - less that container header space left on the page.\n - enough space for container header, but not for tuple header.\n - exactly enough space for tuple header, but not for any key or value data.\n - enough space for tuple header + 1 byte for the key value.",
      "parentUuid": "8fb02a86_baf996e1",
      "range": {
        "startLine": 2749,
        "startChar": 4,

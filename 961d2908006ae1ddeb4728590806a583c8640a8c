    {
      "key": {
        "uuid": "06f2be9b_5996abce",
        "filename": "common/new_nvmem.c",
        "patchSetId": 9
      },
      "lineNbr": 128,
      "author": {
        "id": 1152319
      },
      "writtenOn": "2019-03-28T05:57:20Z",
      "side": 1,
      "message": "will we have a natural LRU after compaction? this may address the issue w/o further optimization. e.g.\nif we start with \u003cobj1\u003e\u003cobj2\u003e\u003cobj3\u003e, then update \u003cobj2\u003e, we will have \u003cobj1\u003e---\u003cobj3\u003e\u003cobj2\u003e. if we compact at this point we\u0027ll have most recently updated objects at the end: \u003cobj1\u003e\u003cobj3\u003e\u003cobj2\u003e, right?",
      "range": {
        "startLine": 127,
        "startChar": 36,
        "endLine": 128,
        "endChar": 22
      },
      "revId": "961d2908006ae1ddeb4728590806a583c8640a8c",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

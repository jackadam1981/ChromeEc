      "writtenOn": "2019-03-28T05:57:20Z",
      "side": 1,
      "message": "this will wipe everything if nc-\u003econtainer_type !\u003d NN_OBJ_TRANSACTION_DEL, since we get an error fro verify_last_section() in this case. should we instead perform the cleanup of the last transaction only, as done below in this function?",
      "range": {
        "startLine": 1989,
        "startChar": 9,
        "endLine": 1989,
        "endChar": 28
      },
      "revId": "961d2908006ae1ddeb4728590806a583c8640a8c",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true

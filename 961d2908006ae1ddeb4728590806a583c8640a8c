    {
      "key": {
        "uuid": "d08c13bb_4a58b585",
        "filename": "common/new_nvmem.c",
        "patchSetId": 9
      },
      "lineNbr": 1944,
      "author": {
        "id": 1000039
      },
      "writtenOn": "2019-03-29T00:21:30Z",
      "side": 1,
      "message": "yeah, with adding transaction delimiters there is no point in checking generation any more, I kept is as some extra datapoint for debugging in case there are some weird failures we can\u0027t figure out.\n\nBut the idea is that the later encountered object is newer, but can be discarded if there is no transaction delimiter after this later encountered object.",
      "parentUuid": "63ff19cd_286a21cb",
      "range": {
        "startLine": 1944,
        "startChar": 3,
        "endLine": 1944,
        "endChar": 16
      },
      "revId": "961d2908006ae1ddeb4728590806a583c8640a8c",

        "id": 1152319
      },
      "writtenOn": "2019-03-28T05:57:20Z",
      "side": 1,
      "message": "what if cr50 dies here? we\u0027ll be left with two copies of var in flash, and the next find_var will find the first one. if we later ask to erase that var, it will erase the first copy, but the 2nd copy will remain?",
      "range": {
        "startLine": 2692,
        "startChar": 1,
        "endLine": 2692,
        "endChar": 24
      },
      "revId": "961d2908006ae1ddeb4728590806a583c8640a8c",

      },
      "writtenOn": "2019-03-29T00:21:30Z",
      "side": 1,
      "message": "since NN_OBJ_TUPLE are not a subject to transaction processing, there will be only one instance on NN_OBJ_TUPLE object in case there is a valid transaction delimiter.",
      "parentUuid": "18eb8f09_df6a655d",
      "range": {
        "startLine": 1866,

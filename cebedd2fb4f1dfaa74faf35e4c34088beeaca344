    },
    {
      "unresolved": true,
      "key": {
        "uuid": "7407cbc0_ef1f5784",
        "filename": "zephyr/subsys/ucsi/ucsi_host_cmd.c",
        "patchSetId": 28
      },
      "lineNbr": 162,
      "author": {
        "id": 1149894
      },
      "writtenOn": "2024-04-17T00:26:25Z",
      "side": 1,
      "message": "The device should be initialized from the devicetree. See pdc_subsys_init in https://chromium.googlesource.com/chromiumos/platform/ec/+/d41d5845207b8f8d79871e4231ea6c813e60a27d/zephyr/subsys/pd_controller/pdc_power_mgmt.c",
      "range": {
        "startLine": 162,
        "startChar": 1,
        "endLine": 162,
        "endChar": 33
      },
      "revId": "cebedd2fb4f1dfaa74faf35e4c34088beeaca344",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "bc4b080d_6a91b925",
        "filename": "zephyr/subsys/ucsi/ucsi_host_cmd.c",
        "patchSetId": 28
      },
      "lineNbr": 211,
      "author": {
        "id": 1149894
      },
      "writtenOn": "2024-04-17T00:26:25Z",
      "side": 1,
      "message": "eppm_init should be called with DEVICE_DT_INST_DEFINE\n\nhttps://docs.zephyrproject.org/apidoc/latest/group__device__model.html#gada5ba4aca9e0662ccebb2232c7256419\n\nAlso, see pdc_subsys_init in https://chromium.googlesource.com/chromiumos/platform/ec/+/d41d5845207b8f8d79871e4231ea6c813e60a27d/zephyr/subsys/pd_controller/pdc_power_mgmt.c",
      "range": {
        "startLine": 211,
        "startChar": 0,
        "endLine": 211,
        "endChar": 54
      },
      "revId": "cebedd2fb4f1dfaa74faf35e4c34088beeaca344",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "6469b687_95004bc9",
        "filename": "zephyr/subsys/ucsi/ucsi_host_cmd.c",
        "patchSetId": 28

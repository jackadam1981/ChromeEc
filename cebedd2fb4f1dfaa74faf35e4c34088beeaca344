      "lineNbr": 29,
      "author": {
        "id": 1308749
      },
      "writtenOn": "2024-04-18T14:42:26Z",
      "side": 1,
      "message": "This module is called `ucsi_host_cmd.c`, but the implementation is specific to the Realtek chip.  What\u0027s the plan for supporting other vendors?\n\nCan the Realtek specific code be put into the existing driver?",
      "range": {
        "startLine": 29,
        "startChar": 0,
        "endLine": 29,
        "endChar": 30
      },
      "revId": "cebedd2fb4f1dfaa74faf35e4c34088beeaca344",

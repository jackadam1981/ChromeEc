      "writtenOn": "2018-10-24T21:36:51Z",
      "side": 1,
      "message": "why does this need to be true?\n\nAlso is this also true for write as well?\n\nIf this is supposed to be our generated host communication protocol layer, I do not believe that common code will honor this constraint. Should we add extra protection for this now?",
      "range": {
        "startLine": 58,
        "startChar": 3,
        "endLine": 58,
        "endChar": 66
      },
      "revId": "9881dc24fe1c2899c227a5e68aa2d23968d26d38",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

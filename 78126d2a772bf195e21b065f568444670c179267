      "author": {
        "id": 1123814
      },
      "writtenOn": "2016-05-23T21:44:23Z",
      "side": 1,
      "message": "Yes, if not NULL was intended here.",
      "parentUuid": "57bb123b_bb3652f0",
      "range": {
        "startLine": 140,
        "startChar": 22,
        "endLine": 140,
        "endChar": 29
      },
      "revId": "78126d2a772bf195e21b065f568444670c179267",

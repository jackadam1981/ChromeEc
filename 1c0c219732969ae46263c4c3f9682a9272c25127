    },
    {
      "key": {
        "uuid": "78f7fee1_4644741b",
        "filename": "include/queue.h",
        "patchSetId": 1
      },
      "lineNbr": 132,
      "author": {
        "id": 1112784
      },
      "writtenOn": "2015-07-15T16:26:02Z",
      "side": 1,
      "message": "There is no memory copy, in fact these two prototypes generate EXACTLY the same code (well if you had put the chunk parameter before the queue they would be exactly the same, as it is written here the arguments to the function are swapped\".  This is because the ARM ABI specifies (Section 5.4 and Section 5.5, Rule A.4) that if a return value is larger than 4 bytes then the address for the result is placed in R0 (the first parameter slot), which is just what manually passing the pointer is doing.  I verified that this is the case by disassembling both versions of queue_get_write_chunk.",
      "parentUuid": "98975254_e7ed3904",
      "revId": "1c0c219732969ae46263c4c3f9682a9272c25127",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false

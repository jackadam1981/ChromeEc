    },
    {
      "key": {
        "uuid": "3837466d_412a3233",
        "filename": "include/queue.h",
        "patchSetId": 1
      },
      "lineNbr": 109,
      "author": {
        "id": 1112784
      },
      "writtenOn": "2015-07-15T16:26:02Z",
      "side": 1,
      "message": "This isn\u0027t specifying a constant pointer, a constant pointer would be \"struct queue * const q\", as with the prototypes above, this is a constant queue.  The \"const struct queue *q\" form is the same as \"struct queue const *q\".  I find that putting the const on the right is more intuitive because that is where it has to go for pointers, say you want a constant pointer to a constant queue, that would have to be \"const struct queue * const q\" or \"struct queue const * const q\".  I prefer the second because it allows it to be read from right to left as \"q is a constant pointer to a constant queue\".",
      "parentUuid": "9870321a_3e8679f1",
      "revId": "1c0c219732969ae46263c4c3f9682a9272c25127",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },
    {
      "key": {

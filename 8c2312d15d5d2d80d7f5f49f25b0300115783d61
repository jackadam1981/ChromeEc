      "writtenOn": "2018-06-26T11:10:15Z",
      "side": 1,
      "message": "No, they are only for DX version.\nI want to add an implementation and is able to apply to all versions without adding a new config option. So we don\u0027t need to enable/disable a additional config option for each board.",
      "parentUuid": "d4b8d448_9c3a7693",
      "range": {
        "startLine": 106,
        "startChar": 0,
        "endLine": 108,
        "endChar": 60
      },
      "revId": "8c2312d15d5d2d80d7f5f49f25b0300115783d61",

    },
    {
      "unresolved": true,
      "key": {
        "uuid": "e24f8d7e_42165829",
        "filename": "driver/battery/smart.c",
        "patchSetId": 1
      },
      "lineNbr": 67,
      "author": {
        "id": 1390635
      },
      "writtenOn": "2022-02-25T23:37:54Z",
      "side": 1,
      "message": "It\u0027s not noisy normally. It\u0027s really noisy when connecting or disconnecting the battery, which is I guess is not unexpected. It could be very noisy during bring-up if there\u0027s a bug. It will require a bit more flash storage on boards that use PLATFORM_EC_BATTERY_SMART.",
      "parentUuid": "62b6a450_afb908e2",
      "range": {
        "startLine": 67,
        "startChar": 45,
        "endLine": 67,
        "endChar": 71
      },
      "revId": "b0c965ee3db2ca314867fa9bf309dacbfd5ac707",

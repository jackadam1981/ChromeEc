      "writtenOn": "2022-02-25T23:14:39Z",
      "side": 1,
      "message": "I wonder if we check only rv and battery_is_present, errors are too noisy? If not, we can have these error messages included by default.",
      "range": {
        "startLine": 67,
        "startChar": 45,
        "endLine": 67,
        "endChar": 71
      },
      "revId": "b0c965ee3db2ca314867fa9bf309dacbfd5ac707",

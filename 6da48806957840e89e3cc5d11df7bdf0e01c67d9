      "writtenOn": "2018-07-31T16:08:06Z",
      "side": 1,
      "message": "Yves, what\u0027s the latest on the SN+RMAbits structure we need to store in INFO1? What should struct sn_bits be here?",
      "range": {
        "startLine": 27,
        "startChar": 1,
        "endLine": 27,
        "endChar": 16
      },
      "revId": "6da48806957840e89e3cc5d11df7bdf0e01c67d9",

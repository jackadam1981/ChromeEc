      "writtenOn": "2024-01-03T19:43:05Z",
      "side": 1,
      "message": "I know this function return void, but it\u0027d be nice to know if it failed so this state machine could try again, or take some other action.",
      "range": {
        "startLine": 490,
        "startChar": 2,
        "endLine": 490,
        "endChar": 22
      },
      "revId": "b53f4b77655a3fe0ad4d3c0725fb88af57b09fbb",

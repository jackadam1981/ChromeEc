      "writtenOn": "2013-08-29T17:10:21Z",
      "side": 1,
      "message": "How does this work?  You\u0027re now overwriting current_osc before checking whether it\u0027s OSC_INIT.",
      "revId": "d3bf01e44d83933007bd1dc47b662619626a379a",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

      "writtenOn": "2020-07-10T15:53:48Z",
      "side": 1,
      "message": "Why do we not need to offset the min vsys target when the system resistance is known?",
      "range": {
        "startLine": 217,
        "startChar": 2,
        "endLine": 217,
        "endChar": 22
      },
      "revId": "ee587f547a8d9c5faddb3638aed7e4ce5370cac4",

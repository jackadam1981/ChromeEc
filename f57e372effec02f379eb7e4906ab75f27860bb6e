      "side": 1,
      "message": "may be we can use board_get_usb_pd_port_count() + 1\nthough MCHP is ADL-P only 2 type-c ports are enabled",
      "parentUuid": "4bd9a30e_8a0d32e3",
      "revId": "f57e372effec02f379eb7e4906ab75f27860bb6e",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "fc36296d_b29801e6",

    {
      "key": {
        "uuid": "AAAAXX//v+U\u003d",
        "filename": "chip/stm32/spi.c",
        "patchSetId": 2
      },
      "lineNbr": 264,
      "author": {
        "id": 1000294
      },
      "writtenOn": "2013-05-01T18:09:53Z",
      "side": 1,
      "message": "Doing the register lookup each time slowed things down a lot. Can we keep this optimization, or at least benchmark the performance loss?",
      "revId": "7a35f4c6af4d357ba42192d2e2b4e79be4f59d22",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

      "writtenOn": "2020-06-15T18:03:32Z",
      "side": 1,
      "message": "do we need to clear this now since entry in snk and src ready will clear this?",
      "range": {
        "startLine": 930,
        "startChar": 2,
        "endLine": 930,
        "endChar": 52
      },
      "revId": "2f32dd48ad71741414904abf295ba7645006b393",

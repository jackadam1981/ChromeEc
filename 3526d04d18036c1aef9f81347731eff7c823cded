    },
    {
      "unresolved": false,
      "key": {
        "uuid": "7373ad12_71b77c9d",
        "filename": "zephyr/shim/src/watchdog.c",
        "patchSetId": 11
      },
      "lineNbr": 171,
      "author": {
        "id": 1390635
      },
      "writtenOn": "2026-01-21T23:12:12Z",
      "side": 1,
      "message": "It prevents a race condition where an interrupt updates watchdog_reload_last_ts_ms to be newer than now, causing integer underflow in the elapsed time calculation.",
      "parentUuid": "ebe0f40d_1f42dbb1",
      "range": {
        "startLine": 171,
        "startChar": 0,
        "endLine": 171,
        "endChar": 33
      },
      "revId": "3526d04d18036c1aef9f81347731eff7c823cded",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "af71bac5_8d8be214",
        "filename": "zephyr/shim/src/watchdog.c",
        "patchSetId": 11
      },
      "lineNbr": 172,
      "author": {
        "id": 1479762
      },
      "writtenOn": "2026-01-21T06:03:39Z",
      "side": 1,
      "message": "`now` is 64-bit wide, other variables here are only 32 bits",
      "range": {
        "startLine": 172,
        "startChar": 22,
        "endLine": 172,
        "endChar": 25
      },
      "revId": "3526d04d18036c1aef9f81347731eff7c823cded",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {

      "writtenOn": "2026-01-21T06:03:39Z",
      "side": 1,
      "message": "nitpicking, welcome to disregard: the call to k_uptime_get() doesn\u0027t have to be inside this spinlock",
      "range": {
        "startLine": 171,
        "startChar": 0,
        "endLine": 171,
        "endChar": 33
      },
      "revId": "3526d04d18036c1aef9f81347731eff7c823cded",

<!--
List of enabled tasks in the priority order

The first one has the lowest priority.

For each task, define a <task> node with child nodes:
  'name' contains the name of the task
  'routine' contains the main routine of the task
  'arg' contains an opaque parameter passed to the routine at startup
-->
<tasklist>
	<task>
		<name>WATCHDOG</name>
		<routine>watchdog_task</routine>
		<arg>NULL</arg>
	</task>
	<task>
		<name>KEYSCAN</name>
		<routine>keyboard_scan_task</routine>
		<arg>NULL</arg>
	</task>
	<task>
		<name>GAIAPOWER</name>
		<routine>gaia_power_task</routine>
		<arg>NULL</arg>
	</task>
	<task>
		<name>CONSOLE</name>
		<routine>console_task</routine>
		<arg>NULL</arg>
	</task>
</tasklist>

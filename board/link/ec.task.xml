<!--
List of enabled tasks in the priority order

The first one has the lowest priority.

For each task, define a <task> node with child nodes:
  'name' contains the name of the task
  'routine' contains the main routine of the task
  'arg' contains an opaque parameter passed to the routine at startup
-->
<tasklist>
	<task>
		<name>WATCHDOG</name>
		<routine>watchdog_task</routine>
	</task>
	<task>
		<name>TEMPSENSOR</name>
		<routine>temp_sensor_task</routine>
	</task>
	<task>
		<name>THERMAL</name>
		<routine>thermal_task</routine>
	</task>
	<task>
		<name>PWM</name>
		<routine>pwm_task</routine>
	</task>
	<task>
		<name>KEYSCAN</name>
		<routine>keyboard_scan_task</routine>
	</task>
	<task>
		<name>POWERBTN</name>
		<routine>power_button_task</routine>
	</task>
	<task>
		<name>X86POWER</name>
		<routine>x86_power_task</routine>
	</task>
	<task>
		<name>CONSOLE</name>
		<routine>console_task</routine>
	</task>
	<task>
		<name>HOSTCMD</name>
		<routine>host_command_task</routine>
	</task>
	<task>
		<name>I8042CMD</name>
		<routine>i8042_command_task</routine>
	</task>
	<task>
		<name>POWERSTATE</name>
		<routine>charge_state_machine_task</routine>
	</task>
</tasklist>

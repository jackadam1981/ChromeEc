# KCONFIG_USB_PD_TCPM_ANX741X is not set
# KCONFIG_USB_PD_TCPM_ANX7447 is not set
# KCONFIG_USB_PD_TCPM_ANX7688 is not set
# KCONFIG_USB_PD_TCPM_NCT38XX is not set
KCONFIG_USB_PD_TCPM_PS8751=y
# KCONFIG_USB_PD_TCPM_PS8805 is not set
# KCONFIG_USB_PD_TCPM_MT6370 is not set
# KCONFIG_USB_PD_TCPM_TUSB422 is not set
# KCONFIG_USB_PD_RETIMER is not set
# KCONFIG_USB_PD_RETIMER_INTEL_BB is not set
# KCONFIG_USB_PD_TCPM_ANX7447_OCM_ERASE_COMMAND is not set
KCONFIG_USB_PD_TCPM_MUX=y
KCONFIG_USB_PD_VBUS_DETECT_TCPC=y
# KCONFIG_USB_PD_VBUS_DETECT_CHARGER is not set
# KCONFIG_USB_PD_VBUS_DETECT_GPIO is not set
# KCONFIG_USB_PD_VBUS_DETECT_PPC is not set
# KCONFIG_USB_PD_VBUS_DETECT_NONE is not set
# KCONFIG_USB_PD_VBUS_MEASURE_ADC_EACH_PORT is not set
KCONFIG_USB_PD_VBUS_MEASURE_NOT_PRESENT=y
KCONFIG_TCPC_I2C_BASE_ADDR_FLAGS=0x4E
KCONFIG_USB_PD_TRY_SRC=y
KCONFIG_USB_PD_TRY_SRC_MIN_BATT_SOC=2
# KCONFIG_USB_PD_RESET_MIN_BATT_SOC__yn is not set
# KCONFIG_USB_PD_TX_PHY_ONLY is not set
# KCONFIG_PD_USE_DAC_AS_REF is not set
# KCONFIG_USB_TYPEC_VPD is not set
# KCONFIG_USB_TYPEC_CTVPD is not set
# KCONFIG__USB_TYPEC_DRP_ACC_TRYSRC is not set
# KCONFIG_USB_PID is not set
# KCONFIG_USB_PD_MAX_SINGLE_SOURCE_CURRENT is not set
# KCONFIG_USB_PD_MAX_TOTAL_SOURCE_CURRENT__yn is not set
# KCONFIG_MCMDS is not set
# KCONFIG_LOW_POWER_S0 is not set
KCONFIG_LTO=y
KCONFIG_PWM=y
KCONFIG_SOFTWARE_PANIC=y
KCONFIG_SHA256_UNROLLED=y

#
# Common Code
#
KCONFIG_COMMON_PANIC_OUTPUT=y
KCONFIG_COMMON_GPIO=y
# KCONFIG_COMMON_GPIO_SHORTNAMES is not set
KCONFIG_COMMON_RUNTIME=y
KCONFIG_COMMON_TIMER=y

#
# IPI
#
# KCONFIG_IPI is not set
# KCONFIG_FACTORY_MODE is not set

#
# Vboot
#
# KCONFIG_VBOOT_EFS is not set
KCONFIG_VBOOT_HASH=y
KCONFIG_VSTORE=y
KCONFIG_VSTORE_SLOT_COUNT=1
KCONFIG_SWITCH=y
# KCONFIG_SWITCH_DEDICATED_RECOVERY is not set
KCONFIG_TASK_PROFILING=y

#
# Rollback
#
KCONFIG_ROLLBACK_VERSION=0
# KCONFIG_ROLLBACK_SECRET_SIZE__yn is not set
# KCONFIG_ROLLBACK_MPU_PROTECT is not set
# KCONFIG_ROLLBACK_SECRET_LOCAL_ENTROPY_SIZE is not set
KCONFIG_ROLLBACK_UPDATE=y
KCONFIG_PWR_STATE_DISCHARGE_FULL=y

#
# Motion Sensor
#
KCONFIG_MOTION_SENSE_SUSPEND_DELAY_US=0
KCONFIG_MOTION_SENSE_RESUME_DELAY_US=0
# KCONFIG_DYNAMIC_MOTION_SENSOR_COUNT is not set
KCONFIG_MOTION_FILL_LPC_SENSE_DATA=y
KCONFIG_EXTERNAL_STORAGE=y
# KCONFIG_INTERNAL_STORAGE is not set
KCONFIG_MAPPED_STORAGE=y
KCONFIG_FW_INCLUDE_RO=y
# KCONFIG_FW_LIMITED_IMAGE is not set

#
# Chipset config
#
# KCONFIG_CHIPSET_ICELAKE is not set
# KCONFIG_CHIPSET_CANNONLAKE is not set
# KCONFIG_CHIPSET_COMETLAKE is not set
KCONFIG_CHIPSET_SKYLAKE=y
# KCONFIG_CHIPSET_GEMINILAKE is not set
# KCONFIG_CHIPSET_APOLLOLAKE is not set
# KCONFIG_CHIPSET_BRASWELL is not set
# KCONFIG_CHIPSET_MT8183 is not set
# KCONFIG_CHIPSET_MT817X is not set
# KCONFIG_CHIPSET_RK3399 is not set
# KCONFIG_CHIPSET_RK3288 is not set
# KCONFIG_CHIPSET_SDM845 is not set
# KCONFIG_CHIPSET_STONEY is not set
# KCONFIG_CHIPSET_ECDRIVEN is not set
KCONFIG_CHIPSET_POWER_SEQ_VERSION=0
KCONFIG_CHIPSET_HAS_PLATFORM_PMIC_RESET=y
KCONFIG_CHIPSET_RESET_HOOK=y
KCONFIG_CHIPSET_X86_RSMRST_DELAY=y
KCONFIG_CPU_PROCHOT_ACTIVE_LOW=y

#
# Power
#

#
# Power Button
#
KCONFIG_POWER_BUTTON=y
# KCONFIG_POWER_BUTTON_ACTIVE_STATE__yn is not set
# KCONFIG_POWER_BUTTON_IGNORE_LID is not set
KCONFIG_POWER_BUTTON_X86=y
# KCONFIG_POWER_BUTTON_INIT_IDLE is not set
KCONFIG_POWER_BUTTON_INIT_TIMEOUT__yn=y
KCONFIG_POWER_BUTTON_INIT_TIMEOUT=1
KCONFIG_POWER_COMMON=y
# KCONFIG_POWER_PP5000_CONTROL is not set
# KCONFIG_POWER_SHUTDOWN_PAUSE_IN_S5 is not set
KCONFIG_POWER_SIGNAL_INTERRUPT_STORM_DETECT_THRESHOLD__yn=y
KCONFIG_POWER_SIGNAL_INTERRUPT_STORM_DETECT_THRESHOLD=30
KCONFIG_POWER_TRACK_HOST_SLEEP_STATE=y
KCONFIG_POWER_S0IX=y
# KCONFIG_POWER_S0IX_FAILURE_DETECTION is not set
KCONFIG_HIBERNATE=y
KCONFIG_HIBERNATE_DELAY_SEC=3600

#
# External Power
#
KCONFIG_EXTPOWER=y
KCONFIG_EXTPOWER_GPIO=y
KCONFIG_EXTPOWER_DEBOUNCE_MS=30
# KCONFIG_VIF_TYPE_C_CAN_ACT_AS_HOST is not set
# KCONFIG_VIF_CAPTIVE_CABLE is not set

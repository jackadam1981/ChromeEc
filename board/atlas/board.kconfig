CONFIG_USB_PD_ALT_MODE=y
CONFIG_USB_PD_ALT_MODE_DFP=y
# CONFIG_USB_PD_CHECK_MAX_REQUEST_ALLOWED is not set
# CONFIG_USB_PD_COMM_DISABLED is not set
CONFIG_USB_PD_COMM_LOCKED=y
# CONFIG_USB_PD_DEBUG_LEVEL is not set
CONFIG_USB_PD_DISCHARGE=y
# CONFIG_USB_PD_DISCHARGE_GPIO is not set
CONFIG_USB_PD_DISCHARGE_TCPC=y
# CONFIG_USB_PD_DISCHARGE_PPC is not set
CONFIG_USB_PD_DUAL_ROLE=y
CONFIG_USB_PD_DUAL_ROLE_AUTO_TOGGLE=y
# CONFIG_BD9995X_DELAY_INPUT_PORT_SELECT is not set
# CONFIG_USB_PD_5V_EN_ACTIVE_LOW is not set
# CONFIG_USB_PD_5V_CHARGER_CTRL is not set
# CONFIG_USB_PD_5V_EN_CUSTOM is not set
# CONFIG_USB_PD_DYNAMIC_SRC_CAP is not set
# CONFIG_USB_PD_FLASH is not set
# CONFIG_USB_PD_FLASH_ERASE_CHECK is not set
# CONFIG_USB_PD_GIVE_BACK is not set
# CONFIG_USB_PD_REV30 is not set
# CONFIG_USB_PD_HW_DEV_ID_BOARD__yn is not set
# CONFIG_USB_PD_IDENTITY_HW__yn is not set
# CONFIG_USB_PD_IDENTITY_SW__yn is not set
CONFIG_USB_PD_I2C_SLAVE_ADDR_FLAGS=0x1E
# CONFIG_USB_PD_INTERNAL_COMP is not set
CONFIG_USB_PD_LOGGING=y
CONFIG_EVENT_LOG_SIZE=512
CONFIG_USB_PD_LOW_POWER=y
# CONFIG_USB_PD_LOW_POWER_IDLE_WHEN_CONNECTED is not set
CONFIG_USB_PD_PORT_COUNT__yn=y
# CONFIG_USB_PD_SIMPLE_DFP is not set
CONFIG_USB_PD_RX_COMP_IRQ=y
# CONFIG_USB_PD_TCPC is not set
CONFIG_USB_PD_TCPC_LOW_POWER=y
# CONFIG_USB_PD_DECODE_SOP is not set
# CONFIG_USB_PD_TCPC_TRACK_VBUS is not set
# CONFIG_USB_PD_TCPC_RUNTIME_CONFIG is not set

#
# TCPM choice
#
# CONFIG_USB_PD_TCPM_STUB is not set
CONFIG_USB_PD_TCPM_TCPCI=y
# CONFIG_USB_PD_TCPM_FUSB302 is not set
# CONFIG_USB_PD_TCPM_ITE83XX is not set
# CONFIG_USB_PD_TCPM_ANX3429 is not set
# CONFIG_USB_PD_TCPM_ANX740X is not set
# CONFIG_USB_PD_TCPM_ANX741X is not set
# CONFIG_USB_PD_TCPM_ANX7447 is not set
# CONFIG_USB_PD_TCPM_ANX7688 is not set
# CONFIG_USB_PD_TCPM_NCT38XX is not set
CONFIG_USB_PD_TCPM_PS8751=y
# CONFIG_USB_PD_TCPM_PS8805 is not set
# CONFIG_USB_PD_TCPM_MT6370 is not set
# CONFIG_USB_PD_TCPM_TUSB422 is not set
# CONFIG_USB_PD_RETIMER is not set
# CONFIG_USB_PD_RETIMER_INTEL_BB is not set
# CONFIG_USB_PD_TCPM_ANX7447_OCM_ERASE_COMMAND is not set
CONFIG_USB_PD_TCPM_MUX=y
CONFIG_HAVE_USB_PD_VBUS_DETECT_TCPC=y
# CONFIG_USB_PD_VBUS_DETECT_NONE is not set
CONFIG_USB_PD_VBUS_DETECT_TCPC=y
# CONFIG_USB_PD_VBUS_DETECT_CHARGER is not set
# CONFIG_USB_PD_VBUS_DETECT_GPIO is not set
# CONFIG_USB_PD_VBUS_DETECT_PPC is not set
# CONFIG_USB_PD_VBUS_MEASURE_ADC_EACH_PORT is not set
CONFIG_USB_PD_VBUS_MEASURE_NOT_PRESENT=y
CONFIG_TCPC_I2C_BASE_ADDR_FLAGS=0x4E
CONFIG_USB_PD_TRY_SRC=y
# CONFIG_USB_PD_RESET_MIN_BATT_SOC__yn is not set
# CONFIG_USB_PD_TX_PHY_ONLY is not set
# CONFIG_PD_USE_DAC_AS_REF is not set
# CONFIG_USB_TYPEC_VPD is not set
# CONFIG_USB_TYPEC_CTVPD is not set
# CONFIG__USB_TYPEC_DRP_ACC_TRYSRC is not set
# CONFIG_USB_PID is not set
# CONFIG_USB_PD_MAX_SINGLE_SOURCE_CURRENT is not set
# CONFIG_USB_PD_MAX_TOTAL_SOURCE_CURRENT__yn is not set
# CONFIG_LOW_POWER_S0 is not set
CONFIG_SOFTWARE_PANIC=y

#
# Common Code
#
CONFIG_COMMON_PANIC_OUTPUT=y
CONFIG_COMMON_GPIO=y
# CONFIG_COMMON_GPIO_SHORTNAMES is not set
CONFIG_COMMON_RUNTIME=y
CONFIG_COMMON_TIMER=y
# CONFIG_IPI is not set

#
# Vboot
#
# CONFIG_VBOOT_EFS is not set
CONFIG_VBOOT_HASH=y
CONFIG_VSTORE=y

#
# Debug & Profiling Options
#

#
# Debug setup
#
CONFIG_DEBUG_ASSERT=y
CONFIG_DEBUG_ASSERT_REBOOTS=y
# CONFIG_DEBUG_ASSERT_BRIEF is not set
# CONFIG_DEBUG_DISABLE_WRITE_BUFFER is not set
CONFIG_DEBUG_EXCEPTIONS=y
# CONFIG_DEBUG_PRINTF is not set
CONFIG_DEBUG_STACK_OVERFLOW=y
CONFIG_PORT80_HISTORY_LEN=128
CONFIG_PORT80_PRINT_IN_INT=0
# CONFIG_FACTORY_MODE is not set
# CONFIG_SWITCH_DEDICATED_RECOVERY is not set
CONFIG_TASK_PROFILING=y

#
# Optimization Options
#
CONFIG_LTO=y
CONFIG_SHA256_UNROLLED=y

#
# Rollback
#
CONFIG_ROLLBACK_VERSION=0
# CONFIG_ROLLBACK_SECRET_SIZE__yn is not set
# CONFIG_ROLLBACK_MPU_PROTECT is not set
# CONFIG_ROLLBACK_SECRET_LOCAL_ENTROPY_SIZE is not set
CONFIG_ROLLBACK_UPDATE=y
CONFIG_MOTION_MIN_SENSE_WAIT_TIME=3
CONFIG_HAVE_CHIPSET_SKYLAKE=y

#
# Chipset config
#
# CONFIG_CHIPSET_TIGERLAKE is not set
# CONFIG_CHIPSET_ICELAKE is not set
# CONFIG_CHIPSET_CANNONLAKE is not set
# CONFIG_CHIPSET_COMETLAKE is not set
CONFIG_CHIPSET_SKYLAKE=y
# CONFIG_CHIPSET_GEMINILAKE is not set
# CONFIG_CHIPSET_APOLLOLAKE is not set
# CONFIG_CHIPSET_BRASWELL is not set
# CONFIG_CHIPSET_MT8183 is not set
# CONFIG_CHIPSET_MT817X is not set
# CONFIG_CHIPSET_RK3399 is not set
# CONFIG_CHIPSET_RK3288 is not set
# CONFIG_CHIPSET_SDM845 is not set
# CONFIG_CHIPSET_STONEY is not set
# CONFIG_CHIPSET_ECDRIVEN is not set
CONFIG_CHIPSET_POWER_SEQ_VERSION=0
CONFIG_CHIPSET_HAS_PLATFORM_PMIC_RESET=y
# CONFIG_CHIPSET_HAS_PRE_INIT_CALLBACK is not set
CONFIG_CHIPSET_RESET_HOOK=y
CONFIG_CHIPSET_X86_RSMRST_DELAY=y
CONFIG_CPU_PROCHOT_ACTIVE_LOW=y

#
# Power Setup
#

#
# Power Button
#
CONFIG_POWER_BUTTON=y
# CONFIG_POWER_BUTTON_ACTIVE_STATE__yn is not set
# CONFIG_POWER_BUTTON_IGNORE_LID is not set
CONFIG_POWER_BUTTON_X86=y
# CONFIG_POWER_BUTTON_INIT_IDLE is not set
CONFIG_POWER_BUTTON_INIT_TIMEOUT__yn=y
CONFIG_POWER_BUTTON_INIT_TIMEOUT=1
CONFIG_POWER_COMMON=y
# CONFIG_POWER_PP5000_CONTROL is not set
# CONFIG_POWER_SHUTDOWN_PAUSE_IN_S5 is not set
CONFIG_POWER_SIGNAL_INTERRUPT_STORM_DETECT_THRESHOLD__yn=y
CONFIG_POWER_TRACK_HOST_SLEEP_STATE=y
CONFIG_POWER_S0IX=y
# CONFIG_POWER_S0IX_FAILURE_DETECTION is not set
CONFIG_HIBERNATE_DELAY_SEC=3600

#
# External Power
#
CONFIG_EXTPOWER=y
CONFIG_EXTPOWER_GPIO=y
CONFIG_EXTPOWER_DEBOUNCE_MS=30

#
# Util Setup
#
# CONFIG_VIF_TYPE_C_CAN_ACT_AS_HOST is not set
# CONFIG_VIF_CAPTIVE_CABLE is not set

#
# Automatically generated file; DO NOT EDIT.
# EC configuration
#

#
# General setup
#
# KCONFIG_TEST_CONFIG_1 is not set
KCONFIG_BOARD_ATLAS=y
# KCONFIG_BOARD_NOCTURNE is not set
KCONFIG_ADC=y
KCONFIG_BOARD_VERSION_CUSTOM=y
KCONFIG_BOARD_FORCE_RESET_PIN=y
KCONFIG_DPTF=y
KCONFIG_FPU=y
KCONFIG_I2C=y
KCONFIG_I2C_MASTER=y
KCONFIG_LID_SWITCH=y

#
# LPI
#
KCONFIG_LOW_POWER_IDLE=y
# KCONFIG_LOW_POWER_USE_LFIOSC is not set
# KCONFIG_LOW_POWER_IDLE_LIMITED is not set
# KCONFIG_LOW_POWER_S0 is not set
KCONFIG_LTO=y
KCONFIG_CHIP_PANIC_BACKUP=y
KCONFIG_BATTERY=y

#
# battery type
#
KCONFIG_BATTERY_SMART=y
# KCONFIG_BATTERY_BQ20Z453 is not set
# KCONFIG_BATTERY_BQ27541 is not set
# KCONFIG_BATTERY_BQ27621 is not set
# KCONFIG_BATTERY_BQ4050 is not set
# KCONFIG_BATTERY_MAX17055 is not set
# KCONFIG_BATTERY_MM8013 is not set
# KCONFIG_BATTERY_MOCK is not set
KCONFIG_BATTERY_PRECHARGE_TIMEOUT=30
KCONFIG_BATTERY_HW_PRESENT_CUSTOM=y
KCONFIG_BATTERY_PRESENT_CUSTOM=y
# KCONFIG_BATTERY_PRESENT_GPIO is not set
KCONFIG_BATTERY_DEVICE_CHEMISTRY="LION"
# KCONFIG_BATTERY_FUEL_GAUGE is not set
KCONFIG_BATTERY_CRITICAL_SHUTDOWN_TIMEOUT=30
# KCONFIG_BATTERY_CRITICAL_SHUTDOWN_CUT_OFF is not set
KCONFIG_BATTERY_CUT_OFF=y
# KCONFIG_BATTERY_CUTOFF_DELAY_US is not set
# KCONFIG_BATTERY_VENDOR_PARAM is not set
KCONFIG_BATTERY_REQUESTS_NIL_WHEN_DEAD=y
# KCONFIG_BATTERY_REVIVE_DISCONNECT is not set
KCONFIG_BATTERY_LEVEL_NEAR_FULL=95
# KCONFIG_BATTERY_V2 is not set
# KCONFIG_BATTERY_MEASURE_IMBALANCE is not set
KCONFIG_BATTERY_MAX_IMBALANCE_MV=200
KCONFIG_BATT_FULL_FACTOR=98
KCONFIG_BATT_HOST_SHUTDOWN_PERCENTAGE=4
KCONFIG_BATT_HOST_FULL_FACTOR=94
KCONFIG_PWM=y
KCONFIG_PWM_KBLIGHT=y
KCONFIG_SOFTWARE_PANIC=y
KCONFIG_SHA256_UNROLLED=y

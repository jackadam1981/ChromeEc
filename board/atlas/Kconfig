
config BOARD_ATLAS
#	prompt "Atlas"
#	def_bool n
#	bool
	select ADC
	select BOARD_VERSION_CUSTOM
	select BOARD_FORCE_RESET_PIN
	select DPTF
	select FPU
	select I2C
	select I2C_MASTER
	select LID_SWITCH
	select LOW_POWER_IDLE
	select LTO
	select CHIP_PANIC_BACKUP
	select SOFTWARE_PANIC
	select PWM
	select PWM_KBLIGHT
	select SHA256_UNROLLED
	select BATTERY_SMART





# ================================================================

config ADC
	bool "Compile chip support for analog-to-digital converter"
	default n

config BOARD_VERSION_CUSTOM
	bool "The board version function is defined in board code"
	default n

config BOARD_FORCE_RESET_PIN
	bool "Force reset pin"
	default n
	help
	  The board is unable to distinguish EC reset from power-on so it should treat
	  all resets as triggered by RESET_PIN even if it is a POWER_ON reset.

config DPTF
	bool "Enable DPTF to manage thermals"
	default n
	help
	  If defined, DPTF is enabled to manage thermals.

	  NOTE: This doesn't mean that thermal control is completely taken care by
	  DPTF. We have some hybrid solutions where the EC still manages the fans.

config FPU
	bool "Enable support for floating point unit"
	default n

config I2C
	bool "Enable I2C support"
	default n

config I2C_MASTER
	bool "EC uses an I2C master interface"
	default n

config LID_SWITCH
	bool "Compile lid switch support"
	default y
	help
	  This is enabled by default because all boards other than reference boards
	  are for laptops with lid switchs.  Reference boards #undef it.


menu LPI

config LOW_POWER_IDLE
	bool "low power idle"
	default n
	help
	  Low power idle options. These are disabled by default and all boards that
	  want to use low power idle must define it. When using the LFIOSC, the low
	  frequency clock will be used to conserve even more power when possible.

	  GPIOs which need to trigger interrupts in low power idle must specify the
	  GPIO_INT_DSLEEP flag in gpio_list[].

	  Note that for some processors (e.g. LM4), an active JTAG connection will
	  prevent the EC from using low-power idle.

config LOW_POWER_USE_LFIOSC
	bool "Use LFIOSC"
	default n

config LOW_POWER_IDLE_LIMITED
	bool "Allows us to enable/disable low power idle mode in runtime"
	default n

config LOW_POWER_S0
	bool "Enable deep sleep during S0 (ignores SLEEP_MASK_AP_RUN)"
	default n

endmenu

config LTO
	bool "Use Link-Time Optimizations to try to reduce the firmware code size"
	default n


+static int ssd0303_event(I2CSlave *i2c, enum i2c_event event)
+{
+    ssd0303_state *s = SSD0303(i2c);
+
+    switch (event) {
+    case I2C_FINISH:
+        s->mode = SSD0303_IDLE;
+        break;
+    case I2C_START_RECV:
+    case I2C_START_SEND:
+    case I2C_NACK:

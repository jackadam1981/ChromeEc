+static void ssd0303_update_display(gfx_state *s)
+{
+    DisplaySurface *surface = qemu_console_surface(s->con);
+    uint8_t *dest;
+    uint8_t *src;
+    int x;
+    int y;
+    int line;
+    char *colors[2];
+    char colortab[MAGNIFY * 8];
+    int dest_width;
+    uint8_t mask;
+
+    switch (surface_bits_per_pixel(surface)) {
+    case 0:
+        return;
+    case 15:
+        dest_width = 2;
+        break;
+    case 16:
+        dest_width = 2;
+        break;
+    case 24:
+        dest_width = 3;
+        break;
+    case 32:
+        dest_width = 4;
+        break;
+    default:
+        BADF("Bad color depth\n");
+        return;
+    }
+    dest_width *= MAGNIFY;
+    memset(colortab, 0xff, dest_width);
+    memset(colortab + dest_width, 0, dest_width);
+
+    if (flash) {
+        colors[0] = colortab;
+        colors[1] = colortab;
+    } else if (inverse) {
+        colors[0] = colortab;
+        colors[1] = colortab + dest_width;
+    } else {
+        colors[0] = colortab + dest_width;
+        colors[1] = colortab;
+    }
+
+    dest = surface_data(surface);
+    dest += (dest_width * 4 * 96);
+    for (y = 0; y < 16; y++) {
+        line = (y + start_line) & 63;
+        src = framebuffer + 132 * (line >> 3) + 36;
+        mask = 1 << (line & 7);
+        for (x = 0; x < 96; x++) {
+            memcpy(dest, colors[(*src & mask) != 0], dest_width);
+            dest += dest_width;
+            src++;
+        }
+        for (x = 1; x < MAGNIFY; x++) {
+            memcpy(dest, dest - dest_width * 96, dest_width * 96);
+            dest += dest_width * 96;
+        }
+    }
+
+    update_lcd = 0;
+}
+
+static void gfx_update_display(void *opaque)
+{
+
+    gfx_state *s = (gfx_state *)opaque;
+
+    if (update_lcd)
+        ssd0303_update_display(s);
+
+    if (update_isc) {
+        isc_update_display0(s);
+        isc_update_display1(s);
+        update_isc = 0;
+    }
+
+    draw_led(s);
+
+    dpy_gfx_update(s->con, 0, 0, 96 * MAGNIFY, 25 * MAGNIFY);
+}
+
+static void gfx_invalidate_display(void * opaque)
+{
+    update_lcd = 1;
+    update_isc = 1;
+}
+
+static const GraphicHwOps gfx_ops = {
+    .invalidate  = gfx_invalidate_display,
+    .gfx_update  = gfx_update_display,
+};

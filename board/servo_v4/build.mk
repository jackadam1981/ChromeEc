# Board specific files build

# the IC is STmicro STM32F072RBT6
CHIP:=stm32
CHIP_FAMILY:=stm32f0
CHIP_VARIANT:=stm32f07x

board-y=board.o

# This list is generated by removing the relevant
# CONFIG defines from board.h and printing the
# +$(info $(ro-objs)) variable from ec/Makefile

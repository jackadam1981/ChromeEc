	chip/stm32/system.o \
	chip/stm32/uart.o \
	chip/stm32/usb-stm32f0.o \
	chip/stm32/usb-stream.o \
	chip/stm32/usb.o \
	chip/stm32/usb_console.o \
	chip/stm32/usb_endpoints.o \

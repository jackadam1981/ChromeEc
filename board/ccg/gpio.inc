/* Intel ADL-P-RVP-ITE board-specific configuration */

/*
 * Declare symbolic names for all the GPIOs that we care about.
 * Note: Those with interrupt handlers must be declared first.
 */

IOEX(DSW_PWROK, EXPIN(0, PCA9535_PORT1, PCA9535_IO_PIN7), GPIO_OUT_LOW)
IOEX(SYS_PWROK, EXPIN(0, PCA9535_PORT1, PCA9535_IO_PIN6), GPIO_OUT_LOW)
IOEX(SYS_RST, EXPIN(0, PCA9535_PORT1, PCA9535_IO_PIN5), GPIO_OUT_HIGH)
IOEX(PM_PWR_BTN, EXPIN(0, PCA9535_PORT1, PCA9535_IO_PIN4), GPIO_OUT_HIGH)
IOEX(PCH_WAKE, EXPIN(0, PCA9535_PORT1, PCA9535_IO_PIN3), GPIO_OUT_HIGH)
IOEX(EN_PP3300_A, EXPIN(0, PCA9535_PORT1, PCA9535_IO_PIN2), GPIO_OUT_LOW)
IOEX(PM_RSMRST, EXPIN(0, PCA9535_PORT1, PCA9535_IO_PIN1), GPIO_OUT_LOW)

GPIO(SLP_S0, PIN(D, 4), GPIO_INPUT)
GPIO(SLP_S3, PIN(F, 2), GPIO_INPUT)
GPIO(SLP_S4, PIN(F, 3), GPIO_INPUT)
GPIO(AC_PRESENT, PIN(K, 3), GPIO_INPUT)
GPIO(PLT_RST, PIN(H, 6), GPIO_INPUT)
GPIO(POWER_BTN, PIN(E, 4), GPIO_INPUT)
GPIO(RSMRST_PWRGD, PIN(F, 1), GPIO_INPUT)
GPIO(ALL_SYS_PWRGD, PIN(F, 0), GPIO_INPUT)

GPIO(SMB_BS_CLK, PIN(C, 1), GPIO_INPUT) /* I2C_B_SCL */
GPIO(SMB_BS_DATA, PIN(C, 2), GPIO_INPUT) /* I2C_B_SDA */

ALTERNATE(PIN_MASK(C, BIT(1) | BIT(2)), GPIO_ALT_FUNC_DEFAULT, MODULE_I2C,
	  GPIO_FLAG_NONE) /* I2C B SCL/SDA C1/C2 */
ALTERNATE(PIN_MASK(B, BIT(0) | BIT(1)), GPIO_ALT_FUNC_DEFAULT, MODULE_UART,
	  GPIO_FLAG_NONE) /* UART1 B0/B1 */

UNIMPLEMENTED(WP_L)
UNIMPLEMENTED(ENTERING_RW)
UNIMPLEMENTED(SLP_S5)

GPIO_INT(ESPI_RESET_L, PIN(D, 2), GPIO_INT_FALLING | GPIO_SEL_1P8V,
	 espi_reset_pin_asserted_interrupt) /* eSPI_reset# */
UNIMPLEMENTED(PCH_WAKE_L)

      "writtenOn": "2022-09-09T23:54:38Z",
      "side": 1,
      "message": "what needs to change here? i is iterating through 0..caps_count and caps count is already included in the array element?",
      "parentUuid": "5b2b4fa1_1d676d78",
      "range": {
        "startLine": 2315,

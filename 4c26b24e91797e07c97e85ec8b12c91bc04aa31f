      "lineNbr": 651,
      "author": {
        "id": 1117279
      },
      "writtenOn": "2016-08-17T21:49:50Z",
      "side": 1,
      "message": "\"update\" by not changing it is confusing to me.",
      "parentUuid": "bb944b51_662872e8",
      "range": {
        "startLine": 651,
        "startChar": 53,
        "endLine": 651,
        "endChar": 62
      },
      "revId": "4c26b24e91797e07c97e85ec8b12c91bc04aa31f",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },
    {
      "key": {

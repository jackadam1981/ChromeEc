    {
      "key": {
        "uuid": "bb944b51_3bea0302",
        "filename": "common/btle_ll.c",
        "patchSetId": 2
      },
      "lineNbr": 651,
      "author": {
        "id": 1117279
      },
      "writtenOn": "2016-08-17T20:04:23Z",
      "side": 1,
      "message": "I would expect that we would not call this function if rx_rv !\u003d EC_SUCCESS",
      "range": {
        "startLine": 651,
        "startChar": 53,
        "endLine": 651,
        "endChar": 62
      },
      "revId": "4c26b24e91797e07c97e85ec8b12c91bc04aa31f",

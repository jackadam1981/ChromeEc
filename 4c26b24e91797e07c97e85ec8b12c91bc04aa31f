    {
      "key": {
        "uuid": "bb944b51_bb8a730f",
        "filename": "common/btle_ll.c",
        "patchSetId": 2
      },
      "lineNbr": 639,
      "author": {
        "id": 1156614
      },
      "writtenOn": "2016-08-17T19:37:17Z",
      "side": 1,
      "message": "This isn\u0027t something that should be called outside of this file. Do you mean to put the headers up at the top of the file? Like \"uint8_t is_repeated_packet(struct ble_pdu *packet);\" ?",
      "parentUuid": "bb944b51_327f880d",
      "revId": "4c26b24e91797e07c97e85ec8b12c91bc04aa31f",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

      },
      "lineNbr": 8709,
      "author": {
        "id": 1441652
      },
      "writtenOn": "2026-02-10T07:38:17Z",
      "side": 1,
      "message": "`data` is `uint8_t` array, so it doesn\u0027t need to be aligned. Do you think the compiler can emit better code if the array is aligned, e.g. when copying data?",
      "parentUuid": "90407c14_39032011",
      "range": {
        "startLine": 8708,
        "startChar": 0,
        "endLine": 8709,
        "endChar": 42
      },
      "revId": "64f3d8d82c753f39d8a1f25a6b7c44724cbdab27",

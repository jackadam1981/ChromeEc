    {
      "key": {
        "uuid": "a74c9bb3_37ebd100",
        "filename": "chip/g/dcrypto/aes_cmac.c",
        "patchSetId": 1
      },
      "lineNbr": 120,
      "author": {
        "id": 1264944
      },
      "writtenOn": "2018-03-28T12:30:30Z",
      "side": 1,
      "message": "I wasn\u0027t sure which mode to use--the RFC doesn\u0027t say--but it seems like not reinitializing every iteration gives me incorrect answers and every mode gives the same result for one call. So as far as I can tell, it doesn\u0027t matter what mode we use, but this should probably pass under the eye of someone familiar with AES.",
      "parentUuid": "9e66a1fb_693a42ed",
      "range": {
        "startLine": 119,
        "startChar": 0,
        "endLine": 120,
        "endChar": 2
      },
      "revId": "599bfa777053ed93db64d27930f0fd4b49d819d1",

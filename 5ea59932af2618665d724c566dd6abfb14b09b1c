        "id": 1000016
      },
      "writtenOn": "2017-12-13T10:07:57Z",
      "side": 1,
      "message": "Smart battery gas gauge already have an integrated function to integrate the current over the last, ie AverageCurrent() [0x0b].\nIt\u0027s likely giving a more accurate result than half-frequently polling the instantaneous value.",
      "range": {
        "startLine": 294,
        "startChar": 0,
        "endLine": 294,
        "endChar": 31
      },
      "revId": "5ea59932af2618665d724c566dd6abfb14b09b1c",

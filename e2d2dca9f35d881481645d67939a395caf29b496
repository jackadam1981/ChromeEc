      "side": 1,
      "message": "is this still a recommended module? if so, it nicely nukes my gLinux updates as of recently, and we should probably recommend people update their sources",
      "revId": "e2d2dca9f35d881481645d67939a395caf29b496",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

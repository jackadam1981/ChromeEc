      "writtenOn": "2025-01-02T16:15:42Z",
      "side": 1,
      "message": "how do these pointer resources get cleaned up? Are they passed back into the FFI layer?",
      "range": {
        "startLine": 100,
        "startChar": 39,
        "endLine": 100,
        "endChar": 55
      },
      "revId": "25d07fbc0d0423f3986a705337b99790d9a8a687",

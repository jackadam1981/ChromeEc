      "writtenOn": "2016-11-09T21:10:05Z",
      "side": 1,
      "message": "What happens if the tick counter wraps before 0xffffffff?",
      "range": {
        "startLine": 123,
        "startChar": 8,
        "endLine": 123,
        "endChar": 43
      },
      "revId": "61256ad925d058a2470fe761844d55f483f5b8c9",

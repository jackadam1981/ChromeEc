    {
      "unresolved": true,
      "key": {
        "uuid": "78a9e5e4_9bf7e000",
        "filename": "board/taeko/fw_config.c",
        "patchSetId": 9
      },
      "lineNbr": 46,
      "author": {
        "id": 1190764
      },
      "writtenOn": "2021-09-17T23:21:54Z",
      "side": 1,
      "message": "the parade parts do not respond to I2C on first access because\nthey auto-sleep when I2C is idle.\nyou have to wake up the chip with an I2C read, then wait\n10ms, then issue the actual I2C read you\u0027re trying to perform.\n\nin addition to the 10ms wake-up delay, there\u0027s some time needed\nfor its firmware to boot. some registers don\u0027t read back correct\nvalues until the firmware is fully running.",
      "range": {
        "startLine": 46,
        "startChar": 6,
        "endLine": 46,
        "endChar": 15
      },
      "revId": "65f8612b5bb389b699fdf5be4d6cc9fa5e54d913",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

      "writtenOn": "2021-09-24T13:48:03Z",
      "side": 1,
      "message": "From \"PS8815 Application Note\", it defines I2C readable 10ms (at least) right after RST# is released.\n\nWhatever, I already move this I2C read after board_reset_pd_mcu.",
      "parentUuid": "753e6a7f_17a28164",
      "range": {
        "startLine": 42,
        "startChar": 42,
        "endLine": 42,
        "endChar": 43
      },
      "revId": "65f8612b5bb389b699fdf5be4d6cc9fa5e54d913",

      "writtenOn": "2026-01-15T17:31:25Z",
      "side": 1,
      "message": "Can you check the difference between `k_oops` and `k_panic`? I think `k_oops` may not necessarily be fatal, but I\u0027m not sure.",
      "range": {
        "startLine": 94,
        "startChar": 0,
        "endLine": 94,
        "endChar": 11
      },
      "revId": "bbc6e7d93923dec4052498e871c989622f050122",

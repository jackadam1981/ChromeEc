    {
      "key": {
        "uuid": "5b071d40_d1ccbbcd",
        "filename": "board/cr50/wp.c",
        "patchSetId": 5
      },
      "lineNbr": 369,
      "author": {
        "id": 1000039
      },
      "writtenOn": "2017-07-18T20:07:48Z",
      "side": 1,
      "message": "I am not sure this is the best way to do it: with this condition we\u0027d never be able to debug fwmp behavior using a DBG cr50 image.\n\nNote that transition from prod to DBG and back wipes out NVMEM anyways, so changing the image type on the cr50 will make sure that FWMP is not present.\n\nWe can always wipe out nvmem using a console command (or could add a specific command to the DBG image to erase FWMP if needed)",
      "range": {
        "startLine": 369,
        "startChar": 0,
        "endLine": 369,
        "endChar": 15
      },
      "revId": "0c063d65ae2cab0258ab9fab19756b1627bce1b5",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "1de8dad8_bea7cfba",
        "filename": "board/cr50/wp.c",
        "patchSetId": 5
      },
      "lineNbr": 369,
      "author": {
        "id": 1000187
      },
      "writtenOn": "2017-07-18T20:47:53Z",
      "side": 1,
      "message": "This is temporary for debugging on the Cr50 dev board.\n\nThe problem is that fwmp_allows_unlock defaults to 0, and is only set to 1 after TPM2_Startup is called.  Which never happens on a dev board.\n\nThe real fix is to read nvmem before TPM2_Startup.  But that\u0027s best done in a separate patch.",
      "parentUuid": "5b071d40_d1ccbbcd",
      "range": {
        "startLine": 369,
        "startChar": 0,
        "endLine": 369,
        "endChar": 15
      },
      "revId": "0c063d65ae2cab0258ab9fab19756b1627bce1b5",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

        "startLine": 378,
        "startChar": 12,
        "endLine": 378,
        "endChar": 27
      },
      "revId": "0c063d65ae2cab0258ab9fab19756b1627bce1b5",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true

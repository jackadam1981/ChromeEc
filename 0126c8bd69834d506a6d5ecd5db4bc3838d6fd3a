      "writtenOn": "2023-06-23T23:29:55Z",
      "side": 1,
      "message": "nit: do you mind using a variable (e.g. kblog_size)? It\u0027s frequently used.",
      "range": {
        "startLine": 1198,
        "startChar": 6,
        "endLine": 1198,
        "endChar": 31
      },
      "revId": "0126c8bd69834d506a6d5ecd5db4bc3838d6fd3a",

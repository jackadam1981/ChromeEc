      "writtenOn": "2014-09-24T22:05:27Z",
      "side": 1,
      "message": "Do we have to do it at every init? Won\u0027t we lose the host setting?",
      "revId": "7d40063d46aa9a8b6146355ee9be9db775af7f0d",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

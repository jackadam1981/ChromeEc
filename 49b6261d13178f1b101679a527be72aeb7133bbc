      "side": 1,
      "message": "Why do we assume it is disconnected and not debouncing? Why dont we just add || DEVICE_STATE_UNDETECTABLE to 165 or just do regular debouncing stuff after UNDETECTABLE?",
      "range": {
        "startLine": 155,
        "startChar": 4,

    {
      "key": {
        "uuid": "d8410661_e234d09e",
        "filename": "board/cr50/servo_state.c",
        "patchSetId": 4
      },
      "lineNbr": 155,
      "author": {
        "id": 1000187
      },
      "writtenOn": "2017-08-30T19:52:58Z",
      "side": 1,
      "message": "While we\u0027re debouncing for a second, we inhibit ECTX.\n\nIf servo was driving ECTX, and then isn\u0027t, that may be because servo just happens to be sending a 0-bit, so we want to debounce, and during that time, we want to block CCD from taking over ECTX.\n\nIf CCD was driving ECTX, and then isn\u0027t, then we want to give priority to CCD being able to reclaim ECTX, rather than blocking it for a whole second.\n\nThat is, \"undetectable\" is a sub-state of \"disconnected\", just as \"debouncing\" is a sub-state of \"connected\".",
      "parentUuid": "80e1d551_a989657b",

      },
      "writtenOn": "2016-03-23T21:46:13Z",
      "side": 1,
      "message": "The full SHA1 hash is an array of uint8_t. Casting this between uint32_t will work, but it can lead to misaligned accesses and isn\u0027t \"pure\" C. Can you use \"uint8_t sha[4]\" intead?",
      "range": {
        "startLine": 100,
        "startChar": 1,
        "endLine": 100,
        "endChar": 9
      },
      "revId": "5760325b7541a45a59f8619b95389f35b9f395a4",

      },
      "writtenOn": "2016-03-23T21:46:13Z",
      "side": 1,
      "message": "We also have to watch out for malicious configurations. What happens if I create four identical valid blocks, or multiple sets of valid blocks, or several copies of the same block all with different versions?",
      "range": {
        "startLine": 300,
        "startChar": 4,
        "endLine": 300,
        "endChar": 21
      },
      "revId": "5760325b7541a45a59f8619b95389f35b9f395a4",

      "writtenOn": "2016-07-21T09:16:40Z",
      "side": 1,
      "message": "If we make these just GPIO_OUT_LOW by default then the existing VBUS enable/disable code will work.  Otherwise we should pair this change with changes to usb_pd_policy.c to change the VBUS enable/disable behavior.",
      "range": {
        "startLine": 145,
        "startChar": 31,
        "endLine": 145,
        "endChar": 59
      },
      "revId": "204decd47cada11b48bf0ccbb48a8cb6547e7b3e",

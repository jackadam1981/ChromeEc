        "id": 1000187
      },
      "writtenOn": "2017-11-09T23:29:25Z",
      "side": 1,
      "message": "Won\u0027t we still watchdog reset if servo doesn\u0027t reset us in time?",
      "range": {
        "startLine": 734,
        "startChar": 1,
        "endLine": 736,
        "endChar": 3
      },
      "revId": "691964095feea2c08ab15becfc476107b586b091",

    {
      "key": {
        "uuid": "58814702_40b3e642",
        "filename": "chip/npcx/system.c",
        "patchSetId": 2
      },
      "lineNbr": 736,
      "author": {
        "id": 1123814
      },
      "writtenOn": "2017-11-10T01:00:58Z",
      "side": 1,
      "message": "Yes, That would happen if the external reset doesn\u0027t happen soon enough. What would be better for this case?",
      "parentUuid": "340c3965_8b1aec6a",
      "range": {
        "startLine": 734,
        "startChar": 1,
        "endLine": 736,
        "endChar": 3
      },
      "revId": "691964095feea2c08ab15becfc476107b586b091",

      "writtenOn": "2023-02-01T22:10:52Z",
      "side": 1,
      "message": "shouldn\u0027t we take now after we take the head? otherwise an interrupt could add to head after we take now, right?",
      "range": {
        "startLine": 454,
        "startChar": 55,
        "endLine": 456,
        "endChar": 31
      },
      "revId": "05ede497d67a8f3949b03822cb6f1b229cc82954",

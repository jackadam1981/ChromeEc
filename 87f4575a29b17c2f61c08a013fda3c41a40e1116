      },
      "writtenOn": "2022-10-19T16:51:53Z",
      "side": 1,
      "message": "What would be the consequences of doing this unconditionally?",
      "revId": "87f4575a29b17c2f61c08a013fda3c41a40e1116",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

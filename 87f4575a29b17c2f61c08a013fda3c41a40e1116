    {
      "unresolved": true,
      "key": {
        "uuid": "28f110e6_313c0628",
        "filename": "common/usbc/usbc_task.c",
        "patchSetId": 2
      },
      "lineNbr": 145,
      "author": {
        "id": 1305927
      },
      "writtenOn": "2022-10-19T16:51:53Z",
      "side": 1,
      "message": "This is somewhat outside the scope of this CL, but I think we have a reason for the overall order that these run in, and it would be nice to have a comment stating that. IIRC, the idea is that if we receive a message, we can at least start to react to it during this cycle, and if we decide to send one, we can get it on the wire during this cycle. Diana might be aware of some nuance I\u0027m missing.",
      "revId": "87f4575a29b17c2f61c08a013fda3c41a40e1116",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "34f6e00e_73ad998e",
        "filename": "include/usb_pd_dpm.h",
        "patchSetId": 2
      },
      "lineNbr": 50,

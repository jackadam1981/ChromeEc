      "message": "Currently, our root of trust is RO FW. Would this break the trust chain?",
      "range": {
        "startLine": 9,
        "startChar": 64,
        "endLine": 10,
        "endChar": 14
      },
      "revId": "34eb2d9152a481c25a94832bcba965a9172a2cd6",

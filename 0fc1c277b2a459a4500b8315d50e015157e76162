      "side": 1,
      "message": "H1 shouldn\u0027t disconnect as we set `rddkeepalive` when servod starts up.",
      "parentUuid": "e4205193_041ee75b",
      "revId": "0fc1c277b2a459a4500b8315d50e015157e76162",

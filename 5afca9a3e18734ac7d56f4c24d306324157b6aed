      "writtenOn": "2018-06-19T17:34:22Z",
      "side": 1,
      "message": "Everytime TPM_RST_L is asserted we should reset tpm_mode.",
      "range": {
        "startLine": 44,
        "startChar": 1,
        "endLine": 44,
        "endChar": 11
      },
      "revId": "5afca9a3e18734ac7d56f4c24d306324157b6aed",

    {
      "key": {
        "uuid": "3aedaf0a_4a0d146d",
        "filename": "board/cr50/tpm2/tpm_mode.c",
        "patchSetId": 1
      },
      "lineNbr": 44,
      "author": {
        "id": 1283719
      },
      "writtenOn": "2018-06-20T01:28:05Z",
      "side": 1,
      "message": "TPM_RST_L interrupt will call deferred_tpm_rst_isr(), then tpm_reset_request(). This will set TPM_EVENT_RESET, and on this event, TPM task will call tpm_reset_now().\ntpm_reset_now() cleans up () the memory region from __bss_libtpm2_start to __bss_libtpm2_end, where s_tpm_mode is located.",
      "parentUuid": "704b229e_f48c3813",
      "range": {
        "startLine": 44,
        "startChar": 1,
        "endLine": 44,
        "endChar": 11
      },
      "revId": "5afca9a3e18734ac7d56f4c24d306324157b6aed",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

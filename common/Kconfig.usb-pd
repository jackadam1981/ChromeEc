config USB_PD_5V_EN_ACTIVE_LOW
	bool "Define if VBUS source GPIOs are active-low"
	help
	  Define if VBUS source GPIOs (GPIO_USB_C*_5V_EN) are active-low (and named
	  (..._L) rather than default active-high.

config USB_PD_5V_CHARGER_CTRL
	bool "Ask charger if VBUS is enabled on a source port, instead of using GPIO"

config USB_PD_5V_EN_CUSTOM
	bool "use a custom function to determine if VBUS is enabled"
	help
	  If defined, use a custom function to determine if VBUS is enabled on a
	  source port. The custom function is board_is_sourcing_vbus(port).

config USB_PD_DYNAMIC_SRC_CAP
	bool "Dynamic USB PD source capability"


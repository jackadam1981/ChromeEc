	bool "Define to have a fixed PD Task debug level"
	help
	  Define to have a fixed PD Task debug level.
	  Undef to allow runtime change via console command.

config USB_PD_DISCHARGE
	bool "Define if this board can enable VBUS discharge"
	help
	  Define if this board can enable VBUS discharge (eg. through a GPIO-controlled
	  discharge circuit, or through port controller registers) to discharge VBUS
	  rapidly on disconnect. Will be defined automatically when one of the below
	  options is defined.

config USB_PD_DISCHARGE_GPIO
	bool "Define if discharge circuit is EC GPIO-controlled"
	select USB_PD_DISCHARGE

config USB_PD_DISCHARGE_TCPC
	bool "Define if discharge circuit is using PD discharge registers on TCPC"
	select USB_PD_DISCHARGE

config USB_PD_DISCHARGE_PPC
	bool "Define if discharge circuit is using PD discharge registers on PPC"
	select USB_PD_DISCHARGE

config USB_PD_DUAL_ROLE
	bool "Define if this board can act as a dual-role PD port (source and sink)"

config USB_PD_DUAL_ROLE_AUTO_TOGGLE
	bool "Define if this board can used TCPC-controlled DRP toggle"

config BD9995X_DELAY_INPUT_PORT_SELECT
	bool "Define to reduces VBUS droop caused by inrush current during charging"


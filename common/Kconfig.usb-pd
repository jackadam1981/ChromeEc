	bool "Support USB PD flash"

config USB_PD_FLASH_ERASE_CHECK
	bool "Check whether PD is the sole power source before flash erase operation"

config USB_PD_GIVE_BACK
	bool "Define if this board, operating as a sink, can give power back to a source"

config USB_PD_REV30
	bool "Enable USB PD Rev3.0 features"


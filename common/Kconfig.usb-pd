	bool "Type-C multi-protocol retimer to be used in on-board applications"
	select USB_PD_RETIMER

# move this to Kconfig.cmd?
config USB_PD_TCPM_ANX7447_OCM_ERASE_COMMAND
	bool "Adds an EC console command to erase the ANX7447 OCM flash"
	help
	  Adds an EC console command to erase the ANX7447 OCM flash.
	  Note: this is intended to be a temporary option and
	  won't be needed when ANX7447 are put on boards with OCM already erased

config USB_PD_TCPM_MUX
	bool "support 18h CONFIG_STANDARD_OUTPUT register"
	help
	  Use this option if the TCPC port controller supports the optional register
	  18h CONFIG_STANDARD_OUTPUT to steer the high-speed muxes.

choice
	prompt "TCPM VBUS detection"
	default USB_PD_VBUS_DETECT_NONE
	help
	  The TCPM must know whether VBUS is present in order to make proper state
	  transitions. In addition, charge_manager must know about VBUS presence in
	  order to make charging decisions. VBUS state can be determined by various
	  methods:
	  - Some TCPCs can detect and report the presence of VBUS.
	  - In some configurations, charger ICs can report the presence of VBUS.
	  - On some boards, dedicated VBUS interrupt pins are available.
	  - Some power path controllers (PPC) can report the presence of VBUS.

	  Exactly one of these should be defined for all boards that run the PD
	  state machine.

config USB_PD_VBUS_DETECT_TCPC
	bool "USB_PD_VBUS_DETECT_TCPC"
config USB_PD_VBUS_DETECT_CHARGER
	bool "USB_PD_VBUS_DETECT_CHARGER"
config USB_PD_VBUS_DETECT_GPIO
	bool "USB_PD_VBUS_DETECT_GPIO"
config USB_PD_VBUS_DETECT_PPC
	bool "USB_PD_VBUS_DETECT_PPC"
config USB_PD_VBUS_DETECT_NONE
	bool "USB_PD_VBUS_DETECT_NONE"

endchoice

config USB_PD_VBUS_MEASURE_ADC_EACH_PORT
	bool "Define if the there is a separate ADC channel for each USB-C Vbus voltage"

config USB_PD_VBUS_MEASURE_NOT_PRESENT
	bool "Define if the there is no hardware to measure Vbus voltage"

config TCPC_I2C_BASE_ADDR_FLAGS
       prompt "Define the type-c port controller I2C base address"
       hex
       default 0x4E

config USB_PD_TRY_SRC
	bool "Use this option to enable Try.SRC mode for Dual Role devices"

config USB_PD_TRY_SRC_MIN_BATT_SOC
	prompt "Set the default minimum battery percentage for Try.Src to be enabled"
	int
	default 1

config USB_PD_RESET_MIN_BATT_SOC__yn
	bool "Select the minimum battery percentage"

if USB_PD_RESET_MIN_BATT_SOC__yn
config USB_PD_RESET_MIN_BATT_SOC
	prompt "Minimum battery percentage"
	int
	help
	  Set the minimum battery percentage to allow a PD port to send resets as a
	  sink (and risk a hard reset, losing Vbus).  Note this may cause a high-power
	  charger to appear as only a low-power 15W charger until a reset is sent to
	  re-start PD negotiation.
endif

config USB_PD_TX_PHY_ONLY
	bool "Alternative configuration keeping only the TX part of PHY"

config PD_USE_DAC_AS_REF
	bool "Use DAC as reference for comparator at 850mV."

config USB_TYPEC_VPD
	bool "Type-C VCONN Powered Device"

config USB_TYPEC_CTVPD
	bool "Type-C Charge Through VCONN Powered Device"

config _USB_TYPEC_DRP_ACC_TRYSRC
	bool "Type-C DRP with Accessory and Try.SRC"

config USB_PID
	bool "USB Product ID"

#menu "USB_PD_PULLUP choice"
#	prompt "Default pull-up value on the USB-C ports when they are used as source"
#	default TYPEC_RP_1A5

config USB_PD_MAX_SINGLE_SOURCE_CURRENT
	bool "Override the pull-up value"
	help
	  Override the pull-up value when only zero or one port is actively sourcing
	  current and we can advertise more current than what is defined by
	  `CONFIG_USB_PD_PULLUP`.
	  Should be defined with one of the tcpc_rp_value.

config USB_PD_MAX_TOTAL_SOURCE_CURRENT__yn
	bool "Select total current the board can supply"

if USB_PD_MAX_TOTAL_SOURCE_CURRENT__yn
config USB_PD_MAX_TOTAL_SOURCE_CURRENT
	prompt "Total current in mA the board can supply"
	int
	help
	  Total current in mA the board can supply to external devices through
	  USB-C ports

	  When a sink device is plugged or unplugged, source current redistribution
	  occurs. If this macro is defined, redistribution occurs in such a way
	  that there is no current drop (e.g. 3A -> 1.5A) on active source ports.
endif

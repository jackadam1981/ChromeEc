if CHARGER_BD9995X

config CHARGER_BD9995X_CHGEN
	bool "Enable the CHG_EN at initialization"
	help
	  Enable the CHG_EN at initialization to turn-on the BGATE which allows voltage
	  to be applied to the battery PACK & wakes the battery if it is in shipmode.

config BD9995X_POWER_SAVE_MODE
	bool "BD9995X Power Save Mode"
	help
	  Which power save mode should the charger enter when VBUS is removed.  Check
	  driver/bd9995x.h for the power save settings.  By default, no power save mode
	  is enabled.

config CHARGER_BATTERY_TSENSE
	bool "battery temp sensor support"
	help
	  If the battery temperature sense pin is connected to charger,
	  get the battery temperature from the charger.

endif

if (CHARGER_BQ25890 || CHARGER_BQ25892 || CHARGER_BQ25895)

config CHARGER_BQ2589X_IR_COMP
	bool "BQ2589x IR Compensation settings"
	help
	  Should be the combination of BQ2589X_IR_TREG_xxxC, BQ2589X_IR_VCLAMP_yyyMV
	  and  BQ2589X_IR_BAT_COMP_zzzMOHM.

config CHARGER_BQ2589X_BOOST
	bool "BQ2589x 5V boost current limit and voltage"
	help
	  Should be the combination of BQ2589X_BOOSTV_MV(voltage) and
	  BQ2589X_BOOST_LIM_xxxMA.

config CHARGER_TERM_CURRENT_LIMIT
	int "Board specific charging current termination limit"
	help
	  Board specific charging current termination limit, in mA.  If defined and
	  charger supports setting termination current it should be set during charger
	  init.

	  TODO(tbroch): Only valid for bq2589x currently.  Configure defaults for other
	  charger ICs that support termination currents.

endif

if CHARGER_MT6370

config CHARGER_MT6370_BACKLIGHT
	bool "CHARGER_MT6370_BACKLIGHT"
	help
	  MT6370 backlight control settings.
	  If defined, Panel backlight power is controlled by MT6370.

config CHARGER_MT6370_BC12_GPIO
	bool "MT6370 BC1.2 USB-PHY control"
	help
	  If defined, USB-PHY connection is controlled by GPIO_BC12_DET_EN.
	  Assert GPIO_BC12_DET_EN to detect BC1.2 device, and deassert
	  GPIO_BC12_DET_EN to mux USB-PHY back.

endif

if CHARGER_BQ25710

config CHARGER_BQ25710_IDCHG_LIMIT_MA
	bool "Enable IDCHG trigger for prochot"
	help
	  This config option is used to enable IDCHG trigger for prochot. This macro
	  should be set to the desired current limit to draw from the battery before
	  triggering prochot. Note that is has a 512 mA granularity. The function that
	  sets the limit will mask of the lower 10 bits. For this check to be active
	  the bq25710 must be in performance mode and this config option is also used
	  to keep the bq25710 in performance mode when the AP is in S0.

endif

# there seem to be no references to this

config CHARGER_CURRENT_LIMIT__yn
	bool "Select CHARGER_CURRENT_LIMIT"
config CHARGER_CURRENT_LIMIT
	int "CHARGER_CURRENT_LIMIT"
	depends on CHARGER_CURRENT_LIMIT__yn
	help
	  Board specific charging current limit, in mA.  If defined, the charge state
	  machine will not allow the battery to request more current than this.

config CHARGER_PSYS
	bool "System power monitor PSYS function"
	help
	  Enable/disable system power monitor PSYS function: this enables output
	  from charger chip to SoC.

config CHARGER_PSYS_READ
	bool "Enable reading PSYS"
	select CHARGER_PSYS if (CHARGER_ISL9237 || CHARGER_ISL9238)
	help
	  Enable reading PSYS (system power) value, either via "psys" console command,
	  or via charger_get_system_power function.

config CHARGER_DISCHARGE_ON_AC
	bool "Discharge on AC"
	help
	  Board supports discharge mode.  In this mode, the battery will discharge
	  even if AC is present.  Used for testing.

config CHARGER_DISCHARGE_ON_AC_CUSTOM
	bool "Board has a custom discharge mode"

config CHARGER_ILIM_PIN_DISABLED
	bool "disable external ILIM pin"
	help
	  Board specific flag used to disable external ILIM pin used to determine input
	  current limit. When defined, the input current limit is decided only by
	  the software register value.

config CHARGER_INPUT_CURRENT__yn
	bool "Select CHARGER_INPUT_CURRENT"
config CHARGER_INPUT_CURRENT
	int "Default input current for the board, in mA"
	depends on CHARGER_INPUT_CURRENT__yn
	help
	  Default input current for the board, in mA.  Many boards also use this as the
	  least maximum input current during transients.

	  This value should depend on external power adapter, designed charging
	  voltage, and the maximum power of the running system. For type-C chargers,
	  this should be set to 512 mA in order to not brown-out low-current USB
	  charge ports in accordance with USB-PD r3.0 Sec. 7.3

menu "Power thresholds for AP boot"


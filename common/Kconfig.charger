	bool "CHARGER_MIN_POWER_MW_FOR_POWER_ON"
	help
	  Default: 15000
config CHARGER_MIN_POWER_MW_FOR_POWER_ON
	int "CHARGER_MIN_POWER_MW_FOR_POWER_ON"
	depends on CHARGER_MIN_POWER_MW_FOR_POWER_ON__yn


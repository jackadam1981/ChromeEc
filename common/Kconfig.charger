	int "CHARGER_MIN_POWER_MW_FOR_POWER_ON_WITH_BATT"
	depends on CHARGER_MIN_POWER_MW_FOR_POWER_ON_WITH_BATT__yn

#config CHARGER_MIN_BAT_PCT_IMBALANCED_POWER_ON__yn
#	bool "Select CHARGER_MIN_BAT_PCT_IMBALANCED_POWER_ON"
#	help
#	  Minimum battery percentage for power on with an imbalanced pack
config CHARGER_MIN_BAT_PCT_IMBALANCED_POWER_ON
	int "Minimum battery percentage for power on with an imbalanced pack"
	range 0 100
	default 5
#	depends on CHARGER_MIN_BAT_PCT_IMBALANCED_POWER_ON__yn
	help
	  The function of MEASURE_BATTERY_IMBALANCE and these variables is to prevent a
	  battery brownout when the management IC reports a state of charge that is
	  higher than CHARGER_MIN_BAT_PCT_FOR_POWER_ON, but an individual cell is lower
	  than the rest of the pack.  The critical term is MAX_IMBALANCE_MV, which must
	  be small enough to ensure that the system can reliably boot even when the
	  battery total state of charge barely passes the
	  CHARGER_MIN_BAT_PCT_FOR_POWER_ON threshold.

	  Lowering CHARGER_MIN_BAT_PCT_IMBALANCED_POWER_ON below
	  CHARGER_MIN_BAT_PCT_FOR_POWER_ON disables this check.  Raising it too high
	  may needlessly prevent boot when the lowest cell can still support the
	  system.

	  As this term is lowered and BATTERY_MAX_IMBALANCE_MV is raised, the risk of
	  cell-undervoltage brownout during startup increases.  Raising this term and
	  lowering MAX_IMBALANCE_MV increases the risk of poor UX when the user must
	  wait longer to turn on their device.

config BATTERY_MAX_IMBALANCE_MV
	int "Maximum battery cell imbalance in millivolts"
	default 200
	help
	  Maximum battery cell imbalance to accept before considering the pack to be
	  imbalanced, in millivolts.

	  WAG.  Imbalanced battery packs in this situation appear to have balanced
	  charge very quickly after beginning the charging cycle, since dV/dQ rapidly
	  decreases as the cell is charged out of deep discharge.  Increasing the value
	  of CHARGER_MIN_BAT_PCT_IMBALANCED_POWER_ON will make a system tolerant of
	  larger values of BATTERY_MAX_IMBALANCE_MV.

# Low energy thresholds - when battery level is below BAT_PCT and an external
# charger provides less than CHG_MW of power, inform the AP of the situation
# through the LIMIT_POWER charge state parameter.  Depthcharge will hold off on
# the boot for up to 3 seconds while waiting for either condition to clear
# before starting the kernel.  This wait happens after sw sync in RW mode, so
# the firmware may set it high enough that PD negotiation is required to clear
# it.
# 
# Default: Disabled.  Depthcharge is immediately released to boot the kernel.
# 
# Setting this value to 15001 will require PD negotiation to be complete prior
# to releasing depthcharge.  During PD negotiation, the charger will be briefly
# reduced to about 2.5W for a few hundred ms.


config CHARGER_LIMIT_POWER_THRESH_CHG_MW__yn
	bool "Select CHARGER_LIMIT_POWER_THRESH_CHG_MW"
config CHARGER_LIMIT_POWER_THRESH_CHG_MW
	int "CHARGER_LIMIT_POWER_THRESH_CHG_MW"
	depends on CHARGER_LIMIT_POWER_THRESH_CHG_MW__yn

config CHARGER_LIMIT_POWER_THRESH_BAT_PCT__yn
	bool "Select CHARGER_LIMIT_POWER_THRESH_BAT_PCT"
config CHARGER_LIMIT_POWER_THRESH_BAT_PCT
	int "CHARGER_LIMIT_POWER_THRESH_BAT_PCT"
	range 0 100
	depends on CHARGER_LIMIT_POWER_THRESH_BAT_PCT__yn
	help
	  Default: CHARGER_MIN_BAT_PCT_FOR_POWER_ON
endmenu


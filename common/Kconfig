menuconfig MCMDS
	bool
	prompt "MCMDS"

comment "some commands"

menu "Console commands"
source "common/Kconfig.cmd"
endmenu

source "common/Kconfig.battery"

config PWM
	bool "Support PWM control"

config SOFTWARE_PANIC
	bool "Software panic"

	help
	  Store a panic log and halt the system for a software-related reasons, such as
	  stack overflow or assertion failure.

config SHA256_UNROLLED
	bool "Unroll some loops in SHA256_transform for better performance"

menu "Common Code"

config COMMON_PANIC_OUTPUT
	bool "Provide common core code to output panic information without interrupts"
	default y

config COMMON_GPIO
	bool "Provide the default GPIO abstraction layer"
	default y
	help
	  You want this unless you are doing a really tiny firmware.

config COMMON_GPIO_SHORTNAMES
	bool "Use short GPIO names"
	depends on COMMON_GPIO
	help
	  Provides smaller GPIO names to reduce flash size.  Instead of the 'name'
	  field in GPIO macro it will concat 'port' and 'pin' to reduce flash size.

config COMMON_RUNTIME
	bool "COMMON_RUNTIME"
	default y
	help
	  Provide common runtime layer code (tasks, hooks ...)
	  You want this unless you are doing a really tiny firmware.

config COMMON_TIMER
	bool "Provide common core code to handle the operating system timers"
	default y

endmenu

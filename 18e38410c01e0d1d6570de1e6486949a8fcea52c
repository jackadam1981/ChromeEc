      "writtenOn": "2023-12-14T18:31:23Z",
      "side": 1,
      "message": "This is an unfortunate name for this API call. It\u0027s only purpose is to trigger a read of the power level at some future time, and the actual power can be read via the GET_CONNECTOR_STATUS command.\n\nNOTE: Realtek is violating the spec by using the READ_POWER_LEVEL command to enable reading VBUS while operating in sink mode.",
      "parentUuid": "b73ebd4b_56a29a88",
      "range": {
        "startLine": 134,
        "startChar": 18,
        "endLine": 134,
        "endChar": 38
      },
      "revId": "18e38410c01e0d1d6570de1e6486949a8fcea52c",

      },
      "writtenOn": "2017-10-27T15:31:15Z",
      "side": 1,
      "message": "I think we should still require \u0027clear\u0027 to clear the password",
      "range": {
        "startLine": 1122,
        "startChar": 3,
        "endLine": 1122,
        "endChar": 50
      },
      "revId": "54f2f0ce80b5c5824fb54a826247ff41d373a247",

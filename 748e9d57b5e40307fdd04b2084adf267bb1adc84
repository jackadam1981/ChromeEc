    {
      "unresolved": true,
      "key": {
        "uuid": "d8bee5a7_b2230883",
        "filename": "zephyr/program/skywalker/skywalker/skywalker_vif.xml",
        "patchSetId": 1
      },
      "lineNbr": 124,
      "author": {
        "id": 1523797
      },
      "writtenOn": "2025-09-26T23:26:26Z",
      "side": 1,
      "message": "The OCP setting that the PDC advertises in its source PDO should be controlled by the Kconfig choice `PDC_POWER_MGMT_SRC_PDO_PEAK_OCP` (zephyr/subsys/pd_controller/Kconfig:47). Default is 100%. The PDO is defined near zephyr/subsys/pd_controller/pdc_power_mgmt.c:880\n\nHowever, I don\u0027t think 130% is one of the allowed options, so not sure what is going on here",
      "parentUuid": "f06e09e7_8e96a619",
      "range": {
        "startLine": 124,
        "startChar": 8,
        "endLine": 124,
        "endChar": 79
      },

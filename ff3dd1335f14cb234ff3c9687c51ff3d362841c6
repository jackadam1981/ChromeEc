      "writtenOn": "2021-06-28T20:52:36Z",
      "side": 1,
      "message": "You should add \"_MASK\" or \"_BIT\" to all the names in this file.  As is, these names conflict with the enums ec_mkbp_event and host_event_code.\n\nHowever, the compile time evaluation will differ whether a file includes ec_commands.h or this file.\n\nUsing the same name for both will likely confuse future developers.",
      "range": {
        "startLine": 22,
        "startChar": 0,
        "endLine": 22,
        "endChar": 39
      },
      "revId": "ff3dd1335f14cb234ff3c9687c51ff3d362841c6",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

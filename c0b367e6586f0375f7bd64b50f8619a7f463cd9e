      "writtenOn": "2021-12-09T02:33:50Z",
      "side": 1,
      "message": "Does this PPC support vSafe0V detection? This is a useful (required) feature to pass type-c functional cert testing.",
      "range": {
        "startLine": 270,
        "startChar": 11,
        "endLine": 270,
        "endChar": 34
      },
      "revId": "c0b367e6586f0375f7bd64b50f8619a7f463cd9e",

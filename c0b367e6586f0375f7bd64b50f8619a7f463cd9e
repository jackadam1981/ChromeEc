      },
      "lineNbr": 270,
      "author": {
        "id": 1479762
      },
      "writtenOn": "2021-12-09T18:10:58Z",
      "side": 1,
      "message": "KTU1125 doesn\u0027t support it, but from what I see vSafe0V detection is part of TCPC (Parade\u0027s PS8815 has is). Are you sure it should be part of PPC?",
      "parentUuid": "6e674500_04643172",
      "range": {
        "startLine": 270,
        "startChar": 11,
        "endLine": 270,
        "endChar": 34
      },
      "revId": "c0b367e6586f0375f7bd64b50f8619a7f463cd9e",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {

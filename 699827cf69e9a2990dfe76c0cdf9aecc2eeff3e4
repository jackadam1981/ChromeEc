    {
      "key": {
        "uuid": "f55d5f7d_b0fc1298",
        "filename": "chip/g/sps.c",
        "patchSetId": 22
      },
      "lineNbr": 228,
      "author": {
        "id": 1283719
      },
      "writtenOn": "2020-05-26T20:37:07Z",
      "side": 1,
      "message": "sps_register_rx_handler() shall be called when AP is on or off.\nI intend to disable GC_IRQNUM_TIMEHS0_TIMINT1 when AP is off.\n\nThe patch http://crrev.com/c/2202839 adds the matching call to enable the extension, below line 241.",
      "parentUuid": "387c3689_6e1a30ab",
      "range": {
        "startLine": 228,
        "startChar": 1,
        "endLine": 228,
        "endChar": 27
      },
      "revId": "699827cf69e9a2990dfe76c0cdf9aecc2eeff3e4",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

      "writtenOn": "2023-09-12T15:53:38Z",
      "side": 1,
      "message": "don\u0027t you need to `queue_remove_units` first before `rx_buffer` has data?",
      "range": {
        "startLine": 252,
        "startChar": 5,
        "endLine": 252,
        "endChar": 14
      },
      "revId": "a9d94b2c14aaacf4c432238f11d61b94dfd67794",

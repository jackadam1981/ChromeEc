    },
    {
      "unresolved": false,
      "key": {
        "uuid": "328997d9_60520e1a",
        "filename": "zephyr/dts/bindings/motionsense/driver/cros-ec,drv-bmi260-accel.yaml",
        "patchSetId": 2
      },
      "lineNbr": 6,
      "author": {
        "id": 1245946
      },
      "writtenOn": "2021-03-11T23:36:31Z",
      "side": 1,
      "message": "It\u0027s just there to distinguish between the driver information which is per sensor-type from a chip and the driver data which can be per the sernsor-type or per chip(sharing one data instance for all sensor type from the chip).\n\nFor short, drv prefix is for driver info, drvdata prefix is for driver data.\n\nAnyway, I\u0027ll remove it since we can still have drvdata for driver data.",
      "parentUuid": "119d464e_1cc23e23",
      "range": {
        "startLine": 6,
        "startChar": 21,
        "endLine": 6,
        "endChar": 25
      },
      "revId": "d26d642b3eb74deddc99b8ae05161a516171e544",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "a74858e8_cf17abeb",
        "filename": "zephyr/dts/bindings/motionsense/driver/drv-bmi260.yaml",

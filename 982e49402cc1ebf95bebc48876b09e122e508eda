        "id": 1103909
      },
      "writtenOn": "2014-12-29T15:55:04Z",
      "side": 1,
      "message": "do we have to run this every second? can\u0027t we just wait indefinitely until next interrupt (task_wait_event(-1))?",
      "range": {
        "startLine": 193,
        "startChar": 3,
        "endLine": 193,
        "endChar": 31
      },
      "revId": "982e49402cc1ebf95bebc48876b09e122e508eda",

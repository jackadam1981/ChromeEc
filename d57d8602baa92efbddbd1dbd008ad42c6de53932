      "writtenOn": "2021-08-13T15:42:59Z",
      "side": 1,
      "message": "Probably should use atomic_clear() for consistency with other writes to flags[].",
      "range": {
        "startLine": 366,
        "startChar": 0,
        "endLine": 366,
        "endChar": 17
      },
      "revId": "d57d8602baa92efbddbd1dbd008ad42c6de53932",

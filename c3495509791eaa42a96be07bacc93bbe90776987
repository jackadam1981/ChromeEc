    },
    {
      "unresolved": true,
      "key": {
        "uuid": "a4f63c7c_37b192d8",
        "filename": "zephyr/drivers/usbc/pdc_tps6699x.c",
        "patchSetId": 2
      },
      "lineNbr": 1513,
      "author": {
        "id": 1530058
      },
      "writtenOn": "2024-09-05T21:17:24Z",
      "side": 1,
      "message": "We only want to poll on the cmd register when we have sent a command and are waiting for a response from the PDC.  Having the thread wakeup every X ms for to run its state handler may hide issues within the driver itself.",
      "parentUuid": "d11d041f_daa45408",
      "range": {
        "startLine": 1513,
        "startChar": 13,
        "endLine": 1513,
        "endChar": 38

      "message": "SGTM.",
      "parentUuid": "cdea6851_dd8bde0b",
      "revId": "21cdc2db621214beffd8ad780f2d08e656518e12",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true

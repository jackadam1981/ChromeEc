      "side": 1,
      "message": "Can we just use a different enum mpu_region in mpu.h, instead of trying to look for an available region at runtime?",
      "revId": "21cdc2db621214beffd8ad780f2d08e656518e12",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

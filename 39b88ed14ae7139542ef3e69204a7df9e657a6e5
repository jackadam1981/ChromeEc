      "author": {
        "id": 1520327
      },
      "writtenOn": "2023-11-29T03:00:40Z",
      "side": 1,
      "message": "Even if there is match, the templates need to be locked. Because no matter what happens in this match, the next match should require the label seed again.",
      "parentUuid": "7a5302a5_889862af",
      "range": {
        "startLine": 169,
        "startChar": 2,
        "endLine": 169,
        "endChar": 30
      },
      "revId": "39b88ed14ae7139542ef3e69204a7df9e657a6e5",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

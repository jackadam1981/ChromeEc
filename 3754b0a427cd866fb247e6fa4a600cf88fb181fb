    {
      "key": {
        "uuid": "f9c4b462_3ebe6d51",
        "filename": "chip/stm32/usb_console.c",
        "patchSetId": 14
      },
      "lineNbr": 148,
      "author": {
        "id": 1001139
      },
      "writtenOn": "2014-07-16T00:36:10Z",
      "side": 1,
      "message": "__tx_char only queues the data to USB buffer but doesn\u0027t actually send it out. We only need to make sure the buffer is available before starting to write to it. If usb_wait_console is moved to __tx_char, it\u0027ll be called many more times for cputs() and cprintf() calls.",
      "parentUuid": "d9c1b053_57c30ed0",
      "revId": "3754b0a427cd866fb247e6fa4a600cf88fb181fb",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "f9c4b462_b8d0d58b",

        "id": 1305927
      },
      "writtenOn": "2024-09-24T18:35:09Z",
      "side": 1,
      "message": "I\u0027m not sure either if sending a 20V/0A PDO violates the spec, but I\u0027m highly confident that drawing current for a hypothetical 20V/0A PDO _would_ violate the spec, so I think being extra cautious here is correct.",
      "parentUuid": "617ba21e_d7bfdbc1",
      "revId": "fdbd5e867e12e4fe6d5964b7905c54d9bfe60c26",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

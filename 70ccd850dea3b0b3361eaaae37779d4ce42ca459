      "writtenOn": "2022-08-02T00:58:52Z",
      "side": 1,
      "message": "The same thing applies as on the lower block: I prefer to keep this in the same file so it\u0027s easier to reason about how sub-board configuration varies.",
      "parentUuid": "ae40f8ef_a3164c06",
      "revId": "70ccd850dea3b0b3361eaaae37779d4ce42ca459",

    },
    {
      "unresolved": false,
      "key": {
        "uuid": "8c5e369b_d1414dd8",
        "filename": "util/mchp/crisis_rcvry_util.py",
        "patchSetId": 1
      },
      "lineNbr": 245,
      "author": {
        "id": 1577857
      },
      "writtenOn": "2023-12-12T12:31:12Z",
      "side": 1,
      "message": "No, we are covering those failure response and end with script termination.\n\nwe have below failure responses\n\"CRC Failure\"\n\"Illegal Payload Length\"\n\"Illegal HEADER Offset\"\n\"Illegal HEADER Format,\"\n\"SPI FLASH Access Error,\" and\n\"Illegal FLASH Length\"\n\nImplemented a retry logic exclusively for \"CRC Failure\" among the listed failure responses. For the remaining failures, they are treated as non-recoverable errors, resulting in script termination.\n\nSo decided to update the comments in a generic manner (not to list all failure in the comments).",
      "parentUuid": "0fa164b1_f9e5dadb",
      "range": {
        "startLine": 243,
        "startChar": 0,

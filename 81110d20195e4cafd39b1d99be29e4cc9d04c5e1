      },
      "writtenOn": "2023-12-11T19:04:23Z",
      "side": 1,
      "message": "So was this a bug where we weren\u0027t catching failures? Do we have a buganizer issue for this?",
      "range": {
        "startLine": 259,
        "startChar": 19,
        "endLine": 259,
        "endChar": 22
      },
      "revId": "81110d20195e4cafd39b1d99be29e4cc9d04c5e1",

      },
      "lineNbr": 52,
      "author": {
        "id": 1153134
      },
      "writtenOn": "2023-08-01T08:23:19Z",
      "side": 1,
      "message": "Maybe we can read TP\u0027s report descriptor in usb_hid_tp_init() (TP\u0027s datasheet is required) and register hid device with that descriptor. So we don\u0027t need to hardcode these macros anymore?",
      "parentUuid": "f71fdc7c_6f114147",
      "range": {
        "startLine": 45,
        "startChar": 1,
        "endLine": 52,
        "endChar": 27
      },
      "revId": "c2744d8d7714c443c309dd71daf14c5283065152",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": false,

      "writtenOn": "2023-08-01T07:54:00Z",
      "side": 1,
      "message": "These dimensions need to be defined per-project. Either statically defined in device tree, or probe at runtime.\n\n(Historically we implement `report_desc` as a compile time constant because memory is very limited on Hammer. I think it\u0027s ok to put this on stack now?)",
      "range": {
        "startLine": 45,
        "startChar": 1,
        "endLine": 52,
        "endChar": 27
      },
      "revId": "c2744d8d7714c443c309dd71daf14c5283065152",

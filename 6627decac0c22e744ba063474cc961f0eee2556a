      "writtenOn": "2022-12-13T19:53:54Z",
      "side": 1,
      "message": "nit: I understand why it might make sense to use `enum ec_error_list` as a return type but it might make more sense to just return an `int` here so the prototype matches the standard `gettimeofday` function.",
      "range": {
        "startLine": 11,
        "startChar": 0,
        "endLine": 11,
        "endChar": 18
      },
      "revId": "6627decac0c22e744ba063474cc961f0eee2556a",

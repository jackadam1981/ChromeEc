      "writtenOn": "2022-08-09T10:32:46Z",
      "side": 1,
      "message": "May i know why you put the cps8x00_probe() into the cps8100_get_alert_info() but  cps8100_init()?",
      "range": {
        "startLine": 389,
        "startChar": 0,
        "endLine": 391,
        "endChar": 36
      },
      "revId": "9073ce7a162412b329ff059e423a9b0451332a48",

      "writtenOn": "2025-07-01T00:02:01Z",
      "side": 1,
      "message": "On WCL-RVP, these pins don\u0027t read properly unless the S5 rails are turned on to enable the pullups, so we cannot detect the cards as the EC powers up.\n\nIs this different on PTL-RVP?",
      "range": {
        "startLine": 58,
        "startChar": 2,
        "endLine": 60,
        "endChar": 4
      },
      "revId": "93e3946519c50b469810a1557d16a8f5dc714996",

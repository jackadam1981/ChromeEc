      "writtenOn": "2022-09-19T16:30:23Z",
      "side": 1,
      "message": "Hmm, I think we can change this to `$(BUILDCC_PREFIX)` and then you can specify `BUILDCC_PREFIX\u003d` when building.",
      "range": {
        "startLine": 5,
        "startChar": 28,
        "endLine": 7,
        "endChar": 24
      },
      "revId": "a61feb58f50eb882f77cfa0ab65caccd2f35fa74",

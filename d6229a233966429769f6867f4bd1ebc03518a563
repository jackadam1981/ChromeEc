      "unresolved": true
    },
    {
      "key": {
        "uuid": "07a6fe7d_0f32b99a",
        "filename": "common/aux_fw_chip_info.c",
        "patchSetId": 2
      },
      "lineNbr": 22,
      "author": {
        "id": 1302633
      },
      "writtenOn": "2019-05-06T19:41:46Z",
      "side": 1,
      "message": "Makes sense given that this whole support is controlled by a CONFIG item.\n\nOn the other hand, for variants like ampton which does not have TCPC FW update this weak definition helps. May be I can return 0 in the weak definition.",
      "parentUuid": "71dd9638_17d21909",
      "range": {
        "startLine": 18,
        "startChar": 0,
        "endLine": 22,
        "endChar": 1
      },
      "revId": "d6229a233966429769f6867f4bd1ebc03518a563",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

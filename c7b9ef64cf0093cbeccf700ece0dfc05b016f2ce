      "writtenOn": "2025-05-23T15:51:04Z",
      "side": 1,
      "message": "Delete all the GPIOs that are setup by rtk_power_signals.dtsi.\n\nITE brox defines these GPIOs because of a limitation with the tool that creates the generated.dtsi file.",
      "range": {
        "startLine": 35,
        "startChar": 0,
        "endLine": 37,
        "endChar": 4

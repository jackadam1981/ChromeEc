      "writtenOn": "2021-12-22T16:43:52Z",
      "side": 1,
      "message": "If cros-ec is case-insensitive, let\u0027s change firmware_ECUsbPorts to always use lower case then.",
      "parentUuid": "378910db_9723380a",
      "range": {
        "startLine": 20,

      "writtenOn": "2019-08-20T22:50:19Z",
      "side": 1,
      "message": "Your callback shouldn\u0027t be reading the raw gpio levels. The logic of switching to tablet mode is this sub-systems responsibility. \n\nYour listener should not care how the value of tablet mode is calculated, and should use tablet_get_mode() within the callback.",
      "parentUuid": "45df97f3_01b453e0",
      "range": {
        "startLine": 84,
        "startChar": 1,
        "endLine": 103,
        "endChar": 38
      },
      "revId": "de8b7c3a37ee67bb82d0717792ec118b6b9f1f37",

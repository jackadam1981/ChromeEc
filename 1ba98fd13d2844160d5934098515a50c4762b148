    {
      "key": {
        "uuid": "9b6e549b_49fb4c2d",
        "filename": "common/usb_pd_protocol.c",
        "patchSetId": 1
      },
      "lineNbr": 2303,
      "author": {
        "id": 1119124
      },
      "writtenOn": "2017-08-31T23:49:05Z",
      "side": 1,
      "message": "i don\u0027t think depthcharge should (or can) depend on a later\nreboot happening.  depthcharge doesn\u0027t have enough context\nto determine that.  we\u0027d probably have to reboot right after\nupdating the TCPCs - that seems like overkill.\n\nanother practical consideration is that we really want the\nTCPCs to be operational when we hand control off to the kernel.\nlinux most likely needs USB and PD to be operational, but that\nmay not be true if we\u0027ve had to shut down the TCPCs to\nupdate their firmware.",
      "parentUuid": "67bddb82_83bb78d6",
      "range": {
        "startLine": 2303,
        "startChar": 7,
        "endLine": 2303,
        "endChar": 22
      },
      "revId": "1ba98fd13d2844160d5934098515a50c4762b148",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },
    {
      "key": {

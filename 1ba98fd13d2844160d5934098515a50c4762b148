      "writtenOn": "2017-08-31T23:28:41Z",
      "side": 1,
      "message": "Why do we need to reset a tcpc here knowing the whole system will be rebooted later?",
      "parentUuid": "4c9dac7c_5c74a84a",
      "range": {
        "startLine": 2303,
        "startChar": 7,
        "endLine": 2303,
        "endChar": 22
      },
      "revId": "1ba98fd13d2844160d5934098515a50c4762b148",

      "writtenOn": "2023-12-01T17:24:18Z",
      "side": 1,
      "message": "No, because `dev` is passed from API (`zephyr/include/drivers/fingerprint.h`) which previously dereferences that pointer to get pointer to the function called, so if the `dev` was not correct, it would cause the crash earlier.",
      "parentUuid": "4aadfeec_5074dae8",
      "range": {
        "startLine": 38,
        "startChar": 33,
        "endLine": 38,
        "endChar": 44
      },
      "revId": "726c1c594b2240889e8ba591c7e7a03f37357ed2",

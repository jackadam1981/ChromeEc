      "author": {
        "id": 1124569
      },
      "writtenOn": "2016-04-25T08:50:06Z",
      "side": 1,
      "message": "Thanks, I don\u0027t see this in \"MI-1 TCPM Firmware Specification v0.32.pdf\". Can you release a newer version?",
      "parentUuid": "88656498_3d1079a5",
      "range": {
        "startLine": 90,
        "startChar": 24,
        "endLine": 90,
        "endChar": 45
      },
      "revId": "fdae003f396553fe79c9d5e0aa11b244c9fb2758",

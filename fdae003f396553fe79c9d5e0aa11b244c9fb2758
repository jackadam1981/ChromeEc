    {
      "key": {
        "uuid": "88656498_3d1079a5",
        "filename": "driver/tcpm/tcpci.c",
        "patchSetId": 5
      },
      "lineNbr": 90,
      "author": {
        "id": 1151775
      },
      "writtenOn": "2016-04-22T08:32:34Z",
      "side": 1,
      "message": "Yes, Anx7688 support Power status register with these following features:\nB0 Sinking VBUS   RO\nB1: VCONN Present RO\nB2: VBUS Present  RO\nB3: VBUS Present Detection Enabled RO\nB4: Sourcing VBUS              RO\nB5: Sourcing High Voltage      RO\nB6: TCPC Initialization Status RO\nB7: Debug Accessory Connected  RO (only register level support:\n             0b: No Debug Accessory connected \n             1b: Debug Accessory connected\n             Reflects the state of the DebugAccessoryConnected#                \n             Register is required but output is not required )",
      "parentUuid": "a801483f_2b95755e",
      "range": {
        "startLine": 90,
        "startChar": 24,
        "endLine": 90,
        "endChar": 45
      },
      "revId": "fdae003f396553fe79c9d5e0aa11b244c9fb2758",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

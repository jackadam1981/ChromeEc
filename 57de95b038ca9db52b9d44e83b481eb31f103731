      },
      "writtenOn": "2021-12-22T19:34:00Z",
      "side": 1,
      "message": "After rereading, I believe you are right.",
      "parentUuid": "cf9cda87_b96a2a29",
      "revId": "57de95b038ca9db52b9d44e83b481eb31f103731",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

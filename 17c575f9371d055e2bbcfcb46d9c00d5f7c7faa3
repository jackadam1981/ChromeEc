    {
      "key": {
        "uuid": "9582daf4_f5b68fe3",
        "filename": "driver/ioexpander_it8801.c",
        "patchSetId": 23
      },
      "lineNbr": 81,
      "author": {
        "id": 1113904
      },
      "writtenOn": "2019-08-20T23:00:20Z",
      "side": 1,
      "message": "And not just that, but it seems like we\u0027re hardcoding these to be ksos instead of gpios.\n\nIT8801_REG_GPIO00_KSO19 is actually an output that goes to EN_PP5000_USBC. I feel like this function should not touch anything that\u0027s not a keyboard pin.\nIT8801_REG_GPIO22_KSO21 is just a testpad (TP9146). I doubt it has to be a KSO ever.\nIT8801_REG_GPIO01_KSO18 is fine, that\u0027s actually a KSO that we use\nIT8801_REG_GPIO23_KSO20 is maybe fine, assuming we\u0027ll even use it uninverted. If we use it inverted we change it back to GPIO anyway 5 lines later.",
      "parentUuid": "6474ef26_2c44d69e",
      "range": {
        "startLine": 81,
        "startChar": 0,
        "endLine": 81,
        "endChar": 70
      },
      "revId": "17c575f9371d055e2bbcfcb46d9c00d5f7c7faa3",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

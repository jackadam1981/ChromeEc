      "writtenOn": "2019-08-19T22:10:31Z",
      "side": 1,
      "message": "Why are all these gpios pulled up now?",
      "range": {
        "startLine": 81,
        "startChar": 0,
        "endLine": 81,
        "endChar": 70
      },
      "revId": "17c575f9371d055e2bbcfcb46d9c00d5f7c7faa3",

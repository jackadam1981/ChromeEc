    {
      "key": {
        "uuid": "c2c1f56d_3c828b84",
        "filename": "board/servo_micro/board.c",
        "patchSetId": 4
      },
      "lineNbr": 188,
      "author": {
        "id": 1112784
      },
      "writtenOn": "2016-02-23T18:59:04Z",
      "side": 1,
      "message": "Because on the STM32F072 SPI2 defaults to using DMA channels 4 and 5, but our hard coded mapping of DMA usage in registers.h assumes that it will use channels 6 and 7.  So we remap the SPI2 peripheral DMA channels.  A better solution in the long run would be to completely remove the hard coded mapping in registers.h and configure each device driver with its DMA channels the way the new UART driver does.  That way each board could fully select how its DMA channels were used.",
      "range": {
        "startLine": 188,
        "startChar": 14,
        "endLine": 188,
        "endChar": 16
      },
      "revId": "b7871c60a36ec55eff456a456c4f46b77bb01afb",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

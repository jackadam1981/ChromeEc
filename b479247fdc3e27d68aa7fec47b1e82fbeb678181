        "id": 1149894
      },
      "writtenOn": "2019-11-12T18:37:22Z",
      "side": 1,
      "message": "After looking at the type-c spec, page 171, I don\u0027t think PR swap to source is allowed. Could you take a look? If this is the case, I\u0027ll remove the PR_SWAP code from the run state.",
      "parentUuid": "d900285d_9d7803ea",
      "range": {
        "startLine": 2138,
        "startChar": 1,
        "endLine": 2146,
        "endChar": 37
      },
      "revId": "b479247fdc3e27d68aa7fec47b1e82fbeb678181",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

      "writtenOn": "2019-11-13T19:20:17Z",
      "side": 1,
      "message": "Should we ignore CTVPD devices in this state?",
      "range": {
        "startLine": 2261,
        "startChar": 2,
        "endLine": 2280,
        "endChar": 3
      },
      "revId": "b479247fdc3e27d68aa7fec47b1e82fbeb678181",

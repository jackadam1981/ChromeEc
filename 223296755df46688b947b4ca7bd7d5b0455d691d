    },
    {
      "key": {
        "uuid": "eafac7b5_b91fd55f",
        "filename": "include/config.h",
        "patchSetId": 2
      },
      "lineNbr": 2277,
      "author": {
        "id": 1132339
      },
      "writtenOn": "2019-10-28T07:27:32Z",

    {
      "key": {
        "uuid": "70f817f1_f5023a76",
        "filename": "chip/npcx/ps2.c",
        "patchSetId": 3
      },
      "lineNbr": 67,
      "author": {
        "id": 1132339
      },
      "writtenOn": "2020-01-16T08:45:18Z",
      "side": 1,
      "message": "These four PS/2 channels in npcx chip share one PS/2 protocol hardware module (we called it Automatic Hardware Shift Mechanism, see section 4.8.4 in the datasheet.)\nShift Mechanism hardware is protected by the mutex ps2_lock to make sure only one task can use it at one time. Hence. we don\u0027t need the per-channel task_waiting.\n(The task_waiting is used in between mutex_lock and mutex_unlock.)",
      "parentUuid": "61919beb_01f2ba62",
      "range": {
        "startLine": 67,
        "startChar": 26,
        "endLine": 67,
        "endChar": 38
      },
      "revId": "a9af4356ee322061c03441a7c02d94faa6301816",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

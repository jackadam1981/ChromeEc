      "message": "Testing below code changes as per above comments to move in helper function.\n\n+#ifdef CONFIG_DPTF_FAIL_SAFE_OFFSET\n+static bool temp_sensor_read(uint8_t *mptr, int i)\n+{\n+\tint cur_temp, dptf_active_flag;\n+\n+\t/* get the current temp */\n+\tcur_temp \u003d *mptr + EC_TEMP_SENSOR_OFFSET + CONFIG_DPTF_FAIL_SAFE_OFFSET;\n+\n+\t/* if temperature is higher than temp_fan_max,assume DPTF is not active. */\n+\tdptf_active_flag \u003d (((thermal_params[i].temp_fan_max) \u0026\u0026 \n+\t\t\t\t(cur_temp \u003e thermal_params[i].temp_fan_max)) ? 0 : 1);\n+\n+\treturn dptf_active_flag;\n+}\n+static bool is_dptf_still_active(void)\n+{\n+\tint i;\n+\tuint8_t *mptr \u003d host_get_memmap(EC_MEMMAP_TEMP_SENSOR);\n+\n+\tfor (i \u003d 0; i \u003c TEMP_SENSOR_COUNT; i++, mptr++) {\n+\t\tif(!(temp_sensor_read(mptr, i)))\n+\t\t\treturn false;\t\n+\t}\n+\treturn true;\n+}\n+#endif",

    {
      "key": {
        "uuid": "a58513c4_1fddf6df",
        "filename": "driver/tcpm/anx7447.c",
        "patchSetId": 1
      },
      "lineNbr": 6,
      "author": {
        "id": 1269380
      },
      "writtenOn": "2018-03-13T11:21:31Z",
      "side": 1,
      "message": "ANX74xx and ANX7447 are two different chipsets.\nANX7447 is partly compliant with TCPCI. It does not support the registers specified as \"optional\" in the standard USB TCPC specification. For example, the standard spec uses the register 0x18 (CONFIG_STANDARD_OUTPUT Register) for MUX Control function (USB3.1, DP 4-Lanes, or USB3.1+DP 2-Lanes). Instead of supporting CONFIG-STANDARD_OUTPUT register, ANX7447 implements MUX Control function by another register sets (0x7E:0xB4 ~ 0xB6). So it needs a driver to control the setting of these registers.",
      "parentUuid": "6602a016_b7738bf7",
      "range": {
        "startLine": 6,
        "startChar": 24,
        "endLine": 6,
        "endChar": 26
      },
      "revId": "20d2cb6435f4186055b393a521a8301f5f6159fe",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

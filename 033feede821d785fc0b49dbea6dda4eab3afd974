        "filename": "common/usb_pd_protocol.c",
        "patchSetId": 1
      },
      "lineNbr": 2699,
      "author": {
        "id": 1111479
      },
      "writtenOn": "2016-10-12T07:22:23Z",
      "side": 1,
      "message": "When set_cc is called, its current code will stop auto-toggle.\nanx74xx\u0027s set_cc will enable CC Software Control.\ntcpci\u0027s set_cc will clear the DRP bit.",
      "parentUuid": "bcffee21_9ad59c11",
      "revId": "033feede821d785fc0b49dbea6dda4eab3afd974",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

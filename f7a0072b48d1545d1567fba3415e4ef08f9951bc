      "writtenOn": "2015-08-20T21:44:56Z",
      "side": 1,
      "message": "The race condition that you described is not possible due to the way the priorities are currently assigned. The chipset task which handles the transition to POWER_S5G3 state has a higher priority than the hook task that takes care of handling the power button press through the power_button_change_deferred() function once the power button press interrupt has been serviced.",
      "parentUuid": "e4dfcd21_81947c99",
      "range": {
        "startLine": 283,
        "startChar": 0,
        "endLine": 283,
        "endChar": 15
      },
      "revId": "f7a0072b48d1545d1567fba3415e4ef08f9951bc",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

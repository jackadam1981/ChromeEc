    {
      "key": {
        "uuid": "89e3266b_2f357ee3",
        "filename": "chip/ish/heci.c",
        "patchSetId": 19
      },
      "lineNbr": 456,
      "author": {
        "id": 1137654
      },
      "writtenOn": "2018-12-18T09:12:54Z",
      "side": 1,
      "message": "This is bitmap that host asked ISH FW to provides, It\u0027s nothing related with handle. host generates fw address from this bitmap. interface doesn\u0027t allow to use bit 0. since fw address \"0\" is for special purpose. +1/-1 here is due to interface designed. Please read host driver code then you will get better understanding.\n\nBugs we found until now were not related with wrong handle or wrong fw address. \n\n--------------------------------------\n\nsize_in_bits is constant. I didn\u0027t declare it with \"const\" keyword but compiler knows it\u0027s constant. Of course, since compiler knows size_in_bits is 8, it uses shift operations.",
      "parentUuid": "775d32f8_c0f8823c",
      "range": {
        "startLine": 456,
        "startChar": 29,
        "endLine": 456,
        "endChar": 50
      },
      "revId": "e61da9ce473d700e985937a561084b72f39b1b26",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

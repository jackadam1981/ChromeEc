        "id": 1308749
      },
      "writtenOn": "2024-05-16T22:28:40Z",
      "side": 1,
      "message": "`pdc_execute_command_sync()` runs from the PPM task and the interrupt handler runs on the `rts54xx_thread`.",
      "parentUuid": "0cffbeb6_19105001",
      "range": {
        "startLine": 1284,
        "startChar": 0,
        "endLine": 1284,
        "endChar": 34

        "id": 1487622
      },
      "writtenOn": "2023-08-08T01:37:41Z",
      "side": 1,
      "message": "I don\u0027t think so? The EC only sends one or the other, so the order shouldn\u0027t matter.",
      "parentUuid": "deab740c_7e36e614",
      "range": {
        "startLine": 11326,
        "startChar": 0,
        "endLine": 11329,
        "endChar": 3
      },
      "revId": "96e9423f40cd6332187e7c0a734f143814e570c4",

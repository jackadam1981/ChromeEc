      "side": 1,
      "message": "the logic seems to work ok, but is harder to follow than necessary. honestly, I\u0027d do the following instead:\n\nstatic bool ready_asserted_ \u003d false; /* we actually rely in the code that int_ap_sts_ can take only one of two states, and everything, which is not asserted is DEasserted, so better to express it explicitly in the variable type (bool) and then pick an appropriate name */\n\ntimer_int_ap_irq_handler() {\n  if (ready_asserted_) {\n    ready_set_state(false);    \n  } else {\n    ready_set_state(true);\n    schedule_timer_after_deasserted_delay();\n  }\n}\n\nap_start_ack_completion() {\n  if (ready_deasserted_delay_completed())\n    ready_set_state(true);\n}\n\nap_stop_ack_completion() {\n  if (ready_asserted_)\n    ready_set_state(false);\n  else\n    schedule_timer_after_deasserted_delay();\n}\n\nschedule_timer_after_deasserted_delay() {\n  diff_usec \u003d __hw_clock_source_read() - last_time_deassert_;\n  /* schedule timer for diff_usec */\n}\n\nready_set_state(bool do_assert) {\n  /* clear timer interrupt */\n  gpio_set_level(GPIO_INT_AP_L, do_assert);\n  ready_asserted_ \u003d do_assert;\n}\n\nbool ready_deasserted_delay_completed() {\n  return __hw_clock_source_read() \u003e\u003d last_time_deassert_;\n}",

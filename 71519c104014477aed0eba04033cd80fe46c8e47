      "writtenOn": "2019-11-22T02:26:34Z",
      "side": 1,
      "message": "Let\u0027s check the PP5000_A PGOOD before enabling the ROA rails.",
      "revId": "71519c104014477aed0eba04033cd80fe46c8e47",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

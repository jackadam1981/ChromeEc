    {
      "key": {
        "uuid": "cf1aa664_150c9ca6",
        "filename": "power/cometlake-discrete.c",
        "patchSetId": 1
      },
      "lineNbr": 280,
      "author": {
        "id": 1361259
      },
      "writtenOn": "2019-11-24T22:54:07Z",
      "side": 1,
      "message": "While PP3300_A does depend on PP5000_A for correct operation, it has an undervoltage lockout that should prevent bad startup and it can function correctly before PP5000_A ramps fully.\n\nOn the other hand waiting is probably more robust to BOM changes and PP5000_A should ramp in under a millisecond, so sure.",
      "parentUuid": "0231d9d0_4a747f8e",
      "revId": "71519c104014477aed0eba04033cd80fe46c8e47",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false

              "range": {
                "startLine": 28,
                "startChar": 0,
                "endLine": 30,
                "endChar": 0
              },
              "replacement": "\t/* The sleep duration is adjusted to the system tick boundaries.\n\t * The maximum error threshold is two ticks, this is equivalent to\n\t * two times the duration of a tick.\n\t */\n"
            }
          ]
        }
      ],
      "revId": "bfc398d7035604c2d5071f5d97e39c3ce10bd833",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

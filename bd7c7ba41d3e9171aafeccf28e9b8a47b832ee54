      "writtenOn": "2022-03-01T02:40:48Z",
      "side": 1,
      "message": "Ack",
      "parentUuid": "60c0357b_cff04fcd",
      "range": {
        "startLine": 11,
        "startChar": 0,
        "endLine": 13,

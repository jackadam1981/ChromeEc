    {
      "key": {
        "uuid": "437ff998_244e9c2e",
        "filename": "board/cr50/board.c",
        "patchSetId": 2
      },
      "lineNbr": 169,
      "author": {
        "id": 1123814
      },
      "writtenOn": "2017-01-12T18:19:06Z",
      "side": 1,
      "message": "These come from the 2 bit per strap pin expected value based on the H1 pinout table. Strong pullup encodes to 11, weak pullup encodes to 10, weak pulldown encodes to 01, and strong pulldown encodes to 00. 4 pins give an 8 bit strap_config result.\n\nSPI variants use the lower 4 bits to describe a particular configuration, while I2C variants use the upper 4 bits. Previously I was thinking of SPI as having 0-15 and I2C as having 16-31 results (where each group has 4 can\u0027t use configurations), but I have changed this now so that either upper 4 bits or lower 4 bits describe the variant. \n\nFor SPI variants the config value must be 0x0X and for I2C variants it must be 0xX0 where X will some 4 bit value other than 0, 1, 4, 5 which are not allowed because there would be no pullups. Based on the H1 pinout table, it really should be 0x5X and 0xX5, but I am not requiring the weak pulldowns to read correctly in case they are being held down by the AP.",
      "parentUuid": "97a04ea7_e2635056",
      "range": {
        "startLine": 169,
        "startChar": 2,
        "endLine": 169,
        "endChar": 19
      },
      "revId": "c399c5133e7d88392998bd1d7768521469d83049",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

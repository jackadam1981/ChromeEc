      "writtenOn": "2017-01-09T01:15:09Z",
      "side": 1,
      "message": "where do these numbers (0x2, 0x12) come from?",
      "range": {
        "startLine": 169,
        "startChar": 2,
        "endLine": 169,
        "endChar": 19
      },
      "revId": "c399c5133e7d88392998bd1d7768521469d83049",

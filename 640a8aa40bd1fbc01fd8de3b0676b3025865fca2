      "writtenOn": "2017-08-03T09:54:11Z",
      "side": 1,
      "message": "The masks are generic WAKE_MASKS and the usage is shown in https://chromium-review.googlesource.com/#/c/chromiumos/platform/ec/+/576048/",
      "parentUuid": "384819ac_1b948c22",
      "range": {

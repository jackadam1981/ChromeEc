      "writtenOn": "2024-05-07T19:05:28Z",
      "side": 1,
      "message": "Just for my knowledge: Is this the pattern Zephyr tests use for tests that need to reboot? If there is no well-defined pattern, maybe we should propose something upstream like the \"multistep\" test API that we use in EC.",
      "range": {
        "startLine": 78,
        "startChar": 0,
        "endLine": 111,
        "endChar": 79
      },
      "revId": "c00233c8fb973f3a78aa9d17f2669e8791a3b0d1",

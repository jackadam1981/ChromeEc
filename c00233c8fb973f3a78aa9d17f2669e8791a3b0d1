        "id": 1438457
      },
      "writtenOn": "2024-05-08T13:07:36Z",
      "side": 1,
      "message": "I haven\u0027t found such thing, but I will take a look one more time. It is connected with a test runner, if a test starts automatically or additional shell command. Also, some memory is needed that keeps a test state across reboots.",
      "parentUuid": "dc184fc8_0f51aba8",
      "range": {
        "startLine": 78,
        "startChar": 0,
        "endLine": 111,
        "endChar": 79
      },

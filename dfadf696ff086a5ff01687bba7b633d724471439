      "writtenOn": "2022-06-17T16:26:22Z",
      "side": 1,
      "message": "And I\u0027d propose that state machine live in the DPM portion of the code, just for a clean policy separation from the PE",
      "parentUuid": "6090b61c_aa97b15e",
      "revId": "dfadf696ff086a5ff01687bba7b633d724471439",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

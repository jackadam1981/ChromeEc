    {
      "key": {
        "uuid": "f2113632_12ebabe1",
        "filename": "board/treeya/board.c",
        "patchSetId": 3
      },
      "lineNbr": 214,
      "author": {
        "id": 1287347
      },
      "writtenOn": "2020-01-14T10:53:14Z",
      "side": 1,
      "message": "I think it\u0027s the limitation of this proposal. Recovery mode will disable sensors. It\u0027s not easy to cover all the active_mask(e.g. some sensors powered by S3, some by S5, some by S0) in RO stage.",
      "parentUuid": "eb27e0f3_6ef02f79",
      "revId": "8fc98f0ba30c87c702381862562430e29e686632",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

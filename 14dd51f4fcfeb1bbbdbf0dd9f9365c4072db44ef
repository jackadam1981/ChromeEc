        "filename": "common/port80.c",
        "patchSetId": 3
      },
      "lineNbr": 71,
      "author": {
        "id": 1132339
      },
      "writtenOn": "2021-05-11T02:18:42Z",
      "side": 1,
      "message": "Do you mean we can just ignore code \u003e\u003d0x100 even when it is 4-byte code?",
      "parentUuid": "f526343c_d32545ed",
      "range": {
        "startLine": 71,
        "startChar": 22,
        "endLine": 71,
        "endChar": 54
      },
      "revId": "14dd51f4fcfeb1bbbdbf0dd9f9365c4072db44ef",

      "writtenOn": "2021-05-10T20:50:50Z",
      "side": 1,
      "message": "Doesn\u0027t this mean that we would not ignore the special event codes in case of `CONFIG_PORT80_4_BYTE`? This would make the behavior inconsistent across different products, which can be confusing for debugging?",
      "range": {
        "startLine": 71,
        "startChar": 22,
        "endLine": 71,
        "endChar": 54
      },
      "revId": "14dd51f4fcfeb1bbbdbf0dd9f9365c4072db44ef",

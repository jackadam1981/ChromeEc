      "writtenOn": "2025-10-10T20:56:14Z",
      "side": 1,
      "message": "Do have an example that shows how this is used?\nWould it make more sense to only add this mode for the EC/FP chips that need it?",
      "range": {
        "startLine": 13,
        "startChar": 0,
        "endLine": 17,
        "endChar": 0
      },
      "revId": "702ccff27a586acbbff2b90d3d9fad613d43e090",

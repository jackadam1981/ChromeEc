      "writtenOn": "2023-12-18T01:10:08Z",
      "side": 1,
      "message": "yes, we need base detection will keep running in G3, because we should disable lid_detect if the base detach, and I use power_status_change to enable/disable en_ppvar_base_x at G3 state.",
      "parentUuid": "eea942d4_42a800fc",
      "range": {
        "startLine": 111,
        "startChar": 2,
        "endLine": 113,
        "endChar": 4

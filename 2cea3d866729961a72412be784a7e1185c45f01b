        "id": 1000039
      },
      "writtenOn": "2018-01-29T17:43:18Z",
      "side": 1,
      "message": "why do you need to disable interrupts? who cares in the counter is one off when it is read?",
      "range": {
        "startLine": 308,
        "startChar": 1,
        "endLine": 308,
        "endChar": 19
      },
      "revId": "2cea3d866729961a72412be784a7e1185c45f01b",

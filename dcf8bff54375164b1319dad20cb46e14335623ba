      "writtenOn": "2020-05-13T19:45:51Z",
      "side": 1,
      "message": "it is possible that the deferred function is running right now (or in the middle of running). This cancels any future invocations of this method.\n\nThis means that the current_state variable could get reset to READY_RX after the next line is run.\n\nWe need to add access guards to this global state",
      "range": {
        "startLine": 275,
        "startChar": 1,
        "endLine": 277,
        "endChar": 6
      },
      "revId": "dcf8bff54375164b1319dad20cb46e14335623ba",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

      "author": {
        "id": 1339295
      },
      "writtenOn": "2020-05-20T05:06:12Z",
      "side": 1,
      "message": "All the global resets are guarded under interrupt disabled so that globals can be processed in entirety in same context.",
      "parentUuid": "94ccf0d8_38ac76f5",
      "range": {
        "startLine": 275,
        "startChar": 1,
        "endLine": 277,
        "endChar": 6
      },
      "revId": "dcf8bff54375164b1319dad20cb46e14335623ba",

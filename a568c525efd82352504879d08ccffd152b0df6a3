      "writtenOn": "2022-05-27T21:49:00Z",
      "side": 1,
      "message": "What do you think of doing a round robin to select the starting port?",
      "range": {
        "startLine": 192,
        "startChar": 0,
        "endLine": 192,
        "endChar": 64
      },
      "revId": "a568c525efd82352504879d08ccffd152b0df6a3",

      "writtenOn": "2017-09-15T20:28:56Z",
      "side": 1,
      "message": "Vincent, this seems like a pretty obvious binary to bcd conversion. Is there any clean/clever assembly tricks where this can become better?",
      "parentUuid": "cbfcbcd7_03b05883",
      "range": {
        "startLine": 82,
        "startChar": 0,
        "endLine": 84,
        "endChar": 52
      },
      "revId": "eee0aaf11e5b689f89242b9ce0f8bfd397f2ff35",

      },
      "writtenOn": "2020-06-02T18:57:26Z",
      "side": 1,
      "message": "It is still executed in the chipset task context, before the power rails are removed.",
      "parentUuid": "bcdb791d_e0f69eed",
      "range": {
        "startLine": 953,
        "startChar": 60,
        "endLine": 953,
        "endChar": 77
      },
      "revId": "15a80770291b67881e1cef35f02fa737c06d8b70",

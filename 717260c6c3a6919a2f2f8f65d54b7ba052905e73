      "writtenOn": "2023-06-23T17:15:04Z",
      "side": 1,
      "message": "Is TCPC_FLAGS_TCPCI_REV2_0_NO_VSAFE0V a mode that the emulator supports? Or is that basically V1?",
      "parentUuid": "40c7509e_5c524057",
      "revId": "717260c6c3a6919a2f2f8f65d54b7ba052905e73",

        "id": 1330845
      },
      "writtenOn": "2019-06-07T16:48:26Z",
      "side": 1,
      "message": "We shouldn\u0027t be initializing the structure here, as this happens during system initialization (from saved panic data). We don\u0027t want to eradicate that saved data.",
      "range": {
        "startLine": 198,
        "startChar": 1,
        "endLine": 202,
        "endChar": 39
      },
      "revId": "98a3623c7dca05b93e1ef84f2674211e3e2e29f9",

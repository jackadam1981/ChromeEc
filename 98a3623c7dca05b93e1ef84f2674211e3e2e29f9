    },
    {
      "key": {
        "uuid": "b3ac72ed_bfacf39a",
        "filename": "core/minute-ia/panic.c",
        "patchSetId": 3
      },
      "lineNbr": 202,
      "author": {
        "id": 1346479
      },
      "writtenOn": "2019-06-07T17:01:58Z",
      "side": 1,
      "message": "This is how all of the panic.c implementations do this.  Are you sure this is not what I want?",
      "parentUuid": "a306fd22_0f549a59",
      "range": {
        "startLine": 198,
        "startChar": 1,
        "endLine": 202,
        "endChar": 39
      },
      "revId": "98a3623c7dca05b93e1ef84f2674211e3e2e29f9",

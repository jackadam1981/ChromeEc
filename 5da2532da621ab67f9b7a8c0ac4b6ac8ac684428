      },
      "lineNbr": 687,
      "author": {
        "id": 1106949
      },
      "writtenOn": "2019-04-13T02:29:18Z",
      "side": 1,
      "message": "p9221_is_online is just reading chip id over i2c. How can it imply VBUS is provided by WPC? Is the chip in stand-by mode?",
      "parentUuid": "0eb9c98f_214ab3fb",
      "range": {
        "startLine": 687,
        "startChar": 1,
        "endLine": 687,
        "endChar": 12
      },

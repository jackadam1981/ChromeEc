    {
      "key": {
        "uuid": "0eb9c98f_214ab3fb",
        "filename": "driver/wpc/p9221.c",
        "patchSetId": 14
      },
      "lineNbr": 687,
      "author": {
        "id": 1311150
      },
      "writtenOn": "2019-04-09T02:49:07Z",
      "side": 1,
      "message": "p9221_is_online means the TX and RX actual connected or not, wpc-\u003eonline is the status save this status. if wpc-\u003eonline is true, means VRECT INT has been occured, and no need process this intterrupt again. if  p9221_is_online  is true, we can distinguish if this VBUS is provide by WPC or USBPD.",
      "parentUuid": "7dbb997a_185eeb86",
      "range": {
        "startLine": 687,
        "startChar": 1,
        "endLine": 687,
        "endChar": 12
      },
      "revId": "5da2532da621ab67f9b7a8c0ac4b6ac8ac684428",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "21efa615_594c0547",
        "filename": "driver/wpc/p9221.c",

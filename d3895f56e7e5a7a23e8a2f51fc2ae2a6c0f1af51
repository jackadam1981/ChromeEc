      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "40ac5e4a_7954d8fc",
        "filename": "board/vilboz/board.c",
        "patchSetId": 1
      },
      "lineNbr": 464,
      "author": {
        "id": 1262393

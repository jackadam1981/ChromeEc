      "writtenOn": "2021-10-16T00:12:02Z",
      "side": 1,
      "message": "The idea is to make it easy to run both with and without firmware_builder.py.\n\nbash is not a good language to use for anything; inevitably it will end up being complex and impossible to maintain: http://go/deshell",
      "parentUuid": "803301ef_0646e965",
      "range": {
        "startLine": 13,
        "startChar": 0,
        "endLine": 13,
        "endChar": 62
      },

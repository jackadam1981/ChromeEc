      "writtenOn": "2021-04-23T14:23:19Z",
      "side": 1,
      "message": "Is there a way to know which bytes were sent together in a message? We may to group these bytes in the console output.",
      "revId": "366429fa4de8734aac06963400efdf45b2207e1e",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

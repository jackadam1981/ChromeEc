    {
      "key": {
        "uuid": "3c30f57d_6593b0ff",
        "filename": "driver/accel_kxcj9.c",
        "patchSetId": 3
      },
      "lineNbr": 183,
      "author": {
        "id": 1103909
      },
      "writtenOn": "2014-03-20T17:56:17Z",
      "side": 1,
      "message": "Clearing the interrupt pending register needs to happen last. \n\nThe motion detect functionality is always enabled because the WUFE bit in KXCJ9_CTRL1 is set in the init() function. Setting the interrupt enable bit above enables the physical interrupt pin so that when motion is detected it toggles the pin that generates an interrupt on the EC. Clearing the interrupt pending register clears the motion detected latch, which essentially allows the motion detect functionality to trigger.\n\nIf the latch register is cleared before the enable, then if motion is detected before the enable, no interrupt signal will be sent to EC.",
      "parentUuid": "dc4d1911_553d0cca",
      "revId": "ccceba46de8e4f501ab8dfe01cbc29a4a64ece02",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

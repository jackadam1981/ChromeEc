      },
      "writtenOn": "2023-07-12T15:20:10Z",
      "side": 1,
      "message": "To make a module, it\u0027s necessary to introduce module definition files in an external repository. BoringSSL is not going to accept definition files and we don\u0027t want to create a new repository with BoringSSL + module definition files and maintain it.",
      "parentUuid": "c93b6d69_cd56be8a",
      "range": {
        "startLine": 7,
        "startChar": 0,
        "endLine": 7,
        "endChar": 31
      },
      "revId": "1b75272b2ee919ef5283e0c56d9f6b9ab1991381",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "146a6c85_66e990de",

      "writtenOn": "2019-03-05T22:02:32Z",
      "side": 1,
      "message": "SOP message gets priority over SOP_PRIME. So if we send SOP and SOP_PRIME, SOP message will get queued. Here, the SOP message is queued and the message is transmitted, them the SOP_PRIME message gets queued and transmitted. The intent is to send SOP_PRIME message to the cable without disturbing the flow.",
      "parentUuid": "9deb4846_4cedd6ca",
      "range": {
        "startLine": 3365,
        "startChar": 0,
        "endLine": 3368,
        "endChar": 38
      },
      "revId": "61eb416d3739eec94c645cfd4f51643dbddcf15a",

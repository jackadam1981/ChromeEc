      "writtenOn": "2019-05-08T03:01:19Z",
      "side": 1,
      "message": "Does the prochot then get deasserted when battery is plugged in? Or does it need to be de-asserted explicitly?",
      "range": {
        "startLine": 174,
        "startChar": 50,
        "endLine": 175,
        "endChar": 64
      },
      "revId": "093db5626136f1fac38572d884e929d9ceede472",

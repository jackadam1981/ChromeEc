        "id": 1000187
      },
      "writtenOn": "2014-12-23T01:16:59Z",
      "side": 1,
      "message": "See ssl\u0027s comments from the other patch.  It may be tidier to create flash_physical_read() which does memcpy().",
      "range": {
        "startLine": 182,
        "startChar": 1,
        "endLine": 182,
        "endChar": 46
      },
      "revId": "31a58c66b91291ba74290a30516414fb21f1843d",

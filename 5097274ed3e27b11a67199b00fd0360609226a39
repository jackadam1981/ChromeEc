      },
      "writtenOn": "2017-07-28T18:36:28Z",
      "side": 1,
      "message": "With this you can no longer tell the difference between the EC being enabled and the AP being enabled right?",
      "range": {
        "startLine": 59,
        "startChar": 15,
        "endLine": 59,
        "endChar": 17
      },
      "revId": "5097274ed3e27b11a67199b00fd0360609226a39",

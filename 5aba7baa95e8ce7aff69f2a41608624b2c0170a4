        "id": 1333748
      },
      "writtenOn": "2024-03-20T15:11:23Z",
      "side": 1,
      "message": "I agree, I think it would be better to launch the test from the `ZTEST` then have the test wait for a result. twister will timeout if anything goes wrong.",
      "parentUuid": "333d02fc_25bb8aff",
      "range": {
        "startLine": 72,
        "startChar": 0,
        "endLine": 72,
        "endChar": 59
      },
      "revId": "5aba7baa95e8ce7aff69f2a41608624b2c0170a4",

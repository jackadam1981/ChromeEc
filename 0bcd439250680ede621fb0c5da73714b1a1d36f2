      "side": 1,
      "message": "afaikt this gets called when the SPI endpoint gets opened (i.e., flashrom opens).  so it would be better for this to do the equivalent of \"spi_enable [detect Vref]\" here.\n\ndoing so would also avoid any glitches between gpio_config_module and gpio_set_flags, although I didn\u0027t see any glitch in my scope shot.",
      "range": {
        "startLine": 238,
        "startChar": 5,
        "endLine": 238,
        "endChar": 25
      },
      "revId": "0bcd439250680ede621fb0c5da73714b1a1d36f2",

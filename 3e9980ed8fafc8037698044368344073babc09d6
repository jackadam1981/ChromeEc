        "id": 1308749
      },
      "writtenOn": "2021-01-21T15:04:52Z",
      "side": 1,
      "message": "Even if this is only going to support BB for now, lets make the naming more generic so this ACPI hook could be used for other retimers in the future.  I suggest replacing \"BB_RETIMER\" with \"USB_RETIMER\" throughout.",
      "range": {
        "startLine": 457,
        "startChar": 0,
        "endLine": 457,
        "endChar": 45
      },
      "revId": "3e9980ed8fafc8037698044368344073babc09d6",

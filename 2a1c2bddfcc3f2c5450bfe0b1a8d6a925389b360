    {
      "key": {
        "uuid": "8c97abf7_6384b962",
        "filename": "common/usb_pd_protocol.c",
        "patchSetId": 2
      },
      "lineNbr": 4124,
      "author": {
        "id": 1284593
      },
      "writtenOn": "2018-10-03T19:57:59Z",
      "side": 1,
      "message": "I don\u0027t think the added complexity is justified for an infrequently-used error handling path.  By definition, if this thing is a hot spot, there are more important concerns.\n\nBut if we\u0027re going down that road, I\u0027d rather just use leading-zero-count instead of find-last-set.  Its a pinch smaller, since you don\u0027t have to subtract off the bias, and fls is pedagogically awful.  Its undefined for x\u003d\u003d\u003d0.  Even though that\u0027s not an obstacle for this logic, its a bad habit that I don\u0027t want to encourage when it isn\u0027t required.",
      "parentUuid": "4f44c137_a6a5964a",
      "range": {
        "startLine": 4123,
        "startChar": 1,
        "endLine": 4124,
        "endChar": 36
      },
      "revId": "2a1c2bddfcc3f2c5450bfe0b1a8d6a925389b360",

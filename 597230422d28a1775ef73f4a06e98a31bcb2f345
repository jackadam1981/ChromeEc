      "writtenOn": "2020-09-28T16:38:25Z",
      "side": 1,
      "message": "This should probably go in https://chromium.googlesource.com/chromiumos/platform/ec/+/424ca6d7b31e2f627adb83629ec07467d871b421/include/util.h. Unit tests can go in corresponding test file: https://chromium.googlesource.com/chromiumos/platform/ec/+/424ca6d7b31e2f627adb83629ec07467d871b421/test/utils.c.",
      "range": {
        "startLine": 97,
        "startChar": 0,

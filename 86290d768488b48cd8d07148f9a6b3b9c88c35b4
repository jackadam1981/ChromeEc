        "id": 1314845
      },
      "writtenOn": "2024-01-12T23:36:01Z",
      "side": 1,
      "message": "Is `s` short for seconds? If so, I would call it `rtc_delay_seconds` just to avoid any ambiguity.",
      "range": {
        "startLine": 12,
        "startChar": 17,
        "endLine": 12,
        "endChar": 28

      "writtenOn": "2025-11-20T22:36:52Z",
      "side": 1,
      "message": "The `write_pending buffer` is only `8 bytes`. Is this guaranteed to be sufficient for all `leave_cs_asserted \u003d\u003d true` calls?",
      "range": {
        "startLine": 29,
        "startChar": 15,
        "endLine": 29,
        "endChar": 31
      },
      "revId": "d521ab3aa75239138dbfac7e5df88e4bb47df40b",

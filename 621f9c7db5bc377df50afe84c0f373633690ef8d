      },
      "lineNbr": 4141,
      "author": {
        "id": 1333748
      },
      "writtenOn": "2025-08-22T17:03:30Z",
      "side": 1,
      "message": "The ISH can\u0027t send host events though.",
      "parentUuid": "0b8e02cf_962b53f4",
      "revId": "621f9c7db5bc377df50afe84c0f373633690ef8d",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

    {
      "key": {
        "uuid": "4038befc_32ba02c6",
        "filename": "power/icelake.c",
        "patchSetId": 2
      },
      "lineNbr": 202,
      "author": {
        "id": 1373037
      },
      "writtenOn": "2020-02-10T17:43:19Z",
      "side": 1,
      "message": "ALL_SYS_PWRGD is the enable signal for VCCIN VR, which would take around 1ms for the ramp up (tPLT04). \nSince VCCIN VR power good is the wired AND with PCH_PWROK onboard, we kept 2ms delay between while enabling ALL_SYS_PWRGD  and PCH_PWROK.  \nTo meet “tCPU16” timing requirement, EC_AP_VCCST_PWRGD_OD and PCH_PWGD are driven at the same time from EC. \nSo driving ALL_SYS_PWRGD, not combined with the deferred function.",
      "parentUuid": "6b222920_2ac85946",
      "revId": "8003d5fb3859a2642a368a13ea79f1beb2a796e3",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

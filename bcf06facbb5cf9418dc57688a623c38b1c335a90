        "id": 3773521
      },
      "writtenOn": "2025-11-04T02:18:38Z",
      "side": 1,
      "message": "The device requests 20V at the beginning meaning 60W, and after this it requests again but this time 15V. Probably mismatch between PDC and EC policies. Not sure which value should be here.",
      "parentUuid": "8c0103a8_5574d011",
      "range": {
        "startLine": 132,
        "startChar": 40,
        "endLine": 132,
        "endChar": 45

      },
      "writtenOn": "2025-11-04T01:14:21Z",
      "side": 1,
      "message": "If the device wants both 20V 2.25A and 15V 3A, how do we deal with this case ? Or do we recomment partner to limit the voltage to 15V so that we could align the PD_Power_As_Sink to 45W as well ?",
      "parentUuid": "8c0103a8_5574d011",
      "range": {
        "startLine": 132,
        "startChar": 40,
        "endLine": 132,
        "endChar": 45
      },
      "revId": "bcf06facbb5cf9418dc57688a623c38b1c335a90",

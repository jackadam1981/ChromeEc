      "writtenOn": "2020-01-02T22:21:38Z",
      "side": 1,
      "message": "just out of curiosity - what is the meaning of the reserved byte set to zero, who would anyone send a request with reserved byte not set to zero?",
      "range": {
        "startLine": 11,
        "startChar": 3,
        "endLine": 11,
        "endChar": 21
      },
      "revId": "e913dca12c9a7d95d622b8635ed1e50474c9b6b5",

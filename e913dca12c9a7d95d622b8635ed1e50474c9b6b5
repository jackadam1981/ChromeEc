      "unresolved": true
    },
    {
      "key": {
        "uuid": "5f512d4d_0f47fff6",
        "filename": "/COMMIT_MSG",
        "patchSetId": 2
      },
      "lineNbr": 11,
      "author": {
        "id": 1000039
      },
      "writtenOn": "2020-01-02T22:44:39Z",
      "side": 1,
      "message": "so, if the final check would fail anyways - what\u0027s the point of explicitly checking this value - just to return sooner?",
      "parentUuid": "4f6cf31b_ad47a9e6",
      "range": {
        "startLine": 11,
        "startChar": 3,
        "endLine": 11,
        "endChar": 21
      },
      "revId": "e913dca12c9a7d95d622b8635ed1e50474c9b6b5",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "99884d63_64789dcc",
        "filename": "/COMMIT_MSG",
        "patchSetId": 2
      },
      "lineNbr": 11,
      "author": {

    {
      "key": {
        "uuid": "4f6cf31b_ad47a9e6",
        "filename": "/COMMIT_MSG",
        "patchSetId": 2
      },
      "lineNbr": 11,
      "author": {
        "id": 1152319
      },
      "writtenOn": "2020-01-02T22:31:53Z",
      "side": 1,
      "message": "the spec fixes it to 0 (the side that checks attestation needs to reconstruct this data blob to verify the signature, so setting it to a different value would fail the signature check).",
      "parentUuid": "d9779099_ba95d96e",
      "range": {
        "startLine": 11,
        "startChar": 3,
        "endLine": 11,
        "endChar": 21

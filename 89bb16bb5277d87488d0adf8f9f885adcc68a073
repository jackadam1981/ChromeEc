      "writtenOn": "2019-07-15T17:53:32Z",
      "side": 1,
      "message": "We found that presenting Rp 3.0A on initial connections before Vconn was sourced could trigger CCD mode, causing failures to communicate with DP dongles that present Ra.  Instead, we wait to present Rp 3.0A after the connection is established and Vconn is being sourced on the old stack.\n\nYou can see b/124531988 and b/123063171 for more details.",
      "parentUuid": "bccd7f11_eedf4f25",
      "range": {
        "startLine": 297,
        "startChar": 0,
        "endLine": 298,
        "endChar": 45
      },
      "revId": "89bb16bb5277d87488d0adf8f9f885adcc68a073",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

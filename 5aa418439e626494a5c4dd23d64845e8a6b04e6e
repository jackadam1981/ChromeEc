      "writtenOn": "2017-01-14T06:49:49Z",
      "side": 1,
      "message": "Where do we disable the normal interrupt for sys_rst_l when board_us_plt_rst() is true?",
      "revId": "5aa418439e626494a5c4dd23d64845e8a6b04e6e",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

    {
      "key": {
        "uuid": "6cd94380_47e2c58f",
        "filename": "driver/accelgyro_bmi160.h",
        "patchSetId": 9
      },
      "lineNbr": 468,
      "author": {
        "id": 1186109
      },
      "writtenOn": "2017-07-19T05:20:56Z",
      "side": 1,
      "message": "No, I don\u0027t think so.  The raw_orientation field is needed for efficiency.  It\u0027s used by the driver layer to store off the raw value read from the orientation register.  We need to do a quick check to see if orientation has changed, so adding storage space for this raw_orientaiton allows us not to have to remap an orientation just to determine if it\u0027s changed. The \"orientation\" and \"last_orientation\" fields are used by the motion_sense layer and hold post-remapped (rotated) orientation, allowing motion_sense layer to determine if orientation has changed without performing a remap/rotation operation.",
      "parentUuid": "72f6d296_bc48d60b",
      "revId": "ec494513014aae3eece8ae0def0827b3a3057638",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

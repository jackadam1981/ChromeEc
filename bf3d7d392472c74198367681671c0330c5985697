    {
      "key": {
        "uuid": "195c9438_00d64b50",
        "filename": "board/servo_micro/board.c",
        "patchSetId": 7
      },
      "lineNbr": 447,
      "author": {
        "id": 1000104
      },
      "writtenOn": "2018-08-02T23:10:38Z",
      "side": 1,
      "message": "You can do this in a slightly cleaner fashion like so:\nhttps://cs.corp.google.com/chromeos_public/src/platform/ec/board/servo_v4/usb_pd_config.h?l\u003d166\n\n\t\t\t/* USB_DUT_CC1_TX_DATA: PB14 is SPI2 MISO */\n\t\t\tconst struct gpio_info *g \u003d gpio_list +\n\t\t\t\tGPIO_USB_DUT_CC1_TX_DATA;\n\t\t\tgpio_set_alternate_function(g-\u003eport, g-\u003emask, 0);",
      "parentUuid": "d87de684_9cd9b0ae",
      "revId": "bf3d7d392472c74198367681671c0330c5985697",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

    {
      "key": {
        "uuid": "bf16e1e1_8d4d520b",
        "filename": "board/cr50/ec_state.c",
        "patchSetId": 4
      },
      "lineNbr": 107,
      "author": {
        "id": 1000039
      },
      "writtenOn": "2018-08-11T01:54:59Z",
      "side": 1,
      "message": "I moved setting of the bitbang_enabled state such that it is set to TRUE to envelope all possible bit bang related configuration changes.\n\nI think it is sufficient for avoiding race conditions, as none of these actions (bit bang enable, bit bang disable, ec detect) run on interrupt context.",
      "parentUuid": "70febb9d_5b239677",
      "range": {
        "startLine": 107,
        "startChar": 5,
        "endLine": 107,
        "endChar": 28

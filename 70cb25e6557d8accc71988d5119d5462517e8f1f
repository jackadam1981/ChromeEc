    },
    {
      "key": {
        "uuid": "40f4d449_5aa7364f",
        "filename": "driver/max695x.c",
        "patchSetId": 2
      },
      "lineNbr": 52,
      "author": {
        "id": 1106949
      },
      "writtenOn": "2019-04-24T00:23:42Z",
      "side": 1,
      "message": "I meant\ni2c_write32(I2C_PORT_PORT80, PORT80_I2C_ADDR, MAX695X_DIGIT0_ADDR | I2C_FLAG_BIG_ENDIAN, data);",
      "parentUuid": "33afcacd_aaf8b8fc",
      "range": {
        "startLine": 51,
        "startChar": 0,
        "endLine": 52,
        "endChar": 40
      },
      "revId": "70cb25e6557d8accc71988d5119d5462517e8f1f",

    {
      "key": {
        "uuid": "33afcacd_aaf8b8fc",
        "filename": "driver/max695x.c",
        "patchSetId": 2
      },
      "lineNbr": 52,
      "author": {
        "id": 1329040
      },
      "writtenOn": "2019-04-23T20:58:52Z",
      "side": 1,
      "message": "For same reason mentioned above, we can\u0027t directly send the data for a i2c_write32",
      "parentUuid": "d36db4b7_eaef2a5f",
      "range": {
        "startLine": 51,
        "startChar": 0,
        "endLine": 52,
        "endChar": 40
      },

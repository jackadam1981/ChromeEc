    {
      "key": {
        "uuid": "0e265220_96d4ce54",
        "filename": "driver/max695x.c",
        "patchSetId": 2
      },
      "lineNbr": 42,
      "author": {
        "id": 1329040
      },
      "writtenOn": "2019-04-23T20:58:52Z",
      "side": 1,
      "message": "For hex mode, max695x decoder ignores D7-D4. So the first two bytes are used to represent the module and the next two are used for data.",
      "parentUuid": "8ccc57ea_f27ebbd8",
      "range": {
        "startLine": 37,
        "startChar": 0,
        "endLine": 42,
        "endChar": 4
      },
      "revId": "70cb25e6557d8accc71988d5119d5462517e8f1f",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "21689802_4eeea55b",
        "filename": "driver/max695x.c",
        "patchSetId": 2
      },
      "lineNbr": 42,
      "author": {
        "id": 1106949
      },
      "writtenOn": "2019-04-24T00:23:42Z",
      "side": 1,
      "message": "If I read the code correctly, only the 2nd byte is manipulated to represent the module.",
      "parentUuid": "0e265220_96d4ce54",
      "range": {
        "startLine": 37,
        "startChar": 0,
        "endLine": 42,
        "endChar": 4
      },
      "revId": "70cb25e6557d8accc71988d5119d5462517e8f1f",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "d7c3f96e_985aaac1",

package {
    default_team: "trendy_team_desktop_hwsec",
}

rust_binary_host {
    name: "boot_param_test",
    defaults: ["boot_param_test.defaults"],
    srcs: [
        "src/main.rs"
    ],
    rustlibs: [
        "libanyhow",
        "libcbor_util",
        "libciborium",
        "libcoset",
        "libdiced_open_dice_multialg",
        "libhwtrust",
    ],
}

rust_defaults {
    name: "boot_param_test.defaults",
    defaults: ["avf_build_flags_rust"],
    prefer_rlib: true,
}

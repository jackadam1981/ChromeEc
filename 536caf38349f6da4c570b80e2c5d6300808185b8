        "id": 1135824
      },
      "writtenOn": "2018-11-12T15:12:07Z",
      "side": 1,
      "message": "side note (no action required): given we\u0027re seeing all this ad-hoc serialization code pop up, we should really consider converting this to protobuf or somesuch, and also make sure we do that right away for the next project like this.",
      "range": {
        "startLine": 122,
        "startChar": 0,
        "endLine": 320,
        "endChar": 1
      },
      "revId": "536caf38349f6da4c570b80e2c5d6300808185b8",

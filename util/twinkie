import array
import os
import sys
import time
import usb

TWINKIE_VID=0x18d1
TWINKIE_PID=0x500a

EP_CON_TX=0x02
EP_CON_RX=0x81
EP_SNIFFER=0x83

def findTwinkie():
	busses = usb.busses()
	for bus in busses:
		devices = bus.devices
		for dev in devices:
			if dev.idVendor == TWINKIE_VID and dev.idProduct == TWINKIE_PID:
				print "Twinkie FOUND"
				return dev
	return None

def twinkieConsole(hnd):
	hnd.bulkWrite(EP_CON_TX,"help\r\n")
	while True:
		try:
			txt = hnd.bulkRead(EP_CON_RX,64)
		except usb.core.USBError:
			inp = os.read(sys.stdin.fileno(),64)
			hnd.bulkWrite(EP_CON_TX, inp)
			continue
		if len(txt):
			sys.stdout.write(txt.tostring())

MAX_RECORD_SIZE = 1024 * 1024 * 256

def decodeBuffer(packets, store):
	prev_src = 0
	rollbacks = 0
	last_tstamp = 0
	last_seq = 0
	invalid = 0
	cnt = 0
	seqs = []
	state = False
	for p in packets:
		a = array.array("B", p)
		if len(a) % 64:
			print "Invalid size"
		n = len(a) / 64
		for i in range(n):
			samples = a[i * 64:(i + 1)*64]
			tstamp = (samples[3] << 8) | samples[2]
			seq = (samples[1] << 8) | samples[0]
			seqs.append((seq, (tstamp-last_tstamp) % 65536))
			cnt += 1
			if (seq - last_seq) % 0x1000 != 1:
				print "invalid seq %d->%d" % (last_seq, seq)
				invalid += 1
			last_seq = seq
			last_tstamp = tstamp
			for s in samples[4:]:
				if s == prev_src:
					rollbacks += 1
				else:
					diff = (s - prev_src) % 256
					fixup = rollbacks and ((s < prev_src) or (s == 0xff))
					if fixup:
						rollbacks -= 1
					total = rollbacks * 256 + diff
					store.write("\x01" * total if state else "\0" * total)
					rollbacks = 0
					prev_src = s
					state = not state
	print "Overflow packets %d/%d %f%%" % (invalid, cnt, invalid * 100.0 / cnt)


def twinkieRecord(hnd, filename):
	store = open(filename,"w")
	try:
		total = 0
		packets = []
		while total < MAX_RECORD_SIZE:
			pkt = hnd.bulkRead(EP_SNIFFER, 10*1024)
			total += len(pkt)
			packets.append(pkt)
	except KeyboardInterrupt:
		print "Acquisition stopped by Ctrl-C"
	print "Decoding ..."
	decodeBuffer(packets, store)
	store.close()
	print "Done"

def main():
	dev = findTwinkie()
	if not dev:
		sys.stderr.write("No Twinkie found\n")
		return
	hnd = dev.open()

	if len(sys.argv) > 1:
		hnd.claimInterface(1)
		twinkieRecord(hnd, sys.argv[1])
	else:
		hnd.claimInterface(0)
		twinkieConsole(hnd)

if __name__=="__main__":
	main()

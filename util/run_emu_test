import pexpect
import sys

TIMEOUT=10

test_name = sys.argv[1]
child = pexpect.spawn('build/emu/{0}/{0}.exe'.format(test_name), timeout=TIMEOUT)
child.logfile = sys.stdout
result_id = child.expect([pexpect.TIMEOUT, 'Pass!', 'Fail!'])
if result_id == 0:
  print >>sys.stderr, 'Test %s timed out after %d seconds!' % (test_name, TIMEOUT)
  sys.exit(1)
elif result_id == 1:
  print >>sys.stderr, 'Test %s passed!' % test_name
  sys.exit(0)
elif result_id == 2:
  print >>sys.stderr, 'Test %s failed!' % test_name
  sys.exit(1)

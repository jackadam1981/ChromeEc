FPMCU_SPI=10.0
DEVICE_FOLDER=/sys/devices/platform/soc@0/*/*/spi_master/*/spi${FPMCU_SPI}
ls $DEVICE_FOLDER

# currently loaded driver
basename $(readlink $DEVICE_FOLDER/driver)

# swap to spidev
echo spi${FPMCU_SPI} > /sys/bus/spi/drivers/cros-ec-spi/unbind
echo spi${FPMCU_SPI} > /sys/bus/spi/drivers/spidev/bind #-bash: echo: write error: No such device
gpioset `gpiofind FPMCU_BOOT0`=1
gpioset `gpiofind FP_RST_L`=0
gpioset `gpiofind FP_RST_L`=1
stm32mon -p --retries 6 -s /dev/spidev${FPMCU_SPI}
stm32mon -p --retries 6 -s /dev/spidev${FPMCU_SPI} -u -U -e -w ec.bin

# swap to cros-ec
gpioset `gpiofind FPMCU_BOOT0`=0
gpioset `gpiofind FP_RST_L`=0
gpioset `gpiofind FP_RST_L`=1
echo spi${FPMCU_SPI} > /sys/bus/spi/drivers/spidev/unbind
echo spi${FPMCU_SPI} > /sys/bus/spi/drivers/cros-ec-spi/bind
ectool --name=cros_fp version

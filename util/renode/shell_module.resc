logFile $ORIGIN/shell_module-renode.log True

using sysbus
$name?="adp_xc7k_ae350"
mach create $name

machine LoadPlatformDescription $ORIGIN/shell_module.repl


showAnalyzer uart1

uart1 RecordToAsciinema $ORIGIN/shell_module-asciinema

macro reset
"""
    sysbus LoadELF @https://zephyr-dashboard.renode.io/zephyr/70f55bccf8af2866331f6fd84e05c600f4457704/adp_xc7k_ae350/shell_module/shell_module.elf
    cpu0 EnableZephyrMode
    cpu1 IsHalted true
    cpu2 IsHalted true
    cpu3 IsHalted true
    cpu4 IsHalted true
    cpu5 IsHalted true
    cpu6 IsHalted true
    cpu7 IsHalted true
    cpu0 EnableProfilerCollapsedStack $ORIGIN/shell_module-profile true
"""

runMacro $reset
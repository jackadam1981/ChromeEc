      "author": {
        "id": 1132339
      },
      "writtenOn": "2023-08-18T03:13:05Z",
      "side": 1,
      "message": "With is change,",
      "parentUuid": "7d1d3352_4a75a6a4",
      "range": {
        "startLine": 214,
        "startChar": 0,
        "endLine": 224,
        "endChar": 2
      },
      "revId": "d721debc252d998a23b64aecf49f5d77dceed2b7",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "519cdf6c_16da5168",
        "filename": "chip/npcx/trng.c",
        "patchSetId": 4
      },
      "lineNbr": 224,

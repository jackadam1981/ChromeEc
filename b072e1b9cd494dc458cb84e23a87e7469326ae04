    {
      "key": {
        "uuid": "66cc2b8e_8e21eb38",
        "filename": "driver/sensorhub_lsm6dsm.c",
        "patchSetId": 2
      },
      "lineNbr": 120,
      "author": {
        "id": 1302633
      },
      "writtenOn": "2018-10-10T17:52:16Z",
      "side": 1,
      "message": "So in this case, if the I2C master in accel/gyro is used as a pass-through, then it cannot be in master mode.\n\nBut if it were previously in master mode, then we have to ensure that it is switched back to that state after coming out of pass through mode. Pass through mode is primarily used to configure the registers in external sensors directly by EC. This will help expedite the configuration. Else EC has to write a lot of configuration to accel/gyro module which in turn will write to external sensors.",
      "parentUuid": "3aaaeefb_3f2e369c",
      "range": {
        "startLine": 120,
        "startChar": 5,
        "endLine": 120,
        "endChar": 10
      },
      "revId": "b072e1b9cd494dc458cb84e23a87e7469326ae04",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

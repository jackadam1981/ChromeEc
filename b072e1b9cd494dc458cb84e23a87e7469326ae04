      "writtenOn": "2018-10-04T20:17:32Z",
      "side": 1,
      "message": "As much as I like these help methods, it is causing us to re-read the same register multiple time in the function. Can we directly write to the LSM6DSM_MASTER_CFG_ADDR within enable_i2c_pass_through instead?",
      "range": {
        "startLine": 95,
        "startChar": 7,
        "endLine": 95,
        "endChar": 24
      },
      "revId": "b072e1b9cd494dc458cb84e23a87e7469326ae04",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true

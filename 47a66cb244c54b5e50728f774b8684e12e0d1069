    },
    {
      "key": {
        "uuid": "6c752720_66d172a8",
        "filename": "test/tpm_test/trng_test.py",
        "patchSetId": 10
      },
      "lineNbr": 64,
      "author": {
        "id": 1324172
      },
      "writtenOn": "2019-12-21T01:46:27Z",
      "side": 1,
      "message": "TRNG_SAMPLE_BITS is internal setting for TRNG which is important for entropy analysis. TRNG internally gets a 16 bit sample (measurement of time to collapse ring oscillator). Then some slice of these bits [0:TRNG_SAMPLE_BITS] is added (packed) to TRNG FIFO which has internal size of 2048(?) bits. when I read TRNG, I read 32 bits from this FIFO. Now, I need to reverse this process to split read 32-bit into number of readings, each size TRNG_SAMPLE_BITS bits. Since I can read only 32 bits at once and TRNG_SAMPLE_BITS can be anything from 1 to 16, including non-power of 2, I want readings to result in non-fractional number of samples. At the same time NIST requires minimum 1000 samples at once. This calculation tries to meet this requirement.",
      "parentUuid": "223cc91c_ff778d19",
      "range": {
        "startLine": 62,
        "startChar": 1,
        "endLine": 64,
        "endChar": 61
      },
      "revId": "47a66cb244c54b5e50728f774b8684e12e0d1069",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    }
  ]

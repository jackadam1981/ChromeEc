      "writtenOn": "2022-03-07T02:18:05Z",
      "side": 1,
      "message": "Actually not, GPIO_ACTIVE_LOW is applied in the configure inline to flip this to GPIO_OUTPUT_HIGH for GPIO_ACTIVE_LOW pins, the pin will be high.\nFor non ACTIVE_LOW, it will be low.\nThe intent is to get the pin into de-asserted state, not to leave it inactive (presumably that means high-Z?)",
      "parentUuid": "9ed733e5_568320c7",
      "range": {
        "startLine": 118,
        "startChar": 35,
        "endLine": 118,
        "endChar": 50
      },
      "revId": "9565490c7749a32561f0c84c0785dff94f186e0c",

    {
      "key": {
        "uuid": "68bc51c9_7080d29b",
        "filename": "include/i2c_hid_touchpad.h",
        "patchSetId": 2
      },
      "lineNbr": 50,
      "author": {
        "id": 1289152
      },
      "writtenOn": "2019-10-23T21:48:36Z",
      "side": 1,
      "message": "This seems like quite a complicated return value. Is this defined by the I2C HID spec, or could we replace it with something more intuitive?",
      "revId": "227a5993bf5a239e4e7f4a6b102063bf756bcf48",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "cc78d968_9010e68c",
        "filename": "include/i2c_hid_touchpad.h",
        "patchSetId": 2
      },
      "lineNbr": 50,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2019-10-25T08:12:50Z",
      "side": 1,
      "message": "No, this is not part of the spec. It is designed to return parsed data so that the caller can perform necessary steps on the board-level. Since the only data that can potentially be returned in the spec are the power state value which has just a few possibilities, I chose to encode it in the return value instead of adding an extra input argument.\n\nI did this mainly because I vaguely remember that EC folks like to encode data in the return value if it is small enough. Let me know if you think this is not a good idea.",
      "parentUuid": "68bc51c9_7080d29b",
      "revId": "227a5993bf5a239e4e7f4a6b102063bf756bcf48",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true

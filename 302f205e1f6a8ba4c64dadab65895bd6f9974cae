    {
      "key": {
        "uuid": "cbd7567d_f0d6383f",
        "filename": "core/minute-ia/switch.S",
        "patchSetId": 4
      },
      "lineNbr": 46,
      "author": {
        "id": 1002124
      },
      "writtenOn": "2016-04-13T21:52:30Z",
      "side": 1,
      "message": "You can\u0027t increment this w/ interrupts on. You would be trashing the frame on the isr stack when there are 2 nested interrupts. Once sti is executed and __in_isr \u003d\u003d 0 you can take another interrupt which would re-initialize the irq stack, clobbering the previously saved state.\n\nYou should move the increment to within the code block that utilizes the __isr_stack_ptr.",
      "range": {
        "startLine": 46,
        "startChar": 1,
        "endLine": 46,
        "endChar": 17
      },
      "revId": "302f205e1f6a8ba4c64dadab65895bd6f9974cae",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },
    {

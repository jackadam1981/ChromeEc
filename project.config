[access]
	inheritFrom = chromiumos
[submit]
	action = inherit
	mergeContent = true
[project]
	description = ChromiumOS Embedded Controller software
[access "refs/for/refs/heads/master"]
[access "refs/heads/master"]
[access "^refs/for/refs/heads/firmware.*"]
	pushMerge = group chromeos-committers
[access "refs/sandbox/*"]
	exclusiveGroupPermissions = create
[access "refs/*"]
	read = group mdb/copybara-git-readers
	read = group mdb/zoss-cl-coverage
	forgeAuthor = group mdb/copybara-git-writers
	forgeCommitter = group mdb/copybara-git-writers
	push = group mdb/copybara-git-writers
	label-Code-Coverage = -1..+1 group Logged-in Public Users
	label-Code-Coverage = -1..+1 group mdb/zoss-cl-coverage
	labelAs-Code-Coverage = -1..+1 group mdb/zoss-cl-coverage
[receive]
	requireContributorAgreement = false
[label "Code-Coverage"]
	function = NoBlock
	value = -1 Fails
	value = 0 No score
	value = +1 Ok
	copyCondition = changekind:NO_CODE_CHANGE
	defaultValue = 0
[submit-requirement "Code-Coverage"]
	description = Submit requirement for the 'Code-Coverage' label
	submittableIf = label:Code-Coverage=MAX,user=non_uploader OR -label:Code-Coverage=MIN
	overrideIf = label:Bot-Commit=+1
	canOverrideInChildProjects = true
[access "refs/meta/config"]
	read = group mdb/zoss-cl-coverage
[access "refs/tags/*"]
	createTag = group Branch Masters
	createTag = group chromiumos-ec-owners
	createTag = group cr50-guc-owners
	createTag = group cr53-owners
[access "^refs/for/refs/heads/factory.*"]
	pushMerge = group chromeos-committers
[plugin "zosscoverage"]
	enable = true
	enableLowCoverageAlerting = true
	enableVoting = true
	incrementalCoverageDisplayErrorBelow = 80
	incrementalCoverageDisplayWarningBelow = 80
	labelName = Code-Coverage
	minAffectedFilesToEnforce = 0
	minAffectedLinesToEnforce = 0
	negativeVoteValue = -1
	positiveVoteValue = 1
[plugin "uploadvalidator"]
	blockedContentTypeWhitelist = false
	maxPathLength = 0
	rejectDuplicatePathnamesLocale = en
	rejectSubmodule = false
	rejectSymlink = false
	rejectWindowsLineEndings = false

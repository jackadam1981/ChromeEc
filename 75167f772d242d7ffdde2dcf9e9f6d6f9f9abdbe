      "writtenOn": "2023-07-25T15:43:58Z",
      "side": 1,
      "message": "What\u0027s in the response buffer at this point?  Isn\u0027t the response buffer zeroed out before the handler is called?",
      "range": {
        "startLine": 71,
        "startChar": 2,
        "endLine": 71,
        "endChar": 55
      },
      "revId": "75167f772d242d7ffdde2dcf9e9f6d6f9f9abdbe",

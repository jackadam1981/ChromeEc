        "patchSetId": 3
      },
      "lineNbr": 366,
      "author": {
        "id": 1152319
      },
      "writtenOn": "2019-06-26T23:12:02Z",
      "side": 1,
      "message": "RMA Device ID is 8 bytes. The hash (RSU Device ID) is 32 bytes.\nSomewhere in reviews it was decided that we shouldn\u0027t be sending the original device id, but only it\u0027s hmac. (security or privacy considerations iirc).\nAnd we can\u0027t be returning RMA Dev ID here and letting the userland do the hashing, since they need to send the cr50-attested value, so whatever is returned from here needs to be sent to the server, even if we send a hashed value in parallel.",
      "parentUuid": "e80b18c6_16b9b797",
      "range": {
        "startLine": 366,
        "startChar": 36,
        "endLine": 366,
        "endChar": 40
      },

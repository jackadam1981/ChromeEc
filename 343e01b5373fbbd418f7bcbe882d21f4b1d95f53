      "message": "What\u0027s the reasoning on making all the states overridable?",
      "range": {
        "startLine": 631,
        "startChar": 0,
        "endLine": 631,
        "endChar": 13
      },
      "revId": "343e01b5373fbbd418f7bcbe882d21f4b1d95f53",

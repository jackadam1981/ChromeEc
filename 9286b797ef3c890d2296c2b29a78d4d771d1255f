      "writtenOn": "2024-10-09T04:01:49Z",
      "side": 1,
      "message": "wake_small_angle will cause EC get angle unreliable if lid open and angle \u003c\u003d 15.",
      "parentUuid": "56ad7567_c5b41b1c",
      "revId": "9286b797ef3c890d2296c2b29a78d4d771d1255f",

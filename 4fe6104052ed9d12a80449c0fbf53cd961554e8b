      "writtenOn": "2019-03-13T23:52:03Z",
      "side": 1,
      "message": "I assume that the final patch would drop either of cases, and not have these flags. Right?",
      "parentUuid": "3b5419e8_ae72d627",
      "range": {
        "startLine": 178,
        "startChar": 0,
        "endLine": 189,
        "endChar": 24
      },
      "revId": "4fe6104052ed9d12a80449c0fbf53cd961554e8b",

      },
      "writtenOn": "2017-09-06T00:53:35Z",
      "side": 1,
      "message": "Why do we care about init_rx_only here?",
      "range": {
        "startLine": 31,
        "startChar": 31,
        "endLine": 31,
        "endChar": 56
      },
      "revId": "b153f0679da4023de4854a22cffdc777300bb59b",

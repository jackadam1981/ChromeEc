      "side": 1,
      "message": "If CONFIG_USB_PD_MAX_SINGLE_SOURCE_CURRENT is defined, and no other sink is connected, the Rp should be that of CONFIG_USB_PD_MAX_SINGLE_SOURCE_CURRENT.",
      "range": {
        "startLine": 10,
        "startChar": 0,
        "endLine": 10,
        "endChar": 72
      },
      "revId": "ece6ed9b0da60624cb39079e3dd7d5aed65a884e",

      },
      "writtenOn": "2023-02-07T20:30:05Z",
      "side": 1,
      "message": "Note that the read/write methods here are only useful for writing to the TOP section registers (8 bit device address 0x20). We also need methods to access TopCtl registers which by default use the 8 bit device address of 0x40",
      "range": {
        "startLine": 26,
        "startChar": 18,
        "endLine": 26,
        "endChar": 31
      },
      "revId": "5ffcf3d69295d4c47d98f91ee694ad7a34e39425",

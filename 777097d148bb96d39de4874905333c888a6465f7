      "writtenOn": "2018-11-22T11:34:08Z",
      "side": 1,
      "message": "I assume you\u0027ve put the -1 to make a value of 0 indicate \"default version\". While that works, it has the confusing side-effect of an off-by-one between the proto field and the version in the request.\n\nSuggestion: Change the check to pinweaver.has_version(), drop the -1.",
      "range": {
        "startLine": 16,
        "startChar": 0,
        "endLine": 17,
        "endChar": 54
      },
      "revId": "777097d148bb96d39de4874905333c888a6465f7",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

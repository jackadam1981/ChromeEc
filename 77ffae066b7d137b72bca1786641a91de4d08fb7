      "writtenOn": "2023-12-07T17:43:08Z",
      "side": 1,
      "message": "Should there be a minimum timeout?  What if a developer running ectool sets this to 0?\nIt looks like a boot loop is avoid because shutdown/reset path clears hdparams.",
      "range": {
        "startLine": 115,
        "startChar": 12,
        "endLine": 115,
        "endChar": 30
      },
      "revId": "77ffae066b7d137b72bca1786641a91de4d08fb7",

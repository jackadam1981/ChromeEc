      "writtenOn": "2023-08-28T20:51:45Z",
      "side": 1,
      "message": "If we don\u0027t care about rollovers, then the count isn\u0027t very meaningful. \nWhat\u0027s the point of using more than 6 bits to save the flash error count?",
      "parentUuid": "44d26838_2ac476d0",
      "range": {
        "startLine": 345,
        "startChar": 2,
        "endLine": 345,
        "endChar": 34
      },
      "revId": "f79db141e0a1ae1b22647d1e0e0e9b748847655d",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": false,

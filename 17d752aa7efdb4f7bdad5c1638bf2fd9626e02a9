      },
      "writtenOn": "2024-06-04T14:35:10Z",
      "side": 1,
      "message": "Do you need this cast?",
      "range": {
        "startLine": 191,
        "startChar": 25,
        "endLine": 191,
        "endChar": 34
      },
      "revId": "17d752aa7efdb4f7bdad5c1638bf2fd9626e02a9",

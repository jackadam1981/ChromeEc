    {
      "key": {
        "uuid": "cb02bf41_f1636831",
        "filename": "chip/mec1322/lpc.c",
        "patchSetId": 2
      },
      "lineNbr": 368,
      "author": {
        "id": 1111479
      },
      "writtenOn": "2015-01-21T07:40:15Z",
      "side": 1,
      "message": "Since this interface is originally used to initiate the host command, this reserved byte, which is \"inb(0x200)\" from host, is used to return the host command status, so I am marking it as reserved in this context to keep the existing value not modified.",
      "parentUuid": "6b6c7315_99fa1f44",
      "revId": "5cd8dd5bb50f1a0d3a8f1eb1424e9450a0c9870d",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false

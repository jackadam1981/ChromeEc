    {
      "key": {
        "uuid": "ab074b51_a4d87a81",
        "filename": "util/comm-lpc.c",
        "patchSetId": 2
      },
      "lineNbr": 23,
      "author": {
        "id": 1111479
      },
      "writtenOn": "2015-01-21T07:40:15Z",
      "side": 1,
      "message": "This structure is to provide a function pointer to inb, inl, outl, and usleep function since different cros component used different library / H file. \n\nHaving this structure defined here will allow the comm-mec1322.c to be portable as a copy-exact to coreboot/depthcharge/flashrom/mosys/etc.\n\nThe flashrom change, https://chromium-review.googlesource.com/#/c/236781,  is an example on how this is used.",
      "parentUuid": "cb5d5f61_bc138d4e",
      "revId": "5cd8dd5bb50f1a0d3a8f1eb1424e9450a0c9870d",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "0b4a1799_24c3d86d",
        "filename": "util/comm-lpc.c",
        "patchSetId": 2
      },

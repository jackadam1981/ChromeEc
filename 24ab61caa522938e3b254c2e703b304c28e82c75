    {
      "key": {
        "uuid": "53fe59ba_5ea4647c",
        "filename": "extra/i2c_pseudo/install",
        "patchSetId": 3
      },
      "lineNbr": 34,
      "author": {
        "id": 1291807
      },
      "writtenOn": "2020-04-07T01:08:00Z",
      "side": 1,
      "message": "I don\u0027t think softdep is appropriate.  Presence or absence of i2c-dev doesn\u0027t change i2c-pseudo functionality.\n\nAn i2c-pseudo adapter can be used by kernel I2C device drivers without involving i2c-dev.  E.g. one might use i2c-pseudo to mock an I2C adapter+device for testing an I2C device driver.\n\nLastly, this is an install script.  One should not be running an install script on every boot just to modprobe i2c-dev.  This isn\u0027t the right place to hook that in.",
      "parentUuid": "e539b50a_09806f61",
      "revId": "24ab61caa522938e3b254c2e703b304c28e82c75",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

      "author": {
        "id": 1002022
      },
      "writtenOn": "2020-04-06T22:54:44Z",
      "side": 1,
      "message": "Added MODULE_SOFTDEP as a POC; let me know what you think.",
      "parentUuid": "f3fbbad2_f3908de0",
      "revId": "24ab61caa522938e3b254c2e703b304c28e82c75",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

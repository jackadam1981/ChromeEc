    {
      "key": {
        "uuid": "f3fbbad2_f3908de0",
        "filename": "extra/i2c_pseudo/install",
        "patchSetId": 3
      },
      "lineNbr": 34,
      "author": {
        "id": 1002022
      },
      "writtenOn": "2020-04-06T22:30:54Z",
      "side": 1,
      "message": "It\u0027s effectively a dependency of i2c-pseudo.  I\u0027m not sure why i2c-pseudo doesn\u0027t already require it to be loaded.  Maybe this would be better served adding it as a dependency via a MODULE_SOFTDEP macro or whatever?",
      "parentUuid": "511dcc3d_674d6a3c",
      "revId": "24ab61caa522938e3b254c2e703b304c28e82c75",

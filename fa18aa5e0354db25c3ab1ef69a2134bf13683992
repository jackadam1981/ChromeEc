      "writtenOn": "2020-01-30T20:57:18Z",
      "side": 1,
      "message": "why prefix everything with 0xec ? Why not just make it 0, 1, 2 etc?\n\nIf we make the 0xec part of the encoding, don\u0027t we only need one byte for error space?",
      "range": {
        "startLine": 124,
        "startChar": 5,
        "endLine": 124,
        "endChar": 15
      },
      "revId": "fa18aa5e0354db25c3ab1ef69a2134bf13683992",

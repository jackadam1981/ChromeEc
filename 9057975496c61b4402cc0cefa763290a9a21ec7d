      "writtenOn": "2024-08-14T17:59:15Z",
      "side": 1,
      "message": "Yes re-connection is overkill. Implemented another way to make the PDC power management state machine enter SNK_ATTACHED_SET_SINK_PATH state.",
      "parentUuid": "e17cad1f_b7b35e89",
      "revId": "9057975496c61b4402cc0cefa763290a9a21ec7d",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

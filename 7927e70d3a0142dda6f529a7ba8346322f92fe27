      "side": 1,
      "message": "What does this need to be stored for?  Do we need to reference it later?\n\nShould ExitMode be clearing out the EnterMode message that was saved?",
      "revId": "7927e70d3a0142dda6f529a7ba8346322f92fe27",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "d8c66797_a31c5742",

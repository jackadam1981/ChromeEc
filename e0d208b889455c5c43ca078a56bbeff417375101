        "id": 1000039
      },
      "writtenOn": "2021-10-25T20:13:07Z",
      "side": 1,
      "message": "I think the suggested flag will work well for new devices with H1, it will guarantee that after the first successful verification the unsigned AP firmware will not be accepted, no matter what the board ID is.",
      "parentUuid": "fbafb639_40af106b",
      "revId": "e0d208b889455c5c43ca078a56bbeff417375101",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

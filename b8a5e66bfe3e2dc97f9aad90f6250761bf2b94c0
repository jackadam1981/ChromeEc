      "writtenOn": "2017-08-09T22:45:49Z",
      "side": 1,
      "message": "I don\u0027t see how ASSERT is useful on an embedded device. If you care about a possibility of size mismatch, return an error here.",
      "range": {
        "startLine": 43,
        "startChar": 1,
        "endLine": 43,

    },
    {
      "key": {
        "uuid": "07e90a2f_9fdae8c8",
        "filename": "common/tpm_log.c",
        "patchSetId": 3
      },
      "lineNbr": 43,
      "author": {
        "id": 1001696
      },
      "writtenOn": "2017-08-09T22:56:42Z",
      "side": 1,
      "message": "ASSERT is useful on an embedded device as a clear sign of failure that cannot easily be ignored by the developer. If this assert were to ever fail (eg. if our logging code is somehow busted despite previous testing, or someone adds a patch to push structs of the wrong size into our log queue) it\u0027s best to find out about it sooner rather than later, and ASSERT forces it to be sooner.\n\nIn this case, I will take your suggestion and return an error.",
      "parentUuid": "6a9c6a19_6b458ef0",
      "range": {
        "startLine": 43,
        "startChar": 1,
        "endLine": 43,
        "endChar": 41
      },

    {
      "key": {
        "uuid": "75310c34_b0fc55cf",
        "filename": "common/nvmem.c",
        "patchSetId": 2
      },
      "lineNbr": 372,
      "author": {
        "id": 1000039
      },
      "writtenOn": "2017-01-26T21:04:33Z",
      "side": 1,
      "message": "I don\u0027t see this as odd, this is the main idea of how this works. There are two partitions in flash so that there is a valid partition at all times. If there are two - the younger one is used.\n\nMutating here is necessary to make sure that nvmem_save() writes both partitions to flash. If it were called with the same contents of the cache, it would not write the second instance.",
      "revId": "e6be934ab9c87c999b11bb1e875d762c173cca43",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

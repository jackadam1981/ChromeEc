      },
      "lineNbr": 492,
      "author": {
        "id": 1002124
      },
      "writtenOn": "2016-12-16T23:53:37Z",
      "side": 1,
      "message": "OK. I think that\u0027d work.",
      "parentUuid": "da6cabba_552a9f91",
      "revId": "d9353c75fae6aa0300192b47e72d2db659773503",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

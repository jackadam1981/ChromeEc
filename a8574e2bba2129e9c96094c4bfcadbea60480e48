      "writtenOn": "2021-10-13T03:02:08Z",
      "side": 1,
      "message": "No, this blocks ec packet mode from being enabled. It\u0027s to ensure packet mode cant get in the way of flashing the EC over uart.\n\nWe need a separate bit.",
      "parentUuid": "27b5df61_66542d54",
      "range": {
        "startLine": 509,
        "startChar": 16,
        "endLine": 509,
        "endChar": 38
      },
      "revId": "a8574e2bba2129e9c96094c4bfcadbea60480e48",

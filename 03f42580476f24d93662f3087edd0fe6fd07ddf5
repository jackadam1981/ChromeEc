        "id": 1308749
      },
      "writtenOn": "2024-06-26T21:59:11Z",
      "side": 1,
      "message": "This was my suggestion, not the from the bot.\n\nMy preference is that you increment by the calculated value returned by `snprintf`.  This way if the format string changes, then you don\u0027t need to also modify the hard coded increment.",
      "parentUuid": "5e176dc8_8077906d",
      "range": {
        "startLine": 212,
        "startChar": 0,
        "endLine": 213,
        "endChar": 29
      },
      "revId": "03f42580476f24d93662f3087edd0fe6fd07ddf5",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {

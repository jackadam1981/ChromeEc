        "id": 1190764
      },
      "writtenOn": "2024-06-26T21:02:19Z",
      "side": 1,
      "message": "i\u0027m highly skeptical of this suggested edit. this is a well controlled\nsituation where using a constant should be preferred over a computed result\neven when semantics dictate that they are the same value.\nwill the bot be happier if we use snprintf()?",
      "parentUuid": "5002f115_56e63d22",
      "range": {
        "startLine": 212,
        "startChar": 0,
        "endLine": 213,
        "endChar": 29
      },
      "revId": "03f42580476f24d93662f3087edd0fe6fd07ddf5",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "d45d40bc_e7abf860",
        "filename": "zephyr/subsys/pd_controller/pdc_trace_msg.c",
        "patchSetId": 11
      },
      "lineNbr": 213,

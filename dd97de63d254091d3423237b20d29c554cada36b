        "id": 1123814
      },
      "writtenOn": "2024-08-20T23:10:00Z",
      "side": 1,
      "message": "If the CCI_EVENT flag is going to set from the resync_port_state_for_ppm() function, we should update this comment here and in the other attached state handlers we have.",
      "range": {
        "startLine": 1318,
        "startChar": 4,
        "endLine": 1318,
        "endChar": 51
      },
      "revId": "dd97de63d254091d3423237b20d29c554cada36b",

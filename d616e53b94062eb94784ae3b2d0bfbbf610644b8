      "writtenOn": "2022-01-09T23:41:13Z",
      "side": 1,
      "message": "Would it be safer to default this to 1? The Nivviks example that builds on this doesn\u0027t always have two chargers.",
      "revId": "d616e53b94062eb94784ae3b2d0bfbbf610644b8",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

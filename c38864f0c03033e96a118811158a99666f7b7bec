    },
    {
      "key": {
        "uuid": "51e536e7_9135f65a",
        "filename": "chip/npcx/system.c",
        "patchSetId": 2
      },
      "lineNbr": 257,
      "author": {
        "id": 1003000
      },
      "writtenOn": "2017-06-12T04:11:22Z",
      "side": 1,
      "message": "\u003e 2 others options (but both are potentially fragile):\n\u003e 1. Check if all registers are 0\n\nYes, this is safer than to check just for MMFS but again it can run into the same false positive issues.\n\n\u003e 2. Set an unused bit in MMFS.\n\nThis solution isn\u0027t future proof and might not always be a good idea to use a bit in there.\n\nI have added another byte-index for flags indicating validity of panic data in BBRAM.",
      "parentUuid": "772558ca_9025bb4f",

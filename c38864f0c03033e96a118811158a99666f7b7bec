        "id": 1129199
      },
      "writtenOn": "2017-06-12T02:06:38Z",
      "side": 1,
      "message": "I\u0027m not 100% convinced, what about a watchdog reset?",
      "parentUuid": "4319f7da_d5521afb",
      "range": {
        "startLine": 257,
        "startChar": 57,
        "endLine": 257,
        "endChar": 61
      },

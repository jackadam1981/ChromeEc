        "id": 1003000
      },
      "writtenOn": "2017-06-12T03:17:22Z",
      "side": 1,
      "message": "Yes, that is true. Watchdog reset will have mmfs set to 0. I did not want to waste another byte in BBRAM to just indicate that valid panic data is present. But maybe that is the only way to go. Thoughts?",
      "parentUuid": "404dbe76_3cf032aa",
      "range": {
        "startLine": 257,
        "startChar": 57,
        "endLine": 257,
        "endChar": 61
      },
      "revId": "c38864f0c03033e96a118811158a99666f7b7bec",

    {
      "key": {
        "uuid": "e61d0d9d_5cda6d32",
        "filename": "common/weaver_ng.c",
        "patchSetId": 14
      },
      "lineNbr": 53,
      "author": {
        "id": 1160200
      },
      "writtenOn": "2018-02-20T18:57:08Z",
      "side": 1,
      "message": "That isn\u0027t allowed in what ever standard the EC code is built using (probably gnu90).\n\n\"\"\"\n  CC      RW/common/weaver_ng.o\ncommon/weaver_ng.c: In function ‘create_merkle_tree’:\ncommon/weaver_ng.c:52:2: error: ‘for’ loop initial declarations are only allowed in C99 or C11 mode\n  for (param_h_t hx \u003d 1; hx \u003c param_h; ++hx) {\n\"\"\"",
      "parentUuid": "5fd38980_1b23dcb7",
      "range": {
        "startLine": 53,
        "startChar": 6,
        "endLine": 53,
        "endChar": 8
      },
      "revId": "bf47c6921a44528be02283f2358566abd5cc03c2",

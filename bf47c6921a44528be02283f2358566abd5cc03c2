    {
      "key": {
        "uuid": "88804ece_dcff6a1d",
        "filename": "common/weaver_ng.c",
        "patchSetId": 14
      },
      "lineNbr": 67,
      "author": {
        "id": 1160200
      },
      "writtenOn": "2018-02-20T18:57:08Z",
      "side": 1,
      "message": "We might want some way of encrypting the secrets that are sent over dbus. If we don\u0027t care if clear text secrets are sent over dbus, we can get rid of the asymmetric key pair. The code to handle decryption and using a session key isn\u0027t written yet.",
      "parentUuid": "d1ccbdb1_2b59967a",
      "range": {
        "startLine": 67,
        "startChar": 1,
        "endLine": 67,
        "endChar": 55
      },
      "revId": "bf47c6921a44528be02283f2358566abd5cc03c2",

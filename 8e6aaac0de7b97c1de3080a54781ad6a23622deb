    {
      "key": {
        "uuid": "b14fbbd6_f0e80aac",
        "filename": "common/main.c",
        "patchSetId": 4
      },
      "lineNbr": 48,
      "author": {
        "id": 1259838
      },
      "writtenOn": "2020-07-08T23:34:43Z",
      "side": 1,
      "message": "I have gone back and forth on this before uploading.\n\nSince I really don\u0027t think there should be anyone using this type of function outside of this file, I like keeping it here.\n\nAlso, the POR CPU speed for all devices is non-trival to research and implement since we don\u0027t already have an existing config that gives up this information.\n\nMy approach was to make the failed assumption (of CR50 reset coming) to be very noticable but not something that would require an RMA if it happened once randmonly.\n\nI want it to be noticeable since we need to correct our development assumptions",
      "parentUuid": "108542c8_0f4b18b8",
      "range": {
        "startLine": 48,
        "startChar": 53,

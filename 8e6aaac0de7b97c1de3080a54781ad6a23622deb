        "id": 1259838
      },
      "writtenOn": "2020-07-08T23:34:43Z",
      "side": 1,
      "message": "Agreed the race is between the lines you mentioned. I don\u0027t see around if at least looking at NPCX as the example. The rail isn\u0027t going to report a reset if the power rail didn\u0027t just reset",
      "parentUuid": "d98bbd5d_cbb7be5d",
      "range": {
        "startLine": 91,
        "startChar": 0,
        "endLine": 94,
        "endChar": 32
      },
      "revId": "8e6aaac0de7b97c1de3080a54781ad6a23622deb",

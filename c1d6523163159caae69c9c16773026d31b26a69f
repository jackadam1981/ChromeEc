        "id": 1003000
      },
      "writtenOn": "2017-10-31T21:21:23Z",
      "side": 1,
      "message": "Why is this required? LPC_HOST_EVENT_WAKE will be eventually overridden when state machine reaches POWER_S5.",
      "range": {
        "startLine": 233,
        "startChar": 2,
        "endLine": 237,
        "endChar": 3
      },
      "revId": "c1d6523163159caae69c9c16773026d31b26a69f",

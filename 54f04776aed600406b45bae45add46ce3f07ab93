      "writtenOn": "2022-12-13T20:08:16Z",
      "side": 1,
      "message": "Why do we need this restriction (instead of 12)?",
      "range": {
        "startLine": 353,
        "startChar": 16,
        "endLine": 353,
        "endChar": 30
      },
      "revId": "54f04776aed600406b45bae45add46ce3f07ab93",

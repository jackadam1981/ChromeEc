    {
      "key": {
        "uuid": "8c7d90d4_07606e86",
        "filename": "common/tpm_registers.c",
        "patchSetId": 2
      },
      "lineNbr": 798,
      "author": {
        "id": 1002124
      },
      "writtenOn": "2017-02-06T20:01:15Z",
      "side": 1,
      "message": "I don\u0027t see where 0 is handled any differently than -1.  See core/cortex-m0/task.c 0 is the same as -1 which is wait until an event comes in. \n\nPresumably we should always be here waiting for the reset. We either just had a power on reset or woke from deep sleep. All such cases the AP should be just coming out of reset itself so we should be waiting.",
      "parentUuid": "201e18d9_3fdc81e8",
      "revId": "5f83d5f78fec32c74dffe9da02b2a2f8c40438e0",

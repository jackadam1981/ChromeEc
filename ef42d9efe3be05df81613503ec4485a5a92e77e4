      "writtenOn": "2023-11-22T19:31:01Z",
      "side": 1,
      "message": "Maybe it\u0027s cleaner to integrate this with \u0027ectool bcfg\u0027:\n\n* ectool bcfg: Print active config.\n* ectool bcfg /path/to/json \u003cid\u003e: Program a config from json into CBI.\n* ectool bcfg \u003cindex\u003e: Read a config[index] from CBI.\n\nWDYT?",
      "range": {
        "startLine": 11969,
        "startChar": 4,
        "endLine": 11969,
        "endChar": 22
      },
      "revId": "ef42d9efe3be05df81613503ec4485a5a92e77e4",

    {
      "unresolved": true,
      "key": {
        "uuid": "01134ea9_a1a5d0f8",
        "filename": "common/usbc/usb_tc_drp_acc_trysrc_sm.c",
        "patchSetId": 2
      },
      "lineNbr": 681,

      "side": 1,
      "message": "Why should this be board specific? Could we not wait a constant time after disabling VCONN?",
      "revId": "2a151b31ab01db847466cac2e0da6b6fe211d602",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

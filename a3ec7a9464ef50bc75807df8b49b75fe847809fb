      "writtenOn": "2020-09-09T19:07:58Z",
      "side": 1,
      "message": "Isn\u0027t the TCPC already debouncing a little bit here?",
      "parentUuid": "04159303_f16e6ca3",
      "range": {
        "startLine": 2724,
        "startChar": 5,
        "endLine": 2724,
        "endChar": 32

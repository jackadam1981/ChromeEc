    {
      "unresolved": false,
      "key": {
        "uuid": "6787c40b_96a03655",
        "filename": "board/cr50/tpm2/platform.c",
        "patchSetId": 1
      },
      "lineNbr": 56,
      "author": {
        "id": 1152319
      },
      "writtenOn": "2023-02-14T04:41:14Z",
      "side": 1,
      "message": "it\u0027s before coreboot extended anything into PCR0, by including it we allow coreboot itself to modify the space. it doesn\u0027t add additional capabilities: if you have PCR0\u003d0, you know whatto extend to get it to normal or dev value so that you can change FWMP even ifwe don\u0027t allow 00s here.",
      "parentUuid": "781d03c0_34a59027",
      "range": {
        "startLine": 49,
        "startChar": 0,
        "endLine": 56,
        "endChar": 0
      },
      "revId": "8a0af9582e26005ccf435ef0c4a122111fa3b968",

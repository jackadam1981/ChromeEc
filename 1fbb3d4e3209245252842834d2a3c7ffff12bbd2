      "writtenOn": "2019-01-23T01:47:50Z",
      "side": 1,
      "message": "Is the idea hear to force the AP off earlier for SKU 70/71?",
      "range": {
        "startLine": 228,
        "startChar": 3,
        "endLine": 234,
        "endChar": 6
      },
      "revId": "1fbb3d4e3209245252842834d2a3c7ffff12bbd2",

      "writtenOn": "2023-11-22T12:22:28Z",
      "side": 1,
      "message": "Yeap, you are right, but what do you mean by \"separate\"? All those are kind of an action to do by EC, like start, stop, get, clear etc.",
      "parentUuid": "a0848d21_68e6493b",
      "range": {
        "startLine": 4738,
        "startChar": 0,
        "endLine": 4757,

      "writtenOn": "2019-03-05T18:54:23Z",
      "side": 1,
      "message": "This seems unnecessary. EC already tracks state transitions and that can be easily used to increment slp_s0ix_transitions without having to maintain a separate state machine. Please see my comment on line 402.",
      "range": {
        "startLine": 246,
        "startChar": 5,
        "endLine": 246,
        "endChar": 39
      },
      "revId": "01af02670e8db2673242e01b7dd0c613a11860f4",

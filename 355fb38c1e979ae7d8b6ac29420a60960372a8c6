      "writtenOn": "2019-06-20T16:34:43Z",
      "side": 1,
      "message": "this could be a byte pointer, no need to use 32 bits for a Boolean, also, the name is very obscure, something like \u0027tx_in_progress\u0027 would be much clearer.",
      "range": {
        "startLine": 32,
        "startChar": 1,
        "endLine": 32,
        "endChar": 12
      },
      "revId": "355fb38c1e979ae7d8b6ac29420a60960372a8c6",

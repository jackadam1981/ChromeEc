    {
      "key": {
        "uuid": "540daa35_0e767a60",
        "filename": "chip/g/usb-stream.c",
        "patchSetId": 12
      },
      "lineNbr": 245,
      "author": {
        "id": 1283719
      },
      "writtenOn": "2019-06-20T18:03:38Z",
      "side": 1,
      "message": "The variable should be designed to have zero as its initial value, which should block tx_stream_handler() proceeding.",
      "parentUuid": "7cb36a41_0d7872cf",
      "range": {
        "startLine": 245,
        "startChar": 3,
        "endLine": 245,
        "endChar": 20
      },
      "revId": "355fb38c1e979ae7d8b6ac29420a60960372a8c6",

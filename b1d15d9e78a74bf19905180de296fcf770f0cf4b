      "lineNbr": 388,
      "author": {
        "id": 1000039
      },
      "writtenOn": "2016-12-20T21:03:04Z",
      "side": 1,
      "message": "current_image_is_newer() is called on the init hook context, and system_process_retry_counter is called on the task context after the AP boots the kernel.\n\nDo you think a comment somewhere is needed?",
      "parentUuid": "57b7b6b5_a68863b2",
      "revId": "b1d15d9e78a74bf19905180de296fcf770f0cf4b",

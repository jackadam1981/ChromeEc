      "writtenOn": "2019-07-22T23:44:51Z",
      "side": 1,
      "message": "If using a PPC, you will want to call `ppc_sink_is_connected(port, 0)` and ppc_clear_oc_event_counter(port).",
      "revId": "e72dd1a8c97daa4010553fe51175472c4cccd230",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

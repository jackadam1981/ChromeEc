    {
      "key": {
        "uuid": "7509cc97_cc5204b4",
        "filename": "chip/it83xx/espi.c",
        "patchSetId": 1
      },
      "lineNbr": 478,
      "author": {
        "id": 1153134
      },
      "writtenOn": "2018-05-31T07:26:13Z",
      "side": 1,
      "message": "No, this is the last interrupt event which enable by bit7@ESGCTRL1.\nWe can get more information at section 6.1.3.5 \"Expression of eSPI Interrupt Events\" from the datasheet.\nInterrupt events of ESUCTRL0 bit2-1 are control by bit5@ESUCTRL0, and we didn\u0027t enable it.",
      "parentUuid": "6e2a601b_a3f5e78a",
      "range": {
        "startLine": 475,
        "startChar": 1,
        "endLine": 478,
        "endChar": 53
      },

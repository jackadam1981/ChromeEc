      "writtenOn": "2022-10-25T15:08:44Z",
      "side": 1,
      "message": "nit: It might be helpful to have the function return either int or `enum ec_error_list` (i.e. `EC_SUCCESS`) so that the benchmark can bail out if the test fails for some reason, rather than potentially providing bad benchmark data.",
      "range": {
        "startLine": 68,
        "startChar": 58,
        "endLine": 68,
        "endChar": 62
      },
      "revId": "2840be03b49b45fbe2d23471d372d9955303b9ed",

/ {
	named-gpios {
		compatible = "named-gpios";

		ec_flash_wp_odl {
			gpios = <&gpio9 4 (GPIO_INPUT | GPIO_PULL_UP)>;
			enum-name = "GPIO_WP_L";
		};
		gpio_bc_acok: bc_acok {
			gpios = <&gpioc 6 GPIO_INPUT>;
			enum-name = "GPIO_AC_PRESENT";
		};
		ec_pch_pwr_btn {
			gpios = <&gpio9 7 GPIO_ODR_HIGH>;
			enum-name = "GPIO_PCH_PWRBTN_L";
		};
		gpio_pwr_btn_odl: pwr_btn_odl {
			gpios = <&gpio0 0 GPIO_INPUT>;
			enum-name = "GPIO_POWER_BUTTON_L";
		};
		gpio_smc_lid: smc_lid {
			gpios = <&gpio0 1 GPIO_INPUT>;
			enum-name = "GPIO_LID_OPEN";
		};
		ec_entering_rw {
			gpios = <&gpiod 4 GPIO_OUT_LOW>;
			enum-name = "GPIO_ENTERING_RW";
		};
		ec_h1_packet_mode {
			gpios = <&gpio2 2 GPIO_OUT_LOW>;
			enum-name = "GPIO_PACKET_MODE_EN";
		};
		pm_rsmrst_n {
			gpios = <&gpiod 3 GPIO_INPUT>;
			enum-name = "GPIO_PCH_RSMRST_L";
		};
		rsmrst_pwrgd {
			gpios = <&gpio3 7 GPIO_OUT_LOW>;
			enum-name = "GPIO_PG_EC_RSMRST_ODL";
		};
		smc_wake_sci_n_mecc {
			gpios = <&gpioa 4 GPIO_OUT_LOW>;
			enum-name = "GPIO_EC_PCH_WAKE_ODL";
		};
		prochot_ec {
			gpios = <&gpioa 7 GPIO_INPUT>;
			enum-name = "GPIO_CPU_PROCHOT";
		};
		sys_rst_odl {
			gpios = <&gpioc 5 GPIO_ODR_HIGH>;
			enum-name = "GPIO_SYS_RST_ODL";
		};
		slp_sus_ec {
			gpios = <&gpio8 6 GPIO_INPUT>;
			enum-name = "GPIO_SLP_SUS_L";
		};
		vccpdsw_3p3 {
			gpios = <&gpio4 5 GPIO_INPUT>;
			enum-name = "GPIO_PG_EC_DSW_PWROK";
		};
		all_sys_pwrgd {
			gpios = <&gpio7 0 GPIO_INPUT>;
			enum-name = "GPIO_PG_EC_ALL_SYS_PWRGD";
		};
		p3300_en {
			gpios = <&gpioc 4 GPIO_OUT_LOW>;
			enum-name = "GPIO_EN_PP3300_A";
		};
		sys_pwrok {
			gpios = <&gpio9 3 GPIO_OUT_LOW>;
			enum-name = "GPIO_EC_PCH_SYS_PWROK";
		};
		ec_dsw_pwrok {
			gpios = <&gpio9 5 GPIO_OUT_LOW>;
			enum-name = "GPIO_PCH_DSW_PWROK";
		};
		rsmrst_pwrgd {
			gpios = <&gpio3 7 GPIO_INPUT>;
			enum-name = "GPIO_PG_EC_RSMRST_ODL";
		};
		pch_slp_s0 {
			gpios = <&gpioa 1 GPIO_INPUT>;
			enum-name = "GPIO_PCH_SLP_S0_L";
		};
		pm_slp_s3 {
			gpios = <&gpiob 0 GPIO_INPUT>;
			enum-name = "GPIO_PCH_SLP_S3_L";
		};
		pm_slp_s4 {
			gpios = <&gpioa 5 GPIO_INPUT>;
			enum-name = "GPIO_PCH_SLP_S4_L";
		};
		ec_spi_oe_mecc {
			gpios = <&gpio6 0 GPIO_OUT_LOW>;
			enum-name = "GPIO_EC_SPI_OE_MECC";
		};
		pch_pwrok_ec {
			gpios = <&gpioa 0 GPIO_INPUT>;
			enum-name = "GPIO_PCH_PWROK";
		};
	};

	hibernate-wake-pins {
		compatible = "cros-ec,hibernate-wake-pins";
		wakeup-pins = <
			&gpio_bc_acok
			&gpio_pwr_btn_odl
			&gpio_smc_lid
		>;
	};
};

/ {
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;
		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			tcpc {
				compatible = "fairchild,fusb302";
				status = "okay";
				port = <&typec_0>;
				i2c-addr-flags = "FUSB302_I2C_ADDR_FLAGS";
			};
			chg {
				compatible = "intersil,isl9241";
				status = "okay";
				port = <&i2c_charger>;
			};
			usb-muxes = <&usb_c0_bb_retimer &virtual_mux_c0>;
		};
		port0-muxes {
			usb_c0_bb_retimer: jhl8040r-c0 {
				compatible = "intel,jhl8040r";
				port = <&typec_0>;
				i2c-addr-flags = <0x56>;
				reset-pin = <&usb_c0_bb_retimer_rst>;
				ls-en-pin = <&usb_c0_bb_retimer_ls_en>;
			};
			usb_c0_soc_side_bb_retimer: jhl8040r-c0-soc-side {
				compatible = "intel,jhl8040r";
				port = <&typec_0>;
				i2c-addr-flags = <0x54>;
				reset-pin = <&usb_c0_bb_retimer_rst>;
				ls-en-pin = <&usb_c0_bb_retimer_ls_en>;
			};
			virtual_mux_c0: virtual-mux-c0 {
				compatible = "cros-ec,usbc-mux-virtual";
			};
		};

		usbc_port1: port1@1 {
			compatible = "named-usbc-port";
			reg = <1>;
			tcpc {
				compatible = "fairchild,fusb302";
				status = "okay";
				port = <&typec_1>;
				i2c-addr-flags = "FUSB302_I2C_ADDR_FLAGS";
			};
			usb-muxes = <&usb_c1_bb_retimer &virtual_mux_c1>;
		};
		port1-muxes {
			usb_c1_bb_retimer: jhl8040r-c1 {
				compatible = "intel,jhl8040r";
				port = <&typec_1>;
				i2c-addr-flags = <0x57>;
				reset-pin = <&usb_c1_bb_retimer_rst>;
				ls-en-pin = <&usb_c1_bb_retimer_ls_en>;
			};
			usb_c1_soc_side_bb_retimer: jhl8040r-c1-soc-side {
				compatible = "intel,jhl8040r";
				port = <&typec_0>;
				i2c-addr-flags = <0x55>;
				reset-pin = <&usb_c1_bb_retimer_rst>;
				ls-en-pin = <&usb_c1_bb_retimer_ls_en>;
			};
			virtual_mux_c1: virtual-mux-c1 {
				compatible = "cros-ec,usbc-mux-virtual";
			};
		};

		port2@2 {
			compatible = "named-usbc-port";
			reg = <2>;
			tcpc {
				compatible = "fairchild,fusb302";
				status = "okay";
				port = <&typec_2>;
				i2c-addr-flags = "FUSB302_I2C_ADDR_FLAGS";
			};
			usb-muxes = <&usb_c2_bb_retimer &virtual_mux_c2>;
		};
		port2-muxes {
			usb_c2_bb_retimer: jhl8040r-c2 {
				compatible = "intel,jhl8040r";
				port = <&typec_2>;
				i2c-addr-flags = <0x58>;
				reset-pin = <&usb_c2_bb_retimer_rst>;
				ls-en-pin = <&usb_c2_bb_retimer_ls_en>;
			};
			virtual_mux_c2: virtual-mux-c2 {
				compatible = "cros-ec,usbc-mux-virtual";
			};
		};

		port3@3 {
			compatible = "named-usbc-port";
			reg = <3>;
			tcpc {
				compatible = "fairchild,fusb302";
				status = "okay";
				port = <&typec_3>;
				i2c-addr-flags = "FUSB302_I2C_ADDR_FLAGS";
			};
			usb-muxes = <&usb_c3_bb_retimer &virtual_mux_c3>;
		};
		port3-muxes {
			usb_c3_bb_retimer: jhl8040r-c3 {
				compatible = "intel,jhl8040r";
				port = <&typec_3>;
				i2c-addr-flags = <0x59>;
				reset-pin = <&usb_c3_bb_retimer_rst>;
				ls-en-pin = <&usb_c3_bb_retimer_ls_en>;
			};
			virtual_mux_c3: virtual-mux-c3 {
				compatible = "cros-ec,usbc-mux-virtual";
			};
		};
	};
	usbc-alt-chips {
		usb_port0_soc_side_mux: alt-chain-port0 {
			compatible = "cros-ec,alt-usb-mux-chain";
			alternate-for = <&usbc_port0>;
			usb-muxes = <&usb_c0_bb_retimer
				     &usb_c0_soc_side_bb_retimer
				     &virtual_mux_c0>;
		};
		c0-soc-side-bb-retimer {
			compatible = "cros-ec,alt-usb-mux";
			port = <&usbc_port0>;
			usb-mux = <&usb_c0_soc_side_bb_retimer>;
		};
		usb_port1_soc_side_mux: alt-chain-port1 {
			compatible = "cros-ec,alt-usb-mux-chain";
			alternate-for = <&usbc_port1>;
			usb-muxes = <&usb_c1_bb_retimer
				     &usb_c1_soc_side_bb_retimer
				     &virtual_mux_c1>;
		};
		c1-soc-side-bb-retimer {
			compatible = "cros-ec,alt-usb-mux";
			port = <&usbc_port1>;
			usb-mux = <&usb_c1_soc_side_bb_retimer>;
		};
	};
};

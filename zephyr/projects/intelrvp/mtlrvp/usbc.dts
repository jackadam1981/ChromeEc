/ {
        usbc {
                #address-cells = <1>;
                #size-cells = <0>;
                port0@0 {
                        compatible = "named-usbc-port";
                        reg = <0>;
                        tcpc {
                                compatible = "nuvoton,nct38xx";
                                gpio-dev = <&nct38xx_C0>;
                        };
			chg {
				compatible = "intersil,isl9241";
				status = "okay";
				port = <&i2c_charger>;
			};
                };

                port1@1 {
                        compatible = "named-usbc-port";
                        reg = <1>;
                        tcpc {
                                compatible = "nuvoton,nct38xx";
                                gpio-dev = <&nct38xx_C1>;
                        };
                };
        };
};


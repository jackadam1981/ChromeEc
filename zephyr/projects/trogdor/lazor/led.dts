/ {
	gpio-led {
		compatible = "gpio-led";

		brightness_range: brightness-range {
			compatible = "led-brightness-range";

			brightness-range-battery = < 0x0 /* Red */
						     0x0 /* Green */
						     0x1 /* Blue */
						     0x0 /* Yellow */
						     0x0 /* White */
						     0x1 /* Amber */
						    >;
		};

		battery-led-colors {
			compatible = "battery-led-colors";

			power-state-charge {
				charge-state = "PWR_STATE_CHARGE";
				chipset-state = "NONE";
				period = <0>;

				color-1 {
					led-color = "LED_AMBER";
				};
			};

			power-state-discharge-s0 {
				charge-state = "PWR_STATE_DISCHARGE";
				chipset-state = "S0";
				period = <0>;

				color-1 {
					led-color = "LED_BLUE";
				};
			};

			power-state-discharge-s3 {
				charge-state = "PWR_STATE_DISCHARGE";
				chipset-state = "S3";
				period = <4>;

				color-1 {
					led-color = "LED_BLUE";
				};
				color-2 {
					led-color = "LED_OFF";
				};
			};

			power-state-discharge-s5 {
				charge-state = "PWR_STATE_DISCHARGE";
				chipset-state = "S5";
				period = <0>;

				color-1 {
					led-color = "LED_BLUE";
				};
			};

			power-state-error {
				charge-state = "PWR_STATE_ERROR";
				chipset-state = "NONE";
				period = <2>;

				color-1 {
					led-color = "LED_AMBER";
				};
				color-2 {
					led-color = "LED_OFF";
				};
			};

			power-state-near-full {
				charge-state = "PWR_STATE_CHARGE_NEAR_FULL";
				chipset-state = "NONE";
				period = <0>;

				color-1 {
					led-color = "LED_BLUE";
				};
			};

			power-state-idle {
				charge-state = "PWR_STATE_IDLE";
				chipset-state = "NONE";
				period = <4>;
				chflags; // Bool

				color-1 {
					led-color = "LED_BLUE";
				};
				color-2 {
					led-color = "LED_AMBER";
				};
				color-3 {
					led-color = "LED_BLUE";
				};
			};
		};


		led_control: led-control {
			compatible = "led-control";

			led-color = "LED_BLUE";
		};
	};
};

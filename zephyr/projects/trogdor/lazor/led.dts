/ {
	gpio-led {
		compatible = "gpio-led-behavior";

		brightness_range: brightness-range {
			compatible = "cros-ec,led-brightness-range";

			brightness-range-battery = < 0x0 /* Red */
						     0x0 /* Green */
						     0x1 /* Blue */
						     0x0 /* Yellow */
						     0x0 /* White */
						     0x1 /* Amber */
						    >;
		};

		battery-led-colors {
			compatible = "cros-ec,battery-led-colors";

			power-state-charge {
				charge-state = "PWR_STATE_CHARGE";

				color-1 {
					led-color = "LED_AMBER";
				};
			};

			power-state-discharge-s0 {
				charge-state = "PWR_STATE_DISCHARGE";
				chipset-state = "S0";

				color-1 {
					led-color = "LED_BLUE";
				};
			};

			power-state-discharge-s3 {
				charge-state = "PWR_STATE_DISCHARGE";
				chipset-state = "S3";

				/* Amber 1 sec, off 3 sec */
				color-1 {
					led-color = "LED_AMBER";
					period = <1>;
				};
				color-2 {
					led-color = "LED_OFF";
					period = <4>;
				};
			};

			power-state-discharge-s5 {
				charge-state = "PWR_STATE_DISCHARGE";
				chipset-state = "S5";

				color-1 {
					led-color = "LED_OFF";
				};
			};

			power-state-error {
				charge-state = "PWR_STATE_ERROR";

				/* Amber 1 sec, off 1 sec */
				color-1 {
					led-color = "LED_AMBER";
					period = <1>;
				};
				color-2 {
					led-color = "LED_OFF";
					period = <1>;
				};
			};

			power-state-near-full {
				charge-state = "PWR_STATE_CHARGE_NEAR_FULL";

				color-1 {
					led-color = "LED_BLUE";
				};
			};

			power-state-idle-forced {
				charge-state = "PWR_STATE_IDLE";
				extra-flag = "CHFLAG_FORCE_IDLE";

				/* Blue 2 sec, Amber 2 sec */
				color-1 {
					led-color = "LED_BLUE";
					period = <2>;
				};
				color-2 {
					led-color = "LED_AMBER";
					period = <2>;
				};
			};

			power-state-idle-default {
				charge-state = "PWR_STATE_IDLE";
				extra-flag = "CHFLAG_DEFAULT";

				color-1 {
					led-color = "LED_BLUE";
				};
			};
		};

		led_control: led-control {
			compatible = "cros-ec,led-control";

			led-color = "LED_BLUE";
		};
	};
};

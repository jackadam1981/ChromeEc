#include <dt-bindings/colors.h>

/ {
	gpio_leds: gpio-leds {
		compatible = "cros-ec,gpio-leds";

		gpios = <&gpioc 3 0>,
			<&gpioc 4 0>;
		label = "EC_LED_ID_BATTERY_LED";
		color-list = <AMBER BLUE>;
		/*
		 * First value is amber LED,
		 * second blue LED,
		 * third duration in tenths of a second.
		 */

		led_off: off {
			colors = <0 0 0>;
		};

		amber: amber {
			colors = <1 0 0>;
		};
		blue: blue {
			colors = <0 1 0>;
		};
		amber1_blue3: amber1_blue3 {
			colors = <1 0 10>;
			colors = <0 1 30>;
		};
		amber_slow_flash: amber1_off3 {
			colors = <1 0 10>;
			colors = <0 0 30>;
		};
		amber_fast_flash: amber1_off1 {
			colors = <1 0 10>;
			colors = <0 0 10>;
		};
		amber_blue: amber2_blue2 {
			colors = <1 0 20>;
			colors = <0 1 20>;
		};
	};

	led-policy {
		compatible = "cros-ec,led-policy";

		led = <&gpio_leds>;

		charging {
			charger = "CHARGING";
			action = <&amber>;
		};
		discharging-s0 {
			cpu = "RUNNING";
			charger = "DISCHARGING";
			action = <&blue>;
		};
		discharging-s3 {
			cpu = "SUSPENDED";
			charger = "DISCHARGING";
			action = <&amber_slow_flash>;
		};
		discharging-s6 {
			cpu = "POWER_OFF";
			charger = "DISCHARGING";
			action = <&led_off>;
		};
		discharging-error {
			charger = "ERROR";
			action = <&amber_fast_flash>;
		};
		battery-full {
			charger = "FULL";
			action = <&blue>;
		};
		charging-idle {
			charger = "IDLE";
			action = <&amber_blue>;
		};
		default {
			action = <&blue>;
		};
	};
};

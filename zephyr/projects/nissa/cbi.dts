/ {
	cbi_fw_config {
		compatible = "named-cbi-fw-config";

		field1 {
			enum-name = "FIELD1";
			start = <0>;
			size = <2>;

			option1 {
				enum-name = "OPTION1";
				compatible = "named-cbi-fw-config-value";
				value = <1>;
			};
			option2 {
				enum-name = "OPTION2";
				compatible = "named-cbi-fw-config-value";
				value = <2>;
			};
		};

		field2 {
			enum-name = "FIELD2";
			start = <2>;
			size = <3>;

			option1 {
				enum-name = "OPTION1";
				compatible = "named-cbi-fw-config-value";
				value = <1>;
			};
			option2 {
				enum-name = "OPTION2";
				compatible = "named-cbi-fw-config-value";
				value = <2>;
			};
		};
	};
};

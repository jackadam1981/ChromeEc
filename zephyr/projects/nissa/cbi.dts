/ {
	nissa-fw-config {
		compatible = "named-cbi-fw-config";

		field-1 {
			enum-name = "FW_CONFIG_X";
			start = <0>;
			size = <2>;

			option-1 {
				compatible = "named-cbi-fw-config-value";
				enum-name = "FW_X_OPTION_1";
				value = <1>;
			};
			option-2 {
				compatible = "named-cbi-fw-config-value";
				enum-name = "FW_X_OPTION_2";
				value = <2>;
			};
		};

		field-2 {
			enum-name = "FW_CONFIG_Y";
			start = <2>;
			size = <3>;

			option-1 {
				compatible = "named-cbi-fw-config-value";
				enum-name = "FW_Y_OPTION_1";
				value = <5>;
			};
			option-2 {
				compatible = "named-cbi-fw-config-value";
				enum-name = "FW_Y_OPTION_2";
				value = <6>;
			};
		};
	};
};

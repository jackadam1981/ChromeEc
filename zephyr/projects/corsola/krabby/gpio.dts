			enum-name = "GPIO_HDMI_PRSNT_ODL";
			label = "HDMI_PRSNT_ODL";
		};
		packet_mode_en: packet_mode_en {
			gpios = <&gpiod 4 (GPIO_INPUT | GPIO_PULL_DOWN)>;
			enum-name = "GPIO_PACKET_MODE_EN";
			label = "PACKET_MODE_EN";
		};
		pg_pp5000_z2_od: pg_pp5000_z2_od {
			gpios = <&gpiod 2 (GPIO_INPUT | GPIO_PULL_DOWN)>;
			enum-name = "GPIO_PG_PP5000_Z2_OD";
			label = "PG_PP5000_Z2_OD";
		};
		pg_mt6315_proc_b_odl: pg_mt6315_proc_b_odl {
			gpios = <&gpioe 1 (GPIO_INPUT | GPIO_PULL_DOWN)>;
			enum-name = "GPIO_PG_MT6315_PROC_B_ODL";
			label = "PG_MT6315_PROC_B_ODL";
		};
		ec_pen_chg_dis_odl: ec_pen_chg_dis_odl {

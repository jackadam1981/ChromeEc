		};
		ac_present: ac_present {
			gpios = <&gpioe 5 GPIO_INPUT>;
			enum-name = "GPIO_AC_PRESENT";
			label = "AC_PRESENT";
		};
		uart1_rx: uart1_rx {
			gpios = <&gpiob 0 GPIO_INPUT>;
			enum-name = "GPIO_UART1_RX";
			label = "UART1_RX";
		};
		wp: wp {

/dts-v1/;

#include <cros/ite/it8xxx2.dtsi>
#include <dt-bindings/gpio_defines.h>
#include <it8xxx2.dtsi>

/ {
	model = "IT8XXX2 EV-Board";
	compatible = "riscv, it8xxx2_evb";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,flash = &flash0;
	};

	named-gpios {
		compatible = "named-gpios";

		pch_smi_l {
			gpios = <&gpiod 3 GPIO_OUT_HIGH>;
			label = "PCH_SMI_L";
		};
		pch_sci_l {
			gpios = <&gpiod 4 GPIO_OUT_HIGH>;
			label = "PCH_SCI_L";
		};
		gate_a20_h {
			gpios = <&gpiob 5 GPIO_OUT_HIGH>;
			label = "GATE_A20_H";
		};
		sys_reset_l {
			gpios = <&gpiob 6 GPIO_OUT_HIGH>;
			label = "SYS_RESET_L";
		};
		lpc_clkrun_l {
			gpios = <&gpioh 0 GPIO_OUT_LOW>;
			label = "LPC_CLKRUN_L";
		};
		pch_wake_l {
			gpios = <&gpiob 7 GPIO_OUT_HIGH>;
			label = "PCH_WAKE_L";
		};
		i2c_a_scl {
			gpios = <&gpiob 3 GPIO_INPUT>;
			label = "I2C_A_SCL";
		};
		i2c_a_sda {
			gpios = <&gpiob 4 GPIO_INPUT>;
			label = "I2C_A_SDA";
		};
		i2c_b_scl {
			gpios = <&gpioc 1 GPIO_INPUT>;
			label = "I2C_B_SCL";
		};
		i2c_b_sda {
			gpios = <&gpioc 2 GPIO_INPUT>;
			label = "I2C_B_SDA";
		};
		i2c_c_scl {
			gpios = <&gpiof 6 GPIO_INPUT>;
			label = "I2C_C_SCL";
		};
		i2c_c_sda {
			gpios = <&gpiof 7 GPIO_INPUT>;
			label = "I2C_C_SDA";
		};
		i2c_e_scl {
			gpios = <&gpioe 0 GPIO_INPUT>;
			label = "I2C_E_SCL";
		};
		i2c_e_sda {
			gpios = <&gpioe 7 GPIO_INPUT>;
			label = "I2C_E_SDA";
		};
		uart2_sin1 {
			gpios = <&gpioh 1 GPIO_INPUT>;
			label = "UART2_SIN1";
		};
		uart2_sout1 {
			gpios = <&gpioh 2 GPIO_INPUT>;
			label = "UART2_SOUT1";
		};
		power_button_l {
			gpios = <&gpioe 4 GPIO_INPUT_PULL_UP>;
			label = "POWER_BUTTON_L";
		};
		pch_pltrst_l {
			gpios = <&gpioe 3 GPIO_INPUT_PULL_UP>;
			label = "PCH_PLTRST_L";
		};
		lid_open {
			gpios = <&gpioe 2 GPIO_INPUT_PULL_UP>;
			label = "LID_OPEN";
		};
		wp_l {
			gpios = <&gpioi 4 GPIO_INPUT_PULL_UP>;
			label = "WP_L";
		};
		uart1_rx {
			gpios = <&gpiob 0 GPIO_INPUT_PULL_UP>;
			label = "UART1_RX";
		};

		board_version1 {
			gpios = <&gpio_ksoh 5 GPIO_INPUT>;
			label = "BOARD_VERSION1";
		};
		board_version2 {
			gpios = <&gpio_ksoh 6 GPIO_INPUT>;
			label = "BOARD_VERSION2";
		};
		board_version3 {
			gpios = <&gpio_ksoh 7 GPIO_INPUT>;
			label = "BOARD_VERSION3";
		};

		entering_rw {
			gpios = <&gpio_ksoh 4 GPIO_INPUT>;
			label = "ENTERING_RW";
		};
	};

	named-adc-channels {
		compatible = "named-adc-channels";

		adc_vbussa: vbussa {
			label = "ADC_VBUSSA";
			channel = <0>;
		};
		adc_vbussb: vbussb {
			label = "ADC_VBUSSB";
			channel = <1>;
		};
		adc_evb_ch_13: evb_ch_13 {
			label = "ADC_EVB_CH_13";
			channel = <2>;
		};
		adc_evb_ch_14: evb_ch_14 {
			label = "ADC_EVB_CH_14";
			channel = <3>;
		};
		adc_evb_ch_15: evb_ch_15 {
			label = "ADC_EVB_CH_15";
			channel = <4>;
		};
		adc_evb_ch_16: evb_ch_16 {
			label = "ADC_EVB_CH_16";
			channel = <5>;
		};
	};

	named-i2c-ports {
		compatible = "named-i2c-ports";
		battery {
			i2c-port = <&i2c0>;
			label = "BATTERY";
		};
		evb-1 {
			i2c-port = <&i2c1>;
			label = "EVB_1";
		};
		evb-2 {
			i2c-port = <&i2c2>;
			label = "EVB_2";
		};
		opt-4 {
			i2c-port = <&i2c3>;
			label = "OPT_4";
		};
	};

	named-pwms {
		compatible = "named-pwms";

	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	clock-frequency = <1804800>;
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c2 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c3 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&adc0 {
	status = "okay";
};

/* Sleep flag */
&pwm0 {
	status = "okay";
};

/* Fan control */
&pwm1 {
	status = "okay";
};


/ {
	chosen {
		intel-ap-pwrseq,espi = &espi0;
	};

	common-pwrseq {
		compatible = "intel,ap-pwrseq";

		en-pp5000-s5-gpios = <&gpiob 6 0>;
		pg-ec-rsmrst-odl-gpios = <&gpioe 2 0>;
		ec-pch-rsmrst-odl-gpios = <&gpioa 6 0>;
		pg-ec-dsw-pwrok-gpios = <&gpioc 7 0>;
		slp-s3-l-gpios = <&gpioa 5 0>;
		pg-ec-all-sys-pwrgd-gpios = <&gpiof 4 0>;
		slp-sus-l-gpios = <&gpiof 1 0>;

		vccst-pwrgd-od-gpios = <&gpioa 4 0>;
		imvp9-vrrdy-od-gpios = <&gpio4 3 0>;
		pch-pwrok-gpios = <&gpio7 2 0>;
		ec-pch-sys-pwrok-gpios = <&gpio3 7 0>;
		sys-rst-l-gpios = <&gpioc 5 0>;
	};
};

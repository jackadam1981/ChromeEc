/ {
	pwrseq_signals_list: pwrseq-signals-list {
		compatible = "ap-pwrseq-signal-list";
		pwrseq-signals-required = <8>;

		pwrseq_slp_s0 {
			dbg-label = "SLP_S0_DEASSERTED";
			pwrseq-gpio-node = <&gpio_slp_s0_l>;
			pwrseq-signal-enum = "X86_SLP_S0_DEASSERTED";
			flags = <0x1>;
		};
		pwrseq_slp_s3 {
			dbg-label = "SLP_S3_DEASSERTED";
			pwrseq-gpio-node = <&gpio_slp_s3_l>;
			pwrseq-signal-enum = "X86_SLP_S3_DEASSERTED";
			flags = <0x1>;
		};
		pwrseq_slp_s4 {
			dbg-label = "SLP_S4_DEASSERTED";
			pwrseq-vw-enum = "ESPI_VWIRE_SIGNAL_SLP_S4";
			pwrseq-signal-enum = "X86_SLP_S4_DEASSERTED";
			flags = <0x1>;
		};
		pwrseq_slp_s5 {
			dbg-label = "SLP_S5_DEASSERTED";
			pwrseq-vw-enum = "ESPI_VWIRE_SIGNAL_SLP_S5";
			pwrseq-signal-enum = "X86_SLP_S5_DEASSERTED";
			flags = <0x1>;
		};
		pwrseq_slp_sus {
			dbg-label = "SLP_SUS_DEASSERTED";
			pwrseq-gpio-node = <&gpio_slp_sus_l>;
			pwrseq-signal-enum = "X86_SLP_SUS_DEASSERTED";
			flags = <0x1>;
		};
		pwrseq_rsmrst {
			dbg-label = "RSMRST_L_PGOOD";
			pwrseq-gpio-node = <&gpio_pg_ec_rsmrst_odl>;
			pwrseq-signal-enum = "X86_RSMRST_L_PGOOD";
			flags = <0x1>;
		};
		pwrseq_dsw_pwrok {
			dbg-label = "DSW_DPWROK";
			pwrseq-gpio-node = <&gpio_pg_ec_dsw_pwrok>;
			pwrseq-signal-enum = "X86_DSW_PWROK";
			flags = <0x1>;
		};
		pwrseq_all_sys_pwrgd {
			dbg-label = "ALL_SYS_PWRGD";
			pwrseq-gpio-node = <&gpio_pg_ec_all_sys_pwrgd>;
			pwrseq-signal-enum = "X86_ALL_SYS_PGOOD";
			flags = <0x1>;
		};
	};

	/*
	 * Example of power signal gpio list element
	 * {
	 *	.net_name = "GPIO_PCH_EC_SLP_S0_L",
	 *	.power_sig = X86_SLP_S0_DEASSERTED,
	 *	.flags = POWER_SIGNAL_ACTIVE_HIGH,
	 *	.name = "SLP_S0_DEASSERTED",
	 * },
	 *
	 * Example of power signal vw list element
	 * {
	 *	.vw_signal = ESPI_VWIRE_SIGNAL_SLP_S4,
	 *	.power_sig = X86_SLP_S4_DEASSERTED,
	 *	.flags = POWER_SIGNAL_ACTIVE_HIGH,
	 *	.name = "SLP_S4_DEASSERTED",
	 * },
	 *
	 * Generate power signals list in this order
	 * enum power_signal {
	 *	X86_SLP_S0_DEASSERTED,
	 *	X86_SLP_S3_DEASSERTED,
	 *	X86_SLP_S4_DEASSERTED,
	 *	X86_SLP_S5_DEASSERTED,
	 *	X86_SLP_SUS_DEASSERTED,
	 *	X86_RSMRST_L_PGOOD,
	 *	X86_DSW_PWROK,
	 *	X86_ALL_SYS_PGOOD,
	 *	POWER_SIGNAL_COUNT
	 * };
	 */
};

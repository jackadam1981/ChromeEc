/ {
	named-pwms {
		compatible = "named-pwms";

		led2: led2  {
			#pwm-cells = <0>;
			pwms = <&pwm0 0 PWM_POLARITY_INVERTED>;
			label = "LED2";
			frequency = <4800>;
		};
		led3: led3 {
			#pwm-cells = <0>;
			pwms = <&pwm1 0 PWM_POLARITY_INVERTED>;
			label = "LED3";
			frequency = <4800>;
		};
		led1: led1 {
			#pwm-cells = <0>;
			pwms = <&pwm2 0 PWM_POLARITY_INVERTED>;
			label = "LED1";
			frequency = <4800>;
		};
		kblight {
			pwms = <&pwm3 0 0>;
			label = "KBLIGHT";
			frequency = <2400>;
		};
		pwm_fan: fan {
			pwms = <&pwm5 0 0>;
			label = "FAN";
			frequency = <1000>;
		};
		led4: led4 {
			#pwm-cells = <0>;
			pwms = <&pwm7 0 PWM_POLARITY_INVERTED>;
			label = "LED4";
			frequency = <4800>;
		};
	};
};

/* LED2 */
&pwm0 {
	status = "okay";
	clock-bus = "NPCX_CLOCK_BUS_LFCLK";
};

/* LED3 */
&pwm1 {
	status = "okay";
	clock-bus = "NPCX_CLOCK_BUS_LFCLK";
};

/* LED1 */
&pwm2 {
	status = "okay";
	clock-bus = "NPCX_CLOCK_BUS_LFCLK";
};

/* Keyboard backlight */
&pwm3 {
	status = "okay";
};

/* Fan control */
&pwm5 {
	status = "okay";
	drive-open-drain;
};

/* LED4 */
&pwm7 {
	status = "okay";
	clock-bus = "NPCX_CLOCK_BUS_LFCLK";
};

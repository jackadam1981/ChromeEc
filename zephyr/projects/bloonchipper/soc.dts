#include <cros/st/stm32f4.dtsi>

&flash {
	st,rdp1-enable-byte = <0x00>;
};

&iwdg {
        status = "okay";
};

&timers2 {
        status = "okay";
        counter {
                status = "okay";
        };
};

&timers9 {
        status = "okay";
        counter {
                status = "okay";
        };
};

&dma1 {
        status = "okay";
};

&dma2 {
        status = "okay";
};

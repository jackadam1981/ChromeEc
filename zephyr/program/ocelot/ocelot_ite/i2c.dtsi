&i2c0 {
	status = "disabled";
};

pd_pow_i2c: &i2c1 {
	label = "I2C_PORT_PD";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c3 {
	status = "disabled";
};

charger_i2c: &i2c4 {
	label = "I2C_PORT_CHARGER";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c5 {
	status = "disabled";
};

/* named-i2c-ports defined by shared i2c.dtsi below. */
/delete-node/ &{/named-i2c-ports};

#include "../i2c.dtsi"

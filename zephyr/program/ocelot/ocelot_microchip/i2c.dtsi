/ {
	named-i2c-ports {
		compatible = "named-i2c-ports";

		i2c_charger: charger {
			i2c-port = <&charger_i2c>;
			enum-names = "I2C_PORT_CHARGER";
		};
		ec_pd_power: typec-aic1-power {
			i2c-port = <&pd_pow_i2c>;
			enum-names = "I2C_PORT_PD";
		};
	};
};

/* charger */
charger_i2c: &i2c_smb_0 {
	label = "I2C_CHARGER";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c00_scl_gpio004 &i2c00_sda_gpio003>;
	pinctrl-names = "default";
	port-sel = <0>;
	status = "okay";

	it8801_mfd: it8801@39 {
		compatible = "ite,it8801-mfd";
		reg = <0x39>;
	};
	pca95xx_0: pca95xx@22 {
		compatible = "nxp,pca95xx";
		label = "PCA95XX";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};
	pca95xx_1: pca95xx@23 {
		compatible = "nxp,pca95xx";
		label = "PCA95XX";
		reg = <0x23>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};
	rvp_board_id: rvp-board-id {
		compatible = "intel,rvp-board-id";
		bom-gpios = <&pca95xx_0 14 0>, <&pca95xx_0 15 0>,
			    <&pca95xx_0 0 0>;

		fab-gpios = <&pca95xx_0 1 0>, <&pca95xx_0 2 0>;

		board-gpios = <&pca95xx_0 8 0>, <&pca95xx_0 9 0>,
			      <&pca95xx_0 10 0>, <&pca95xx_0 11 0>,
			      <&pca95xx_0 12 0>, <&pca95xx_0 13 0>;
	};
};

/* typec-aic1-power */
pd_pow_i2c: &i2c_smb_1 {
	label = "I2C_PD_POWER";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c06_scl_gpio140 &i2c06_sda_gpio132>;
	pinctrl-names = "default";
	port-sel = <6>;
	status = "okay";
};

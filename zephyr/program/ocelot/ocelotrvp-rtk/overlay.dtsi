/* Set bus speeds for I2C */
&i2c_0 {
	label = "I2C_PORT_BATTERY";
	label = "I2C_PORT_CHARGER";
	label = "I2C_PORT_PORT80";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	charger: isl9538@9 {
		compatible = "intersil,isl923x";
		status = "okay";
		reg = <0x9>;
	};

	max695x@38 {
		compatible = "maxim,max695x";
		reg = <0x38>;
	};
};

&i2c_1 {
	label = "I2C_SENSOR";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i2c_3 {
	label = "I2C_PORT_PD";
	clock-frequency = <I2C_BITRATE_FAST_PLUS>;

	pdc_power_p0: rts54-pdc@66 {
		compatible = "realtek,rts54-pdc";
		reg = <0x66>;
		irq-gpios = <&gpiob 11 GPIO_ACTIVE_LOW>;
		ccd;
	};

	pdc_power_p1: rts54-pdc@67 {
		compatible = "realtek,rts54-pdc";
		reg = <0x67>;
		irq-gpios = <&gpiob 11 GPIO_ACTIVE_LOW>;
		no-fw-update;
	};
};

&espi0 {
	status = "okay";
	pinctrl-0 = < &espi_alert_gpio003 &espi_cs_gpio004
				&espi_io3_gpio005 &espi_io2_gpio006
				&espi_io1_gpio007 &espi_io0_gpio008
				&espi_clk_gpio009 &espi_reset_gpio020>;
	pinctrl-names = "default";
};

/* ocelot program common DTS includes */

#include <cros/integrated_fwid.dtsi>

/* ocelotrvp-rtk program common DTS includes */

#include "gpio.dtsi"
#include "i2c.dtsi"
#include "power_signals.dtsi"
#include "../rvp_battery.dtsi"
#include "../rvp_interrupts.dtsi"
#include "../rvp_ioex_gpio.dtsi"
#include "../rvp_usbc.dtsi"

&espi0 {
	status = "okay";
};

&sha0 {
	status = "okay";
};

&usbc_port0 {
	pdc = <&pdc_rtk_c0>;
};
&usbc_port1 {
	pdc = <&pdc_rtk_c1>;
};

/delete-node/ &int_volume_down;
/delete-node/ &int_volume_up;
/* Enabe nodes once b/458003667 is fixed. */
/delete-node/ &pdc_ti_c0;
/delete-node/ &pdc_ti_c1;

&pdc_rtk_c0 {
	irq-gpios = <&gpiob 11 GPIO_ACTIVE_LOW>;
	/* Add property once b/458003667 is fixed. */
	/delete-property/ zephyr,deferred-init;
};
&pdc_rtk_c1 {
	irq-gpios = <&gpiob 11 GPIO_ACTIVE_LOW>;
	/* Add property once b/458003667 is fixed. */
	/delete-property/ zephyr,deferred-init;
};

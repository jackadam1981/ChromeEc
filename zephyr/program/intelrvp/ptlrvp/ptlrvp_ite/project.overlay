/* AP interface */
&espi0 {
	status = "okay";
};

&sha0 {
	status = "okay";
};

&gpio_volume_up_r {
	enum-name = "GPIO_VOLUME_UP_L";
};

&gpio_vol_dn_ec_r {
	enum-name = "GPIO_VOLUME_DOWN_L";
};

/ {
	hibernate_vci_pins {
		compatible = "cros-ec,hibernate-vci-pins";
		#address-cells = <1>;
		#size-cells = <0>;

		/**
		 * Plaform supports three wake-up sources:\
		 * VCI_IN0: Power Button
		 * VCI_IN1: Batt ID - Not applicable for chrome
		 * VCI_OVRD_IN: AC Present
		 *
		 * Note: Lid is not a wake-up source.
		*/
		vci_power_btn: vci_input_0@0 {
			reg = <0>;
			vci-polarity = "Active_Low";
			vci-latch-enable;
			status = "okay";
		};
	};
	vci_gpios: vci-gpios {
		compatible = "cros-ec,vci-gpios";
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <3>;
	};
	named-gpios {
		pwrbtn: vci-in0-n {
			gpios = <&vci_gpios 0 GPIO_INPUT>;
			enum-name = "GPIO_POWER_BUTTON_L";
		};
	};
};

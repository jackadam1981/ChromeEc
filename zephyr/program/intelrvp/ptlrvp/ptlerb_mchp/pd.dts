#include <dt-bindings/gpio_defines.h>

/* typec-aic1-power */
&i2c_smb_1 {
	label = "I2C_PD_POWER";
	status = "okay";

	pd_pow_port0: rts54-pdc@20 {
		compatible = "realtek,rts54-pdc";
		reg = <0x20>;
		irq-gpios = <MCHP_GPIO_DECODE_143 GPIO_ACTIVE_LOW>;
	};
	pd_pow_port1: rts54-pdc@24 {
		compatible = "realtek,rts54-pdc";
		reg = <0x24>;
		irq-gpios = <MCHP_GPIO_DECODE_143 GPIO_ACTIVE_LOW>;
	};
};

&gpio_pdc_pow_irq {
	no-auto-init;
};

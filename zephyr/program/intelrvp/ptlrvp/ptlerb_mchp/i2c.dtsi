/* charger */
&i2c_smb_0 {
	status = "okay";

	pca95xx: pca95xx@22 {
		compatible = "nxp,pca95xx";
		label = "PCA95XX";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};

	rvp_board_id: rvp-board-id {
		compatible = "intel,rvp-board-id";
		bom-gpios = <&pca95xx 14 0>, <&pca95xx 15 0>, <&pca95xx 0 0>;

		fab-gpios = <&pca95xx 1 0>, <&pca95xx 2 0>;

		board-gpios = <&pca95xx 8 0>, <&pca95xx 9 0>, <&pca95xx 10 0>,
			      <&pca95xx 11 0>, <&pca95xx 12 0>, <&pca95xx 13 0>;
	};

	kb_discrete: ite-it8801@39 {
		compatible = "ite,it8801";
		reg = <0x39>;
	};

	seven_seg_display: max695x-seven-seg-display@38 {
		compatible = "maxim,max695x";
		reg = <0x38>;
		label = "MAX695X_SEVEN_SEG_DISPLAY";
	};

	charger: raa489@9 {
		compatible = "intersil,isl9241";
		status = "okay";
		reg = <0x9>;
	};

	cbi_eeprom: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		size = <2048>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;
	};
};

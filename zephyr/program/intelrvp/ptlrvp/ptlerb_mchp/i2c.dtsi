/ {
	named-i2c-ports {
		compatible = "named-i2c-ports";

		i2c_charger: charger {
			i2c-port = <&i2c_smb_0>;
			enum-names = "I2C_PORT_CHARGER",
				"I2C_PORT_BATTERY",
				"I2C_PORT_KB_DISCRETE",
				"I2C_PORT_PORT80",
				"I2C_PORT_EEPROM",
				"I2C_PORT_RAA2250";
		};
		ec_pd_power: typec-aic1-power {
			i2c-port = <&i2c_smb_1>;
			enum-names = "I2C_PORT_TYPEC_AIC_1";
		};
	};
};

/* charger */
&i2c_smb_0 {
	label = "I2C_CHARGER";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c00_scl_gpio004 &i2c00_sda_gpio003>;
	pinctrl-names = "default";
	port_sel = <0>;
	status = "okay";

	charger: raa489@9 {
		compatible = "intersil,isl9241";
		status = "okay";
		reg = <0x9>;
	};
	kb_discrete: ite-it8801@39 {
		compatible = "ite,it8801";
		reg = <0x39>;
	};
	pca95xx: pca95xx@22 {
		compatible = "nxp,pca95xx";
		label = "PCA95XX";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};
	rvp_board_id: rvp-board-id {
		compatible = "intel,rvp-board-id";
		bom-gpios = <&pca95xx 14 0>, <&pca95xx 15 0>, <&pca95xx 0 0>;

		fab-gpios = <&pca95xx 1 0>, <&pca95xx 2 0>;

		board-gpios = <&pca95xx 8 0>, <&pca95xx 9 0>, <&pca95xx 10 0>,
			      <&pca95xx 11 0>, <&pca95xx 12 0>, <&pca95xx 13 0>;
	};
};

/* typec-aic1-power */
&i2c_smb_1 {
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c06_scl_gpio140 &i2c06_sda_gpio132>;
	pinctrl-names = "default";
	port_sel = <6>;
	status = "okay";
};

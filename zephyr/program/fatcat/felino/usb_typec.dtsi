#include <usbc-policy.dtsi>

 /{
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;

		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			chg = <&charger>;
			pdc = <&pdc_power_p0>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		usbc_port1: port0@1 {
			compatible = "named-usbc-port";
			reg = <1>;
			pdc = <&pdc_power_p1>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		ppm-driver {
			compatible = "ucsi-ppm";
			lpm = <&pdc_power_p0 &pdc_power_p1>;
		};
	};
};

&i2c1 {
	pdc_power_p0: tps6699-pdc@20 {
		compatible = "ti,tps6699-pdc";
		reg = <0x20>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
	};
	pdc_power_p1: tps6699-pdc@24 {
		compatible = "ti,tps6699-pdc";
		reg = <0x24>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		no-fw-update;
	};
};

&i2c4 {
	charger: bq25710@9 {
		compatible = "ti,bq25710";
		status = "okay";
		reg = <0x9>;
	};
};

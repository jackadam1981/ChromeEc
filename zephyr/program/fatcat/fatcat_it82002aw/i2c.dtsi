/ {
	named-i2c-ports {
		compatible = "named-i2c-ports";

		bga_pina5 {
			enum-names = "I2C_PORT_SMB_PCH";
		};
		wc_usbc_pd_clk_aic1_r {
			enum-names = "I2C_PORT_WC_USBC_PD";
		};
		wc_usbc_pd_clk_aic2_r {
			enum-names = "I2C_PORT_AIC2";
		};
		i2c_smb_bs: smb_bs_clk_r {
			enum-names = "I2C_PORT_SMB_BS";
		};
		c_ish_ec_clk_r {
			enum-names = "I2C_PORT_ISH_EC";
		};
	};
};

&i2c0 {
	label = "I2C_PORT_SMB_PCH";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

pd_pow_i2c: &i2c1 {
};

&i2c3 {
	label = "I2C_PORT_AIC2";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

charger_i2c: &i2c4 {
};

/* charger */
&charger_i2c {
	label = "I2C_CHARGER";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	charger: raa489@9 {
		compatible = "intersil,isl9241";
		status = "okay";
		reg = <0x9>;
	};
	kb_discrete: ite-it8801@39 {
		compatible = "ite,it8801";
		reg = <0x39>;
	};
	pca95xx_0: pca95xx@22 {
		compatible = "nxp,pca95xx";
		label = "PCA95XX";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};
	pca95xx_1: pca95xx@23 {
		compatible = "nxp,pca95xx";
		label = "PCA95XX";
		reg = <0x23>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};
	rvp_board_id: rvp-board-id {
		compatible = "intel,rvp-board-id";
		bom-gpios = <&pca95xx_0 14 0>, <&pca95xx_0 15 0>,
			    <&pca95xx_0 0 0>;

		fab-gpios = <&pca95xx_0 1 0>, <&pca95xx_0 2 0>;

		board-gpios = <&pca95xx_0 8 0>, <&pca95xx_0 9 0>,
			      <&pca95xx_0 10 0>, <&pca95xx_0 11 0>,
			      <&pca95xx_0 12 0>, <&pca95xx_0 13 0>;
	};
	seven_seg_display: max695x-seven-seg-display@38 {
		compatible = "maxim,max695x";
		reg = <0x38>;
		label = "MAX695X_SEVEN_SEG_DISPLAY";
	};
};

&i2c5 {
	label = "I2C_PORT_ISH_EC";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

/* Set bus speeds for I2C */

&i2c1_0 {
	label = "I2C_DSP";
	clock-frequency = <I2C_BITRATE_FAST>;
	dsp_service: dsp-service@20 {
		compatible = "cros,dsp-service";
		reg = <0x20>;
		int-gpios = <&gpioa 3 (GPIO_PUSH_PULL | GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

&i2c2_0 {
	label = "I2C_PDC";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i2c3_0 {
	label = "I2C_IMVP91";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i2c4_1 {
	label = "I2C_PMC_PD";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i2c6_1 {
	label = "I2C_PORT_CHARGER";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i2c7_0 {
	label = "I2C_BATTERY";
	clock-frequency = <I2C_BITRATE_FAST>;
};
#include <usbc-policy.dtsi>

 /{
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;
		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			chg = <&charger>;
			pdc = <&pdc_power_p0>;
			policy = <&cros_policy>;
		};
		usbc_port1: port1@1 {
			compatible = "named-usbc-port";
			reg = <1>;
			pdc = <&pdc_power_p1>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		ppm-driver {
			compatible = "ucsi-ppm";
		};
	};
};

&usbc_port0 {
	pdc = <&pdc_power_p0 &pdc_power_p0_ti>;
};
&usbc_port1 {
	pdc = <&pdc_power_p1 &pdc_power_p1_ti>;
};

&i2c2_0 {
	pdc_power_p0: rts54-pdc@66 {
		compatible = "realtek,rts54-pdc";
		reg = <0x66>;
		irq-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		ccd;
	};
	pdc_power_p1: rts54-pdc@67 {
		compatible = "realtek,rts54-pdc";
		reg = <0x67>;
		irq-gpios = <&gpioe 1 GPIO_ACTIVE_LOW>;
	};

	pdc_power_p0_ti: tps6699-pdc@20 {
		compatible = "ti,tps6699-pdc";
		reg = <0x20>;
		irq-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		zephyr,deferred-init;
		ccd;
	};
	pdc_power_p1_ti: tps6699-pdc@21 {
		compatible = "ti,tps6699-pdc";
		reg = <0x21>;
		irq-gpios = <&gpioe 1 GPIO_ACTIVE_LOW>;
		zephyr,deferred-init;
	};
};

&pdc_power_p0 {
	zephyr,deferred-init;
};

&pdc_power_p1 {
	zephyr,deferred-init;
};

&i2c6_1 {
	charger: bq25710@9 {
		compatible = "ti,bq25710";
		status = "okay";
		reg = <0x9>;
	};
};

&i2c3_0 {
    status = "disabled";
};
/delete-node/ &i2c_i2c_ec_imvp91;

&i2c7_0 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

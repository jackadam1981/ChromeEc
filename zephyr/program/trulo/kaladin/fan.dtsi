/ {
	fans {
		compatible = "cros-ec,fans";
		fan_0 {
			pwms = <&pwm7 PWM_CHANNEL_7
				PWM_KHZ(25)
				PWM_POLARITY_NORMAL>;
			tach = <&tach1>;
			rpm_min = <1100>;
			rpm_start = <1100>;
			rpm_max = <4000>;
			rpm_deviation = <1>;
		};
	};

	fan_steps {
		compatible = "cros-ec,fan-steps";
		level_0 {
			temp_on = <0xff 0xff 48>;
			temp_off = <0xff 0xff 0xff>;
			rpm_target = <0>;
		};
		level_1 {
			temp_on = <0xff 0xff 49>;
			temp_off = <0xff 0xff 47>;
			rpm_target = <3200>;
		};
		level_2 {
			temp_on = <0xff 0xff 50>;
			temp_off = <0xff 0xff 49>;
			rpm_target = <3400>;
		};
		level_3 {
			temp_on = <0xff 0xff 51>;
			temp_off = <0xff 0xff 50>;
			rpm_target = <3700>;
		};
		level_4 {
			temp_on = <0xff 0xff 52>;
			temp_off = <0xff 0xff 51>;
			rpm_target = <4000>;
		};
		level_5 {
			temp_on = <0xff 0xff 53>;
			temp_off = <0xff 0xff 52>;
			rpm_target = <4300>;
		};
		level_6 {
			temp_on = <0xff 0xff 54>;
			temp_off = <0xff 0xff 53>;
			rpm_target = <4600>;
		};
		level_7 {
			temp_on = <0xff 0xff 55>;
			temp_off = <0xff 0xff 54>;
			rpm_target = <5000>;
		};
	};
};

/* fan tachometer sensor */
&tach1 {
	status = "okay";
	channel = <IT8XXX2_TACH_CHANNEL_A>;
	pulses-per-round = <2>;
	pinctrl-0 = <&tach1a_gpd7_default>;
	pinctrl-names = "default";
};

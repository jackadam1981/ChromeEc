		gpios = <0 0>;
		output-low;
	};
	ec_i2c_usb_a0_c0_scl {
		gpio-hog;
		gpios = <5 0>;
		input;
	};
	ec_i2c_usb_a0_c0_sda {
		gpio-hog;
		gpios = <4 0>;
		input;
	};
	ec_i2c_soc_sic {
		gpio-hog;
		gpios = <3 (GPIO_VOLTAGE_1P8)>;
		input;
	};
	ec_i2c_soc_sid {
		gpio-hog;
		gpios = <2 (GPIO_VOLTAGE_1P8)>;
		input;
	};
};

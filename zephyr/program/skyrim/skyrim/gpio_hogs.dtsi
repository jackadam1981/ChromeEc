/* GPIO Hogs */
&gpioc {
	ccd_mode_odl {
		gpio-hog;
		gpios = <6 (GPIO_SINGLE_ENDED | GPIO_LINE_OPEN_DRAIN)>;
		output-high;
	};
	pg_pwr_s5 {
		gpio-hog;
		gpios = <0 0>;
		input;
		line-names = "GPIO_S5_PGOOD";
	};
	ec_soc_rsmrst_l {
		gpio-hog;
		gpios = <5 0>;
		output-low;
		line-names = "GPIO_PCH_RSMRST_L";
	};
	usb_c1_tcpc_int_odl {
		gpio-hog;
		gpios = <7 0>;
		input;
		line-names = "GPIO_USB_C1_TCPC_INT_ODL";
	};
	tablet_mode_l {
		gpio-hog;
		gpios = <1 0>;
		input;
		line-names = "GPIO_TABLET_MODE_L";
	};
};
&gpiob {
	ec_gsc_packet_mode {
		gpio-hog;
		gpios = <1 0>;
		output-low;
		line-names = "GPIO_PACKET_MODE_EN";
	};
	pg_pcore_s0_r_od {
		gpio-hog;
		gpios = <6 0>;
		input;
		line-names = "GPIO_S0_PGOOD";
	};
	en_pwr_s5 {

/ {
	tarkin-fw-config {
		compatible = "cros-ec,cbi-fw-config";

		kb_bl {
			enum-name = "FW_KB_BL";
			start = <1>;
			size = <1>;
			kb-bl-not-present {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_KB_BL_NOT_PRESENT";
				value = <0>;
			};
			kb-bl-present {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_KB_BL_PRESENT";
				value = <1>;
                		default;
			};
		};

		thermal {
			enum-name = "FW_THERMAL";
			start = <2>;
			size = <2>;

			thermal_no_limit {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_THERMAL_N";
				value = <0>;
			};
			thermal_limit_1 {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_THERMAL_1";
				value = <1>;
			};
			thermal_limit_2 {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_THERMAL_2";
				value = <2>;
			};
		};
	};
};

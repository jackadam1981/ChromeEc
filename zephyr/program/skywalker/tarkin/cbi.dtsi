/ {
	tarkin-fw-config {
		compatible = "cros-ec,cbi-fw-config";

		/*
		 * FW_CONFIG field to indicate the device is clamshell
		 * or convertible.
		 */
		form_factor {
			enum-name = "FORM_FACTOR";
			start = <28>;
			size = <2>;
			convertible {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "CONVERTIBLE";
				value = <0>;
			};
			clamshell {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "CLAMSHELL";
				value = <1>;
			};
		};
		usbc-ports {
			enum-name = "USBC_PORTS";
			start = <8>;
			size = <2>;

			two-ports {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "TWO_PORTS";
				value = <0>;
			};
			one-port {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "ONE_PORT";
				value = <1>;
			};
		};
	};
};

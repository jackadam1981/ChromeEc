#include <dt-bindings/led/led.h>
#include <dt-bindings/macros.h>
//#include <zephyr/dt-bindings/led/led.h>

/ {
	aliases {
		led-strip = &led_strip_uart;
	};
};

&uart4 {
	status = "okay";

	current-speed = <3333333>;
	pinctrl-0 = <&uart4_sout_gp35>;
	pinctrl-names = "default";
	data-bits = <6>;
	tx-invert;

	led_strip_uart: ws2812-strip {
		compatible = "worldsemi,ws2812-uart";
		status = "okay";

		chain-length = <6>;
		color-mapping = <LED_COLOR_ID_RED
				LED_COLOR_ID_GREEN
				LED_COLOR_ID_BLUE>;

		reset-delay = <205>;
		bits-per-symbol = <4>;
		one-symbol = <BINARY(1,1,1,0)>;
		zero-symbol = <BINARY(1,0,0,0)>;
	};
};

&pcc {
	clock-frequency = <DT_FREQ_M(80)>;
	core-prescaler = <1>;
	apb1-prescaler = <4>;
	apb2-prescaler = <4>;
	apb3-prescaler = <4>;
	apb4-prescaler = <1>;
};

&pinctrl {
	/* ADC0 pinctrl for GPIO function. Note:
	 *   - IT8XXX2_ALT_DEFAULT: configures pin for default mode (GPIO)
	 *   - IT8XXX2_ALT_FUNC_1: configures pin alt function 1 (ADC)
	 * The node names unfortunately are backwards because ITE used
	 * adc0_ch0_gpi0_default to set ADC mode.
	 */
	adc0_ch0_gpi0_gpio: adc0_ch0_gpi0_gpio {
		pinmuxs = <&pinctrli 0 IT8XXX2_ALT_DEFAULT>;
	};
};

/ {
	aliases {
		gpio-wp = &gpio_ec_wp_odl;
	};
	chosen {
		zephyr,console = &uart2;
		zephyr,shell-uart = &uart2;
	};

	prochot-vcmp {
		compatible = "cros-ec,prochot-vcmp";
		vcmp = <&vcmp0>;
		high-level-mv = <1050>;
		prochot {
			gpios = <&gpioi 0 (GPIO_ACTIVE_LOW | GPIO_LINE_OPEN_DRAIN)>;
			pinctrl-0 = <&adc0_ch0_gpi0_default>;
			pinctrl-1 = <&adc0_ch0_gpi0_gpio>;
			pinctrl-names = "default", "gpio";
		};
	};
};

&vcmp0 {
	status = "okay";
	scan-period = <IT8XXX2_VCMP_SCAN_PERIOD_5MS>;
	comparison = <IT8XXX2_VCMP_GREATER>;
	threshold-mv = <0>;
	io-channels = <&adc0 0>;
};

/* UART interface is SIN1/SOUT1 pins, which ITE maps to devicetree uart2 */
&uart1 {
	status = "disabled";
};

&ite_uart1_wrapper {
	status = "disabled";
};

&uart2 {
	status = "okay";
	current-speed = <115200>;
};

&ite_uart2_wrapper {
	status = "okay";
	pinctrl-0 = <&uart2_rx_gpf0_default
		     &uart2_tx_gpf1_default>;
	pinctrl-names = "default";
};

&espi0 {
	status = "okay";
};

&sha0 {
	status = "okay";
};

/* Brox program common DTS includes */

/* Arbitrage generates an incorrect node label when using alternate pins.
 * Create a 2nd node label on I2C3 as a workaround.
 * TODO: b/310227384 - I2C alternate selection not detected automatically.
 */
i2c3ALT: &i2c3 {
};

#include <cros/cbi_flash.dtsi>

#include "../binman.dtsi"
#include "../brox.dtsi"
#include "cbi.dtsi"
#include "../fan.dtsi"
#include "gpio.dtsi"
#include "../i2c.dtsi"
#include "../interrupts.dtsi"
#include "../led_pins.dtsi"
#include "../led_policy.dtsi"
#include "../keyboard.dtsi"
#include "../power_signals.dtsi"
#include "../power_signals_gpios.dtsi"
#include "../pwm.dtsi"
#include "../temp_sensors.dtsi"
#include "../usb_typec.dtsi"
#include "../usba.dtsi"

/* Caboc project DTS includes*/

/* Caboc overrides follow... */

/{
        batteries {
                default_battery: atl_gb-s30-586075-020h {
                        compatible = "atl,gb-s30-586075-020h", "battery-smart";
                };
                atl_gb-s30-636076-010h {
                        compatible = "atl,gb-s30-636076-010h", "battery-smart";
                };
                cosmx_313-ac-38-a {
                        compatible = "cosmx,313-ac-38-a", "battery-smart";
                };
                cosmx_333-ac-3f-a {
                        compatible = "cosmx,333-ac-3f-a", "battery-smart";
                };
                dynapack_313-27-38-a {
                        compatible = "dynapack,313-27-38-a", "battery-smart";
                };
                dynapack_313-27-3f-a {
                        compatible = "dynapack,313-27-3f-a", "battery-smart";
                };
                dynapack_333-2d-38-a {
                        compatible = "dynapack,333-2d-38-a", "battery-smart";
                };
                smp_313-1d-38-a {
                        compatible = "smp,313-1d-38-a", "battery-smart";
                };
                sunwoda_333-cf-38-a {
                        compatible = "sunwoda,333-cf-38-a", "battery-smart";
                };
                sunwoda_333-cf-3f-a {
                        compatible = "sunwoda,333-cf-3f-a", "battery-smart";
                };
        };
};

/* These GPIOS are initialized by the PDC driver */
&gpio_usb_pd_int_odl {
	no-auto-init;
};
&gpio_ec_i2c_pmc_pd_int_odl {
	no-auto-init;
};

/* Set up runtime driver selection of TI and RTK PDCs */
&usbc_port0 {
	pdc = <&pdc_power_p0 &pdc_power_p0_ti>;
};
&usbc_port1 {
	pdc = <&pdc_power_p1 &pdc_power_p1_ti>;
};

/* Modify Realtek RTS5453P PDCs from parent DT */
&pdc_power_p0 {
	zephyr,deferred-init;
};
&pdc_power_p1 {
	zephyr,deferred-init;
};

/* Add TI TPS66994 PDCs */
&i2c1 {
        pdc_power_p0_ti: tps6699-pdc@20 {
                compatible = "ti,tps6699-pdc";
                reg = <0x20>;
                irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		zephyr,deferred-init;
        };

        pdc_power_p1_ti: tps6699-pdc@24 {
                compatible = "ti,tps6699-pdc";
                reg = <0x24>;
                irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
                no-fw-update;
		zephyr,deferred-init;
        };
};

/* Caboc does not support motion sense */
/delete-node/ &int_lid_imu;

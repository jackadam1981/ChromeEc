/{
	port0-muxes {
		virtual_mux_0: virtual-mux-0 {
			compatible = "cros-ec,usbc-mux-virtual";
		};
	};
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;
		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			alt-mode = <&pdc_alt_mode_port0>;
			chg = <&charger>;
			pdc = <&pdc_power_p0>;
			usb-mux-chain-0 {
				compatible = "cros-ec,usb-mux-chain";
				usb-muxes = <&virtual_mux_0>;
			};
		};
	};
};

&i2c1 {
	pdc_power_p0: rts54-pdc@67 {
		compatible = "realtek,rts54-pdc";
		reg = <0x67>;
		irq-gpios = <&gpioa 2 GPIO_ACTIVE_LOW>;
	};
};

&i2c3 {
	pdc_alt_mode_port0: rts54-pdc@69 {
		compatible = "intel,pd-altmode";
		reg = <0x69>;
		irq-gpios = <&gpioj 11 GPIO_ACTIVE_LOW>;
	};
};

&i2c4 {
	charger: isl9238@9 {
		compatible = "intersil,isl923x";
		status = "okay";
		reg = <0x9>;
	};
};

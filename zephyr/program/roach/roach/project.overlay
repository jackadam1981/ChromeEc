/* Roach program common DTS includes */

#include <cros/touchpad_hashes.dtsi>

#include "../adc.dtsi"
#include "../gpio.dtsi"
#include "../uart.dtsi"
// #include "../i2c.dtsi"
#include "../interrupts.dtsi"
#include "../keyboard.dtsi"
//#include "../pwm.dtsi"
#include "../rwsig.dtsi"

// &i2c0 {
// 	touchpad@15 {
// 		/* not tested, don't care on reference board */
		// logical_max_x = <2644>;
		// logical_max_y = <1440>;
		// physical_max_x = <839>;
		// physical_max_y = <457>;
// 	};
// };

&touchpad_fw_hashes {
	size = <((65536 / 1024) * 32)>;
};

/ {
	aliases {
		usb-hid-tp = &usb_hid_tp;
	};
};

&i2c0 {
	status = "disabled";
};

&i2c2 {
	status = "disabled";
};

&usb0 {
	status = "okay";
	pinctrl-0 = <&usb0_dm_gph5_default
		     &usb0_dp_gph6_default>;
	pinctrl-names = "default";

	usb_hid_tp: usb-hid-tp {
		compatible = "cros-ec,usb-hid-touchpad";
	};
};

/* Roach program common DTS includes */

#include "../adc.dtsi"
#include "../gpio.dtsi"
#include "../uart.dtsi"
#include "../i2c.dtsi"
#include "../interrupts.dtsi"
#include "../keyboard.dtsi"
#include "../pwm.dtsi"
#include "../rwsig.dtsi"

/ {
	aliases {
		gpio-wp = &ec_flash_wp_odl;
		usb-hid-tp = &touchpad;
	};
};

&touchpad {
	logical_max_x = <2925>;
	logical_max_y = <1440>;
	physical_max_x = <929>;
	physical_max_y = <457>;
	max_pressure = <511>;
};

&usb0 {
	status = "okay";
	pinctrl-0 = <&usb0_dm_gph5_default
		     &usb0_dp_gph6_default>;
	pinctrl-names = "default";
};

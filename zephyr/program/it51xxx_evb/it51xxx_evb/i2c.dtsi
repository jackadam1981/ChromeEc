/ {
	named-i2c-ports {
		compatible = "named-i2c-ports";

		battery {
			i2c-port = <&i2c2>;
			enum-names = "I2C_PORT_BATTERY";
		};
		evb-1 {
			i2c-port = <&i2c0>;
			enum-names = "I2C_PORT_EVB_1";
		};
		evb-2 {
			i2c-port = <&i2c1>;
			enum-names = "I2C_PORT_EVB_2";
		};
		opt-4 {
			i2c-port = <&i2c4>;
			enum-names = "I2C_PORT_OPT_4";
		};
	};
};

/* it8801 test */
&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_clk_gpf2_default
		     &i2c0_data_gpf3_default>;
	pinctrl-names = "default";

	it8801_mfd: it8801@38 {
		compatible = "ite,it8801-mfd";
		reg = <0x38>;
		irq-gpios = <&gpioa 1 0>;
	};
};

#include <ite/it8801-common-cfg.dtsi>
&ioex_it8801_kbd {
	status = "okay";
	mfdctrl = <&kso18_gp01_default>;
	kso-mapping = <0 1 20 3 4 5 6 17 18 16 15 11 12>;
	row-size = <8>;
	col-size = <13>;
};


/* loop back test */
&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	pinctrl-0 = <&i2c2_clk_gpf6_default
		     &i2c2_data_gpf7_default>;
	pinctrl-names = "default";
	scl-gpios = <&gpiof 6 0>;
	sda-gpios = <&gpiof 7 0>;
	channel-switch-sel = <SMB_SWITCH_INTERFACE2>;
	/delete-property/ fifo-enable;   /* FIFO2 */
	target-enable;

	target-shared-fifo-mode;
	i2c1_target: target@52 {
		compatible = "ite,target-i2c";
		reg = <0x52>;
	};

	i2c1_target_addr2: target@62 {
		compatible = "ite,target-i2c";
		reg = <0x62>;
	};

	i2c1_target_addr3: target@72 {
		compatible = "ite,target-i2c";
		reg = <0x72>;
	};
};

&i2c2 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	pinctrl-0 = <&i2c1_clk_gpc1_default
		     &i2c1_data_gpc2_default>;
	pinctrl-names = "default";
	scl-gpios = <&gpioc 1 0>;
	sda-gpios = <&gpioc 2 0>;
	channel-switch-sel = <SMB_SWITCH_INTERFACE1>;

};

&pinctrl {
	/* I2C property setting */
	i2c1_clk_gpc1_default: i2c1_clk_gpc1_default {
		gpio-voltage = "1v8";
	};
	i2c1_data_gpc2_default: i2c1_data_gpc2_default {
		gpio-voltage = "1v8";
	};

};

&i2c4 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c4_clk_gpe0_default
		     &i2c4_data_gpe7_default>;
	pinctrl-names = "default";
	push-pull-recovery;

};

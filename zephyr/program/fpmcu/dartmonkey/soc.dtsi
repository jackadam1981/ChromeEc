//
///*
// * Introduce additional pinctrl nodes that describe PB13, PB14, PB15 pin
// * configuration used when SPI module goes to sleep state. Without that
// * these pins are connected to disabled SPI module which increases power
// * consumption by the sensor.
// */
//&pinctrl {
//	gpio_out_low_pb13: gpio_out_low_pb13 {
//		pinmux = <STM32_PINMUX('B', 13, GPIO)>;
//		output-low;
//	};
//	gpio_out_low_pb14: gpio_out_low_pb14 {
//		pinmux = <STM32_PINMUX('B', 14, GPIO)>;
//		output-low;
//	};
//	gpio_out_low_pb15: gpio_out_low_pb15 {
//		pinmux = <STM32_PINMUX('B', 15, GPIO)>;
//		output-low;
//	};
//};

&dmamux1 {
	status = "okay";
};

&dma1 {
	status = "okay";
};

&dma2 {
	status = "okay";
};

&spi1 {
//	pinctrl-1 = <&analog_pa4 &analog_pa5 &analog_pa6 &analog_pa7>;
//	pinctrl-names = "default", "sleep";
//	/* Change the compatible string to use the Host Command version of the
//	 * STM32 SPI driver
//	 */
	compatible = "st,stm32-spi-host-cmd";
	status = "okay";

	dmas = <&dma2 3 3 0x38440 0x03>,
		<&dma2 0 3 0x38480 0x03>;
	dma-names = "tx", "rx";
	/* This field is used to point at our CS pin */
	cs-gpios = <&gpioa 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
};

&spi4 {
//	/*
//	 * Set the sleep state as output low to reduce FP sensor
//	 * power consumption.
//	 */
//	pinctrl-1 = <&gpio_out_low_pb13 &gpio_out_low_pb14 &gpio_out_low_pb15>;
//	pinctrl-names = "default", "sleep";
	/* Select hsi_ker_ck as source clock for SPI4 */
	clocks = <&rcc STM32_CLOCK_BUS_APB2 0x00002000>,
		 <&rcc STM32_SRC_HSI_KER SPI45_SEL(3)>;
	//Channels for compability. TODO USE only one DMA?
	dmas = <&dmamux1 9 84 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH)
		 &dmamux1 12 83 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
	dma-names = "tx", "rx";
};

//&flash0 {
//	/*
//	 * 4 byte parallelism can be enabled when the voltage is at least 2.7V.
//	 * See STM32F412 reference manual for more details.
//	 */
//	write-block-size = <4>;
//};
//

/ {
	/* Overwrite SRAM1 node, to a common node handling SRAM1, SRAM2 and
	 * SRAM3. This is contious memory anyway. We need that to store
	 * big FP buffers.
	 */
	sram1_3: memory@30000000 {
		compatible = "zephyr,memory-region";
		reg = <0x30000000 DT_SIZE_K(288)>;
		zephyr,memory-region = "SRAM1-3";
	};

};
/* SRAM2 and SRAM3 memory is handled by a common sram1_3 node. */
/delete-node/ &sram2;
/delete-node/ &sram3;

/* Configure to use . */
&pll {
	div-m = <4>;
	mul-n = <50>;
	div-p = <2>;
	clocks = <&clk_hsi>;
	status = "okay";
};

//&rcc {
//	/* TODO check APB1-4 enr, if enabled - rather yes */
//	d1ppre = <2>;
//	d2ppre1 = <2>;
//	d2ppre2 = <2>;
//	d3ppre = <2>;
//};

&usart1 {
	/* Select hsi_ker_ck as source clock for USART1 */
	clocks = <&rcc STM32_CLOCK_BUS_APB2 0x00000010>,
		 <&rcc STM32_SRC_HSI_KER USART16_SEL(3)>;
};

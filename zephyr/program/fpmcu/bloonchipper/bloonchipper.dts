#include "soc.dts"
#include "gpio.dts"

/ {

	named-bbram-regions {
		compatible = "named-bbram-regions";

		scratchpad {
			offset = <0x00>;
			size = <0x02>;
		};
		saved-reset-flags {
			offset = <0x02>;
			size = <0x04>;
		};
		saved-panic-reason {
			offset = <0x06>;
			size = <0x02>;
		};
		saved-panic-info {
			offset = <0x08>;
			size = <0x02>;
		};
		saved-panic-exception {
			offset = <0x0a>;
			size = <0x02>;
		};
		saved-panic-flags {
			offset = <0x0c>;
			size = <0x02>;
		};
	};

	binman {
		/* First 5 sectors (4 x 16KB, 1 x 64KB) used for RO */
		wp-ro {
			offset = <0x0>;
			size = <0x20000>;

			key-ro {
				type = "fill";
				//type = "blob";
				//filename = "pubkey.bin";
				offset = <0x1fc00>;
				size = <0x400>;
			};
		};

		/* Two sectors used for rollback (128KB each) */

		/* Remaining 5 sectors (128KB each) used for RW */
		ec-rw {
			offset = <0x60000>;
			size = <0xa0000>;
			rw-fw {
				rw-fwid {
					/* Fix the location of the FWID to the
					 * last 32 bytes of the flash. This
					 * ensures the RW entries in the FMAP
					 * stored in the RO section of flash
					 * are always correct.
					 */
					offset = <(0x9fc00 - 32)>;
				};
			};

			sig-rw {
				type = "fill";
				//type = "blob";
				//filename = "sig.bin";
				offset = <0x9fc00>;
				size = <0x400>;
			};
		};
		pad-byte = <0xff>;
	};
};

&flash0 {
        partitions {
                compatible = "fixed-partitions";
                #address-cells = <1>;
                #size-cells = <1>;

                /* Sixth sector is used as first rollback sector. */
                rollback0: partition@20000 {
                        label = "rollback0";
                        reg = <0x20000 DT_SIZE_K(128)>;
                };

                /* Seventh sector is used as second rollback sector. */
                rollback1: partition@40000 {
                        label = "rollback1";
                        reg = <0x40000 DT_SIZE_K(128)>;
                };
        };
};

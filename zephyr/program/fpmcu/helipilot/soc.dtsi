#include <nuvoton/npcx/npcx9/npcx9-pinctrl.dtsi>

/* DRBG: Deterministic Random Bit Generator */
&drbg0 {
	status = "okay";
};

/* Update program memory size */
&flash0 {
    reg = <0x10058000 DT_SIZE_K(352)>;
};

/* Update data memory size */
&sram0 {
    reg = <0x200B0000 DT_SIZE_K(156)>;
};
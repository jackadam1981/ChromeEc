#include <cros/nuvoton/npcx9.dtsi>

&iwdg {
	status = "okay";
};

&itims {
	status = "okay";
	wdg_helper_counter: counter {
		status = "okay";
	};
}

&wdg_helper {
	counter = <&wdg_helper_counter>;
	status = "okay";
};


&rng {
	status = "okay";
};

/* UART1: Servo UART (console) */
&uart1 {
	/* Use UART1_SL2 ie. PIN64.65 */
	pinctrl-0 = <&uart1_2_sin_gp64 &uart1_2_sout_gp65>;
	pinctrl-names = "default";

	current-speed = <115200>;
	status = "okay";
};

/* UART2: AP UART (Host Commands and MKBP) */
&uart2 {
	pinctrl-0 = <&uart2_sin_gp75 &uart2_sout_gp86>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* SHI0: communication with the AP */
@shi0 {
	buffer-rx-size = <128>;
	buffer-tx-size = <128>;
	status = "enabled";
};

/*

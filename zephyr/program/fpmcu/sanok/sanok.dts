#include <egis/common_priv.dtsi>

#include "soc.dtsi"
#include "gpio.dtsi"
#include "rwsig.dtsi"

#include <cros/integrated_fwid.dtsi>

/ {
	chosen {
		cros-fp,fingerprint-sensor = &fp_sensor;
		cros-ec,flash = &p25q16;
		zephyr,flash = &p25q16;
		zephyr,flash-controller = &p25q16;
		flash-header = &flash_header;
	};

	named-bbram-regions {
		compatible = "named-bbram-regions";

		scratchpad {
			offset = <0x00>;
			size = <0x02>;
		};
		saved-reset-flags {
			offset = <0x02>;
			size = <0x04>;
		};
		saved-panic-reason {
			offset = <0x06>;
			size = <0x02>;
		};
		saved-panic-info {
			offset = <0x08>;
			size = <0x02>;
		};
		saved-panic-exception {
			offset = <0x0a>;
			size = <0x02>;
		};
		saved-panic-flags {
			offset = <0x0c>;
			size = <0x02>;
		};
	};


	/* Map the sections to fit the flash chip protection table */ 
	binman {
		/* SDCP flash header 4kB */
		flash-header {
			offset = <0x0>;
			size = <0x1000>;
			type = "blob";
			filename = "../build-ro/flash_header.bin";
		};

		/* Fill 1/4 of 1MB */
		wp-ro {
			offset = <0x1000>;
			size = <(0x40000 - 0x1000)>;
			ec-ro {
				offset = <0x0>;
				size = <(0x40000 - 0x1000)>;
				pad-byte = <0xff>;
			};
		};

		/* Use the rest for RW + Rollbacks. Erase unit(4kB) per rollback */
		rollback0 {
			offset = <0x40000>;
			size = <0x1000>;
			type = "blob";
			filename = "../build-rw/rollback_initial_data.bin";
		};

		rollback1 {
			offset = <0x41000>;
			size = <0x1000>;
			type = "blob";
			filename = "../build-rw/rollback_initial_data.bin";
		};

		ec-rw {
			offset = <0x42000>;
			size = <0xbe000>;
			rw-fw {
				/*
				 * Clang doesn't emit STT_SECTION symbols (also
				 * called 'section symbols'), so 'rom_start'
				 * symbol is not available. Fortunately, Zephyr
				 * linker scripts provide '__rom_start_address'
				 * symbol which points to the beginning of
				 * 'rom_start' section.
				 */
				zephyr-rw {
					elf-base-sym = "__rom_start_address";
				};
			};
		};
		pad-byte = <0xff>;
	};
};

&spi0 {
	p25q16: qspi-nor-flash {
		compatible = "andestech,qspi-nor-xip", "jedec,spi-nor";
		size = <DT_SIZE_K(1024)>;
		status = "okay";
	};
};

&p25q16 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		calibration_data: partition@1b9 {
			label = "calibration_data";
			reg = <0x1b9 256>;
		};

		rollback0: partition@40000 {
			label = "rollback0";
			reg = <0x40000 DT_SIZE_K(4)>;
		};

		rollback1: partition@41000 {
			label = "rollback1";
			reg = <0x41000 DT_SIZE_K(4)>;
		};
	};
};

&spi1 {
	fp_sensor: egis630@0 {
		compatible = "egis,egis630";
		reg = <0>;
		spi-max-frequency = <4000000>;

		width = <80>;
		height = <64>;
		bits-per-pixel = <8>;
		v4l2-pixel-format = "V4L2_PIX_FMT_GREY";

		irq-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
		calibration-data-addr = <0x800001b9>;
	};
};

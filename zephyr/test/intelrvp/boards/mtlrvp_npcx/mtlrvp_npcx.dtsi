 /{
        pca95xx: pca95xx@22 {
		compatible = "zephyr,gpio-emul";
		label = "PCA95XX";
		reg = <0x22 0x4>;
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
	};

        rvp_board_id: rvp-board-id {
		compatible = "intel,rvp-board-id";

		/*
		 * BOM ID [2]   : IOEX[0]
		 * BOM ID [1:0] : IOEX[15:14]
		 */
		bom-gpios = <&pca95xx 0 (GPIO_INPUT | GPIO_ACTIVE_LOW)>, <&pca95xx 15 (GPIO_INPUT | GPIO_ACTIVE_LOW)>, <&pca95xx 14 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;

		/*
		 * FAB ID [1:0] : IOEX[2:1]
		 */
		fab-gpios = <&pca95xx 2 (GPIO_INPUT | GPIO_ACTIVE_LOW)>, <&pca95xx 1 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;

		/*
		 * BOARD ID[5:0] : IOEX[13:8]
		 */
		board-gpios = <&pca95xx 13 (GPIO_INPUT | GPIO_ACTIVE_LOW)>, <&pca95xx 12 (GPIO_INPUT | GPIO_ACTIVE_LOW)>, <&pca95xx 11 (GPIO_INPUT | GPIO_ACTIVE_LOW)>,
			      <&pca95xx 10 (GPIO_INPUT | GPIO_ACTIVE_LOW)>, <&pca95xx 9 (GPIO_INPUT | GPIO_ACTIVE_LOW)>, <&pca95xx 8 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;
	};
 };
#include <board-overlays/native_posix.dts>
#include <dt-bindings/gpio_defines.h>

/ {
	named-gpios {
		compatible = "named-gpios";

		/* STB dumping GPIOs */
		gpio_ec_sfh_int_h: ec_sfh_int_h {
			gpios = <&gpio0 0 GPIO_OUTPUT_LOW>;
		};
		gpio_sfh_ec_int_h: sfh_ec_int_h {
			gpios = <&gpio0 1 GPIO_INPUT>;
		};
	};

	named-i2c-ports {
		compatible = "named-i2c-ports";

		i2c_soc_thermal: soc-thermal {
			i2c-port = <&i2c0>;
			enum-names = "I2C_PORT_THERMAL_AP";
		};
	};

	gpio-interrupts {
		compatible = "cros-ec,gpio-interrupts";

		int_stb_dump: stb_dump {
			irq-pin = <&gpio_sfh_ec_int_h>;
			flags = <GPIO_INT_EDGE_RISING>;
			handler = "amd_stb_dump_interrupt";
		};
	};
};

&gpio0 {
	ngpios = <2>;
};

&i2c0 {
	status = "okay";

	sb_rmi_emul: sb_rmi@0x3c {
		compatible = "amd,sb-rmi";
		status = "okay";
		reg = <0x3c>;
	};
};
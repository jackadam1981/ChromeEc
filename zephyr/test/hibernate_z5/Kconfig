config HIBERNATE_Z1_INIT_SHOULD_FAIL
	bool
	help
	  Helper symbol that indicates that the hibernate z1 driver
	  initialization is expected to fail.

config TEST_HIBERNATE_Z1_DEFAULT
	bool "Hibernate Z1 default test"
	help
	  Default test case for the hibernate z1 driver. This verifies the
	  happy paths.

config TEST_HIBERNATE_Z1_GPIO_NOT_READY
	bool "Hibernate Z1 GPIO not ready test"
	select HIBERNATE_Z1_INIT_SHOULD_FAIL
	help
	  Verifies the hibernate z1 driver handles a GPIO port not ready.

config TEST_HIBERNATE_Z1_GPIO_BAD_CONFIG
	bool "Hibernate Z1 GPIO config fail test"
	select HIBERNATE_Z1_INIT_SHOULD_FAIL
	help
	  Verifies the hibernate z1 driver handles errors during GPIO
	  configuration.

source "Kconfig.zephyr"

#include <board-overlays/native_posix.dts>
#include <cros/binman.dtsi>
#include <cros/touchpad_hashes.dtsi>

/ {
	chosen {
		cros-ec,flash-controller = &cros_flash;
		/delete-property/ zephyr,code-partition;
	};

	cros_flash: cros-flash {
		compatible = "cros-ec,flash-emul";
	};

	aliases {
		gpio-wp = &gpio_wp_l;
		/delete-property/ led0;
	};

	named-gpios {
		compatible = "named-gpios";
		gpio_wp_l: wp_l {
			gpios = <&gpio0 0 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;
		};
	};

	/delete-node/ leds;

	flashcontroller0: flash-controller@0 {
		reg = <0 0x100000>;

		flash0: flash@0 {
			reg = <0x0 0x100000>;

			/delete-node/ partitions;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				ro: ro@800000 {
					label = "ro";
					reg = <0x00000 0x40000>;
				};
				rw: rw@840000 {
					label = "rw";
					reg = <0x40000 0x40000>;
				};
				rollback0: rollback0@880000 {
					label = "rollback0";
					reg = <0x80000 0x1000>;
				};
				rollback1: rollback1@881000 {
					label = "rollback1";
					reg = <0x81000 0x1000>;
				};
			};
		};
	};
};

&touchpad_fw_hashes {
	size = <((65536 / 1024) * 32)>;
};

/ {
  chosen {
		zephyr,shell-uart = &test_uart;
  };
  named-gpios {
		compatible = "named-gpios";
		/* unimplemented GPIOs */
		entering-rw {
			enum-name = "GPIO_ENTERING_RW";
		};
	};

	ec-console {
		compatible = "ec-console";
		disabled = "events", "lpc", "hostcmd";
	};

	test_uart: uart@55556666 {
	   compatible = "vnd,serial";
	   reg = <0x55556666 0x1000>;
	   status = "okay";
	   buffer-size = <200>;
	};
};

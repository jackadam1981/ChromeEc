#include <board-overlays/native_posix.dts>
#include <dt-bindings/gpio_defines.h>

/ {
	/* GPIOs shared by all boards */
	named-gpios {
		compatible = "named-gpios";

		gpio_3axis_int_l: 3axis_int_l {
			gpios = <&gpio0 0 GPIO_INPUT_PULL_UP>;
		};
		gpio_6axis_int_l: 6axis_int_l {
			gpios = <&gpio0 1 GPIO_INPUT_PULL_UP>;
		};
		gpio_acok_od: acok_od {
			gpios = <&gpio0 2 GPIO_INPUT>;
			enum-name = "GPIO_AC_PRESENT";
		};
		gpio_ccd_mode_odl: ccd_mode_odl {
			gpios = <&gpio0 3 GPIO_ODR_LOW>;
			enum-name = "GPIO_CCD_MODE_ODL";
		};
		gpio_ec_bat_pres_odl: ec_bat_pres_odl {
			gpios = <&gpio0 4 GPIO_INPUT>;
			enum-name = "GPIO_BATT_PRES_ODL";
		};
		gpio_ec_c0_retimer_int_odl: ec_c0_retimer_int_odl {
			gpios = <&gpio0 5 GPIO_INPUT_PULL_UP>;
		};
		gpio_ec_c0_retimer_rst_l: ec_c0_retimer_rst_l {
			gpios = <&gpio0 6 GPIO_ODR_HIGH>;
		};
		gpio_ec_c1_retimer_int_odl: ec_c1_retimer_int_odl {
			gpios = <&gpio0 7 GPIO_INPUT>;
		};
		gpio_ec_c1_retimer_rst_odl: ec_c1_retimer_rst_odl {
			gpios = <&gpio0 8 GPIO_ODR_LOW>;
		};
		gpio_ec_disable_disp_bl: ec_disable_disp_bl {
			gpios = <&gpio0 9 GPIO_OUTPUT>;
			enum-name = "GPIO_ENABLE_BACKLIGHT";
		};
		gpio_ec_fan1_speed: ec_fan1_speed {
			gpios = <&gpio0 10 GPIO_INPUT>;
		};
		gpio_ec_fan2_speed: ec_fan2_speed {
			gpios = <&gpio0 11 GPIO_INPUT>;
		};
		gpio_ec_gsc_packet_mode_odl: ec_gsc_packet_mode_odl {
			gpios = <&gpio0 12 GPIO_ODR_LOW>;
			enum-name = "GPIO_PACKET_MODE_EN";
		};
		gpio_ec_kso_02_inv: ec_kso_02_inv {
			gpios = <&gpio0 13 (GPIO_OUTPUT | GPIO_ACTIVE_LOW)>;
			enum-name = "GPIO_KBD_KSO2";
		};
		gpio_ec_mech_pwr_btn_odl: ec_mech_pwr_btn_odl {
			gpios = <&gpio0 14 (GPIO_OUTPUT_LOW | GPIO_INPUT)>;
			enum-name = "GPIO_POWER_BUTTON_L";
		};
		gpio_ec_prochot_odl: ec_prochot_odl {
			gpios = <&gpio0 15 GPIO_INPUT>;
			enum-name = "GPIO_CPU_PROCHOT";
		};
		gpio_ec_soc_int: ec_soc_int {
			gpios = <&gpio0 16 GPIO_OUTPUT>;
			enum-name = "GPIO_EC_INT_L";
		};
		gpio_ec_soc_pwr_btn_odl: ec_soc_pwr_btn_odl {
			gpios = <&gpio0 17 GPIO_OUTPUT_HIGH>;
			enum-name = "GPIO_PCH_PWRBTN_L";
		};
		gpio_ec_soc_pwr_good: ec_soc_pwr_good {
			/*
			 * Needs to be configured as I/O to allow tested code to
			 * read this pin.
			 */
			gpios = <&gpio0 18 (GPIO_OUTPUT_LOW | GPIO_INPUT)>;
		};
		gpio_ec_soc_rsmrst_l: ec_soc_rsmrst_l {
			/*
			 * Needs to be configured as I/O to allow tested code to
			 * read this pin.
			 */
			gpios = <&gpio0 19 (GPIO_OUTPUT_LOW | GPIO_INPUT)>;
			enum-name = "GPIO_PCH_RSMRST_L";
		};
		gpio_ec_soc_wake_odl: ec_soc_wake_odl {
			gpios = <&gpio0 20 GPIO_ODR_LOW>;
		};
		gpio_ec_sys_rst_l: ec_sys_rst_l {
			gpios = <&gpio0 21 GPIO_ODR_HIGH>;
			enum-name = "GPIO_SYS_RESET_L";
		};
		gpio_ec_wp_l: ec_wp_l {
			gpios = <&gpio0 22 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;
		};
		gpio_en_kb_bl: en_kb_bl {
			gpios = <&gpio0 23 GPIO_OUTPUT>;
			enum-name = "GPIO_EN_KEYBOARD_BACKLIGHT";
		};
		gpio_en_pp5000_usb_a0_vbus: en_pp5000_usb_a0_vbus {
			gpios = <&gpio0 24 GPIO_OUTPUT>;
		};
		gpio_en_pp5000_usb_a1_vbus: en_pp5000_usb_a1_vbus {
			gpios = <&gpio0 25 GPIO_OUTPUT>;
		};
		gpio_en_pwr_pcore_s0: en_pwr_pcore_s0 {
			/*
			 * Needs to be configured as I/O to allow tested code to
			 * read this pin.
			 */
			gpios = <&gpio0 26 (GPIO_OUTPUT_LOW | GPIO_INPUT)>;
		};
		gpio_en_pwr_s0: en_pwr_s0 {
			/*
			 * Needs to be configured as I/O to allow tested code to
			 * read this pin.
			 */
			gpios = <&gpio0 27 (GPIO_OUTPUT_LOW | GPIO_INPUT)>;
		};
		gpio_en_pwr_s5: en_pwr_s5 {
			gpios = <&gpio0 28 GPIO_OUTPUT>;
			enum-name = "GPIO_EN_PWR_A";
		};
		gpio_en_pwr_z1: en_pwr_z1 {
			gpios = <&gpio0 29 GPIO_OUTPUT>;
		};
		gpio_en_usb_a1_retimer: en_usb_a1_retimer {
			gpios = <&gpio0 30 GPIO_OUTPUT>;
		};
		gpio_en_usb_c0_tcpc_vbsnk_l: en_usb_c0_tcpc_vbsnk_l {
			gpios = <&gpio0 31 GPIO_INPUT>;
		};
		gpio_lid_open: lid_open {
			gpios = <&gpio1 0 GPIO_INPUT>;
			enum-name = "GPIO_LID_OPEN";
		};
		gpio_pg_groupc_s0_od: pg_groupc_s0_od {
			gpios = <&gpio1 1 GPIO_INPUT>;
		};
		gpio_pg_lpddr5_s3_od: pg_lpddr5_s3_od {
			gpios = <&gpio1 2 GPIO_INPUT>;
		};
		gpio_pg_pcore_s0_r_od: pg_pcore_s0_r_od {
			gpios = <&gpio1 3 GPIO_INPUT>;
			enum-name = "GPIO_S0_PGOOD";
		};
		gpio_pg_ppvar_mem_od: pg_ppvar_mem_od {
			gpios = <&gpio1 4 GPIO_INPUT>;
		};
		gpio_pg_pwr_s5: pg_pwr_s5 {
			gpios = <&gpio1 5 GPIO_INPUT>;
			enum-name = "GPIO_S5_PGOOD";
		};
		gpio_pg_vddq_mem_od: pg_vddq_mem_od {
			/*
			 * Needs to be configured as I/O to allow tested code to
			 * read this pin.
			 */
			gpios = <&gpio1 6 (GPIO_OUTPUT_LOW | GPIO_INPUT)>;
		};
		gpio_slp_s3_l: slp_s3_l {
			gpios = <&gpio1 7 GPIO_INPUT>;
			enum-name = "GPIO_PCH_SLP_S3_L";
		};
		gpio_slp_s5_l: slp_s5_l {
			gpios = <&gpio1 8 GPIO_INPUT>;
			enum-name = "GPIO_PCH_SLP_S5_L";
		};
		gpio_soc_alert_ec_odl: soc_alert_ec_odl {
			gpios = <&gpio1 9 GPIO_INPUT>;
		};
		gpio_soc_thermtrip_r_odl: soc_thermtrip_r_odl {
			gpios = <&gpio1 10 GPIO_INPUT>;
		};
		gpio_soc_usbc_pd_int: soc_usbc_pd_int {
			gpios = <&gpio1 11 GPIO_INPUT>;
		};
		gpio_tablet_mode: tablet_mode {
			gpios = <&gpio1 12 GPIO_INPUT>;
			enum-name = "GPIO_TABLET_MODE_L";
		};
		gpio_usb_a1_retimer_rst_l: usb_a1_retimer_rst_l {
			gpios = <&gpio1 13 GPIO_OUTPUT>;
		};
		gpio_usb_c0_c1_fault_odl: usb_c0_c1_fault_odl {
			gpios = <&gpio1 14 GPIO_ODR_HIGH>;
		};
		gpio_usb_c0_frs_alert_od: usb_c0_frs_alert_od {
			gpios = <&gpio1 15 GPIO_INPUT>;
		};
		gpio_usb_c0_hpd: usb_c0_hpd {
			gpios = <&gpio1 16 GPIO_OUTPUT>;
			enum-name = "GPIO_USB_C0_DP_HPD";
		};
		gpio_usb_c0_ppc_int_odl: usb_c0_ppc_int_odl {
			gpios = <&gpio1 17 (GPIO_INPUT_PULL_UP | GPIO_ACTIVE_LOW)>;
			enum-name = "GPIO_USB_C0_PPC_INT_ODL";
		};
		gpio_usb_c0_ppc_rst_l: usb_c0_ppc_rst_l {
			gpios = <&gpio1 18 GPIO_ODR_HIGH>;
		};
		gpio_usb_c0_sbu_flip: usb_c0_sbu_flip {
			gpios = <&gpio1 19 GPIO_ODR_LOW>;
		};
		gpio_usb_c0_tcpc_int_odl: usb_c0_tcpc_int_odl {
			gpios = <&gpio1 20 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;
			enum-name = "GPIO_USB_C0_TCPC_INT_ODL";
		};
		gpio_usb_c1_frs_alert_od: usb_c1_frs_alert_od {
			gpios = <&gpio1 21 GPIO_INPUT>;
		};
		gpio_usb_c1_hpd: usb_c1_hpd {
			gpios = <&gpio1 22 GPIO_OUTPUT>;
			enum-name = "GPIO_USB_C1_DP_HPD";
		};
		gpio_usb_c1_ppc_int_odl: usb_c1_ppc_int_odl {
			gpios = <&gpio1 23 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;
			enum-name = "GPIO_USB_C1_PPC_INT_ODL";
		};
		gpio_usb_c1_tcpc_int_odl: usb_c1_tcpc_int_odl {
			gpios = <&gpio1 24 (GPIO_INPUT | GPIO_ACTIVE_LOW)>;
			enum-name = "GPIO_USB_C1_TCPC_INT_ODL";
		};
		gpio_voldn_btn_odl: voldn_btn_odl {
			gpios = <&gpio1 25 GPIO_INPUT_PULL_UP>;
			enum-name = "GPIO_VOLUME_DOWN_L";
		};
		gpio_volup_btn_odl: volup_btn_odl {
			gpios = <&gpio1 26 GPIO_INPUT_PULL_UP>;
			enum-name = "GPIO_VOLUME_UP_L";
		};
	};

	gpio1: gpio@101 {
		status = "okay";
		compatible = "zephyr,gpio-emul";
		reg = <0x101 0x4>;
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <27>;
	};


	gpio-interrupts {
		compatible = "cros-ec,gpio-interrupts";

		int_slp_s3: slp_s3 {
			irq-pin = <&gpio_slp_s3_l>;
			flags = <GPIO_INT_EDGE_BOTH>;
			handler = "baseboard_en_pwr_s0";
		};
		int_slp_s5: slp_s5 {
			irq-pin = <&gpio_slp_s5_l>;
			flags = <GPIO_INT_EDGE_BOTH>;
			handler = "baseboard_set_en_pwr_s3";
		};
		int_s5_pgood: s5_pgood {
			irq-pin = <&gpio_pg_pwr_s5>;
			flags = <GPIO_INT_EDGE_BOTH>;
			handler = "baseboard_s5_pgood";
		};
		int_pg_groupc_s0: pg_groupc_s0 {
			irq-pin = <&gpio_pg_groupc_s0_od>;
			flags = <GPIO_INT_EDGE_BOTH>;
			handler = "power_interrupt_handler";
		};
		int_pg_lpddr_s3: pg_lpddr_s3 {
			irq-pin = <&gpio_pg_lpddr5_s3_od>;
			flags = <GPIO_INT_EDGE_BOTH>;
			handler = "power_interrupt_handler";
		};
		int_pg_vddq_mem_od: pg_vddq_mem_od {
			irq-pin = <&gpio_pg_vddq_mem_od>;
			flags = <GPIO_INT_EDGE_BOTH>;
			handler = "power_interrupt_handler";
		};
		int_soc_thermtrip: soc_thermtrip {
			irq-pin = <&gpio_soc_thermtrip_r_odl>;
			flags = <GPIO_INT_EDGE_FALLING>;
			handler = "baseboard_soc_thermtrip";
		};
		int_lid_accel: lid_accel {
			irq-pin = <&gpio_3axis_int_l>;
			flags = <GPIO_INT_EDGE_FALLING>;
			handler = "bma4xx_interrupt";
		};
		int_accel_gyro: accel_gyro {
			irq-pin = <&gpio_6axis_int_l>;
			flags = <GPIO_INT_EDGE_FALLING>;
			handler = "bmi3xx_interrupt";
		};
		int_prochot: prochot {
			irq-pin = <&gpio_ec_prochot_odl>;
			flags = <GPIO_INT_EDGE_BOTH>;
			handler = "throttle_ap_prochot_input_interrupt";
		};
	};

	named-i2c-ports {
		compatible = "named-i2c-ports";

		i2c_tcpc0: tcpc0 {
			i2c-port = <&i2c0_0>;
			enum-names = "I2C_PORT_TCPC0";
		};

		i2c_tcpc1: tcpc1 {
			i2c-port = <&i2c1_0>;
			enum-names = "I2C_PORT_TCPC1";
		};

		i2c_sensor: sensor {
			i2c-port = <&i2c6_1>;
			enum-names = "I2C_PORT_SENSOR";
		};
	};

	i2c0_0: i2c@400 {
		status = "okay";
		compatible = "zephyr,i2c-emul-controller";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x400 4>;

		anx7483_port0: anx7483_emul0@3e {
			compatible = "cros,anx7483-emul", "analogix,anx7483";
			reg = <0x3e>;
			board-set = "board_anx7483_c0_mux_set";
		};
	};

	i2c1_0: i2c@500 {
		status = "okay";
		compatible = "zephyr,i2c-emul-controller";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x500 4>;

		anx7483_port1: anx7483_emul1@3e {
			compatible = "cros,anx7483-emul", "analogix,anx7483";
			reg = <0x3e>;
			board-set = "board_anx7483_c1_mux_set";
		};

		ps8811_port1: ps8811_emul@72 {
			compatible = "cros,ps8811-emul";
			reg = <0x72>;
		};
	};

	i2c6_1: i2c@600 {
		status = "okay";
		compatible = "zephyr,i2c-emul-controller";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x600 4>;
	};

	myst-fw-config {
		compatible = "cros-ec,cbi-fw-config";

		form-factor {
			enum-name = "FW_FORM_FACTOR";
			start = <0>;
			size = <1>;

			ff-clamshell {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_FF_CLAMSHELL";
				value = <0>;
			};
			ff-convertible {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_FF_CONVERTIBLE";
				value = <1>;
				default;
			};
		};

		io-db {
			enum-name = "FW_IO_DB";
			start = <6>;
			size = <2>;

			io-db-ps8811-ps8818 {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_IO_DB_PS8811_PS8818";
				value = <0>;
			};
			io-db-none-anx7483 {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_IO_DB_NONE_ANX7483";
				value = <1>;
				default;
			};
		};

		fan {
			enum-name = "FW_FAN";
			start = <10>;
			size = <1>;

			no-fan {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_FAN_NOT_PRESENT";
				value = <0>;
			};
			fan-present {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_FAN_PRESENT";
				value = <1>;
				/*
				 * Set as default so that unprovisioned
				 * configs will run the fan regardless.
				 */
				default;
			};
		};

		charger-option {
			enum-name = "FW_CHARGER";
			start = <11>;
			size = <2>;

			charger-option-isl9241 {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_CHARGER_ISL9241";
				value = <0>;
				default;
			};
			charger-option-isl9538 {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_CHARGER_ISL9538";
				value = <1>;
			};
		};
	};

	usbc {
		#address-cells = <1>;
		#size-cells = <0>;

		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;

			usb-mux-chain-0 {
				compatible = "cros-ec,usb-mux-chain";
				usb-muxes = <&anx7483_port0>;
			};
		};

		usbc_port1: port1@1 {
			compatible = "named-usbc-port";
			reg = <1>;

			usb-mux-chain-1-anx {
				compatible = "cros-ec,usb-mux-chain";
				usb-muxes = <&anx7483_port1>;
			};
		};
	};
};

&gpio0 {
	ngpios = <32>;
};

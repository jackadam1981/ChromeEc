# Common location for test related Kconfigs

if ZTEST

config PLATFORM_EC_TEST_CC_USBPD
	bool "Enable USBPD console channel"
	help
	  Enable USBPD console channel

endif # ZTEST

config HW_TEST
	bool "Include tests that will be run on hardware"
	help
	  Enables building full image with zmake that includes tests.
	  The tests can be run via console or are run automatically depending
	  on a test framework and other configs.

if HW_TEST

config HW_TEST_ON
	bool

config HW_TEST_RW_ONLY
	bool "Include harwdware tests only in the RW copy"
	default y

if HW_TEST_RW_ONLY

config CROS_EC_RW
	select HW_TEST_ON

endif # HW_TEST_RW_ONLY

if !HW_TEST_RW_ONLY

# If !HW_TEST_RW_ONLY enable tests for RO and RW
config HW_TEST_ON
	default y

endif # !HW_TEST_RW_ONLY

if HW_TEST_ON

rsource "test/hwtest/Kconfig"

choice HW_TEST_FRAMEWORK
	prompt "Test Framework for tests on hardware"
	default HW_TEST_ZTEST

config HW_TEST_ZTEST
	bool "ZTEST"
	select ZTEST

endchoice # HW_TEST_FRAMEWORK

endif # HW_TEST_ON
endif # HW_TEST

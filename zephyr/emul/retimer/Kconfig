config EMUL_PS8811
	bool "Parade PS8811 Emulator"
	depends on DT_HAS_CROS_PS8811_EMUL_ENABLED
	help
	  Enable emulator for PS8811 retimer.

config PS8811_EMUL_LOG_LEVEL
	int "PS8811 emulator log level"
	depends on EMUL_PS8811
	default 4 # Log level debug
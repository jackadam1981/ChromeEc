if SOC_SERIES_RTS5912

#
# RTS5915:
#	384KB total SRAM:
#		0x2000_0000 - 0x2000_7000: chrome-loader (28KB)
#		0x2000_7000 - 0x2000_b3E0: customer use (16KB)
#		0x2000_b3E0 - 0x2004_b400: code (256KB + 20B header)
#		0x2004_b400 - 0x2005_0000: customer use (19KB)
#		0x2005_0000 - 0x2006_0000: customer use (64KB)
#	1MB internal SPI flash (reg mapped)
#		0x6000_0000 - 0x6007_FFFF: RO
#		0x6008_0000 - 0x600F_FFFF: RW

# TODO: b/416020794, make the EC image size as big as the available code RAM. 
config CROS_EC_PROGRAM_MEMORY_BASE
	default 0x2000b400

config CROS_EC_RAM_BASE
	default 0x20050000

# 64KB content buffer
config CROS_EC_DATA_RAM_SIZE
	default 0x00010000

config CROS_EC_RAM_SIZE
	default 0x00010000

config CROS_EC_RO_MEM_OFF
	default 0

# Image size is configured with binman's property.
# (CROS_EC_RO_SIZE and CROS_EC_RW_SIZE)

config CROS_EC_RW_MEM_OFF
	default 0

endif # SOC_SERIES_RTS5912

config USBD_GOOGLE_UPDATE_SUPPORT
	bool "USB Google update support"
	depends on USB_DEVICE_STACK_NEXT
	depends on PLATFORM_EC_USB_UPDATE
	select NET_BUF
	default y
	help
	  Enable Google vender specific class.

config GOOGLE_UPDATE_THREAD_PRIORTY
	int "Google update thread priority"
	depends on USBD_GOOGLE_UPDATE_SUPPORT
	default 8
	help
	  Set thread priority of the Google update.

config GOOGLE_UPDATE_STACK_SIZE
	int "Size of the thread stack"
	depends on USBD_GOOGLE_UPDATE_SUPPORT
	default 2048
	help
	  Size of the Google update thread stack.

config INTEL_MODULAR_AIC
	bool
	default y
	depends on EEPROM && DT_HAS_INTEL_MODULAR_AIC_PORT_ENABLED && DT_HAS_INTEL_MODULAR_AIC_SLOT_ENABLED
	help
	  Add support for intel Modular Add-In Card (AIC) detection.

if INTEL_MODULAR_AIC

config INTEL_MODULAR_AIC_CHECK_TAG
	bool "Check memory tag"
	help
	  Add support for Modular Add-In Card (AIC) detection.

endif

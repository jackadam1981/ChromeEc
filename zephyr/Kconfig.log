# These Logging Modules were pre generated from CrOS EC console_channel.inc

config LOG
	default y

config PLATFORM_EC_LOG_FULL
	bool "Enable core Zephyr logging features"
	imply LOG_SPEED
	imply LOG_OUTPUT_FORMAT_LINUX_TIMESTAMP
	imply LOG_RUNTIME_FILTERING
	help
	  The Zephyr logging subsystem is quite robust. Selecting this option
	  will enable the core Zephyr logging features used by EC.
	  The logging subsystem consumes a significant amount of storage and memory,
	  so some EC projects will not be able to utilize it.

choice LOG_MODE
	default LOG_MODE_IMMEDIATE if PLATFORM_EC_LOG_FULL
	default LOG_MODE_MINIMAL
endchoice

module = CC_COMMAND
module-str = command
source "subsys/logging/Kconfig.template.log_config"


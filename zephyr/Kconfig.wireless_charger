config PLATFORM_EC_PERIPHERAL_CHARGER
	bool "Enable peripheral charger task"
	help
	  Enable peripheral charger task.

if PLATFORM_EC_PERIPHERAL_CHARGER

config PLATFORM_EC_CPS8100
	bool "Use CPS8100 driver"
	help
	  Use CPS8100 driver. CPS8100 is a Qi wireless power transmitter.

config PLATFORM_EC_DYNAMIC_WIRELESS_CHARGER_COUNT
	bool "Dynamic Wireless Charger Count"
	help
	  Some hardware skus may not have wireless charger but share the same EC firmware,
	  enable this to allow charger count to be determined at runtime.
	  CONFIG_DYNAMIC_WIRELESS_CHARGER_COUNT removes the const assumption for the
	  global variable pchg_count.

endif # PLATFORM_EC_PERIPHERAL_CHARGER
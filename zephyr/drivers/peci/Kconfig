config ESPI_PECI
	bool "Support PECI over eSPI"
	depends on DT_HAS_INTEL_ESPI_PECI_ENABLED
	depends on ESPI_OOB_CHANNEL
	default y
	help
	  EC supports Platform Environment Control Interface (PECI) over eSPI
	  using OOB messages.

if ESPI_PECI

config PLATFORM_EC_ESPI_PECI_CONSOLE
	bool "Support PECI over eSPI console commands"
	default y
	help
	  EC supports PECI over eSPI console command.

config ESPI_PECI_TRANSFER_DEBUG_PRINT
	bool "Prints PECI over eSPI transfer data"
	default y
	help
	  EC supports prining PECI over eSPI transer Tx/Rx/ data.

config PLATFORM_EC_ESPI_PECI_CONSOLE_XFER_RAW
	bool "Support raw data transfer over concole"
	depends on ESPI_PECI_TRANSFER_DEBUG_PRINT
	help
	  EC supports generating raw eSPI PECI data over console.
endif

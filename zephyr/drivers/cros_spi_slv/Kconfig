menuconfig CROS_SPI_ITE
	bool "ITE it81202 spi slave driver for Zephyr"
	depends on SOC_FAMILY_RISCV_ITE
	default y
	help
		This option enables spi slave driver which is required to
		communicate with the EC when the CPU is the ARM processor.

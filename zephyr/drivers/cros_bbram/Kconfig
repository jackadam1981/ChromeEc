menuconfig CROS_BBRAM_NPCX
	bool "Nuvoton NPCX battery backed RAM driver for Zephyr"
	depends on SOC_FAMILY_NPCX
	default y
	help
		This options enables stuff.

if CROS_BBRAM_NPCX

config CROS_BBRAM_NPCX_INIT_PRIORITY
	int "cros_bbram npcx initialization priority"
	default 11
	range 0 99
	help
	  This sets the npcx cros_bbram driver initialization priority. CROS
	  system initializes flow is influence by the system reset cause. NPCX
	  chip uses BBRAM to save some system information that can cross the
	  chip reset. The priority should be higher than
	  SYSTEM_PRE_INIT_PRIORITY & lower than CROS_SYSTEM_NPCX_INIT_PRIORITY.

endif # CROS_BBRAM_NPCX

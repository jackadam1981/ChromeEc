# 0~0x3000 for boot loader
CONFIG_FLASH_BASE_ADDRESS=0x4000
CONFIG_ROM_START_OFFSET=0x0000
#CONFIG_FLASH_BASE_ADDRESS=0x0
#CONFIG_ROM_START_OFFSET=0x0

# Serial Drivers
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=n
CONFIG_SHELL_BACKEND_SERIAL=y

# Enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# GPIO Controller
CONFIG_GPIO=y
CONFIG_GPIO_GET_CONFIG=y

# WATCHDOG configuration
CONFIG_WATCHDOG=y

# Power Management
CONFIG_PM=y
CONFIG_PM_DEVICE=y
CONFIG_PM_POLICY_CUSTOM=y
CONFIG_UART_CONSOLE_INPUT_EXPIRED=y

# Flash
CONFIG_FLASH=y
CONFIG_FLASH_JESD216_API=y
CONFIG_FLASH_EX_OP_ENABLED=y
CONFIG_FLASH_PAGE_LAYOUT=y

CONFIG_BBRAM=y

//	status = "okay";
//	pinctrl-0 = <&ledpwm0_gpio19>;
//	pinctrl-names = "default";
//};
&ledpwm1 {
	status = "okay";
	pinctrl-0 = <&ledpwm1_gpio54>;
	pinctrl-names = "default";
};

&tach0 {
	status = "okay";
	pinctrl-0 = <&tach0_gpio14>;
	pinctrl-names = "default";
	pulses-per-round = <1>;
	sample-time-us = <8>;
};


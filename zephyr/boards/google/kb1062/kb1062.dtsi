&espi0 {
	status = "okay";
	pinctrl-0 = <&espi_cs_gpio03 &espi_rst_gpio07>;
	pinctrl-names = "default";
};

&i2c_bus0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_clk_gpio44 &i2c0_dat_gpio45>;
	pinctrl-names = "default";
	support-target-mode = <0>;
	slave-num = <0>;
};


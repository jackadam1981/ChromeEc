&kbd0 {
	/* keyboard pinout sample code
	 * // normal ikb pinout 
	 * pinctrl-0 = <&ksi00_gpio30 &ksi01_gpio31 &ksi02_gpio32 &ksi03_gpio33
	 *              &ksi04_gpio34 &ksi05_gpio35 &ksi06_gpio36 &ksi07_gpio37
	 *              &kso00_gpio20 &kso01_gpio21 &kso02_gpio22 &kso03_gpio23
	 *              &kso04_gpio24 &kso05_gpio25 &kso06_gpio26 &kso07_gpio27
	 *              &kso08_gpio28 &kso09_gpio29 &kso10_gpio2a &kso11_gpio2b
	 *              &kso12_gpio2c &kso13_gpio2d &kso14_gpio2e &kso15_gpio2f
	 *              &kso16_gpio48 &kso17_gpio49 &kso18_gpio4e &kso19_gpio4f
	 *              &kso20_gpio52 >;
	 *
	 * // nkro ikb pinout 
	 * pinctrl-0 = <&nkro_ksi00_gpio30 &nkro_ksi01_gpio31 &nkro_ksi02_gpio32
	 *              &nkro_ksi03_gpio33 &nkro_ksi04_gpio34 &nkro_ksi05_gpio35
	 *              &nkro_ksi06_gpio36 &nkro_ksi07_gpio37 &nkro_ksi08_gpio28
	 *              &nkro_ksi09_gpio29 &nkro_ksi10_gpio2a &nkro_ksi11_gpio2b
	 *              &nkro_ksi12_gpio2c &nkro_ksi13_gpio2d &nkro_ksi14_gpio2e
	 *              &nkro_ksi15_gpio2f &nkro_ksi16_gpio48 &nkro_ksi17_gpio49
	 *              &nkro_ksi18_gpio4e &nkro_ksi19_gpio4f &nkro_ksi20_gpio52
	 *              &nkro_kso00_gpio20 &nkro_kso01_gpio21 &nkro_kso02_gpio22
	 *              &nkro_kso03_gpio23 &nkro_kso04_gpio24 &nkro_kso05_gpio25
	 *              &nkro_kso06_gpio26 &nkro_kso07_gpio27 >;
	 */

	status = "okay";
	pinctrl-0 = <&ksi00_gpio30 &ksi01_gpio31 &ksi02_gpio32 &ksi03_gpio33
		     &ksi04_gpio34 &ksi05_gpio35 &ksi06_gpio36 &ksi07_gpio37
		     &kso00_gpio20 &kso01_gpio21 &kso02_gpio22 &kso03_gpio23
		     &kso04_gpio24 &kso05_gpio25 &kso06_gpio26 &kso07_gpio27
		     &kso08_gpio28 &kso09_gpio29 &kso10_gpio2a &kso11_gpio2b
		     &kso12_gpio2c &kso13_gpio2d &kso14_gpio2e &kso15_gpio2f
		     &kso16_gpio48 &kso17_gpio49 &kso18_gpio4e &kso19_gpio4f
		     &kso20_gpio52 >;
	pinctrl-names = "default";
};


#include <zephyr/dt-bindings/gpio/gpio.h>
#include <ene/kb106x/kb1062.dtsi>
#include <ene/kb106x/kb1062-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <cros/ene/kb106x.dtsi>
#include <dt-bindings/i2c/i2c.h>

/ {
	model = "KB1062 board";
	compatible = "ene,kb1062";

	aliases {
		i2c-0 = &i2c_bus0;
		i2c-1 = &i2c_bus1;
		i2c-2 = &i2c_bus2;
		i2c-3 = &i2c_bus3;
		i2c-4 = &i2c_bus4;
		i2c-5 = &i2c_bus5;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &flash_controller;
	};

	named-i2c-ports {
		compatible = "named-i2c-ports";
	};

	named-adc-channels {
		compatible = "named-adc-channels";
	};

	soc {
		i2c_bus0: i2c@40340000 {
			compatible = "ene,kb106x-i2c";
			reg = <0x40340000 0x1000>;
			i2cs-reg = <0x40350000 0x40351000>;
			interrupts = <15 1>, <16 1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
			support-target-mode = <0>;
			slave-num = <0>;
		};
		//smbus0: smbus0 {
		//	compatible = "ene,kb106x-smbus","simple-bus";
		//	#address-cells = <1>;
		//	#size-cells = <0>;
		//	i2c = <&i2c_bus0>;
		//	status = "okay";
		//};

		i2c_bus1: i2c@40341000 {
			compatible = "ene,kb106x-i2c";
			reg = <0x40341000 0x1000>;
			i2cs-reg = <0x40350000 0x40351000>;
			interrupts = <15 1>, <16 1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
			support-target-mode = <0>;
			slave-num = <0>;
		};
		//smbus1: smbus1 {
		//	compatible = "ene,kb106x-smbus","simple-bus";
		//	#address-cells = <1>;
		//	#size-cells = <0>;
		//	i2c = <&i2c_bus1>;
		//	status = "okay";
		//};

		i2c_bus2: i2c@40342000 {
			compatible = "ene,kb106x-i2c";
			reg = <0x40342000 0x1000>;
			i2cs-reg = <0x40350000 0x40351000>;
			interrupts = <15 1>, <16 1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
			support-target-mode = <0>;
			slave-num = <0>;
		};
		//smbus2: smbus2 {
		//	compatible = "ene,kb106x-smbus","simple-bus";
		//	#address-cells = <1>;
		//	#size-cells = <0>;
		//	i2c = <&i2c_bus2>;
		//	status = "okay";
		//};

		i2c_bus3: i2c@40343000 {
			compatible = "ene,kb106x-i2c";
			reg = <0x40343000 0x1000>;
			i2cs-reg = <0x40350000 0x40351000>;
			interrupts = <15 1>, <16 1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
			support-target-mode = <0>;
			slave-num = <0>;
		};
		//smbus3: smbus3 {
		//	compatible = "ene,kb106x-smbus","simple-bus";
		//	#address-cells = <1>;
		//	#size-cells = <0>;
		//	i2c = <&i2c_bus3>;
		//	status = "okay";
		//};

		i2c_bus4: i2c@40344000 {
			compatible = "ene,kb106x-i2c";
			reg = <0x40344000 0x1000>;
			i2cs-reg = <0x40350000 0x40351000>;
			interrupts = <15 1>, <16 1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
			support-target-mode = <0>;
			slave-num = <0>;
		};
		//smbus4: smbus4 {
		//	compatible = "ene,kb106x-smbus","simple-bus";
		//	#address-cells = <1>;
		//	#size-cells = <0>;
		//	i2c = <&i2c_bus4>;
		//	status = "okay";
		//};

		i2c_bus5: i2c@40345000 {
			compatible = "ene,kb106x-i2c";
			reg = <0x40345000 0x1000>;
			i2cs-reg = <0x40350000 0x40351000>;
			interrupts = <15 1>, <16 1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
			support-target-mode = <0>;
			slave-num = <0>;
		};
		//smbus5: smbus5 {
		//	compatible = "ene,kb106x-smbus","simple-bus";
		//	#address-cells = <1>;
		//	#size-cells = <0>;
		//	i2c = <&i2c_bus5>;
		//	status = "okay";
		//};

		tach0: tach@40100000 {
			compatible = "ene,kb106x-tach";
			reg = <0x40100000 0x10>;
			status = "disabled";
		};

		tach1: tach@40100010 {
			compatible = "ene,kb106x-tach";
			reg = <0x40100010 0x10>;
			status = "disabled";
		};

		kbd0: kbd@40110000 {
			compatible = "ene,kb106x-kbd";
			reg = <0x40110000 0x100>;
			interrupts = <14 0>;
			row-size = <8>;
			col-size = <21>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		espi0: espi@50200000 {
			compatible = "ene,kb106x-espi";
			reg = <0x50200000 0x1000>;
			espivw-reg = <0x50202000>;
			espivw-tab = <0x50202100>;
			espioob-reg = <0x50203000>;
			espifa-reg = <0x50204000>;
			hif-reg = <0x50210000>;
			kbc-reg = <0x50211000>;
			eci-reg = <0x50212000>;
			legi-reg = <0x50213000>;
			dbi-reg = <0x50214000>;
			mbx-reg = <0x50215000>;
			uart-reg = <0x50216000>;
			interrupts = <30 3>,   // 46-16
			             <31 3>,
			             <32 3>,
			             <24 3>,
			             <25 3>,
			             <26 3>,
			             <27 3>,
			             <28 3>,
			             <29 3>,
			             <21 3>;
			interrupt-names = "vwire", "oob", "flash", "kbc", "eci", "dbi", "legi", "mbx", "iotosram", "uart";
			gpios = <&gpio0x1x 0x07 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		fanpwm0: fanpwm@40200000 {
			compatible = "ene,kb106x-pwm";
			reg = <0x40200000 0x10>;
			pwm-channel = <0>;
			#pwm-cells = <3>;
			status = "disabled";
		};

		fanpwm1: fanpwm@40200010 {
			compatible = "ene,kb106x-pwm";
			reg = <0x40200010 0x10>;
			pwm-channel = <1>;
			#pwm-cells = <3>;
			status = "disabled";
		};

		ledpwm0: fanpwm@40220000 {
			compatible = "ene,kb106x-pwm";
			reg = <0x40220000 0x10>;
			pwm-channel = <0>;
			#pwm-cells = <3>;
			status = "disabled";
		};

		ledpwm1: fanpwm@40220010 {
			compatible = "ene,kb106x-pwm";
			reg = <0x40220010 0x10>;
			pwm-channel = <1>;
			#pwm-cells = <3>;
			status = "disabled";
		};

		bbram: bbram@40040000 {
			compatible = "ene,kb106x-bbram";
			reg = <0x40040000 0x84>;
			bbram-size = <4>;
			status = "disabled";
		};
	};
};

&pinctrl {
	/* fan tachometer */
	/omit-if-no-ref/ tach0_gpio14: tach0_gpio14 {
		pinmux = <ENE_KB106X_PINMUX(0x14, PINMUX_FUNC_A)>;
		input-enable;
	};
	/omit-if-no-ref/ tach1_gpio15: tach1_gpio15 {
		pinmux = <ENE_KB106X_PINMUX(0x15, PINMUX_FUNC_A)>;
		input-enable;
	};
	/omit-if-no-ref/ tach2_gpio43: tach2_gpio43 {
		pinmux = <ENE_KB106X_PINMUX(0x43, PINMUX_FUNC_A)>;
		input-enable;
	};
	/omit-if-no-ref/ tach3_gpio64: tach3_gpio64 {
		pinmux = <ENE_KB106X_PINMUX(0x64, PINMUX_FUNC_A)>;
		input-enable;
	};
	/* led pwm */
	/omit-if-no-ref/ ledpwm0_gpio19: ledpwm0_gpio19 {
		pinmux = <ENE_KB106X_PINMUX(0x19, PINMUX_FUNC_C)>;
	};
	/omit-if-no-ref/ ledpwm1_gpio54: ledpwm1_gpio54 {
		pinmux = <ENE_KB106X_PINMUX(0x54, PINMUX_FUNC_B)>;
	};
};

&flash0 {
	write-block-size = <1>;
	erase-block-size = <512>;
};

&bbram {
	status = "okay";
};


&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&ser0_tx_gpio16 &ser0_rx_gpio17>;
	pinctrl-names = "default";
};

&gpio0x1x {
	status = "okay";
};

&gpio2x3x {
	status = "okay";
};

&gpio4x5x {
	status = "okay";
};

&gpio6x7x {
	status = "okay";
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_gpio38 &adc1_gpio39 &adc2_gpio3a &adc3_gpio3b>;
	pinctrl-names = "default";
};


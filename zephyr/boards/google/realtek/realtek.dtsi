#include <cros/realtek/realtek.dtsi>
#include <dt-bindings/gpio_defines.h>
#include <dt-bindings/gpio/realtek-gpio.h>
#include <realtek/ec/rts5912-pinctrl.dtsi>
#include <cros/vivaldi_kbd_default.dtsi>

/ {
	model = "Google realtek Baseboard";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash-controller = &flash_controller;
		// cros-ec,raw-kb = &kbd;
	};
};

&cpu0 {
	cpu-power-states = <&idle &suspend_to_ram>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};
 
&uart0_wrapper {
	status = "okay";
	pinctrl-0 = <&uart_rx_gpio113 &uart_tx_gpio114>;
	pinctrl-names = "default";
};

&kbd {
	actual-key-mask = <0x1c 0xff 0xff 0xff 0xff
			   0xf5 0xff 0xa4 0xff 0xfe
			   0x55 0xfa 0xca>;
	poll-period-ms = <3>;
	stable-poll-period-ms = <9>;
};

&bbram {
	status = "okay";
};

&flash_controller {
 	status = "okay";
};

&eflash {
	status = "okay";
};

/dts-v1/;

#include <cros/microchip/mec1727.dtsi>
#include <cros/thermistor/thermistor.dtsi>
#include <dt-bindings/gpio_defines.h>
#include <microchip/mec172xnsz.dtsi>
#include <microchip/mec172x/mec172xnsz-pinctrl.dtsi>

/ {
	model = "MEC172x EVB";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
	};

	named-i2c-ports {
		compatible = "named-i2c-ports";
		i2c_sensor: sensor {
			i2c-port = <&i2c_smb_0>;
			enum-name = "I2C_PORT_SENSOR";
		};
		tcpc0_2 {
			i2c-port = <&i2c_smb_1>;
			enum-name = "I2C_PORT_USB_C0_C2_TCPC";
		};
		tcpc1 {
			i2c-port = <&i2c_smb_2>;
			enum-name = "I2C_PORT_USB_C1_TCPC";
		};
		ppc0_2 {
			i2c-port = <&i2c_smb_3>;
			enum-name = "I2C_PORT_USB_C0_C2_PPC";
		};
		ppc1 {
			i2c-port = <&i2c_smb_3>;
			enum-name = "I2C_PORT_USB_C1_PPC";
		};
		retimer0_2 {
			i2c-port = <&i2c_smb_3>;
			enum-name = "I2C_PORT_USB_C0_C2_MUX";
		};
		battery {
			i2c-port = <&i2c_smb_0>;
			enum-name = "I2C_PORT_BATTERY";
		};
		eeprom {
			i2c-port = <&i2c_smb_4>;
			enum-name = "I2C_PORT_EEPROM";
		};
		charger {
			i2c-port = <&i2c_smb_4>;
			enum-name = "I2C_PORT_CHARGER";
		};
		mp2964 {
			i2c-port = <&i2c_smb_4>;
			enum-name = "I2C_PORT_MP2964";
		};
	};

	named-pwms {
		compatible = "named-pwms";
	};

	named-adc-channels {
		compatible = "named-adc-channels";

		adc_ddr_soc: ddr_soc {
			label = "TEMP_DDR_SOC";
			enum-name = "ADC_TEMP_SENSOR_1_DDR_SOC";
			channel = <5>;
		};
		adc_ambient: ambient {
			label = "TEMP_AMBIENT";
			enum-name = "ADC_TEMP_SENSOR_2_AMBIENT";
			channel = <3>;
		};
		adc_charger: charger {
			label = "TEMP_CHARGER";
			enum-name = "ADC_TEMP_SENSOR_3_CHARGER";
			channel = <0>;
		};
		adc_wwan: wwan {
			label = "TEMP_WWAN";
			enum-name = "ADC_TEMP_SENSOR_4_WWAN";
			channel = <4>;
		};
	};

	named-temp-sensors {
		ddr_soc {
			compatible = "cros-ec,temp-sensor";
			thermistor = <&thermistor_3V3_30K9_47K_4050B>;
			label = "DDR and SOC";
			enum-name = "TEMP_SENSOR_1_DDR_SOC";
			temp_fan_off = <35>;
			temp_fan_max = <60>;
			temp_host_high = <85>;
			temp_host_halt = <90>;
			temp_host_release_high = <80>;
			adc = <&adc_ddr_soc>;
		};
		ambient {
			compatible = "cros-ec,temp-sensor";
			thermistor = <&thermistor_3V3_30K9_47K_4050B>;
			label = "Ambient";
			enum-name = "TEMP_SENSOR_2_AMBIENT";
			temp_fan_off = <35>;
			temp_fan_max = <60>;
			temp_host_high = <85>;
			temp_host_halt = <90>;
			temp_host_release_high = <80>;
			adc = <&adc_ambient>;
		};
		charger {
			compatible = "cros-ec,temp-sensor";
			thermistor = <&thermistor_3V3_30K9_47K_4050B>;
			label = "Charger";
			enum-name = "TEMP_SENSOR_3_CHARGER";
			temp_fan_off = <35>;
			temp_fan_max = <65>;
			temp_host_high = <105>;
			temp_host_halt = <120>;
			temp_host_release_high = <90>;
			adc = <&adc_charger>;
		};
		wwan {
			compatible = "cros-ec,temp-sensor";
			thermistor = <&thermistor_3V3_30K9_47K_4050B>;
			label = "WWAN";
			enum-name = "TEMP_SENSOR_4_WWAN";
			temp_fan_off = <35>;
			temp_fan_max = <60>;
			temp_host_high = <130>;
			temp_host_halt = <130>;
			temp_host_release_high = <100>;
			adc = <&adc_wwan>;
		};
	};

	soc {
		/delete-node/ rtc@400f5000;
		/delete-node/ kscan@40009c00;

		crtc: cros-rtc@400f5000 {
			compatible = "microchip,xec-cros-rtc";
			reg = <0x400f5000 0x100>;
			interrupts = <119 0>, <120 0>;
			label = "CRTC";
		};

		cros_kb_raw: cros-kb-raw@40009c00 {
			compatible = "microchip,xec-cros-kb-raw";
			reg = <0x40009c00 0x18>;
			label = "CROS_KB_RAW_0";
			interrupts = <135 4>;
		};
	};
};

&cpu0 {
	status = "okay";
/* cpu-power-states = <&suspend_to_idle_instant &suspend_to_idle_normal>; */
};

&bbram {
	status = "okay";
};

&ecia {
	status = "okay";
};

/* Enable aggregated GIRQ24/25 for eSPI virtual wires */
&girq24 {
	status = "okay";
};

&girq25 {
	status = "okay";
};

&espi0 {
	status = "okay";
	pinctrl-0 = <&pinctrl_espi_reset
		     &pinctrl_espi_cs
		     &pinctrl_espi_clk
		     &pinctrl_espi_io0
		     &pinctrl_espi_io1
		     &pinctrl_espi_io2
		     &pinctrl_espi_io3>;
	pinctrl-names = "default";
};

/* Host facing devices on eSPI bus */
&kbc0 {
	status = "okay";
};

&acpi_ec0 {
	status = "okay";
};

&acpi_ec1 {
	status = "okay";
};

&emi0 {
	status = "okay";
};

&p80bd0 {
	status = "okay";
};

&crtc {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinctrl_uart0_tx &pinctrl_uart0_rx>;
	pinctrl-names = "default";
};

&spi0 {
	status = "okay";
	clock-frequency = <12000000>;
	lines = <2>;
	port-sel = <2>;
	chip-select = <0>;
	pinctrl-0 = < &pinctrl_qint_cs0
		      &pinctrl_qint_clk
		      &pinctrl_qint_io0
		      &pinctrl_qint_io1
		      &pinctrl_qint_wpn >;
	pinctrl-names = "default";

	int_flash: sst25pf040@0 {
		compatible ="jedec,spi-nor";
		/*  4194304 bits = 512K Bytes */
		size = <0x400000>;
		label = "SST25PF040";
		reg = <0>;
		spi-max-frequency = <40000000>;
		status = "okay";
		jedec-id = [62 06 13];
	};
};

&i2c_smb_0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	port_sel = <0>;
	pinctrl-0 = <&pinctrl_i2c_scl0 &pinctrl_i2c_sda0>;
	pinctrl-names = "default";
};

&i2c_smb_1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST_PLUS>;
	port_sel = <2>;
	pinctrl-0 = <&pinctrl_i2c_scl2 &pinctrl_i2c_sda2>;
	pinctrl-names = "default";
};

&i2c_smb_2 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST_PLUS>;
	port_sel = <3>;
	pinctrl-0 = <&pinctrl_i2c_scl3 &pinctrl_i2c_sda3>;
	pinctrl-names = "default";
};

&i2c_smb_3 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST_PLUS>;
	port_sel = <6>;
	pinctrl-0 = <&pinctrl_i2c_scl6 &pinctrl_i2c_sda6>;
	pinctrl-names = "default";
};

&i2c_smb_4 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	port_sel = <7>;
	pinctrl-0 = <&pinctrl_i2c_scl7 &pinctrl_i2c_sda7>;
	pinctrl-names = "default";

	pmic_mp2964: pmic_mp2964@20 {
		compatible = "mps,mp2964";
		reg = <0x20>;
		label = "I2C_ADDR_MP2964_FLAGS";
	};
};

&cros_kb_raw {
	status = "okay";
	/*
	 * No KSO2 (It's inverted and implemented by GPIO for
	 * CONFIG_KEYBOARD_COL2_INVERTED.)
	 */
	pinctrl-0 = <&pinctrl_ksi0
		     &pinctrl_ksi1
		     &pinctrl_ksi3
		     &pinctrl_ksi4
		     &pinctrl_ksi5
		     &pinctrl_ksi6
		     &pinctrl_ksi7
		     &pinctrl_kso0
		     &pinctrl_kso1
		     &pinctrl_kso2
		     &pinctrl_kso3
		     &pinctrl_kso4
		     &pinctrl_kso5
		     &pinctrl_kso6
		     &pinctrl_kso7
		     &pinctrl_kso8
		     &pinctrl_kso9
		     &pinctrl_kso10
		     &pinctrl_kso11
		     &pinctrl_kso12
		     &pinctrl_kso13
		     &pinctrl_kso14
		     &pinctrl_kso15
		     &pinctrl_kso16
		     &pinctrl_kso17>;
	pinctrl-names = "default";
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&pinctrl_adc0_in0
		     &pinctrl_adc0_in3
		     &pinctrl_adc0_in4
		     &pinctrl_adc0_in5>;
	pinctrl-names = "default";
};

&thermistor_3V3_30K9_47K_4050B {
	status = "okay";
};

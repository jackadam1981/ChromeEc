      "writtenOn": "2020-04-03T21:33:52Z",
      "side": 1,
      "message": "Why is this function needed?  Are there faults that never clear even after reading the status register?  See my note below regarding the state register values.",
      "range": {
        "startLine": 107,
        "startChar": 12,
        "endLine": 107,
        "endChar": 36
      },
      "revId": "5a8a22836a5d9056ad4c265217f395aa90b8aea0",

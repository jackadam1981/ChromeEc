    {
      "key": {
        "uuid": "2640e9cd_2cb840e6",
        "filename": "common/usb_pd_alt_mode_dfp.c",
        "patchSetId": 1
      },
      "lineNbr": 589,
      "author": {
        "id": 1305927
      },
      "writtenOn": "2020-09-18T18:04:34Z",
      "side": 1,
      "message": "This CL changes the contract for this function and, indirectly, for pd_get_modes_discovery. In particular, it used to be the case that, if pd_get_modes_discovery returned success, the discovery structure was coherent and complete. This will no longer be true. Also, this function will no longer return a pointer to a successfully discovered mode.\n\nAFAICT, the direct and indirect consumers of these functions will treat this change safely and sanely, i.e. they will not try to access mode data for an SVID that failed mode discovery.\n\nThe comments for these functions in usb_pd.h should be updated to reflect the change. When I wrote this function, I couldn\u0027t think of a good name for it. If you can think of a better one now, feel free to change it.",
      "revId": "37e025d303380516a4474e9c0b6361e114458098",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true
    },

      },
      "writtenOn": "2020-09-18T18:04:34Z",
      "side": 1,
      "message": "svid_good_discovery could just be a bool.",
      "revId": "37e025d303380516a4474e9c0b6361e114458098",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",

        "id": 1000094
      },
      "writtenOn": "2018-06-26T05:49:44Z",
      "side": 1,
      "message": "Shouldn\u0027t you mask off these two bits before doing the OR? (Yes, for 440mA it would work because that has both bits set, but better to do the mask in case things are changed later).",
      "range": {
        "startLine": 332,
        "startChar": 6,
        "endLine": 332,
        "endChar": 7
      },
      "revId": "4910259b0a264da7baa89ec5a1efbe22be9c1173",

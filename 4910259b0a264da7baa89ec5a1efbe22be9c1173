        "id": 1291180
      },
      "writtenOn": "2018-06-26T06:15:05Z",
      "side": 1,
      "message": "By default, the ANALOG_CTRL_8 register bit 2~3 is 0(indicate 240mA), so I just did \"OR\".",
      "parentUuid": "6b18c095_94bac471",
      "range": {
        "startLine": 332,
        "startChar": 6,
        "endLine": 332,
        "endChar": 7
      },
      "revId": "4910259b0a264da7baa89ec5a1efbe22be9c1173",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true

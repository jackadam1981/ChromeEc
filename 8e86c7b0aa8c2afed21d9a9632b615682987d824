      "author": {
        "id": 1190764
      },
      "writtenOn": "2023-08-29T19:55:10Z",
      "side": 1,
      "message": "yes, it\u0027s intentional to the extent that it didn\u0027t affect\npadding when specified at the ec-rw level.\n\ni was also surprised by this, but assumed this is an\n\"intentional\" quirk of the underlying implementation.",
      "parentUuid": "f1f55d61_81011476",
      "range": {
        "startLine": 68,
        "startChar": 4,
        "endLine": 68,
        "endChar": 22

      "key": {
        "uuid": "5786ea70_96f588ef",
        "filename": "test/tablet_broken_sensor.c",
        "patchSetId": 1
      },
      "lineNbr": 92,
      "author": {
        "id": 1104704
      },
      "writtenOn": "2023-03-15T01:39:56Z",
      "side": 1,
      "message": "The duration of the msleep does not matter much. But we need to sleep to let other threads be scheduled.",
      "parentUuid": "ac3dc11e_9b42324d",
      "range": {
        "startLine": 92,
        "startChar": 1,
        "endLine": 92,
        "endChar": 12
      },
      "revId": "493d627698a814ca06f7dcbaa767c0458023720c",

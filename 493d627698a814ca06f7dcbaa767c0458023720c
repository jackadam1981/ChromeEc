      "writtenOn": "2023-03-14T20:57:28Z",
      "side": 1,
      "message": "I\u0027m not all that familiar with standards for EC tests, but these delays concern me and make me think that this test might be flaky if we\u0027re running it on a fully loaded build machine while builds are happening in the background. Is there anything more deterministic we can do, like wait for some background thread that\u0027s simulating interrupts to become quiescent?",
      "range": {
        "startLine": 92,
        "startChar": 1,
        "endLine": 92,
        "endChar": 12
      },
      "revId": "493d627698a814ca06f7dcbaa767c0458023720c",

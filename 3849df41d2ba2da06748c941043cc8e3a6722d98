        "id": 1000402
      },
      "writtenOn": "2013-07-01T21:41:58Z",
      "side": 1,
      "message": "The purpose here is to enable U63 for signal passing from p16 to pin 15, ie PPDUT_SPI1_VREF of PP3300. It is needed only when previous command \"dut_control spi1_vref:pp3300\" doesn\u0027t successfully set PPDUT_SPI1_VREF to pp3300 for unknown reason.",
      "parentUuid": "AAAAbn//3+A\u003d",
      "revId": "3849df41d2ba2da06748c941043cc8e3a6722d98",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },

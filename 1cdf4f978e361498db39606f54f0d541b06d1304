      "writtenOn": "2023-09-06T19:29:18Z",
      "side": 1,
      "message": "Better phrasing: okay. What\u0027s that `(len(devs,)))` thing about?",
      "parentUuid": "9567ff5a_7d197903",
      "revId": "1cdf4f978e361498db39606f54f0d541b06d1304",

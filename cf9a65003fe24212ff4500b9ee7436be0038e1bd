      "writtenOn": "2013-08-06T13:42:58Z",
      "side": 1,
      "message": "Is it a good practice to use global variable?",
      "revId": "cf9a65003fe24212ff4500b9ee7436be0038e1bd",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false

      "writtenOn": "2026-01-29T21:00:53Z",
      "side": 1,
      "message": "Can we have a test where `led_set_custom_patterns` is called within a helper function that defines the pattern?",
      "range": {
        "startLine": 204,
        "startChar": 0,
        "endLine": 222,
        "endChar": 34

      },
      "lineNbr": 229,
      "author": {
        "id": 1000407
      },
      "writtenOn": "2026-01-29T21:46:30Z",
      "side": 1,
      "message": "This is the caller\u0027s responsibility to ensure the data remains valid. The below comment for the API states: `The data pointed to must remain valid until execution completes`.\n\nIn the implementation, a static array is pre-allocated to store these patterns.",
      "parentUuid": "2b17d8d6_b1b9dc69",
      "revId": "8062f20254d66db9d8334e5d03341064bba17231",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

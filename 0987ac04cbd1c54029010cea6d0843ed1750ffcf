      },
      "writtenOn": "2019-04-04T17:22:37Z",
      "side": 1,
      "message": "if (p9221_is_epp(wpc)) {\n\t\tfod_count \u003d board_get_epp_fod(\u0026fod);\n\t\tepp \u003d true;\n\t} else {\n\t\tfod_count \u003d board_get_fod(\u0026fod);\n\t}\n\n\tif (!fod_count || !fod)\n\t\tgoto no_fod;",
      "range": {

      "writtenOn": "2024-01-24T16:35:57Z",
      "side": 1,
      "message": "I don\u0027t think this should be part of the emulator backend.  Each emulator should be responsible for asserting its own interrupt based on other actions.",
      "range": {
        "startLine": 59,
        "startChar": 0,
        "endLine": 59,
        "endChar": 63
      },
      "revId": "6459b98b399edafb51279af9a73d675876961598",

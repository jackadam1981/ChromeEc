      },
      "writtenOn": "2025-12-05T21:19:33Z",
      "side": 1,
      "message": "If we\u0027re not preserving the WP status across reboot, why doesn\u0027t the Zephyr RO + Zephyr RW case fail as well?",
      "range": {
        "startLine": 24,
        "startChar": 5,
        "endLine": 24,
        "endChar": 46
      },
      "revId": "3b347e6257dbf6433f7e4ba850d79adc3e6f6c59",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"

      },
      "lineNbr": 217,
      "author": {
        "id": 1123814
      },
      "writtenOn": "2018-06-26T15:56:56Z",
      "side": 1,
      "message": "If the I2CIDLE write gets NAKd for instance. Again, not a likely outcome, but a possibility.",
      "parentUuid": "c37705e7_3a145568",
      "range": {
        "startLine": 217,
        "startChar": 9,

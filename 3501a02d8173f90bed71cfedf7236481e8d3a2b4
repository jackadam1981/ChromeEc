    {
      "key": {
        "uuid": "546250d3_5bbe76aa",
        "filename": "/COMMIT_MSG",
        "patchSetId": 2
      },
      "lineNbr": 11,
      "author": {
        "id": 1002124
      },
      "writtenOn": "2017-02-23T04:42:48Z",
      "side": 1,
      "message": "Are we limiting wattage or current? In either case applying a fixed percentage to any current seems odd. Shouldn\u0027t we be applying a max()? Otherwise we\u0027re just applying this setting for all currents negotiated -- even if they are low to be even lower. I get I approved the other one. But now that Vincent brought up the question I\u0027m curious why we\u0027re completely basing these percentages of current across the board -- no matter what it actually seems the max current is a function of load and negotiated PD settings. That hasn\u0027t been answered.",
      "parentUuid": "ae9d24f4_feb233b7",
      "range": {
        "startLine": 11,
        "startChar": 4,
        "endLine": 11,
        "endChar": 27
      },
      "revId": "3501a02d8173f90bed71cfedf7236481e8d3a2b4",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": true

      "writtenOn": "2025-09-25T19:49:39Z",
      "side": 1,
      "message": "given that this IMVP9.x chip is very SoC specific, do you expect boards\nto need different implementations for this?",
      "range": {
        "startLine": 280,
        "startChar": 19,
        "endLine": 280,
        "endChar": 53

      "key": {
        "uuid": "36d7a63a_fce8f091",
        "filename": "driver/rt3645.c",
        "patchSetId": 7
      },
      "lineNbr": 0,
      "author": {
        "id": 1190764
      },
      "writtenOn": "2025-09-25T19:49:39Z",
      "side": 1,
      "message": "the driver should not contain the platform/board specific tuning values.\nthese should move to ocelotrvp, if i understand your objective.\n\nhave a look at how we structured this on brya:\n\nhttps://chromium-review.googlesource.com/c/chromiumos/platform/ec/+/2827950\nhttps://chromium-review.googlesource.com/c/chromiumos/platform/ec/+/2823634",
      "revId": "d098d4061a40d7046d6594423cb0cd3f1520cc28",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "d32faf6e_68559b00",
        "filename": "driver/rt3645.c",
        "patchSetId": 7
      },
      "lineNbr": 3,
      "author": {
        "id": 1308749
      },
      "writtenOn": "2025-09-29T16:27:32Z",
      "side": 1,
      "message": "This will only be used on Zephyr EC boards.\n\nThis entire file should be moved to platform/ec/zephyr/drivers/imvp/ and the updated to follow the Zephyr driver model.\n\nYou can then set the I2C port and target address using a node in the devicetree instead of hard coding `I2C_PORT_IMVP` and `I2C_ADDR_IMVP`.\n\nAlso use the Zephyr native API `i2c_transfer_dt` instead of the legacy EC versions.",
      "range": {
        "startLine": 3,
        "startChar": 0,
        "endLine": 3,
        "endChar": 29
      },
      "revId": "d098d4061a40d7046d6594423cb0cd3f1520cc28",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

      },
      "writtenOn": "2025-09-29T16:27:32Z",
      "side": 1,
      "message": "This won\u0027t be used on any legacy EC platforms.  No changes to this file are  needed.",
      "range": {
        "startLine": 261,
        "startChar": 0,
        "endLine": 261,
        "endChar": 33
      },
      "revId": "d098d4061a40d7046d6594423cb0cd3f1520cc28",

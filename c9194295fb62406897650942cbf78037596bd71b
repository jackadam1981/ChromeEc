    {
      "key": {
        "uuid": "d3a7d188_f89d99e2",
        "filename": "include/math_util.h",
        "patchSetId": 23
      },
      "lineNbr": 46,
      "author": {
        "id": 1110619
      },
      "writtenOn": "2014-08-21T20:35:51Z",
      "side": 1,
      "message": "matrix_3x3_t is a array type, indeed it is a pointer type already.\nWe do not need to pass a pointer to a pointer type.\n\nBoth works, keep array type is simpler.  There is no stack overhead at all.\n\nI did the following tests.\n$ cat ~/t.c \n#include\u003cstdio.h\u003e\n#include\u003cstdlib.h\u003e\n#include\u003cstdint.h\u003e\n\ntypedef int vector_3_t[3];\ntypedef float matrix_3x3_t[3][3];\n\nvoid r(vector_3_t a, vector_3_t b)\n{\n  b[0] \u003d 2*a[0];\n  b[1] \u003d 2*a[1];\n  b[2] \u003d 2*a[2];\n}\nvoid f(matrix_3x3_t m)\n{\n  int t \u003d 11;\n  m[1][1] \u003d t;\n  printf(\"%p\\n\", \u0026t);\n}\nvoid g(matrix_3x3_t *m)\n{\n  int t \u003d 12;\n  (*m)[1][1] \u003d t;\n  printf(\"%p\\n\", \u0026t);\n}\nint main(void)\n{\n   matrix_3x3_t m;\n   vector_3_t a,b;\n   a[0]\u003d1;\n   a[1]\u003d2;\n   a[2]\u003d3;\n   r(a, b);\n   f(m);\n   printf(\"%d %d %d\\n\", b[0], b[1], b[2]);\n   printf(\"%f\\n\", m[1][1]);\n   g(\u0026m);\n   printf(\"%f\\n\", m[1][1]);\n   return 0;\n}\n\nOutput:\n$ ~/a.out \n0x7fffc26d416c\n2 4 6\n11.000000\n0x7fffc26d416c\n12.000000",
      "parentUuid": "13432982_e403ae73",

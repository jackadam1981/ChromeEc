      "writtenOn": "2014-08-21T19:46:57Z",
      "side": 1,
      "message": "there\u0027s a good reason for passing in pointers here. these are big data structures, and if you pass in by value it adds a lot to the stack.",
      "range": {
        "startLine": 46,
        "startChar": 51,
        "endLine": 46,
        "endChar": 52
      },
      "revId": "c9194295fb62406897650942cbf78037596bd71b",

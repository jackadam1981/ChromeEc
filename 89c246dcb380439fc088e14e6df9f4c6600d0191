      "writtenOn": "2023-02-02T22:07:22Z",
      "side": 1,
      "message": "Thread names can be compiled out with `CONFIG_THREAD_NAME\u003dn`, so you\u0027ll need a different mechanism for the block list.",
      "range": {
        "startLine": 18,
        "startChar": 2,
        "endLine": 18,
        "endChar": 12
      },
      "revId": "89c246dcb380439fc088e14e6df9f4c6600d0191",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },

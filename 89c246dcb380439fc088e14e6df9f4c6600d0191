        "uuid": "ee97667d_7e63d8f7",
        "filename": "include/ec_commands.h",
        "patchSetId": 9
      },
      "lineNbr": 5580,
      "author": {
        "id": 1519424
      },
      "writtenOn": "2023-02-08T05:11:45Z",
      "side": 1,
      "message": "Fair enough. Removed.",
      "parentUuid": "1b9559a7_8706a8e5",
      "range": {
        "startLine": 5579,
        "startChar": 1,
        "endLine": 5580,
        "endChar": 19
      },
      "revId": "89c246dcb380439fc088e14e6df9f4c6600d0191",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "fba4786f_64ee884d",
        "filename": "util/ectool.cc",
        "patchSetId": 9

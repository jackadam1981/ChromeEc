      "writtenOn": "2018-09-18T15:47:56Z",
      "side": 1,
      "message": "Is it safe for a task to call task_reset() on itself, as long as wait\u003d0?",
      "range": {
        "startLine": 280,
        "startChar": 58,
        "endLine": 281,
        "endChar": 22
      },
      "revId": "0251e7f56c39bff7001c756f3e1750cbcc6f3673",
